@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentDashboardVm
@using InterTrips___Turistička_Agencija.Enums
@{
    ViewData["Title"] = "InterTrips - Agent Panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --sidebar-hover: #133a43;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.04);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --danger: #b91c1c;
                --danger-bg: #fef2f2;
                --danger-border: #fecaca;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
                display: flex; 
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-dark);
                color: var(--white);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 101;
                box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            }

            .logo-area {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logo-text {
                color: var(--white);
                font-size: 20px;
                font-weight: 700;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding: 24px 16px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #a3b8cc;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .nav-item:hover {
                    background-color: var(--sidebar-hover);
                    color: var(--white);
                }

                .nav-item.active {
                    background-color: var(--primary);
                    color: var(--white);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logout-btn {
                width: 100%;
                background: rgba(185, 28, 28, 0.1);
                color: #ef4444;
                border: 1px solid rgba(185, 28, 28, 0.2);
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .sidebar-logout-btn:hover {
                    background: var(--danger);
                    color: var(--white);
                    border-color: var(--danger);
                }

            .main-content {
                margin-left: 260px; 
                flex-grow: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .dash-topbar {
                height: 70px;
                padding: 0 32px;
                display: flex;
                align-items: center;
                justify-content: flex-end; 
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: var(--shadow-sm);
            }

            .topbar-actions {
                display: flex;
                gap: 12px;
                align-items: center;
            }

            .dash-page {
                padding: 40px 32px;
                flex-grow: 1;
            }

            .dash-shell {
                max-width: 1200px;
                margin: 0 auto;
                width: 100%;
            }

            .dash-hero {
                padding: 32px;
                background: var(--white);
                border: 1px solid var(--border-color);
                border-radius: 16px;
                box-shadow: var(--shadow-md);
                margin-bottom: 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .hero-text-area .badge {
                background: var(--sidebar-dark);
                color: #dff4f5;
                padding: 6px 12px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                display: inline-block;
                margin-bottom: 12px;
            }

            .dash-hero h1 {
                font-size: 28px;
                font-weight: 700;
                margin: 0 0 6px 0;
                color: var(--sidebar-dark);
                letter-spacing: -0.5px;
            }

            .dash-hero p {
                margin: 0;
                color: var(--text-muted);
                font-size: 14px;
            }

            .hero-metrics {
                display: flex;
                gap: 16px;
            }

            .metric-card {
                padding: 16px 24px;
                border-radius: 12px;
                background: var(--primary-accent);
                border: 1px solid rgba(30, 127, 136, 0.15);
                text-align: center;
                min-width: 130px;
            }

                .metric-card strong {
                    font-size: 32px;
                    font-weight: 700;
                    color: var(--primary);
                    display: block;
                    line-height: 1.2;
                }

                .metric-card span {
                    font-size: 11px;
                    color: var(--text-muted);
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

            .dash-grid {
                display: grid;
                grid-template-columns: 1.2fr 1fr;
                gap: 30px;
            }

            .dash-card {
                background: var(--white);
                border: 1px solid var(--border-color);
                border-radius: 16px;
                padding: 28px;
                box-shadow: var(--shadow-md);
            }

                .dash-card h2 {
                    font-size: 16px;
                    font-weight: 700;
                    color: var(--sidebar-dark);
                    margin: 0 0 24px 0;
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    border-bottom: 1px solid var(--border-color);
                    padding-bottom: 14px;
                }

                    .dash-card h2 a {
                        font-size: 13px;
                        font-weight: 500;
                        text-transform: none;
                        letter-spacing: 0;
                        color: var(--primary);
                        text-decoration: none;
                        transition: color 0.2s;
                    }

                        .dash-card h2 a:hover {
                            color: var(--sidebar-dark);
                        }

            .dest-list {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .dest-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 20px;
                border-radius: 12px;
                background: var(--white);
                border: 1px solid var(--border-color);
                transition: all 0.2s ease;
            }

                .dest-item:hover {
                    border-color: var(--primary-light);
                    background-color: var(--primary-accent);
                    transform: translateX(4px);
                }

                .dest-item strong {
                    font-size: 14px;
                    font-weight: 600;
                    color: var(--sidebar-dark);
                    display: block;
                }

                .dest-item small {
                    color: var(--text-muted);
                    font-size: 12px;
                    display: block;
                    margin-top: 3px;
                }

            .pill-link {
                padding: 10px 18px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                border: 1px solid var(--border-color);
                color: var(--sidebar-dark);
                background: var(--white);
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
                box-shadow: var(--shadow-sm);
            }

                .pill-link:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                }

            .select-btn {
                border: 1px solid var(--primary);
                border-radius: 8px;
                padding: 8px 16px;
                background: var(--primary);
                color: var(--white);
                font-weight: 600;
                font-size: 13px;
                cursor: pointer;
                transition: all 0.2s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .select-btn:hover {
                    background: var(--sidebar-dark);
                    border-color: var(--sidebar-dark);
                    box-shadow: 0 4px 10px rgba(10, 34, 40, 0.15);
                }

            .btn-muted {
                background: #f1f5f9;
                color: #475569;
                border-color: #cbd5e1;
            }

                .btn-muted:hover {
                    background: #e2e8f0;
                    border-color: #94a3b8;
                    color: #1e293b;
                    box-shadow: none;
                }

            .empty-state {
                text-align: center;
                padding: 32px;
                color: var(--text-muted);
            }

                .empty-state i {
                    font-size: 28px;
                    color: #cbd5e1;
                    margin-bottom: 12px;
                }

            @@media (max-width: 992px) {
                .sidebar {
                    width: 70px;
                }

                    .sidebar .sidebar-logo-text,
                    .sidebar .nav-item span,
                    .sidebar .sidebar-logout-btn span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                }

                .dash-grid {
                    grid-template-columns: 1fr;
                }

                .dash-hero {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                }
            }

            @@media (max-width: 600px) {
                .sidebar {
                    display: none; 
                }

                .main-content {
                    margin-left: 0;
                }

                .dash-topbar {
                    padding: 0 16px;
                }

                .topbar-actions span {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Agent/Index" class="nav-item active">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Agent/Rezervacije?agentId=@Model.AgentId" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Agent/Paketi?agentId=@Model.AgentId" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Agent/Izvjestaj?agentId=@Model.AgentId" class="nav-item ">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout" style="display:block; width:100%;">
                @Html.AntiForgeryToken()
                <button class="sidebar-logout-btn" type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content">
        <header class="dash-topbar">
            <div class="topbar-actions">
                <a href="/Agent/Rezervacije?agentId=@Model.AgentId" class="pill-link">
                    <i class="fa-solid fa-list-check"></i> <span>Pregled svih rezervacija</span>
                </a>
            </div>
        </header>

        <main class="dash-page">
            <div class="dash-shell">

                <div class="dash-hero">
                    <div class="hero-text-area">
                        <span class="badge"><i class="fa-solid fa-user-tie"></i> Turistički Agent</span>
                        <h1>Dobrodošao nazad</h1>
                        <p>Danas imaš <strong>@(Model.AktivneRezervacije?.Count ?? 0)</strong> aktivnih rezervacija koje zahtijevaju tvoju pažnju.</p>
                    </div>
                    <div class="hero-metrics">
                        <div class="metric-card">
                            <strong>@(Model.MojiPaketiIds?.Count ?? 0)</strong>
                            <span>Tvojih paketa</span>
                        </div>
                    </div>
                </div>

                <div class="dash-grid">

                    <div class="dash-card">
                        <h2>
                            <span><i class="fa-solid fa-bell" style="color: var(--primary); margin-right: 6px;"></i> Aktivne rezervacije</span>
                            <a href="/Agent/Rezervacije?agentId=@Model.AgentId">Vidi sve <i class="fa-solid fa-arrow-right" style="font-size: 10px;"></i></a>
                        </h2>

                        <div class="dest-list">
                            @if (Model.AktivneRezervacije == null || !Model.AktivneRezervacije.Any())
                            {
                                <div class="empty-state">
                                    <i class="fa-solid fa-folder-open"></i>
                                    <p style="margin: 0;">Trenutno nema aktivnih rezervacija.</p>
                                    <small style="color: var(--text-muted);">Preuzmite pakete sa desne strane da pokrenete prodaju.</small>
                                </div>
                            }
                            else
                            {
                                foreach (var r in Model.AktivneRezervacije.Take(5))
                                {
                                    <div class="dest-item">
                                        <div>
                                            <strong>#@r.Id — @(r.Korisnik?.Email ?? "Klijent")</strong>
                                            <small><i class="fa-solid fa-plane-departure" style="font-size: 10px; color: var(--text-muted);"></i> @(r.Paket?.Naziv ?? "Paket") • <span style="font-weight: 600;">@r.Status.ToString()</span></small>
                                        </div>
                                        <a class="select-btn" href="/Agent/Rezervacije?agentId=@Model.AgentId">
                                            Detalji <i class="fa-solid fa-chevron-right" style="font-size: 10px;"></i>
                                        </a>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="dash-card">
                        <h2>
                            <span><i class="fa-solid fa-cubes" style="color: var(--primary); margin-right: 6px;"></i> Dostupni paketi</span>
                        </h2>

                        <div class="dest-list">
                            @if (Model.SviPaketi != null)
                            {
                                foreach (var p in Model.SviPaketi.Take(8))
                                {
                                    bool isMine = Model.MojiPaketiIds != null && Model.MojiPaketiIds.Contains(p.Id);
                                    <div class="dest-item">
                                        <div>
                                            <strong>@p.Naziv</strong>
                                            <small><i class="fa-solid fa-tags" style="font-size: 10px;"></i> @p.CijenaOd BAM • <i class="fa-regular fa-moon" style="font-size: 10px;"></i> @p.TrajanjeNoci noći</small>
                                        </div>
                                        <form method="post" action="/Agent/TogglePaket">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="agentId" value="@Model.AgentId" />
                                            <input type="hidden" name="paketId" value="@p.Id" />
                                            @if (isMine)
                                            {
                                                <button class="select-btn btn-muted" type="submit">
                                                    <i class="fa-solid fa-xmark"></i> Pusti
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="select-btn" type="submit">
                                                    <i class="fa-solid fa-plus"></i> Preuzmi
                                                </button>
                                            }
                                        </form>
                                    </div>
                                }
                            }
                        </div>

                        <div style="margin-top: 24px;">
                            <a href="/Agent/Paketi?agentId=@Model.AgentId" class="pill-link" style="display: flex; justify-content: center; width: auto; text-align: center;">
                                <i class="fa-solid fa-gear"></i> Upravljaj svim paketima
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

</body>
</html>