@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentDashboardVm
@{
    ViewData["Title"] = "InterTrips - Agent Panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --glass: rgba(255, 255, 255, 0.82);
                --border: rgba(95, 181, 187, 0.16);
                --shadow: 0 8px 32px rgba(31, 38, 135, 0.07);
            }

            body {
                background: linear-gradient(135deg, #f5fbfc 0%, #ffffff 100%);
                font-family: 'Poppins', sans-serif;
                color: #333;
                margin: 0;
            }

            .dash-topbar {
                height: 65px;
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: var(--glass);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border);
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .logo {
                height: 40px;
            }

            .dash-page {
                padding: 40px 20px;
            }

            .dash-shell {
                max-width: 1200px;
                margin: 0 auto;
            }

           
            .dash-hero {
                padding: 30px;
                background: var(--glass);
                border: 1px solid var(--border);
                border-radius: 24px;
                box-shadow: var(--shadow);
                margin-bottom: 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .dash-hero h1 {
                    font-size: 32px;
                    margin: 5px 0;
                    color: #1a1a1a;
                }

            .badge {
                background: #6abfc6;
                color: white;
                padding: 4px 12px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 700;
            }

            .dash-grid {
                display: grid;
                grid-template-columns: 1.4fr 1fr;
                gap: 24px;
            }

            .dash-card {
                background: var(--glass);
                backdrop-filter: blur(10px);
                border: 1px solid var(--border);
                border-radius: 20px;
                padding: 24px;
                box-shadow: var(--shadow);
            }

                .dash-card h2 {
                    font-size: 19px;
                    margin-bottom: 20px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                }

           
            .metric-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
                margin-bottom: 20px;
            }

            .metric {
                padding: 20px;
                border-radius: 16px;
                background: rgba(106, 191, 198, 0.08);
                border: 1px solid var(--border);
                text-align: center;
            }

                .metric strong {
                    font-size: 34px;
                    color: #00796b;
                    display: block;
                }

                .metric span {
                    font-size: 12px;
                    color: #666;
                    font-weight: 500;
                }

            .dest-list {
                display: grid;
                gap: 12px;
            }

            .dest-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 18px;
                border-radius: 15px;
                background: white;
                border: 1px solid var(--border);
                transition: 0.2s;
            }

                .dest-item:hover {
                    border-color: #6abfc6;
                    transform: translateX(5px);
                }

                .dest-item strong {
                    font-size: 14px;
                    color: #333;
                }

                .dest-item small {
                    color: #888;
                    font-size: 11px;
                    display: block;
                    margin-top: 2px;
                }

            .select-btn {
                border: none;
                border-radius: 10px;
                padding: 8px 16px;
                background: #6abfc6;
                color: #fff;
                font-weight: 700;
                font-size: 12px;
                cursor: pointer;
                transition: 0.3s;
            }

                .select-btn:hover {
                    background: #55a3ab;
                    box-shadow: 0 4px 12px rgba(106, 191, 198, 0.3);
                }

            .btn-muted {
                background: #f1f5f9;
                color: #475569;
                border: 1px solid #e2e8f0;
            }

            .pill-link {
                padding: 8px 18px;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 600;
                text-decoration: none;
                border: 1px solid var(--border);
                color: #333;
                transition: 0.2s;
            }

                .pill-link:hover {
                    background: white;
                    border-color: #6abfc6;
                }

            .logout-btn {
                background: #fff1f1;
                color: #c53030;
                border: 1px solid #fed7d7;
            }

            @@media (max-width: 992px) {
                .dash-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <header class="dash-topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="Logo" class="logo">
        </a>
        <div style="display:flex; gap:10px;">
            <a href="/Agent/Rezervacije?agentId=@Model.AgentId" class="pill-link">Pregled svih rezervacija</a>
            <form method="post" action="/Account/Logout" style="display:inline;">
                <button class="pill-link logout-btn" type="submit">Odjavi se</button>
            </form>
        </div>
    </header>

    <main class="dash-page">
        <div class="dash-shell">

            <div class="dash-hero">
                <div>
                    <span class="badge">TURISTIČKI AGENT</span>
                    <h1>Dobrodošao nazad,</h1>
                    <p style="color:#666;">Danas imate <strong>@Model.AktivneRezervacije.Count</strong> aktivnih rezervacija za provjeru.</p>
                </div>
                <div class="metric-grid" style="margin-bottom:0;">
                    <div class="metric" style="min-width: 120px;">
                        <strong>@Model.MojiPaketiIds.Count</strong>
                        <span>Tvojih paketa</span>
                    </div>
                </div>
            </div>

            <div class="dash-grid">

                <div class="dash-card">
                    <h2>Aktivne rezervacije <a href="/Agent/Rezervacije?agentId=@Model.AgentId" style="font-size:12px; font-weight:400;">Vidi sve →</a></h2>

                    <div class="dest-list">
                        @if (!Model.AktivneRezervacije.Any())
                        {
                            <div style="text-align:center; padding:30px; color:#999;">
                                <p>Trenutno nema aktivnih rezervacija.</p>
                                <small>Preuzmite pakete sa desne strane da počnete.</small>
                            </div>
                        }
                        else
                        {
                            foreach (var r in Model.AktivneRezervacije.Take(5)) 
                            {
                                <div class="dest-item">
                                    <div>
                                        <strong>#@r.Id - @(r.Korisnik?.Email ?? "Klijent")</strong>
                                        <small>@(r.Paket?.Naziv ?? "Paket") • @r.Status</small>
                                    </div>
                                    <a class="select-btn" href="/Agent/Rezervacije?agentId=@Model.AgentId">Detalji</a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="dash-card">
                    <h2>Dostupni paketi</h2>
                    <div class="dest-list">
                        @foreach (var p in Model.SviPaketi.Take(8))
                        {
                            bool isMine = Model.MojiPaketiIds.Contains(p.Id);
                            <div class="dest-item">
                                <div>
                                    <strong>@p.Naziv</strong>
                                    <small>@p.CijenaOd BAM • @p.TrajanjeNoci noći</small>
                                </div>
                                <form method="post" action="/Agent/TogglePaket">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="agentId" value="@Model.AgentId" />
                                    <input type="hidden" name="paketId" value="@p.Id" />
                                    @if (isMine)
                                    {
                                        <button class="select-btn btn-muted" type="submit">Pusti</button>
                                    }
                                    else
                                    {
                                        <button class="select-btn" type="submit">Preuzmi</button>
                                    }
                                </form>
                            </div>
                        }
                    </div>
                    <div style="margin-top:20px; text-align:center;">
                        <a href="/Agent/Paketi?agentId=@Model.AgentId" class="pill-link" style="display:block;">Upravljaj svim paketima</a>
                    </div>
                </div>

            </div>
        </div>
    </main>

</body>
</html>