
@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentDashboardVm
@{
    ViewData["Title"] = "InterTrips - Agent panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

  <style>
    .dash-page { padding: 28px 24px 56px; }
    .dash-topbar {
      height: 58px; padding: 0 28px; display:flex; align-items:center; justify-content:space-between;
      background: rgba(255,255,255,0.78); border-bottom: 1px solid rgba(95,181,187,0.12);
      backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 50;
    }
    .dash-topbar .logo { width: 80px; height: 40px; object-fit: contain; }
    .dash-shell { max-width: 1180px; margin: 0 auto; }
    .dash-hero {
      margin: 22px 0 24px; padding: 24px; background: rgba(255,255,255,0.82);
      border: 1px solid rgba(95,181,187,0.16); border-radius: 18px; box-shadow: var(--shadow);
    }
    .dash-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 8px; color: var(--text); }
    .dash-hero p { color: var(--muted); font-size: 13px; line-height: 1.7; }

    .dash-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .dash-card {
      background: rgba(255,255,255,0.84); border: 1px solid rgba(95,181,187,0.16);
      border-radius: 16px; box-shadow: var(--shadow); padding: 18px;
    }
    .dash-card h2 { font-size: 18px; margin-bottom: 12px; color: var(--text); }

    .metric {
      display:flex; align-items:center; justify-content:space-between; padding:16px; border-radius: 14px;
      background: rgba(106,191,198,0.10); border: 1px solid rgba(95,181,187,0.14); margin-bottom: 12px;
    }
    .metric strong { font-size: 30px; color: var(--primary-dark); }
    .metric span { font-size: 13px; color: var(--muted); }

    .dest-list { display:grid; gap: 10px; }
    .dest-item {
      display:flex; align-items:center; justify-content:space-between; gap: 12px;
      padding: 12px 14px; border-radius: 12px; background: rgba(255,255,255,0.72);
      border: 1px solid rgba(95,181,187,0.14);
    }
    .dest-item strong { font-size: 13px; color: var(--text); }
    .dest-item small { display:block; color: var(--muted); font-size: 11px; margin-top: 3px; }

    .select-btn {
      border:none; border-radius: 999px; padding: 8px 12px;
      background: linear-gradient(135deg, #6abfc6, #86bfe0); color:#fff;
      font-weight:800; font-size:12px; cursor:pointer;
    }
    .btn-muted{
      border: 1px solid rgba(95,181,187,0.18);
      background: rgba(255,255,255,0.72);
      color: var(--primary-dark);
    }

    .logout-btn {
      border: 1px solid rgba(95,181,187,0.25); background: transparent; color: var(--text);
      border-radius: 999px; padding: 8px 14px; cursor: pointer; font-weight: 600; font-size: 12px;
    }
    .top-actions{ display:flex; gap:10px; align-items:center; }
    .pill-link{
      border: 1px solid rgba(95,181,187,0.25); background: transparent; color: var(--text);
      border-radius: 999px; padding: 8px 14px; font-weight: 600; font-size: 12px; text-decoration:none;
    }

    @@media (max-width: 900px){
      .dash-grid{ grid-template-columns: 1fr; }
      .dash-topbar{ padding: 0 16px; }
    }
  </style>
</head>

<body class="auth-page">
<header class="dash-topbar">
  <a href="/" class="logo-link">
    <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
  </a>

  <div class="top-actions">
    <a class="pill-link" href="/Destinacije" target="_blank">Pregled na sajtu</a>
    <button class="logout-btn" type="button" onclick="logout()">Odjavi se</button>
  </div>
</header>

<main class="dash-page">
  <div class="dash-shell">
    <div class="dash-hero">
      <span class="badge">AGENT PANEL</span>
      <h1>Dobrodošli, turistički agent</h1>
      <p>Odaberite pakete koje vodite i pratite aktivne rezervacije (Kreirana / Potvrdjena).</p>
    </div>

    <div class="dash-grid">
      <div class="dash-card">
        <h2>Aktivne rezervacije</h2>

        <div class="metric">
          <div>
            <strong>@Model.AktivneRezervacije.Count</strong>
            <span>Ukupno aktivnih</span>
          </div>
        </div>

        <div class="dest-list">
  @if (Model.AktivneRezervacije == null || !Model.AktivneRezervacije.Any())
  {
    <div class="dest-item">
      <div>
        <strong>Nema aktivnih rezervacija</strong>
        <small>Odaberite paket koji vodite da se rezervacije pojave ovdje.</small>
      </div>
    </div>
  }
  else
  {
    foreach (var r in Model.AktivneRezervacije)
    {
      <div class="dest-item">
        <div>
          <strong>Rezervacija #@r.Id</strong>
          <small>
            @(r.Paket?.Naziv ?? "Paket") •
            @(r.Paket?.Destinacija != null ? $"{r.Paket.Destinacija.Naziv} • {r.Paket.Destinacija.Drzava}" : "—")
            • Status: @r.Status
          </small>
        </div>
        <a class="pill-link" href="/Agent/Rezervacije?agentId=@Model.AgentId">Detalji</a>
      </div>
    }
  }
</div>

      <div class="dash-card">
        <h2>Odaberi pakete koje vodiš</h2>
        <div class="dest-list">
          @foreach (var p in Model.SviPaketi)
          {
            var mine = Model.MojiPaketiIds.Contains(p.Id);

            <div class="dest-item">
              <div>
                <strong>@p.Naziv</strong>
                <small>
                  @(p.Destinacija != null ? $"{p.Destinacija.Naziv} • {p.Destinacija.Drzava}" : "—")
                  • @p.TrajanjeNoci noći • @p.CijenaOd.ToString("0.##") BAM • @p.Status
                </small>
              </div>

              <form method="post" action="/Agent/TogglePaket">
                @Html.AntiForgeryToken()
                <input type="hidden" name="agentId" value="@Model.AgentId" />
                <input type="hidden" name="paketId" value="@p.Id" />

                @if (mine)
                {
                  <button class="select-btn btn-muted" type="submit">Pusti</button>
                }
                else
                {
                  <button class="select-btn" type="submit">Preuzmi</button>
                }
              </form>
            </div>
          }
        </div>
      </div>

  </div>
</main>

<script>
  function logout() {
    localStorage.removeItem('isLoggedIn');
    localStorage.removeItem('userName');
    localStorage.removeItem('userInitial');
    localStorage.removeItem('userRole');
    window.location.href = '/';
  }

  window.addEventListener('DOMContentLoaded', function() {
    const role = localStorage.getItem('userRole');
    if (role !== 'agent') {
      window.location.href = '/korisnik/login';
    }
  });
</script>
</body>
</html>