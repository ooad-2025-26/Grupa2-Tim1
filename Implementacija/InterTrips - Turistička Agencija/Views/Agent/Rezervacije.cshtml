@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentDashboardVm
@{
    ViewData["Title"] = "Agent - Lista Rezervacija";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-gradient: linear-gradient(180deg, #e6f3f3 0%, #dff4f5 100%);
                --primary: #6abfc6;
                --primary-dark: #50a2a8;
                --primary-light: rgba(106, 191, 198, 0.1);
                --text-main: #2d4042;
                --text-muted: #738a8c;
                --shadow: 0 10px 30px rgba(95, 181, 187, 0.08);
                --border: 1px solid rgba(95, 181, 187, 0.16);
                --status-kreirana-bg: rgba(25, 118, 210, 0.1);
                --status-kreirana-txt: #1976d2;
                --status-potvrdjena-bg: rgba(46, 125, 50, 0.1);
                --status-potvrdjena-txt: #2e7d32;
                --status-otkazana-bg: rgba(198, 40, 40, 0.1);
                --status-otkazana-txt: #c62828;
                --status-obrisana-bg: rgba(117, 117, 117, 0.1);
                --status-obrisana-txt: #616161;
            }

            body {
                background: var(--bg-gradient);
                font-family: 'Poppins', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
            }

            .dash-page {
                padding: 40px 20px;
            }

            .dash-shell {
                max-width: 1100px;
                margin: 0 auto;
            }

            .dash-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                background: rgba(255, 255, 255, 0.8);
                backdrop-filter: blur(10px);
                padding: 22px 28px;
                border-radius: 18px;
                border: var(--border);
                box-shadow: var(--shadow);
            }

                .dash-header h1 {
                    font-size: 26px;
                    color: var(--text-main);
                    font-weight: 800;
                    margin: 6px 0 0 0;
                    letter-spacing: -0.5px;
                }

            .agent-badge {
                background: linear-gradient(135deg, #2d4042, #435e61);
                color: #fff;
                font-size: 12px;
                font-weight: 700;
                padding: 6px 16px;
                border-radius: 999px;
                letter-spacing: 0.5px;
                box-shadow: 0 4px 12px rgba(45, 64, 66, 0.15);
            }

            .btn-back {
                text-decoration: none;
                color: var(--text-muted);
                font-size: 13px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                transition: all 0.2s ease;
            }

                .btn-back:hover {
                    color: var(--primary-dark);
                    transform: translateX(-2px);
                }

            .res-card {
                background: rgba(255, 255, 255, 0.9);
                border: 1px solid rgba(0, 0, 0, 0.04);
                border-radius: 18px;
                padding: 22px 28px;
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: var(--shadow);
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            }

                .res-card:hover {
                    transform: translateY(-2px);
                    border-color: var(--primary);
                    box-shadow: 0 14px 35px rgba(95, 181, 187, 0.12);
                }

                .res-card.highlight {
                    background: linear-gradient(90deg, rgba(255, 152, 0, 0.04) 0%, rgba(255, 255, 255, 0.95) 100%);
                    border-left: 6px solid #ff9800;
                }

            .res-info {
                flex: 1;
            }

            .res-title-row {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 6px;
                flex-wrap: wrap;
            }

            .res-info h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 700;
                color: var(--text-main);
            }

            .priority-label {
                background: linear-gradient(135deg, #ff9800, #ffb74d);
                color: white;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.5px;
                box-shadow: 0 4px 10px rgba(255, 152, 0, 0.2);
            }

            .res-meta {
                margin: 0;
                font-size: 13px;
                color: var(--text-muted);
                font-weight: 500;
                line-height: 1.6;
            }

                .res-meta strong {
                    color: var(--text-main);
                }

            .res-submeta {
                margin: 4px 0 0 0;
                font-size: 11px;
                color: var(--text-muted);
                opacity: 0.85;
                display: flex;
                gap: 14px;
            }

            /* Status značke */
            .status-badge {
                padding: 6px 16px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                display: inline-block;
                margin: 0 20px;
            }

            .status-kreirana {
                background: var(--status-kreirana-bg);
                color: var(--status-kreirana-txt);
            }

            .status-potvrdjena {
                background: var(--status-potvrdjena-bg);
                color: var(--status-potvrdjena-txt);
            }

            .status-otkazana {
                background: var(--status-otkazana-bg);
                color: var(--status-otkazana-txt);
            }

            .status-obrisana {
                background: var(--status-obrisana-bg);
                color: var(--status-obrisana-txt);
            }

            /* Akciona dugmad */
            .actions-box {
                display: flex;
                gap: 10px;
            }

            .btn-detail {
                background: linear-gradient(135deg, #6abfc6, #86bfe0);
                color: white;
                border: none;
                border-radius: 999px;
                padding: 10px 24px;
                font-family: 'Poppins', sans-serif;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s ease;
                box-shadow: 0 4px 12px rgba(106, 191, 198, 0.2);
            }

                .btn-detail:hover {
                    background: linear-gradient(135deg, #50a2a8, #6fa9cc);
                    transform: scale(1.02);
                    box-shadow: 0 6px 18px rgba(95, 181, 187, 0.3);
                }

            /* Empty State */
            .empty-state {
                text-align: center;
                padding: 60px 20px;
                background: rgba(255, 255, 255, 0.7);
                border-radius: 20px;
                border: 2px dashed rgba(95, 181, 187, 0.3);
                box-shadow: var(--shadow);
            }

                .empty-state h3 {
                    font-size: 20px;
                    color: var(--text-main);
                    margin-bottom: 6px;
                }

                .empty-state p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin: 0;
                }

            @@media (max-width: 768px) {
                .res-card {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }

                .status-badge {
                    margin: 0;
                }

                .btn-detail {
                    width: 100%;
                    text-align: center;
                }

                .actions-box {
                    width: 100%;
                }

                .dash-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 14px;
                }
            }
    </style>
</head>
<body>

    <div class="dash-page">
        <div class="dash-shell">

            <header class="dash-header">
                <div>
                    <a href="/Agent?agentId=@Model.AgentId" class="btn-back">← Povratak na panel</a>
                    <h1>Lista svih rezervacija</h1>
                </div>
                <div class="agent-badge">AGENT ID: @Model.AgentId</div>
            </header>

            <div class="res-list">
                @if (Model.AktivneRezervacije == null || !Model.AktivneRezervacije.Any())
                {
                    <div class="empty-state">
                        <h3>Nema aktivnih rezervacija</h3>
                        <p>Trenutno nema rezervacija za aranžmane koje vodite.</p>
                    </div>
                }
                else
                {
                    foreach (var r in Model.AktivneRezervacije)
                    {
                        string email = r.Korisnik?.Email ?? "Nepoznat klijent";
                        bool isAlex = email == "alex@example.com";

                        <div class="res-card @(isAlex ? "highlight" : "")">

                            <div class="res-info">
                                <div class="res-title-row">
                                    <h3>#@r.Id - @(r.Paket?.Naziv ?? "Aranžman")</h3>
                                    @if (isAlex)
                                    {
                                        <span class="priority-label">PRIORITET</span>
                                    }
                                </div>
                                <p class="res-meta">
                                    <strong>👤 Klijent:</strong> @email &nbsp;•&nbsp;
                                    <strong>📍 Destinacija:</strong> @(r.Paket?.Destinacija?.Naziv ?? "—")
                                </p>
                                <div class="res-submeta">
                                    <span>📅 Polazak: @r.DatumPolaska.ToString("dd. MMM yyyy")</span>
                                    <span>👥 Putnika: @r.Putnici.Count</span>
                                </div>
                            </div>

                            <div>
                                <span class="status-badge status-@(r.Status.ToString().ToLower())">
                                    @r.Status
                                </span>
                            </div>

                            <div class="actions-box">
                                <button class="btn-detail" onclick="location.href='/Agent/Detalji/@r.Id'">
                                    Detalji
                                </button>
                            </div>

                        </div>
                    }
                }
            </div>

        </div>
    </div>

</body>
</html>