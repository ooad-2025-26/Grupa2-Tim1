@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentDashboardVm
@{
    ViewData["Title"] = "Agent - Lista Rezervacija";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --sidebar-hover: #133a43;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.04);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --status-kreirana-bg: #eff6ff;
                --status-kreirana-txt: #1d4ed8;
                --status-potvrdjena-bg: #f0fdf4;
                --status-potvrdjena-txt: #15803d;
                --status-otkazana-bg: #fef2f2;
                --status-otkazana-txt: #b91c1c;
                --status-obrisana-bg: #f8fafc;
                --status-obrisana-txt: #475569;
                --priority-bg: #fffbeb;
                --priority-border: #f59e0b;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
                display: flex;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-dark);
                color: var(--white);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 101;
                box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            }

            .logo-area {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logo-text {
                color: var(--white);
                font-size: 20px;
                font-weight: 700;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding: 24px 16px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #a3b8cc;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .nav-item:hover {
                    background-color: var(--sidebar-hover);
                    color: var(--white);
                }

                .nav-item.active {
                    background-color: var(--primary);
                    color: var(--white);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logout-btn {
                width: 100%;
                background: rgba(185, 28, 28, 0.1);
                color: #ef4444;
                border: 1px solid rgba(185, 28, 28, 0.2);
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.2s ease;
            }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .dash-page {
                padding: 40px 32px;
            }

            .dash-shell {
                max-width: 1200px;
                margin: 0 auto;
                width: 100%;
                box-sizing: border-box;
            }

            .dash-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
            }

                .dash-header h1 {
                    font-size: 24px;
                    color: var(--sidebar-dark);
                    font-weight: 700;
                    margin: 8px 0 0 0;
                    letter-spacing: -0.5px;
                }

            .agent-badge {
                background: var(--sidebar-dark);
                color: #dff4f5;
                font-size: 11px;
                font-weight: 700;
                padding: 8px 16px;
                border-radius: 8px;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .btn-back {
                text-decoration: none;
                color: var(--text-muted);
                font-size: 14px;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s ease;
            }

                .btn-back:hover {
                    color: var(--primary);
                    transform: translateX(-3px);
                }

            .res-list {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .res-card {
                background: var(--white);
                border: 1px solid var(--border-color);
                border-radius: 16px;
                padding: 24px 32px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: var(--shadow-md);
                transition: all 0.2s ease;
            }

                .res-card:hover {
                    transform: translateY(-2px);
                    border-color: var(--primary-light);
                    box-shadow: 0 12px 30px rgba(10, 34, 40, 0.06);
                }

                .res-card.highlight {
                    background: linear-gradient(90deg, var(--priority-bg) 0%, #ffffff 100%);
                    border-left: 5px solid var(--priority-border);
                }

            .res-info {
                flex: 1;
            }

            .res-title-row {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 8px;
                flex-wrap: wrap;
            }

            .res-info h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 600;
                color: var(--sidebar-dark);
                letter-spacing: -0.3px;
            }

            .priority-label {
                background: #f59e0b;
                color: white;
                padding: 3px 10px;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.5px;
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }

            .res-meta {
                margin: 0 0 8px 0;
                font-size: 13px;
                color: var(--text-muted);
                font-weight: 400;
                line-height: 1.6;
                display: flex;
                gap: 16px;
                flex-wrap: wrap;
            }

                .res-meta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .res-meta strong {
                    font-weight: 600;
                    color: var(--sidebar-dark);
                }

                .res-meta i {
                    color: var(--primary);
                    font-size: 14px;
                }

            .res-submeta {
                font-size: 12px;
                color: var(--text-muted);
                display: flex;
                gap: 16px;
                align-items: center;
            }

                .res-submeta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .res-submeta i {
                    color: var(--text-muted);
                }

            .status-badge {
                padding: 6px 16px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                display: inline-block;
                margin: 0 24px;
                text-align: center;
                min-width: 100px;
                white-space: nowrap;
            }

            .status-kreirana {
                background: var(--status-kreirana-bg);
                color: var(--status-kreirana-txt);
                border: 1px solid rgba(29, 78, 216, 0.15);
            }

            .status-potvrdjena {
                background: var(--status-potvrdjena-bg);
                color: var(--status-potvrdjena-txt);
                border: 1px solid rgba(21, 128, 61, 0.15);
            }

            .status-otkazana {
                background: var(--status-otkazana-bg);
                color: var(--status-otkazana-txt);
                border: 1px solid rgba(185, 28, 28, 0.15);
            }

            .status-obrisana {
                background: var(--status-obrisana-bg);
                color: var(--status-obrisana-txt);
                border: 1px solid rgba(71, 85, 105, 0.15);
            }

            .actions-box {
                display: flex;
            }

            .btn-detail {
                background: var(--primary);
                color: var(--white);
                border: 1px solid transparent;
                border-radius: 8px;
                padding: 10px 20px;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                white-space: nowrap;
            }

                .btn-detail:hover {
                    background: var(--sidebar-dark);
                    box-shadow: 0 4px 12px rgba(10, 34, 40, 0.15);
                }

            .empty-state {
                text-align: center;
                padding: 60px 20px;
                background: var(--white);
                border-radius: 16px;
                border: 2px dashed var(--border-color);
                box-shadow: var(--shadow-md);
            }

                .empty-state i {
                    font-size: 32px;
                    color: #cbd5e1;
                    margin-bottom: 12px;
                }

                .empty-state h3 {
                    font-size: 18px;
                    color: var(--sidebar-dark);
                    margin: 0 0 6px 0;
                }

                .empty-state p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin: 0;
                }

            @@media (max-width: 992px) {
                .sidebar {
                    width: 70px;
                }

                    .sidebar .sidebar-logo-text, .sidebar .nav-item span, .sidebar .sidebar-logout-btn span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                }
            }

           @@media (max-width: 900px) {
                .res-card {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                    padding: 24px;
                }

                .status-badge {
                    margin: 0;
                }

                .actions-box, .btn-detail {
                    width: 100%;
                }

                .btn-detail {
                    justify-content: center;
                }

                .dash-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Agent/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Agent/Rezervacije?agentId=@Model.AgentId" class="nav-item active">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Agent/Paketi?agentId=@Model.AgentId" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Agent/Izvjestaj?agentId=@Model.AgentId" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout" style="display:block; width:100%;">
                @Html.AntiForgeryToken()
                <button class="sidebar-logout-btn" type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content">
        <div class="dash-page">
            <div class="dash-shell">

                <header class="dash-header">
                    <div>
                        <a href="/Agent?agentId=@Model.AgentId" class="btn-back">
                            <i class="fa-solid fa-arrow-left"></i> Povratak na panel
                        </a>
                        <h1>Lista svih rezervacija</h1>
                    </div>
                    <div class="agent-badge">Agent ID: @Model.AgentId</div>
                </header>

                <div class="res-list">
                    @if (Model.AktivneRezervacije == null || !Model.AktivneRezervacije.Any())
                    {
                        <div class="empty-state">
                            <i class="fa-solid fa-folder-open"></i>
                            <h3>Nema aktivnih rezervacija</h3>
                            <p>Trenutno nema rezervacija za aranžmane koje vodite.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var r in Model.AktivneRezervacije)
                        {
                            string email = r.Korisnik?.Email ?? "Nepoznat klijent";
                            bool isAlex = email == "alex@example.com";

                            <div class="res-card @(isAlex ? "highlight" : "")">

                                <div class="res-info">
                                    <div class="res-title-row">
                                        <h3>#@r.Id — @(r.Paket?.Naziv ?? "Aranžman")</h3>
                                        @if (isAlex)
                                        {
                                            <span class="priority-label">
                                                <i class="fa-solid fa-star" style="font-size: 9px;"></i> PRIORITET
                                            </span>
                                        }
                                    </div>

                                    <div class="res-meta">
                                        <span>
                                            <i class="fa-regular fa-user"></i>
                                            <strong>Klijent:</strong> @email
                                        </span>
                                        <span>
                                            <i class="fa-solid fa-location-dot"></i>
                                            <strong>Destinacija:</strong> @(r.Paket?.Destinacija?.Naziv ?? "—")
                                        </span>
                                    </div>

                                    <div class="res-submeta">
                                        <span>
                                            <i class="fa-regular fa-calendar"></i> Polazak: @r.DatumPolaska.ToString("dd. MMM yyyy.")
                                        </span>
                                        <span>
                                            <i class="fa-solid fa-users"></i> Putnika: @r.Putnici.Count
                                        </span>
                                    </div>
                                </div>

                                <div>
                                    <span class="status-badge status-@(r.Status.ToString().ToLower())">
                                        @r.Status
                                    </span>
                                </div>

                                <div class="actions-box">
                                    <button class="btn-detail" onclick="location.href='/Agent/Detalji/@r.Id'">
                                        Detalji <i class="fa-solid fa-chevron-right" style="font-size: 11px;"></i>
                                    </button>
                                </div>

                            </div>
                        }
                    }
                </div>

            </div>
        </div>
    </div>

</body>
</html>