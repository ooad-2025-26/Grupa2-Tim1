@model InterTrips___Turistička_Agencija.Models.PlanPutovanjaTemplate
@{
    ViewData["Title"] = "Agent - Plan Putovanja";
    Layout = null;
    var agentId = ViewData["AgentId"] ?? 0;

    var stavkeListe = Model.Stavke?.OrderBy(s => s.Id).ToList();
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --sidebar-hover: #133a43;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.05);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --shadow-lg: 0 15px 35px rgba(10, 34, 40, 0.06);
                --warning-bg: #fffbeb;
                --warning-border: #fef3c7;
                --warning-text: #b45309;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-dark);
                color: var(--white);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 101;
                box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            }

            .logo-area {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logo-text {
                color: var(--white);
                font-size: 20px;
                font-weight: 700;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding: 24px 16px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #a3b8cc;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .nav-item:hover {
                    background-color: var(--sidebar-hover);
                    color: var(--white);
                }

                .nav-item.active {
                    background-color: var(--primary);
                    color: var(--white);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logout-btn {
                width: 100%;
                background: rgba(185, 28, 28, 0.1);
                color: #ef4444;
                border: 1px solid rgba(185, 28, 28, 0.2);
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.2s ease;
            }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 40px 32px;
                box-sizing: border-box;
            }

            .page-header {
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
            }

                .page-header h2 {
                    margin: 0 0 6px 0;
                    font-size: 24px;
                    font-weight: 700;
                    color: var(--sidebar-dark);
                    letter-spacing: -0.5px;
                }

            .header-meta {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 13px;
                color: var(--text-muted);
            }

            .btn-back {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 18px;
                background: var(--white);
                border: 1px solid var(--border-color);
                color: var(--text-muted);
                border-radius: 10px;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
                box-shadow: var(--shadow-sm);
            }

                .btn-back:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                    transform: translateX(-3px);
                }

            .plan-card {
                background: var(--white);
                padding: 40px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
            }

            .napomena-box {
                background: var(--warning-bg);
                border-left: 4px solid #f59e0b;
                border-top: 1px solid var(--warning-border);
                border-right: 1px solid var(--warning-border);
                border-bottom: 1px solid var(--warning-border);
                padding: 18px 24px;
                border-radius: 12px;
                margin-bottom: 35px;
                font-size: 14px;
                color: #78350f;
                display: flex;
                gap: 14px;
                align-items: flex-start;
            }

                .napomena-box i {
                    font-size: 18px;
                    color: #d97706;
                    margin-top: 2px;
                }

            .section-title {
                color: var(--sidebar-dark);
                font-size: 20px;
                font-weight: 700;
                margin-top: 0;
                margin-bottom: 30px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .timeline {
                position: relative;
                margin: 10px 0 20px 45px;
                padding: 10px 0;
            }

                .timeline::before {
                    content: '';
                    position: absolute;
                    left: -30px;
                    top: 0;
                    bottom: 0;
                    width: 2px;
                    background: linear-gradient(to bottom, var(--primary) 0%, var(--primary-light) 100%);
                    border-left: 2px dashed rgba(30, 127, 136, 0.3);
                    background-color: transparent;
                }

            .timeline-item {
                position: relative;
                margin-bottom: 35px;
            }

                .timeline-item:last-child {
                    margin-bottom: 0;
                }

            .timeline-marker {
                position: absolute;
                left: -65px;
                top: 12px;
                background: var(--white);
                color: var(--primary);
                border: 2px solid var(--primary);
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                box-shadow: var(--shadow-sm);
                white-space: nowrap;
                z-index: 2;
                transition: all 0.3s ease;
            }

            .timeline-item:hover .timeline-marker {
                background: var(--primary);
                color: var(--white);
                transform: scale(1.05);
            }

            .timeline-content {
                background: #fafbfa;
                padding: 24px 28px;
                border-radius: 14px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-sm);
                transition: all 0.25s ease;
            }

            .timeline-item:hover .timeline-content {
                background: var(--white);
                border-color: var(--primary-light);
                box-shadow: var(--shadow-lg);
                transform: translateY(-2px);
            }

            .timeline-title {
                font-size: 17px;
                font-weight: 600;
                color: var(--sidebar-dark);
                margin: 0 0 10px 0;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .timeline-title::before {
                    content: '\f041';
                    font-family: 'Font Awesome 6 Free';
                    font-weight: 900;
                    color: var(--primary-light);
                    font-size: 14px;
                }

            .timeline-desc {
                font-size: 14.5px;
                color: var(--text-muted);
                line-height: 1.6;
                margin: 0;
            }

            .empty-state {
                color: var(--text-muted);
                font-style: italic;
                text-align: center;
                padding: 40px;
                background: #fafbfa;
                border-radius: 12px;
                border: 1px dashed var(--border-color);
            }

            @@media (max-width: 992px) {
                .sidebar {
                    width: 70px;
                }

                    .sidebar .sidebar-logo-text, .sidebar .nav-item span, .sidebar .sidebar-logout-btn span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                }
            }

            @@media (max-width: 768px) {
                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }

                .btn-back {
                    width: 100%;
                    justify-content: center;
                }

                .timeline {
                    margin-left: 55px;
                }

                .timeline-marker {
                    left: -75px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Agent/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Agent/Rezervacije?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Agent/Paketi?agentId=@agentId" class="nav-item active">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Agent/Izvjestaj?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout" style="display:block; width:100%;">
                @Html.AntiForgeryToken()
                <button class="sidebar-logout-btn" type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content">
        <header class="page-header">
            <div>
                <h2>Plan putovanja: @Model.Paket?.Naziv</h2>
                <div class="header-meta">
                    <span><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> @(Model.Paket?.Destinacija?.Naziv ?? "Nespecificirano")</span>
                    <span>•</span>
                    <span><i class="fa-regular fa-moon" style="color: var(--primary);"></i> @Model.Paket?.TrajanjeNoci noći</span>
                </div>
            </div>
            <a href="/Agent/Paketi?agentId=@agentId" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> Nazad na pakete
            </a>
        </header>

        <div class="plan-card">
            @if (!string.IsNullOrEmpty(Model.Napomena))
            {
                <div class="napomena-box">
                    <i class="fa-solid fa-circle-info"></i>
                    <div>
                        <strong style="display: block; margin-bottom: 4px;">Napomena administratora:</strong>
                        <span>@Model.Napomena</span>
                    </div>
                </div>
            }

            <h3 class="section-title">
                <i class="fa-solid fa-route" style="color: var(--primary);"></i> Plan i aktivnosti po danima
            </h3>

           @if (stavkeListe != null && stavkeListe.Any())
{
    <div class="timeline">
        @{ int brojacDana = 1; }
        @foreach (var stavka in stavkeListe)
        {
            <div class="timeline-item">
                <div class="timeline-marker">Dan @brojacDana</div>
                <div class="timeline-content">
                    <h4 class="timeline-title">@stavka.Naziv</h4>
                    <p class="timeline-desc">@stavka.Opis</p>
                </div>
            </div>
            brojacDana++; 
        }
    </div>
}
else
{
    <p class="empty-state">
        <i class="fa-solid fa-folder-open" style="display:block; font-size:24px; margin-bottom:10px; color:var(--text-muted);"></i> 
        Za ovaj plan još uvijek nisu unesene stavke putovanja.
    </p>
}
        </div>
    </div>

</body>
</html>