@model InterTrips___Turistička_Agencija.Models.AgentPaketiVm
@using System.Collections.Generic
@{
    ViewData["Title"] = "Agent - Upravljanje Paketima";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <style>
            .page-wrap {
                padding: 30px;
                max-width: 1000px;
                margin: 0 auto;
            }

            .grid-list {
                display: grid;
                gap: 15px;
            }

            .item {
                background: white;
                padding: 15px;
                border-radius: 12px;
                border: 1px solid #eee;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .info h3 {
                margin: 0;
                font-size: 16px;
            }

            .info p {
                margin: 5px 0 0;
                font-size: 12px;
                color: #777;
            }

            .preuzeto {
                background: #f0f9fa;
                border-color: #6abfc6;
            }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2>Preuzimanje paketa</h2>
            <a href="/Agent" class="btn">Nazad</a>
        </div>

        <div class="grid-list">
            @foreach (var p in Model.SviPaketi)
            {
                bool isMine = Model.MojiPaketiIds.Contains(p.Id);
                <div class="item @(isMine ? "preuzeto" : "")">
                    <div class="info">
                        <h3>@p.Naziv</h3>
                        <p>@p.Destinacija?.Naziv | @p.TrajanjeNoci noći | @p.CijenaOd BAM</p>
                    </div>

                    <form action="/Agent/TogglePaket" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paketId" value="@p.Id" />
                        <input type="hidden" name="agentId" value="@Model.AgentId" />

                        @if (isMine)
                        {
                            <button type="submit" class="select-btn btn-muted">Pusti paket</button>
                        }
                        else
                        {
                            <button type="submit" class="select-btn">Preuzmi paket</button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</body>
</html>