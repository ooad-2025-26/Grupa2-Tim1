@model InterTrips___Turistička_Agencija.Models.ViewModels.AgentPaketiVm
@using System.Collections.Generic
@{
    ViewData["Title"] = "Agent - Upravljanje Paketima";
    Layout = null;

    var agentId = Model?.AgentId ?? 0;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --sidebar-hover: #133a43;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.05);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --danger: #b91c1c;
                --danger-bg: #fef2f2;
                --danger-border: #fecaca;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
                display: flex;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-dark);
                color: var(--white);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 101;
                box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            }

            .logo-area {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logo-text {
                color: var(--white);
                font-size: 20px;
                font-weight: 700;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding: 24px 16px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #a3b8cc;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .nav-item:hover {
                    background-color: var(--sidebar-hover);
                    color: var(--white);
                }

                .nav-item.active {
                    background-color: var(--primary);
                    color: var(--white);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logout-btn {
                width: 100%;
                background: rgba(185, 28, 28, 0.1);
                color: #ef4444;
                border: 1px solid rgba(185, 28, 28, 0.2);
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.2s ease;
            }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .page-wrap {
                padding: 40px 32px;
                max-width: 1200px;
                margin: 0 auto;
                width: 100%;
                box-sizing: border-box;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
            }

                .page-header h2 {
                    margin: 0;
                    font-size: 24px;
                    font-weight: 700;
                    color: var(--sidebar-dark);
                    letter-spacing: -0.5px;
                }

            .btn-back {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 18px;
                background: var(--white);
                border: 1px solid var(--border-color);
                color: var(--text-muted);
                border-radius: 10px;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
                box-shadow: var(--shadow-sm);
            }

                .btn-back:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                    transform: translateX(-3px);
                }

            .grid-list {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .item {
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: var(--shadow-md);
                transition: all 0.2s ease;
            }

                .item:hover {
                    transform: translateY(-2px);
                    border-color: var(--primary-light);
                    box-shadow: 0 12px 30px rgba(10, 34, 40, 0.06);
                }

                .item.preuzeto {
                    border-left: 5px solid var(--primary);
                    background: linear-gradient(90deg, rgba(42, 169, 176, 0.02) 0%, #ffffff 100%);
                }

            .info {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .info-header {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .info h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 600;
                color: var(--sidebar-dark);
                letter-spacing: -0.3px;
            }

            .badge-mine {
                background: rgba(30, 127, 136, 0.08);
                color: var(--primary);
                border: 1px solid rgba(30, 127, 136, 0.2);
                font-size: 11px;
                font-weight: 600;
                padding: 4px 12px;
                border-radius: 6px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }

            .meta-details {
                display: flex;
                align-items: center;
                gap: 16px;
                font-size: 13px;
                color: var(--text-muted);
                flex-wrap: wrap;
            }

                .meta-details span {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .meta-details i {
                    font-size: 14px;
                }

                .meta-details .price-tag {
                    font-weight: 600;
                    color: var(--sidebar-dark);
                }

            .action-btn {
                padding: 10px 22px;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid transparent;
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                white-space: nowrap;
            }

            .btn-take {
                background: var(--primary);
                color: var(--white);
            }

                .btn-take:hover {
                    background: var(--sidebar-dark);
                    box-shadow: 0 4px 12px rgba(10, 34, 40, 0.15);
                }

            .btn-release {
                background: var(--danger-bg);
                color: var(--danger);
                border-color: var(--danger-border);
            }

                .btn-release:hover {
                    background: var(--danger);
                    color: var(--white);
                    border-color: var(--danger);
                }

            .empty-state {
                color: var(--text-muted);
                font-style: italic;
                text-align: center;
                padding: 40px;
                background: var(--white);
                border-radius: 16px;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 992px) {
                .sidebar {
                    width: 70px;
                }

                    .sidebar .sidebar-logo-text, .sidebar .nav-item span, .sidebar .sidebar-logout-btn span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                }
            }

            @@media (max-width: 768px) {
                .item {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                    padding: 20px 24px;
                }

                    .item form {
                        width: 100%;
                    }

                .action-btn {
                    width: 100%;
                    justify-content: center;
                }

                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }
            }

            .alert-danger-custom {
                background-color: var(--danger-bg);
                border: 1px solid var(--danger-border);
                color: var(--danger);
                padding: 16px 24px;
                border-radius: 12px;
                margin-bottom: 24px;
                display: flex;
                align-items: center;
                gap: 16px;
                box-shadow: var(--shadow-sm);
                animation: fadeIn 0.3s ease-in-out;
            }

                .alert-danger-custom .alert-icon {
                    font-size: 20px;
                    display: flex;
                    align-items: center;
                }

                .alert-danger-custom .alert-text {
                    font-size: 14px;
                    font-weight: 500;
                    line-height: 1.5;
                }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .btn-view-plan {
                background: var(--white);
                color: var(--primary);
                border: 1px solid var(--primary);
                margin-right: 8px;
            }

                .btn-view-plan:hover {
                    background: var(--primary-accent);
                    color: var(--primary-light);
                    border-color: var(--primary-light);
                }

            .actions-wrapper {
                display: flex;
                align-items: center;
                gap: 8px;
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Agent/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Agent/Rezervacije?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Agent/Paketi?agentId=@agentId" class="nav-item active">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Agent/Izvjestaj?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout" style="display:block; width:100%;">
                @Html.AntiForgeryToken()
                <button class="sidebar-logout-btn" type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content">
        <div class="page-wrap">

            <header class="page-header">
                <h2>Upravljanje paketima agencije</h2>
                <a href="/Agent?agentId=@agentId" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i> Nazad na panel
                </a>
            </header>

            @if (TempData["ErrorPoruka"] != null)
            {
                <div class="alert-danger-custom">
                    <div class="alert-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="alert-text">
                        @TempData["ErrorPoruka"]
                    </div>
                </div>
            }

            <div class="grid-list">
                @if (Model?.SviPaketi != null && Model.SviPaketi.Any())
                {
                    foreach (var p in Model.SviPaketi)
                    {
                        if (p == null) continue;

                        bool isMine = Model.MojiPaketiIds != null && Model.MojiPaketiIds.Contains(p.Id);

                        <div class="item @(isMine ? "preuzeto" : "")">
                            <div class="info">
                                <div class="info-header">
                                    <h3>@p.Naziv</h3>
                                    @if (isMine)
                                    {
                                        <span class="badge-mine">
                                            <i class="fa-solid fa-check" style="font-size: 10px;"></i> Moj paket
                                        </span>
                                    }
                                </div>

                                <div class="meta-details">
                                    <span>
                                        <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                                        @(p.Destinacija?.Naziv ?? "Nespecificirano")
                                    </span>
                                    <span>•</span>
                                    <span>
                                        <i class="fa-regular fa-moon" style="color: var(--primary);"></i>
                                        @p.TrajanjeNoci noći
                                    </span>
                                    <span>•</span>
                                    <span class="price-tag">
                                        <i class="fa-solid fa-tags" style="color: var(--text-muted);"></i>
                                        @p.CijenaOd.ToString("N2") BAM
                                    </span>
                                </div>
                            </div>

                            <div class="actions-wrapper">
                                @if (isMine)
                                {
                                    <a href="/Agent/PogledajPlan?paketId=@p.Id&agentId=@agentId" class="action-btn btn-view-plan">
                                        <i class="fa-solid fa-route"></i> Plan putovanja
                                    </a>
                                }

                                <form action="/Agent/TogglePaket" method="post" style="display: inline-block;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="paketId" value="@p.Id" />
                                    <input type="hidden" name="agentId" value="@agentId" />

                                    @if (isMine)
                                    {
                                        <button type="submit" class="action-btn btn-release">
                                            <i class="fa-solid fa-minus"></i> Pusti paket
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="action-btn btn-take">
                                            <i class="fa-solid fa-plus"></i> Preuzmi paket
                                        </button>
                                    }
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-state">Trenutno nema dostupnih paketa u bazi podataka.</p>
                }
            </div>

        </div>
    </div>

</body>
</html>