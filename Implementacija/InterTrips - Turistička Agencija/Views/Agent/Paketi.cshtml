@model List<InterTrips___Turistička_Agencija.Models.Paket>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Agent - Paketi";
    Layout = null;

    int agentId = (int)ViewBag.AgentId;
    var mojiIds = (HashSet<int>)ViewBag.MojiPaketiIds;
}

<!DOCTYPE html>
<html lang="bs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    .wrap{ max-width:1150px; margin:28px auto; padding:0 18px; }
    .top{ display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
    .card{ background:rgba(255,255,255,0.84); border:1px solid rgba(95,181,187,0.16); border-radius:16px; box-shadow:var(--shadow); padding:16px; }
    .row{ display:grid; grid-template-columns: 1.4fr 1.4fr auto; gap:12px; align-items:center; padding:12px; border-radius:12px; border:1px solid rgba(95,181,187,0.14); background:rgba(255,255,255,0.72); margin-bottom:10px; }
    .muted{ color:var(--muted); font-size:12px; }
    .btn{ height:40px; padding:0 14px; border-radius:999px; cursor:pointer; font-weight:800; border:1px solid rgba(95,181,187,0.18); background:#fff; }
    .btn-primary{ border:none; color:#fff; background: linear-gradient(135deg, #6abfc6, #86bfe0); }
    .btn-muted{ background:rgba(255,255,255,0.72); color:var(--primary-dark); }
    a.btn{ display:inline-flex; align-items:center; text-decoration:none; }
  </style>
</head>
<body class="auth-page">
  <div class="wrap">
    <div class="top">
      <div>
        <h2 style="margin:0;">Paketi koje vodiš</h2>
        <div class="muted">Klikni “Preuzmi” da paket bude tvoj.</div>
      </div>

      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn" href="/Agent?agentId=@agentId">Dashboard</a>
        <a class="btn" href="/Agent/Rezervacije?agentId=@agentId">Rezervacije</a>
        <a class="btn" href="/Destinacije" target="_blank">Pregled na sajtu</a>
      </div>
    </div>

    <div class="card">
      @if (!Model.Any())
      {
        <div class="muted" style="font-weight:800;">Nema paketa u sistemu.</div>
      }
      else
      {
        foreach (var p in Model)
        {
          var mine = mojiIds.Contains(p.Id);
          <div class="row">
            <div>
              <div style="font-weight:900;">@p.Naziv</div>
              <div class="muted">
                @(p.Destinacija != null ? $"{p.Destinacija.Naziv} • {p.Destinacija.Drzava}" : "—")
              </div>
            </div>

            <div class="muted" style="font-weight:700;">
              @p.TrajanjeNoci noći • @p.CijenaOd.ToString("0.##") BAM • @p.Status
            </div>

            <div style="display:flex; justify-content:flex-end;">
              <form method="post" action="/Agent/TogglePaket">
                @Html.AntiForgeryToken()
                <input type="hidden" name="agentId" value="@agentId" />
                <input type="hidden" name="paketId" value="@p.Id" />

                @if (mine)
                {
                  <button class="btn btn-muted" type="submit">Pusti</button>
                }
                else
                {
                  <button class="btn btn-primary" type="submit">Preuzmi</button>
                }
              </form>
            </div>
          </div>
        }
      }
    </div>
  </div>

  <script>
    window.addEventListener('DOMContentLoaded', function() {
      const role = localStorage.getItem('userRole');
      if (role !== 'agent') window.location.href = '/korisnik/login';
    });
  </script>
</body>
</html>