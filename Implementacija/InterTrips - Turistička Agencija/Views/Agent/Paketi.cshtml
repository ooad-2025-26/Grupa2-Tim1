@model InterTrips___Turistička_Agencija.Models.AgentPaketiVm
@using System.Collections.Generic
@{
    ViewData["Title"] = "Agent - Upravljanje Paketima";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.04);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --danger: #b91c1c;
                --danger-bg: #fef2f2;
                --danger-border: #fecaca;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
            }

            .page-wrap {
                padding: 40px 24px;
                max-width: 1000px;
                margin: 0 auto;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
            }

                .page-header h2 {
                    margin: 0;
                    font-size: 24px;
                    font-weight: 700;
                    color: var(--sidebar-dark);
                    letter-spacing: -0.5px;
                }

            .btn-back {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 18px;
                background: var(--white);
                border: 1px solid var(--border-color);
                color: var(--text-muted);
                border-radius: 10px;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
                box-shadow: var(--shadow-sm);
            }

                .btn-back:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                    transform: translateX(-3px);
                }

            .grid-list {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .item {
                background: var(--white);
                padding: 24px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: var(--shadow-md);
                transition: all 0.2s ease;
            }

                .item:hover {
                    transform: translateY(-2px);
                    border-color: var(--primary-light);
                    box-shadow: 0 12px 30px rgba(10, 34, 40, 0.06);
                }

                .item.preuzeto {
                    border-left: 5px solid var(--primary);
                    background: linear-gradient(90deg, rgba(42, 169, 176, 0.02) 0%, #ffffff 100%);
                }

            .info {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .info-header {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .info h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 600;
                color: var(--sidebar-dark);
                letter-spacing: -0.3px;
            }

            .badge-mine {
                background: var(--primary-accent);
                color: var(--primary);
                border: 1px solid rgba(30, 127, 136, 0.2);
                font-size: 11px;
                font-weight: 600;
                padding: 4px 12px;
                border-radius: 6px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .meta-details {
                display: flex;
                align-items: center;
                gap: 16px;
                font-size: 13px;
                color: var(--text-muted);
                flex-wrap: wrap;
            }

                .meta-details span {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

                .meta-details i {
                    color: var(--text-muted);
                    font-size: 14px;
                }

                .meta-details .price-tag {
                    font-weight: 600;
                    color: var(--sidebar-dark);
                }

            .action-btn {
                padding: 10px 22px;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid transparent;
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .btn-take {
                background: var(--primary);
                color: var(--white);
            }

                .btn-take:hover {
                    background: var(--sidebar-dark);
                    box-shadow: 0 4px 12px rgba(10, 34, 40, 0.15);
                }

            .btn-release {
                background: var(--danger-bg);
                color: var(--danger);
                border-color: var(--danger-border);
            }

                .btn-release:hover {
                    background: var(--danger);
                    color: var(--white);
                    border-color: var(--danger);
                }

            @@media (max-width: 768px) {
                .item {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                    padding: 20px 24px;
                }

                .action-btn {
                    width: 100%;
                    justify-content: center;
                }

                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }
            }
    </style>
</head>
<body>

    <div class="page-wrap">

        <header class="page-header">
            <h2>Upravljanje paketima agencije</h2>
            <a href="/Agent?agentId=@Model.AgentId" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> Nazad na panel
            </a>
        </header>

        <div class="grid-list">
            @if (Model.SviPaketi != null)
            {
                foreach (var p in Model.SviPaketi)
                {
                    bool isMine = Model.MojiPaketiIds != null && Model.MojiPaketiIds.Contains(p.Id);

                    <div class="item @(isMine ? "preuzeto" : "")">
                        <div class="info">
                            <div class="info-header">
                                <h3>@p.Naziv</h3>
                                @if (isMine)
                                {
                                    <span class="badge-mine">
                                        <i class="fa-solid fa-check" style="font-size: 10px; margin-right: 2px;"></i> Moj paket
                                    </span>
                                }
                            </div>

                            <div class="meta-details">
                                <span>
                                    <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                                    @(p.Destinacija?.Naziv ?? "Nespecificirano")
                                </span>
                                <span>•</span>
                                <span>
                                    <i class="fa-regular fa-moon"></i>
                                    @p.TrajanjeNoci noći
                                </span>
                                <span>•</span>
                                <span class="price-tag">
                                    <i class="fa-solid fa-tags"></i>
                                    @p.CijenaOd BAM
                                </span>
                            </div>
                        </div>

                        <form action="/Agent/TogglePaket" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="paketId" value="@p.Id" />
                            <input type="hidden" name="agentId" value="@Model.AgentId" />

                            @if (isMine)
                            {
                                <button type="submit" class="action-btn btn-release">
                                    <i class="fa-solid fa-minus"></i> Pusti paket
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="action-btn btn-take">
                                    <i class="fa-solid fa-plus"></i> Preuzmi paket
                                </button>
                            }
                        </form>
                    </div>
                }
            }
        </div>

    </div>

</body>
</html>