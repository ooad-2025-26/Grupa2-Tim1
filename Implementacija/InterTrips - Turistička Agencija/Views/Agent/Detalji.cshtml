@model InterTrips___Turistička_Agencija.Models.Rezervacija
@{
    ViewData["Title"] = "Agent - Detalji Rezervacije";
    Layout = null;

    string statusKlasa = Model.Status.ToString().ToLower();
    string imeKlijenta = Model.Korisnik?.Ime ?? "Nepoznato ime";
    string emailKlijenta = Model.Korisnik?.Email ?? "Nije uneseno";

    string agentId = Context.Request.Query["agentr"].ToString();
    if (string.IsNullOrEmpty(agentId))
    {
        agentId = "2";
    }
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --bg-main: #f4f7f6;
                --sidebar-dark: #0a2228;
                --sidebar-hover: #133a43;
                --primary: #1e7f88;
                --primary-light: #2aa9b0;
                --primary-accent: rgba(42, 169, 176, 0.05);
                --text-main: #1f2e3d;
                --text-muted: #6b7a87;
                --white: #ffffff;
                --border-color: #e2e8f0;
                --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
                --shadow-md: 0 10px 25px rgba(10, 34, 40, 0.04);
                --status-kreirana-bg: #eff6ff;
                --status-kreirana-txt: #1d4ed8;
                --status-potvrdjena-bg: #ecfdf5;
                --status-potvrdjena-txt: #047857;
                --status-otkazana-bg: #fef2f2;
                --status-otkazana-txt: #b91c1c;
            }

            body {
                background-color: var(--bg-main);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                margin: 0;
                padding: 0;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
                display: flex;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-dark);
                color: var(--white);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 101;
                box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            }

            .logo-area {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logo-text {
                color: var(--white);
                font-size: 20px;
                font-weight: 700;
                text-decoration: none;
                letter-spacing: -0.5px;
            }

            .nav-menu {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding: 24px 16px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #a3b8cc;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    font-size: 16px;
                    width: 20px;
                    text-align: center;
                }

                .nav-item:hover {
                    background-color: var(--sidebar-hover);
                    color: var(--white);
                }

                .nav-item.active {
                    background-color: var(--primary);
                    color: var(--white);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .sidebar-logout-btn {
                width: 100%;
                background: rgba(185, 28, 28, 0.1);
                color: #ef4444;
                border: 1px solid rgba(185, 28, 28, 0.2);
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.2s ease;
            }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .dashboard-container {
                max-width: 1200px;
                margin: 0 auto;
                width: 100%;
                padding: 40px 32px;
                box-sizing: border-box;
            }

            .top-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
            }

            .btn-back {
                text-decoration: none;
                color: var(--text-muted);
                font-size: 14px;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
                background: var(--white);
                padding: 10px 16px;
                border-radius: 10px;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--border-color);
            }

                .btn-back:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                    transform: translateX(-3px);
                }

            .dashboard-header {
                background: var(--white);
                border-radius: 16px;
                padding: 24px 32px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
            }

            .header-title-area h1 {
                font-size: 24px;
                font-weight: 700;
                color: var(--sidebar-dark);
                margin: 0 0 4px 0;
                letter-spacing: -0.5px;
            }

            .header-title-area p {
                margin: 0;
                font-size: 13px;
                color: var(--text-muted);
            }

            .status-badge {
                padding: 8px 18px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .status-kreirana {
                background: var(--status-kreirana-bg);
                color: var(--status-kreirana-txt);
            }

            .status-potvrdjena {
                background: var(--status-potvrdjena-bg);
                color: var(--status-potvrdjena-txt);
            }

            .status-otkazana {
                background: var(--status-otkazana-bg);
                color: var(--status-otkazana-txt);
            }

            .dashboard-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 24px;
                margin-bottom: 24px;
            }

            .dashboard-card {
                background: var(--white);
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
                padding: 28px;
            }

                .dashboard-card.full-width {
                    grid-column: span 2;
                }

            .card-title {
                font-size: 14px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.8px;
                color: var(--primary);
                margin: 0 0 20px 0;
                display: flex;
                align-items: center;
                gap: 10px;
                border-bottom: 1px solid var(--border-color);
                padding-bottom: 12px;
            }

                .card-title i {
                    font-size: 16px;
                }

            .info-list {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .info-item {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

                .info-item label {
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    color: var(--text-muted);
                    font-weight: 600;
                }

                .info-item span {
                    font-size: 15px;
                    font-weight: 500;
                    color: var(--sidebar-dark);
                }

            .table-wrapper {
                overflow-x: auto;
                border-radius: 12px;
                border: 1px solid var(--border-color);
            }

            .passengers-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                background: var(--white);
            }

                .passengers-table th {
                    background: #fafbfc;
                    color: var(--sidebar-dark);
                    font-size: 12px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding: 14px 18px;
                    border-bottom: 1px solid var(--border-color);
                }

                .passengers-table td {
                    padding: 16px 18px;
                    font-size: 14px;
                    color: var(--text-main);
                    border-bottom: 1px solid var(--border-color);
                }

                .passengers-table tr:last-child td {
                    border-bottom: none;
                }

                .passengers-table tr:hover td {
                    background-color: var(--primary-accent);
                }

            .passenger-name {
                font-weight: 600;
                color: var(--sidebar-dark);
            }

            .empty-state {
                color: var(--text-muted);
                font-style: italic;
                margin: 0;
                padding: 20px;
                text-align: center;
            }

            .action-footer {
                display: flex;
                justify-content: flex-end;
                gap: 12px;
                background: var(--white);
                padding: 20px 32px;
                border-radius: 16px;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-md);
                margin-top: 12px;
            }

            .btn-action {
                padding: 12px 24px;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
                text-decoration: none;
            }

            .btn-confirm {
                background-color: #059669;
                color: white;
            }

                .btn-confirm:hover {
                    background-color: #047857;
                }

            .btn-cancel {
                background-color: #dc2626;
                color: white;
            }

                .btn-cancel:hover {
                    background-color: #b91c1c;
                }

            .btn-print {
                background-color: #475569;
                color: white;
            }

                .btn-print:hover {
                    background-color: #334155;
                }

            @@media (max-width: 992px) {
                .sidebar {
                    width: 70px;
                }

                    .sidebar .sidebar-logo-text, .sidebar .nav-item span, .sidebar .sidebar-logout-btn span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                }
            }

            @@media (max-width: 900px) {
                .dashboard-grid {
                    grid-template-columns: 1fr;
                }

                .dashboard-card.full-width {
                    grid-column: span 1;
                }
            }

            @@media (max-width: 600px) {
                .dashboard-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 16px;
                    padding: 20px;
                }

                .info-list {
                    grid-template-columns: 1fr;
                }

                .action-footer {
                    flex-direction: column;
                    width: 100%;
                }

                .btn-action {
                    justify-content: center;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>
        <nav class="nav-menu">
            <a href="/Agent/Index?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Agent/Rezervacije?agentId=@agentId" class="nav-item active">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Agent/Paketi?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Agent/Izvjestaj?agentId=@agentId" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout" style="display:block; width:100%;">
                @Html.AntiForgeryToken()
                <button class="sidebar-logout-btn" type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content">
        <div class="dashboard-container">

            <div class="top-meta">
                <a href="/Agent/Rezervacije?agentId=@agentId" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i> Nazad na listu rezervacija
                </a>
            </div>

            @if (Model != null)
            {
                <header class="dashboard-header">
                    <div class="header-title-area">
                        <h1>Rezervacija #@Model.Id</h1>
                        <p>Pregled detaljnih informacija i rute klijenta</p>
                    </div>
                    <div>
                        <span class="status-badge status-@statusKlasa">
                            <i class="fa-solid fa-circle" style="font-size: 8px; margin-right: 4px;"></i> @Model.Status
                        </span>
                    </div>
                </header>

                <main>
                    <div class="dashboard-grid">

                        <div class="dashboard-card">
                            <h2 class="card-title">
                                <i class="fa-solid fa-compass"></i> Podaci o Aranžmanu
                            </h2>
                            <div class="info-list">
                                <div class="info-item">
                                    <label>Naziv paketa</label>
                                    <span>@(Model.Paket?.Naziv ?? "Nezaveden aranžman")</span>
                                </div>
                                <div class="info-item">
                                    <label>Destinacija</label>
                                    <span>@(Model.Paket?.Destinacija?.Naziv ?? "—")</span>
                                </div>
                                <div class="info-item">
                                    <label>Datum polaska</label>
                                    <span><i class="fa-regular fa-calendar-days" style="font-size:13px; margin-right:4px; color:var(--text-muted)"></i> @Model.DatumPolaska.ToString("dd. MM. yyyy.")</span>
                                </div>
                                <div class="info-item">
                                    <label>Trajanje aranžmana</label>
                                    <span>@(Model.Paket?.TrajanjeNoci ?? 0) noćenja</span>
                                </div>
                            </div>
                        </div>

                        <div class="dashboard-card">
                            <h2 class="card-title">
                                <i class="fa-solid fa-user-tie"></i> Nosilac rezervacije
                            </h2>
                            <div class="info-list">
                                <div class="info-item">
                                    <label>Ime klijenta</label>
                                    <span style="font-weight: 600;">
                                        @(string.IsNullOrEmpty(imeKlijenta) ? "—" : imeKlijenta.Split(' ')[0])
                                    </span>
                                </div>
                                <div class="info-item">
                                    <label>Email adresa</label>
                                    <span>@emailKlijenta</span>
                                </div>
                                <div class="info-item">
                                    <label>Ukupno prijavljenih</label>
                                    <span><i class="fa-solid fa-users" style="font-size:13px; margin-right:4px; color:var(--text-muted)"></i> @(Model.Putnici?.Count ?? 0) osoba</span>
                                </div>
                                <div class="info-item">
                                    <label>Kreirano preko agenta</label>
                                    <span>ID: @agentId</span>
                                </div>
                            </div>
                        </div>

                        <div class="dashboard-card">
                            <h2 class="card-title">
                                <i class="fa-solid fa-hotel"></i> Podaci o smještaju (Hotel)
                            </h2>
                            <div class="info-list">
                                @if (Model.Paket != null && Model.Paket.Hotel != null)
                                {
                                    <div class="info-item">
                                        <label>Naziv hotela</label>
                                        <span style="font-weight:600;">@Model.Paket.Hotel.Naziv</span>
                                    </div>
                                    <div class="info-item">
                                        <label>Kategorizacija</label>
                                        <span>
                                            @if (Model.Paket.Hotel.BrojZvjezdica > 0)
                                            {
                                                @for (int i = 0; i < Model.Paket.Hotel.BrojZvjezdica; i++)
                                                {
                                                    <i class="fa-solid fa-star" style="color: #eab308; font-size: 12px;"></i>
                                                }
                                            }
                                            else
                                            {
                                                <text>—</text>
                                            }
                                        </span>
                                    </div>
                                    <div class="info-item" style="grid-column: span 2;">
                                        <label>Adresa i lokacija</label>
                                        <span>
                                            <i class="fa-solid fa-location-dot" style="color:var(--text-muted); margin-right:4px;"></i>
                                            @(string.IsNullOrWhiteSpace(Model.Paket.Hotel.Lokacija) ? "Nije unesena lokacija" : Model.Paket.Hotel.Lokacija)
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="info-item" style="grid-column: span 2;">
                                        <p class="empty-state" style="padding: 10px 0;">Nema definisanog smještaja za ovaj aranžman.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dashboard-card">
                            <h2 class="card-title">
                                <i class="fa-solid fa-plane-departure"></i> Podaci o letu
                            </h2>
                            <div class="info-list">
                                @if (Model.Paket?.Let != null)
                                {
                                    <div class="info-item">
                                        <label>Avio kompanija</label>
                                        <span style="font-weight:600;">@(string.IsNullOrWhiteSpace(Model.Paket.Let.Aviokompanija) ? "—" : Model.Paket.Let.Aviokompanija)</span>
                                    </div>
                                    <div class="info-item">
                                        <label>Relacija</label>
                                        <span>
                                            @(string.IsNullOrWhiteSpace(Model.Paket.Let.Polazak) ? "Polazak" : Model.Paket.Let.Polazak)
                                            <i class="fa-solid fa-arrow-right" style="font-size:11px; margin: 0 4px; color: var(--primary);"></i>
                                            @(string.IsNullOrWhiteSpace(Model.Paket.Let.Odrediste) ? "Odredište" : Model.Paket.Let.Odrediste)
                                        </span>
                                    </div>
                                    <div class="info-item">
                                        <label>Vrijeme polaska</label>
                                        <span>
                                            <i class="fa-regular fa-clock" style="color:var(--text-muted); margin-right:4px;"></i>
                                            @Model.Paket.Let.VrijemePolaska.ToString("HH:mm") h
                                        </span>
                                    </div>
                                    <div class="info-item">
                                        <label>Klasa leta</label>
                                        <span>Ekonomska / Standardna</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="info-item" style="grid-column: span 2;">
                                        <p class="empty-state" style="padding: 10px 0;">Nema povezanih informacija o letu (npr. autobuski prevoz ili sopstveni).</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dashboard-card full-width">
                            <h2 class="card-title">
                                <i class="fa-solid fa-money-check-dollar"></i> Finansijski pregled i Plaćanje
                            </h2>
                            <div class="info-list" style="grid-template-columns: repeat(4, 1fr);">
                                <div class="info-item">
                                    <label>Cijena po osobi</label>
                                    <span style="font-weight: 600; color: var(--primary);">@(Model.Paket?.CijenaOd.ToString("0.00") ?? "0.00") KM</span>
                                </div>
                                <div class="info-item">
                                    <label>Broj putnika</label>
                                    <span>@(Model.Putnici?.Count ?? 1)x</span>
                                </div>
                                <div class="info-item">
                                    <label>Ukupna vrijednost</label>
                                    <span style="font-weight: 700; font-size: 17px; color: var(--sidebar-dark);">
                                        @(((Model.Paket?.CijenaOd ?? 0) * (Model.Putnici?.Count ?? 1)).ToString("0.00")) KM
                                    </span>
                                </div>
                                <div class="info-item">
                                    <label>Status uplate</label>
                                    <span style="font-weight:600; color: #059669;"><i class="fa-solid fa-circle-check"></i> Plaćeno u cijelosti</span>
                                </div>
                            </div>
                        </div>

                        <div class="dashboard-card full-width">
                            <h2 class="card-title">
                                <i class="fa-solid fa-passport"></i> Detaljni podaci o saputnicima / putnicima
                            </h2>
                            <div class="table-wrapper">
                                @if (Model.Putnici == null || !Model.Putnici.Any())
                                {
                                    <p class="empty-state">Nema registrovanih saputnika za ovu rezervaciju.</p>
                                }
                                else
                                {
                                    <table class="passengers-table">
                                        <thead>
                                            <tr>
                                                <th>Oznaka</th>
                                                <th>Ime i prezime</th>
                                                <th>Državljanstvo</th>
                                                <th>Datum rođenja</th>
                                                <th>Broj pasoša</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int brojac = 1;
                                            }
                                            @foreach (var putnik in Model.Putnici)
                                            {
                                                <tr>
                                                    <td>#@brojac.ToString("D2")</td>
                                                    <td class="passenger-name">@putnik.Ime @putnik.Prezime</td>
                                                    <td>@(string.IsNullOrEmpty(putnik.Drzavljanstvo) ? "—" : putnik.Drzavljanstvo)</td>
                                                    <td>@putnik.DatumRodjenja.ToString("dd.MM.yyyy.")</td>
                                                    <td>
                                                        <code style="font-family:monospace; font-size:13px; background:#f1f5f9; padding:3px 6px; border-radius:4px; color:var(--sidebar-dark)">
                                                            @(string.IsNullOrEmpty(putnik.BrojPasosa) ? "—" : putnik.BrojPasosa)
                                                        </code>
                                                    </td>
                                                </tr>
                                                brojac++;
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>

                    </div>
                </main>
            }
            else
            {
                <div class="alert alert-danger" style="margin-top: 20px;">Podaci o rezervaciji nisu uspješno učitani.</div>
            }

        </div>
    </div>

</body>
</html>