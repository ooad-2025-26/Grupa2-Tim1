@{
    Layout = "_LayoutRaw";
    ViewData["Title"] = "Plaćanje nije uspješno - InterTrips";
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f4f8f9;
                margin: 0;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
            }

            .page {
                padding: 24px;
                width: 100%;
                max-width: 500px;
                box-sizing: border-box;
            }

            .center-shell {
                background: #ffffff;
                border: 1px solid rgba(204, 92, 92, 0.15);
                border-radius: 24px;
                box-shadow: 0 15px 35px rgba(26, 63, 66, 0.05);
                padding: 40px 30px;
                text-align: center;
                animation: fadeIn 0.4s ease-out;
            }

            .error-icon-wrap {
                width: 80px;
                height: 80px;
                background-color: rgba(204, 92, 92, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
            }

            .error-icon {
                font-size: 40px;
                line-height: 1;
                color: #cc5c5c;
                animation: shake 0.5s ease-in-out;
            }

            h2 {
                color: #1a3f42;
                font-size: 24px;
                font-weight: 800;
                margin: 0 0 12px;
                letter-spacing: -0.5px;
            }

            .reason-box {
                background-color: #fdfdfd;
                border: 1px solid rgba(204, 92, 92, 0.12);
                border-radius: 14px;
                padding: 16px;
                margin: 20px 0 28px;
            }

            .reason-label {
                display: block;
                font-size: 11px;
                font-weight: 800;
                color: #cc5c5c;
                margin-bottom: 6px;
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .reason-text {
                color: #4d7073;
                font-size: 14px;
                font-weight: 500;
                line-height: 1.5;
                margin: 0;
            }

            .secondary-btn {
                width: 100%;
                height: 48px;
                padding: 0 24px;
                border-radius: 14px;
                background: #fff;
                border: 1px solid rgba(95, 181, 187, 0.4);
                color: #1a3f42;
                font-weight: 700;
                font-size: 14px;
                font-family: inherit;
                cursor: pointer;
                transition: all 0.2s ease;
                box-shadow: 0 4px 10px rgba(95, 181, 187, 0.05);
            }

                .secondary-btn:hover {
                    background: #f7fbfb;
                    border-color: #6abfc6;
                    transform: translateY(-1px);
                }

                .secondary-btn:active {
                    transform: translateY(0);
                }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(12px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes shake {
                0%, 100% {
                    transform: translateX(0);
                }

                20%, 60% {
                    transform: translateX(-6px);
                }

                40%, 80% {
                    transform: translateX(6px);
                }
            }
    </style>
</head>
<body>

    <div class="page">
        <div class="center-shell">
            <div class="error-icon-wrap">
                <div class="error-icon">✕</div>
            </div>

            <h2>Plaćanje nije uspjelo</h2>

            <div class="reason-box">
                <span class="reason-label">Razlog odbijanja</span>
                <p class="reason-text">
                    @if (ViewBag.Razlog != null && !string.IsNullOrEmpty(ViewBag.Razlog.ToString()))
                    {
                        @ViewBag.Razlog
                    }
                    else
                    {
                        <text>Došlo je do nepredviđene greške prilikom obrade transakcije. Molimo provjerite podatke i pokušajte ponovo.</text>
                    }
                </p>
            </div>

            <button class="secondary-btn" onclick="history.back()">← Pokušaj ponovo</button>
        </div>
    </div>

</body>
</html>