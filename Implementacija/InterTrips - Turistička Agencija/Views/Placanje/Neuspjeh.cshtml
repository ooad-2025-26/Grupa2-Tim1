@{
    Layout = "_LayoutRaw";
    ViewData["Title"] = "Plaćanje nije uspješno - InterTrips";
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary: #2b7a80;
                --primary-hover: #1f5c61;
                --dark: #122b2e;
                --text-main: #2d3748;
                --text-muted: #718096;
                --bg-page: #f8fafc;
                --border-color: #e2e8f0;
                --error-color: #dc2626;
                --error-light: #fff5f5;
                --error-border: #fee2e2;
                --radius-lg: 24px;
                --radius-md: 14px;
                --shadow-md: 0 20px 40px rgba(18, 43, 46, 0.06), 0 1px 3px rgba(0, 0, 0, 0.02);
                --transition: cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--bg-page);
                background-image: radial-gradient(at 0% 0%, rgba(220, 38, 38, 0.03) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(43, 122, 128, 0.03) 0px, transparent 50%);
                color: var(--text-main);
                margin: 0;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }

            .page {
                padding: 20px;
                width: 100%;
                max-width: 500px;
                box-sizing: border-box;
            }

            .center-shell {
                background: #ffffff;
                border: 1px solid rgba(226, 232, 240, 0.8);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md);
                padding: 40px 35px;
                text-align: center;
                animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .error-icon-container {
                position: relative;
                width: 80px;
                height: 80px;
                margin: 0 auto 24px;
            }

            .error-icon-bg {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: var(--error-light);
                border-radius: 50%;
                animation: pulse 2s infinite;
            }

            .error-icon-wrap {
                position: relative;
                width: 80px;
                height: 80px;
                background-color: #fef2f2;
                border: 2px solid var(--error-border);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                animation: shake 0.6s ease-in-out;
                box-sizing: border-box;
            }

                .error-icon-wrap svg {
                    width: 32px;
                    height: 32px;
                    color: var(--error-color);
                }

            h2 {
                color: var(--dark);
                font-size: 26px;
                font-weight: 700;
                margin: 0 0 10px;
                letter-spacing: -0.5px;
            }

            .subtitle {
                font-size: 14px;
                color: var(--text-muted);
                margin: 0 0 30px;
                line-height: 1.6;
                padding: 0 10px;
            }

            .reason-box {
                background-color: var(--error-light);
                border: 1px solid var(--error-border);
                border-left: 4px solid var(--error-color);
                border-radius: var(--radius-md);
                padding: 18px 20px;
                margin-bottom: 32px;
                text-align: left;
                box-shadow: 0 2px 4px rgba(220, 38, 38, 0.01);
            }

            .reason-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 8px;
            }

                .reason-header svg {
                    width: 16px;
                    height: 16px;
                    color: var(--error-color);
                }

            .reason-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--error-color);
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .reason-text {
                color: #451a03;
                font-size: 13.5px;
                font-weight: 500;
                line-height: 1.6;
                margin: 0;
            }

            .button-group {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .primary-btn {
                width: 100%;
                height: 52px;
                padding: 0 24px;
                border-radius: var(--radius-md);
                background: var(--primary);
                border: none;
                color: #ffffff;
                font-weight: 600;
                font-size: 15px;
                font-family: inherit;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                box-shadow: 0 4px 12px rgba(43, 122, 128, 0.2);
            }

                .primary-btn:hover {
                    background: var(--primary-hover);
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(43, 122, 128, 0.3);
                }

                .primary-btn:active {
                    transform: translateY(0);
                }

            /* Sekundarno dugme za povratak nazad / početnu */
            .secondary-btn {
                width: 100%;
                height: 52px;
                padding: 0 24px;
                border-radius: var(--radius-md);
                background: #ffffff;
                border: 1px solid var(--border-color);
                color: var(--text-main);
                font-weight: 500;
                font-size: 14.5px;
                font-family: inherit;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

                .secondary-btn:hover {
                    background: #f8fafc;
                    color: var(--dark);
                    border-color: #cbd5e1;
                }

            .info-footer {
                margin-top: 28px;
                font-size: 12px;
                color: var(--text-muted);
                line-height: 1.5;
            }

                .info-footer a {
                    color: var(--primary);
                    text-decoration: none;
                    font-weight: 500;
                }

                    .info-footer a:hover {
                        text-decoration: underline;
                    }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(24px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes pulse {
                0% {
                    transform: scale(0.95);
                    opacity: 1;
                }

                70% {
                    transform: scale(1.15);
                    opacity: 0;
                }

                100% {
                    transform: scale(0.95);
                    opacity: 0;
                }
            }

            @@keyframes shake {
                0%, 100% {
                    transform: translateX(0);
                }

                15%, 45%, 75% {
                    transform: translateX(-4px);
                }

                30%, 60%, 90% {
                    transform: translateX(4px);
                }
            }
    </style>
</head>
<body>

    <div class="page">
        <div class="center-shell">

            <div class="error-icon-container">
                <div class="error-icon-bg"></div>
                <div class="error-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
            </div>

            <h2>Plaćanje nije uspjelo</h2>
            <p class="subtitle">Nažalost, Vaša banka ili naš procesor kartica su odbili transakciju. Bez brige, Vaš novac je siguran i sredstva nisu skinuta.</p>

            <div class="reason-box">
                <div class="reason-header">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                    <span class="reason-label">Izvještaj o grešci</span>
                </div>
                <p class="reason-text">
                    @if (ViewBag.Razlog != null && !string.IsNullOrEmpty(ViewBag.Razlog.ToString()))
                    {
                        @ViewBag.Razlog
                    }
                    else
                    {
                        <text>Odbijeno od strane banke. Molimo provjerite ispravnost broja kartice, rok trajanja, CVC kod ili stanje sredstava na računu i pokušajte ponovo.</text>
                    }
                </p>
            </div>

            <div class="button-group">
                <button class="primary-btn" onclick="history.back()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Pokušaj ponovo sa plaćanjem
                </button>

                <a href="/" style="text-decoration: none;">
                    <button class="secondary-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        Vrati se na početnu
                    </button>
                </a>
            </div>

            <div class="info-footer">
                Trebate pomoć? Naša podrška je tu za Vas. <br />
                <a href="/Kontakt">Kontaktirajte tim agencije InterTrips</a>
            </div>
        </div>
    </div>

</body>
</html>