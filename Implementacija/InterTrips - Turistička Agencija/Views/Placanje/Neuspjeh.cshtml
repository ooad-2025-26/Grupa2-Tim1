@{
    Layout = "_LayoutRaw";
    ViewData["Title"] = "Plaćanje nije uspješno - InterTrips";
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary: #2b7a80;
                --dark: #122b2e;
                --text-main: #2d3748;
                --text-muted: #718096;
                --bg-page: #f8fafc;
                --border-color: #e2e8f0;
                --error-color: #dc2626;
                --error-light: #fef2f2;
                --error-border: #fca5a5;
                --radius-lg: 20px;
                --radius-md: 12px;
                --shadow-md: 0 10px 25px rgba(18, 43, 46, 0.05);
                --transition: all 0.2s ease;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--bg-page);
                color: var(--text-main);
                margin: 0;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }

            .page {
                padding: 24px;
                width: 100%;
                max-width: 480px;
                box-sizing: border-box;
            }

            .center-shell {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md);
                padding: 45px 35px;
                text-align: center;
                animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .error-icon-wrap {
                width: 72px;
                height: 72px;
                background-color: var(--error-light);
                border: 1px solid rgba(220, 38, 38, 0.15);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
                animation: shake 0.6s ease-in-out;
            }

                .error-icon-wrap svg {
                    width: 30px;
                    height: 30px;
                    color: var(--error-color);
                }

            h2 {
                color: var(--dark);
                font-size: 24px;
                font-weight: 700;
                margin: 0 0 8px;
                letter-spacing: -0.5px;
            }

            .subtitle {
                font-size: 14px;
                color: var(--text-muted);
                margin: 0 0 28px;
                line-height: 1.5;
            }

            .reason-box {
                background-color: var(--error-light);
                border: 1px solid var(--error-border);
                border-radius: var(--radius-md);
                padding: 18px;
                margin-bottom: 30px;
                text-align: left;
            }

            .reason-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 6px;
            }

                .reason-header svg {
                    width: 14px;
                    height: 14px;
                    color: var(--error-color);
                }

            .reason-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--error-color);
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .reason-text {
                color: #7f1d1d;
                font-size: 14px;
                font-weight: 500;
                line-height: 1.5;
                margin: 0;
            }

            .secondary-btn {
                width: 100%;
                height: 48px;
                padding: 0 24px;
                border-radius: var(--radius-md);
                background: #ffffff;
                border: 1px solid var(--border-color);
                color: var(--text-main);
                刻or: pointer;
                font-weight: 600;
                font-size: 14px;
                font-family: inherit;
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

                .secondary-btn:hover {
                    background: #f8fafc;
                    color: var(--dark);
                    border-color: #cbd5e1;
                    transform: translateY(-1px);
                }

                .secondary-btn:active {
                    transform: translateY(0);
                }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes shake {
                0%, 100% {
                    transform: translateX(0);
                }

                15%, 45%, 75% {
                    transform: translateX(-5px);
                }

                30%, 60%, 90% {
                    transform: translateX(5px);
                }
            }
    </style>
</head>
<body>

    <div class="page">
        <div class="center-shell">
            <div class="error-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>

            <h2>Transakcija odbijena</h2>
            <p class="subtitle">Nažalost, nismo uspjeli procesirati Vašu uplatu. Vaša sredstva nisu umanjena.</p>

            <div class="reason-box">
                <div class="reason-header">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                    <span class="reason-label">Razlog sistema</span>
                </div>
                <p class="reason-text">
                    @if (ViewBag.Razlog != null && !string.IsNullOrEmpty(ViewBag.Razlog.ToString()))
                    {
                        @ViewBag.Razlog
                    }
                    else
                    {
                        <text>Došlo je do tehničke greške prilikom komunikacije sa bankom. Molimo provjerite stanje na računu, ispravnost unesenih podataka i pokušajte ponovo.</text>
                    }
                </p>
            </div>

            <button class="secondary-btn" onclick="history.back()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                Pokušaj ponovo
            </button>
        </div>
    </div>

</body>
</html>