@{
    ViewData["Title"] = "InterTrips - Uspješno plaćanje";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --primary: #2aa9b0;
                --primary-dark: #1e7f88;
                --success: #36d399;
                --text: #1a2e35;
                --muted: #64828d;
                --bg: #f0fafa;
                --card: #ffffff;
                --shadow: 0 20px 40px rgba(0,0,0,0.06);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background: radial-gradient(circle at top right, #ffffff, #e6f4f5);
                color: var(--text);
                min-height: 100vh;
                overflow-x: hidden;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .topbar {
                height: 70px;
                background: rgba(255, 255, 255, 0.8);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid rgba(95, 181, 187, 0.15);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 40px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .logo {
                width: 100px;
                transition: transform 0.3s;
            }

                .logo:hover {
                    transform: scale(1.05);
                }

            .secure {
                font-size: 12px;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
            }

                .secure::before {
                    content: "✓";
                    color: var(--success);
                    font-weight: 800;
                }

            .page {
                padding: 60px 20px;
                animation: fadeInUp 0.6s ease-out;
            }

            .shell {
                max-width: 850px;
                margin: 0 auto;
            }

            .hero {
                background: url('/assets/placanje.jpg') center/cover no-repeat !important;
                padding: 60px 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: 24px;
                margin-bottom: 30px;
            }

            .hero-bubble {
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.3);
                border-radius: 30px;
                padding: 40px;
                max-width: 650px;
                display: flex;
                gap: 25px;
                align-items: center;
                box-shadow: 0 20px 40px rgba(0,0,0,0.1); 
                animation: bubbleFloat 0.8s ease-out;
            }

            .hero-icon {
                width: 70px;
                height: 70px;
                background: var(--success);
                color: white;
                font-size: 30px;
                border-radius: 50%;
                display: grid;
                place-items: center;
                flex-shrink: 0;
                box-shadow: 0 8px 20px rgba(54, 211, 153, 0.3);
            }

            .hero-content {
                text-align: left;
            }

                .hero-content h1 {
                    font-size: 24px;
                    margin-bottom: 8px;
                    color: var(--text);
                }

                .hero-content p {
                    font-size: 14px;
                    color: var(--muted);
                    margin-bottom: 20px;
                    line-height: 1.6;
                }

          
            @@keyframes bubbleFloat {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(0.95);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@media (max-width: 600px) {
                .hero-bubble {
                    flex-direction: column;
                    text-align: center;
                    padding: 30px 20px;
                }

                .hero-content {
                    text-align: center;
                }
            }

            .hero h1 {
                font-size: 32px;
                font-weight: 800;
                margin-bottom: 12px;
                letter-spacing: -0.5px;
            }

            .hero p {
                color: var(--muted);
                font-size: 16px;
                max-width: 500px;
                margin: 0 auto 30px;
            }

            .grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            .card {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.4);
                box-shadow: 0 20px 40px rgba(0,0,0,0.08);
                border-radius: 24px;
            }

            .preview {
                height: 200px;
                position: relative;
                background: #cfeff0;
            }

                .preview .badge {
                    position: absolute;
                    top: 15px;
                    right: 15px;
                    background: rgba(255, 255, 255, 0.9);
                    padding: 6px 14px;
                    border-radius: 12px;
                    font-size: 11px;
                    font-weight: 800;
                    color: var(--primary-dark);
                    backdrop-filter: blur(4px);
                }

                .preview .place {
                    position: absolute;
                    bottom: 20px;
                    left: 20px;
                    color: white;
                    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
                }

                    .preview .place h2 {
                        font-size: 24px;
                        font-weight: 800;
                    }

            .card-head {
                padding: 16px 16px 0;
            }

            .card-body {
                padding: 30px;
            }

            .card-title {
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--primary);
                font-weight: 700;
                margin-bottom: 20px;
                display: block;
            }

            .row {
                display: flex;
                justify-content: space-between;
                margin-bottom: 15px;
                font-size: 14px;
                border-bottom: 1px solid #f0f7f8;
                padding-bottom: 10px;
            }

                .row:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

                .row span {
                    color: var(--muted);
                }

                .row strong {
                    color: var(--text);
                    font-weight: 600;
                }

            #codeText {
                font-family: monospace;
                background: #f1f8f9;
                padding: 2px 6px;
                border-radius: 4px;
                font-size: 15px;
            }

            .pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 8px 12px;
                border-radius: 999px;
                background: rgba(106,191,198,0.12);
                border: 1px solid rgba(95,181,187,0.18);
                color: var(--primary-dark);
                font-size: 12px;
                font-weight: 700;
                width: fit-content;
            }

            .btn-row {
                display: flex;
                gap: 15px;
                justify-content: center;
                margin-top: 20px;
            }

            .btn-row {
                display: flex;
                gap: 15px;
                justify-content: center;
                margin-top: 20px;
            }

            .main-btn {
                background: var(--primary);
                color: white;
                padding: 14px 28px;
                border-radius: 16px;
                border: none;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s;
                box-shadow: 0 8px 20px rgba(42, 169, 176, 0.2);
            }

                .main-btn:hover {
                    background: var(--primary-dark);
                    transform: translateY(-2px);
                }

            .secondary-btn {
                background: #f1f8f9;
                color: var(--primary-dark);
                padding: 14px 28px;
                border-radius: 16px;
                border: none;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s;
            }

                .secondary-btn:hover {
                    background: #e2f2f3;
                }

            .preview {
                height: 250px;
                background-size: cover !important;
                background-position: center !important;
                border-bottom: 1px solid rgba(0,0,0,0.05);
            }

                .preview::after {
                    content: "";
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 60%;
                    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
                    pointer-events: none;
                }

                .preview .place {
                    position: absolute;
                    bottom: 20px;
                    left: 20px;
                    color: white;
                    z-index: 2;
                    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
                }

                .preview .badge {
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    padding: 6px 10px;
                    border-radius: 999px;
                    background: rgba(255,255,255,0.78);
                    border: 1px solid rgba(95,181,187,0.18);
                    font-size: 11px;
                    font-weight: 800;
                    color: var(--primary-dark);
                }

                .preview .place {
                    position: absolute;
                    left: 14px;
                    bottom: 14px;
                    color: #fff;
                    font-weight: 800;
                    font-size: 18px;
                    text-shadow: 0 12px 26px rgba(0,0,0,0.18);
                }

                    .preview .place small {
                        display: block;
                        font-size: 11px;
                        font-weight: 500;
                        opacity: .9;
                        margin-top: 2px;
                    }

            @@media (max-width: 768px) {
                .grid {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    padding: 0 20px;
                }

                .hero h1 {
                    font-size: 26px;
                }
            }
    </style>
</head>

<body>
    <header class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure">Uspješno plaćanje</div>
    </header>

    <main class="page">
        <div class="shell">
            <section class="hero">
                <div class="hero-bubble">
                    <div class="hero-icon">✓</div>
                    <div class="hero-content">
                        <h1>Uplata je uspješno evidentirana</h1>
                        <p>Vaša potvrda je spremna. Možete preuzeti PDF dokument ili se vratiti na početnu stranicu.</p>
                        <div class="btn-row">
                            <button class="main-btn" type="button" onclick="downloadPDF()">Preuzmi potvrdu (PDF)</button>
                            <button class="secondary-btn" type="button" onclick="window.location.href='/'">Završi</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="grid">
                <article class="card">
                    <div class="preview" id="tripPreview">
                        <div class="badge" id="paymentBadge">PLAĆANJE</div>
                        <div class="place" id="placeText">Destinacija <small>—</small></div>
                    </div>

                    <div class="card-head">
                        <div class="card-title">DETALJI PUTOVANJA</div>
                    </div>

                    <div class="card-body">
                        <div class="row"><span>Period</span><strong id="periodText">—</strong></div>
                        <div class="row"><span>Smještaj</span><strong id="roomText">—</strong></div>
                        <div class="row"><span>Putnici</span><strong id="travelersText">—</strong></div>
                    </div>
                </article>

                <article class="card">
                    <div class="card-head">
                        <div class="card-title">PODACI O REZERVACIJI I UPLATI</div>
                    </div>
                    <div class="card-body">
                        <div class="row"><span>Broj rezervacije</span><strong id="codeText">—</strong></div>
                        <div class="row"><span>Datum</span><strong id="dateText">—</strong></div>
                        <div class="row"><span>Način plaćanja</span><strong id="methodText">—</strong></div>
                        <div class="row"><span>Ukupno</span><strong id="totalText">—</strong></div>
                        <div id="ratesBox" style="margin-top:12px; display:none;">
                            <div class="pill" id="ratesPill">Rate</div>
                            <div style="margin-top:8px; font-size:13px; color:var(--muted); line-height:1.7;">
                                <div>Mjeseci: <strong id="ratesMonthsText">—</strong></div>
                                <div>Mjesečna rata: <strong id="ratesMonthlyText">—</strong> KM</div>
                            </div>
                        </div>
                    </div>
                </article>
            </section>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        async function loadFontAsBase64(url) {
        const res = await fetch(url);
        const buf = await res.arrayBuffer();
        let binary = '';
        const bytes = new Uint8Array(buf);
        const chunkSize = 0x8000;
        for (let i = 0; i < bytes.length; i += chunkSize) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
        }
        return btoa(binary);
        }

        let fontsReady = false;

        async function ensurePdfFonts(doc) {
        if (fontsReady) return;

        const regularB64 = await loadFontAsBase64('/fonts/DejaVuSans.ttf');
        doc.addFileToVFS('DejaVuSans.ttf', regularB64);
        doc.addFont('DejaVuSans.ttf', 'DejaVuSans', 'normal', 'Identity-H');

        try {
        const boldB64 = await loadFontAsBase64('/fonts/DejaVuSans-Bold.ttf');
        doc.addFileToVFS('DejaVuSans-Bold.ttf', boldB64);
        doc.addFont('DejaVuSans-Bold.ttf', 'DejaVuSans', 'bold', 'Identity-H');
        } catch (e) {
        }

        fontsReady = true;
        }
        window.jsPDF = window.jspdf.jsPDF;

        function safe(key, fallback = '—') {
        const v = localStorage.getItem(key);
        return (v === null || v === undefined || String(v).trim() === '') ? fallback : v;
        }

        function getPaymentLabel(type) {
        if (type === 'bank') return 'BANKOVNI PRENOS';
        if (type === 'cash') return 'GOTOVINA';
        if (type === 'rates') return 'RATE';
        return 'KARTICA';
        }

        function normalizeUpperBs(s) {
        return String(s).toUpperCase()
        .replace(/Č/g, "C")
        .replace(/Ć/g, "C")
        .replace(/Š/g, "S")
        .replace(/Ž/g, "Z")
        .replace(/Đ/g, "DJ");
        }

        async function loadUi() {
        const dest = safe('reservationDestination', 'Destinacija');
        const country = safe('reservationCountry', '—');
        const image = safe('reservationImage', '/assets/bali.jpg');

        document.getElementById('placeText').innerHTML = `${dest} <small>${country}</small>`;
        document.getElementById('tripPreview').style.backgroundImage = `url('${image}')`;

        const dep = safe('reservationDeparture');
        const ret = safe('reservationReturn');
        document.getElementById('periodText').textContent = `${dep} - ${ret}`;

        document.getElementById('roomText').textContent = safe('reservationRoom');
        document.getElementById('travelersText').textContent = safe('reservationTravelers');

        document.getElementById('codeText').textContent = safe('finalReservationCode');
        document.getElementById('dateText').textContent = safe('reservationDate');

        const pType = safe('paymentType', 'card');
        const method = getPaymentLabel(pType);
        document.getElementById('methodText').textContent = method;
        document.getElementById('paymentBadge').textContent = method;

        document.getElementById('totalText').textContent = safe('reservationTotal', '0');

        if (pType === 'rates') {
        const m = safe('ratesMonths', '');
        const r = safe('ratesMonthly', '');
        if (m && r) {
        document.getElementById('ratesBox').style.display = 'block';
        document.getElementById('ratesMonthsText').textContent = m;
        document.getElementById('ratesMonthlyText').textContent = r;
        }
        }
        try {
        const paketIdIzMemorije = safe('selectedPackageId', '0');

        const datumPolaskaRaw = safe('reservationDeparture', '');
        const datumPovratkaRaw = safe('reservationReturn', '');

        const formatirajZaBazu = (dateStr) => {
        if (!dateStr || dateStr === '—') return new Date().toISOString().split('T')[0];
        if (dateStr.includes('.')) {
        const dijelovi = dateStr.split('.');
        if (dijelovi.length >= 3) {
        return `${dijelovi[2]}-${dijelovi[1]}-${dijelovi[0]}`;
        }
        }
        return dateStr;
        };

        const savedPassengers = JSON.parse(localStorage.getItem('savedPassengers') || '[]');

        const podaciZaBazu = {
        paketId: parseInt(paketIdIzMemorije) || 1,

        datumPolaska: formatirajZaBazu(datumPolaskaRaw),

        datumPovratka: formatirajZaBazu(datumPovratkaRaw),

        putnici: savedPassengers.map(p => ({
        ime: p.firstName,
        prezime: p.lastName,
        brojPasosa: p.passport,
        drzavljanstvo: p.nationality,
        telefon: p.phone || "",

        datumRodjenja: p.birthDate
        ? p.birthDate
        : null,

        posebniZahtjevi: p.requests || ""
        }))
        };

        const response = await fetch('/Rezervacija/KreirajRezervaciju', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json'
        },
        body: JSON.stringify(podaciZaBazu)
        });

        if (response.ok) {
        console.log("Rezervacija je uspješno sinhronizovana i upisana u bazu podataka.");
        } else {
        console.error("Server je vratio grešku prilikom upisivanja rezervacije.");
        }
        } catch (error) {
        console.error("Došlo je do greške u komunikaciji sa serverom:", error);
        }

        }


        function pdfSafeText(value) {
        if (value === null || value === undefined) return '';

        let s = String(value);

        s = s.replace(/<[^>]*>/g, '');

        s = s.replace(/&amp;/g, '&')
        .replace(/&nbsp;/g, ' ')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>');

        s = s.replace(/[\u0000-\u001F\u007F]/g, '');

        s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

        s = s.replace(/[^\x20-\x7E]/g, '');

        return s.trim();
        }
        async function generatePDF(resCode) {
        const doc = new jsPDF();

        await ensurePdfFonts(doc);
        doc.setFont('DejaVuSans', 'normal');

        const date = new Date().toLocaleDateString('bs-BA');
        const selectedPaymentType = safe('paymentType', 'card');
        const paymentLabel = getPaymentLabel(selectedPaymentType);

        doc.setFillColor(47, 125, 134);
        doc.rect(0, 0, 210, 40, 'F');

        doc.setTextColor(255, 255, 255);
        doc.setFontSize(24);
        doc.setFont('DejaVuSans', 'bold');
        doc.text("INTERTRIPS", 105, 20, { align: "center" });

        doc.setFontSize(10);
        doc.setFont('DejaVuSans', 'normal');
        doc.text("Agencija za turizam | Sarajevo, BiH | www.intertrips.ba", 105, 30, { align: "center" });

        doc.setTextColor(0, 0, 0);
        doc.setFontSize(18);
        doc.setFont('DejaVuSans', 'bold');
        doc.text("POTVRDA REZERVACIJE", 20, 60);

        doc.setFontSize(10);
        doc.setFont('DejaVuSans', 'normal');
        doc.text(`Broj dokumenta: ${resCode}`, 20, 70);
        doc.text(`Datum izdavanja: ${date}`, 20, 75);
        doc.line(20, 80, 190, 80);

        doc.setFont('DejaVuSans', 'bold');
        doc.text("DETALJI PUTOVANJA:", 20, 95);

        doc.setFont('DejaVuSans', 'normal');
        doc.text(`Destinacija: ${safe('reservationDestination', '')}`, 20, 105);
        doc.text(`Period: ${safe('reservationDeparture', '')} - ${safe('reservationReturn', '')}`, 20, 112);
        doc.text(`Smještaj: ${safe('reservationRoom', '')}`, 20, 119);
        doc.text(`Broj putnika: ${safe('reservationTravelers', '')}`, 20, 126);
        const passengersRaw = localStorage.getItem('savedPassengers');
        let firstPhone = '';
        try {
        const ps = passengersRaw ? JSON.parse(passengersRaw) : [];
        firstPhone = ps?.[0]?.phone || '';
        } catch { }
        if (firstPhone) doc.text(`Kontakt telefon: ${firstPhone}`, 20, 133);

        doc.setFont('DejaVuSans', 'bold');
        doc.text("FINANSIJSKI PODACI:", 120, 95);

        doc.setFont('DejaVuSans', 'normal');
        doc.text(`Način plaćanja: ${normalizeUpperBs(paymentLabel)}`, 120, 105);
        doc.setFontSize(14);
        doc.setFont('DejaVuSans', 'bold');
        doc.text(`UKUPNO: ${safe('reservationTotal', '')}`, 120, 115);

        if (selectedPaymentType === 'rates') {
        doc.setFontSize(10);
        doc.setFont('DejaVuSans', 'normal');
        doc.text(`Mjeseci: ${safe('ratesMonths', '')}`, 120, 124);
        doc.text(`Mjesečna rata: ${safe('ratesMonthly', '')} KM`, 120, 130);
        }

        doc.line(20, 138, 190, 138);
        doc.setFontSize(12);
        doc.setFont('DejaVuSans', 'bold');
        doc.text("PODACI O PUTNICIMA:", 20, 148);

        let passengers = [];
        try {
        const rawPassengers = localStorage.getItem('savedPassengers');
        if (rawPassengers) {
        passengers = JSON.parse(rawPassengers);
        }
        } catch (e) {
        console.error("Greška pri čitanju putnika iz localStorage", e);
        }

        let currentY = 158;

        const colX = { rb: 22, ime: 30, tip: 78, dob: 96, pasos: 122, drz: 146, tel: 170 };

        if (passengers.length === 0) {
        doc.setFontSize(10);
        doc.setFont('DejaVuSans', 'normal');
        doc.text("Nema sačuvanih podataka o putnicima.", 20, currentY);
        currentY += 10;
        } else {
        doc.setFontSize(9);
        doc.setFont('DejaVuSans', 'bold');
        doc.setFillColor(240, 248, 248);
        doc.rect(20, currentY - 5, 175, 7, 'F');

        doc.text("#", colX.rb, currentY);
        doc.text("Ime i Prezime", colX.ime, currentY); // Zamijenjen & sa i
        doc.text("Tip", colX.tip, currentY);
        doc.text("Datum rođ.", colX.dob, currentY);
        doc.text("Pasoš", colX.pasos, currentY);
        doc.text("Drž.", colX.drz, currentY);
        doc.text("Telefon", colX.tel, currentY);

        currentY += 8;

        passengers.forEach((p, index) => {
        if (currentY > 250) {
        doc.addPage();
        doc.setFont('DejaVuSans', 'normal');
        currentY = 30;

        doc.setFontSize(9);
        doc.setFont('DejaVuSans', 'bold');
        doc.setFillColor(240, 248, 248);
        doc.rect(20, currentY - 5, 175, 7, 'F'); // Dodana pozadina i na novoj stranici radi konzistentnosti

        doc.text("#", colX.rb, currentY);
        doc.text("Ime i Prezime", colX.ime, currentY); // Zamijenjen & sa i
        doc.text("Tip", colX.tip, currentY);
        doc.text("Datum rođ.", colX.dob, currentY);
        doc.text("Pasoš", colX.pasos, currentY);
        doc.text("Drž.", colX.drz, currentY);
        doc.text("Telefon", colX.tel, currentY);
        currentY += 8;
        }

        doc.setFontSize(9);
        doc.setFont('DejaVuSans', 'normal');

        const pTypeFormatted = p.type === 'adult' ? 'Odrasli' : 'Dijete';
        const fullName = `${p.firstName} ${p.lastName}`;

        let formattedDate = p.birthDate || '—';
        if (p.birthDate && p.birthDate.includes('-')) {
        const parts = p.birthDate.split('-');
        if (parts.length === 3) formattedDate = `${parts[2]}.${parts[1]}.${parts[0]}.`;
        }

        doc.text(`${index + 1}.`, colX.rb, currentY);
        doc.text(normalizeUpperBs(fullName), colX.ime, currentY);
        doc.text(normalizeUpperBs(pTypeFormatted), colX.tip, currentY);
        doc.text(formattedDate, colX.dob, currentY);
        doc.text(normalizeUpperBs(p.passport || '—'), colX.pasos, currentY);
        doc.text(normalizeUpperBs(p.nationality || '—'), colX.drz, currentY);
        doc.text(p.phone ? String(p.phone) : '—', colX.tel, currentY);

        if (p.requests && p.requests.trim() !== "") {
        currentY += 5;
        doc.setFontSize(8);
        doc.setFont('DejaVuSans', 'italic');
        doc.setTextColor(100, 100, 100);
        doc.text(`Napomena za putnika ${index + 1}: ${p.requests}`, colX.ime, currentY);
        doc.setTextColor(0, 0, 0);
        }

        doc.setDrawColor(220, 235, 235);
        doc.setLineWidth(0.2);
        doc.line(20, currentY + 2, 190, currentY + 2);

        currentY += 8;
        });
        }
        let footerY = currentY + 15;
        if (footerY > 230) {
        doc.addPage();
        footerY = 40;
        }

        doc.setDrawColor(47, 125, 134);
        doc.setLineWidth(0.8);
        doc.circle(50, footerY + 10, 18);

        doc.setFontSize(8);
        doc.setFont('DejaVuSans', 'normal');
        doc.setTextColor(47, 125, 134);
        doc.text("INTERTRIPS d.o.o.", 50, footerY + 8, { align: "center" });
        doc.text("SARAJEVO", 50, footerY + 13, { align: "center" });
        doc.text("ID: 4200000000", 50, footerY + 18, { align: "center" });

        doc.setTextColor(0, 0, 0);
        doc.setFontSize(10);
        doc.text("__________________________", 130, footerY + 10);
        doc.text("Ovlašteno lice", 145, footerY + 16);

        doc.setFontSize(8);
        doc.setTextColor(150, 150, 150);
        doc.text("Ovaj dokument je validan bez pečata i potpisa ukoliko je generisan elektronskim putem.", 105, 285, { align: "center" });

        doc.save(`Potvrda_InterTrips_${resCode}.pdf`);
        }

        async function downloadPDF() {
        const resCode = safe('finalReservationCode', 'IT-0000-0000');
        await generatePDF(resCode);
        }

        window.addEventListener('DOMContentLoaded', loadUi);
    </script>
</body>
</html>