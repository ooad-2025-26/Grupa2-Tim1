@{
    ViewData["Title"] = "InterTrips - Uspješno plaćanje";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --primary: #2b7a80;
                --primary-dark: #1e5a5e;
                --primary-light: #f0f7f8;
                --success: #10b981;
                --success-light: #ecfdf5;
                --dark: #122b2e;
                --text-main: #2d3748;
                --text-muted: #718096;
                --bg-page: #f8fafc;
                --border-color: #e2e8f0;
                --radius-lg: 24px;
                --radius-md: 14px;
                --radius-sm: 8px;
                --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
                --shadow-md: 0 12px 30px rgba(18, 43, 46, 0.06);
                --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--bg-page);
                color: var(--text-main);
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }

            .topbar {
                height: 70px;
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 40px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .logo {
                width: 100px;
                transition: var(--transition);
            }

                .logo:hover {
                    transform: scale(1.03);
                }

            .secure {
                font-size: 13px;
                color: var(--success);
                display: flex;
                align-items: center;
                gap: 6px;
                font-weight: 600;
                background: var(--success-light);
                padding: 6px 14px;
                border-radius: 999px;
                border: 1px solid rgba(16, 185, 129, 0.15);
            }

                .secure svg {
                    width: 14px;
                    height: 14px;
                }

            .page {
                padding: 50px 20px 80px;
                animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .shell {
                max-width: 880px;
                margin: 0 auto;
            }

            .hero {
                background: url('/assets/placanje.jpg') center/cover no-repeat !important;
                padding: 50px 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                border-radius: var(--radius-lg);
                margin-bottom: 30px;
                box-shadow: var(--shadow-sm);
                position: relative;
            }

                .hero::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: rgba(18, 43, 46, 0.15);
                    border-radius: var(--radius-lg);
                }

            .hero-bubble {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.6);
                border-radius: var(--radius-lg);
                padding: 40px;
                max-width: 680px;
                width: 100%;
                display: flex;
                gap: 28px;
                align-items: center;
                box-shadow: var(--shadow-md);
                position: relative;
                z-index: 2;
            }

            .hero-icon {
                width: 64px;
                height: 64px;
                background: var(--success);
                color: white;
                border-radius: 50%;
                display: grid;
                place-items: center;
                flex-shrink: 0;
                box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);
            }

                .hero-icon svg {
                    width: 32px;
                    height: 32px;
                }

            .hero-content {
                text-align: left;
                width: 100%;
            }

                .hero-content h1 {
                    font-size: 24px;
                    font-weight: 700;
                    margin-bottom: 6px;
                    color: var(--dark);
                    letter-spacing: -0.5px;
                }

                .hero-content p {
                    font-size: 14px;
                    color: var(--text-muted);
                    margin-bottom: 24px;
                    line-height: 1.5;
                }

            .btn-row {
                display: flex;
                gap: 12px;
                justify-content: flex-start;
            }

            .main-btn {
                background: var(--primary);
                color: white;
                padding: 12px 24px;
                border-radius: var(--radius-md);
                border: 1px solid transparent;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: var(--transition);
                box-shadow: 0 4px 12px rgba(43, 122, 128, 0.15);
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .main-btn:hover {
                    background: var(--primary-dark);
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(43, 122, 128, 0.25);
                }

                .main-btn:disabled {
                    background: var(--text-muted);
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }

            .secondary-btn {
                background: #ffffff;
                color: var(--text-main);
                padding: 12px 24px;
                border-radius: var(--radius-md);
                border: 1px solid var(--border-color);
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: var(--transition);
            }

                .secondary-btn:hover {
                    background: var(--bg-page);
                    border-color: #cbd5e1;
                    color: var(--dark);
                }

            .grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            .card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-sm);
                border-radius: var(--radius-lg);
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .preview {
                height: 200px;
                position: relative;
                background: #cfeff0;
                background-size: cover !important;
                background-position: center !important;
            }

                .preview::after {
                    content: "";
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 70%;
                    background: linear-gradient(to top, rgba(18, 43, 46, 0.7) 0%, transparent 100%);
                    pointer-events: none;
                    z-index: 1;
                }

                .preview .badge {
                    position: absolute;
                    top: 16px;
                    left: 16px;
                    padding: 5px 12px;
                    border-radius: var(--radius-sm);
                    background: rgba(255, 255, 255, 0.9);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    font-size: 11px;
                    font-weight: 700;
                    color: var(--primary-dark);
                    backdrop-filter: blur(4px);
                    z-index: 2;
                    letter-spacing: 0.5px;
                }

                .preview .place {
                    position: absolute;
                    left: 20px;
                    bottom: 20px;
                    color: #ffffff;
                    font-weight: 700;
                    font-size: 20px;
                    letter-spacing: -0.3px;
                    z-index: 2;
                }

                    .preview .place small {
                        display: block;
                        font-size: 12px;
                        font-weight: 400;
                        opacity: 0.85;
                        margin-top: 2px;
                    }

            .card-head {
                padding: 24px 24px 8px;
            }

            .card-body {
                padding: 8px 24px 24px;
                flex-grow: 1;
            }

            .card-title {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--primary);
                font-weight: 700;
                margin-bottom: 8px;
                display: block;
            }

            .row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 14px;
                font-size: 14px;
                border-bottom: 1px dashed var(--border-color);
                padding-bottom: 10px;
            }

                .row:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                    margin-bottom: 0;
                }

                .row span {
                    color: var(--text-muted);
                    font-weight: 400;
                }

                .row strong {
                    color: var(--dark);
                    font-weight: 500;
                }

            #codeText {
                font-family: monospace;
                background: var(--bg-page);
                padding: 4px 8px;
                border-radius: var(--radius-sm);
                font-size: 14px;
                border: 1px solid var(--border-color);
                color: var(--dark);
                font-weight: 600;
            }

            .pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 12px;
                border-radius: 999px;
                background: var(--primary-light);
                border: 1px solid rgba(43, 122, 128, 0.15);
                color: var(--primary-dark);
                font-size: 11px;
                font-weight: 600;
                width: fit-content;
            }

            .rates-container {
                margin-top: 16px;
                padding: 14px;
                background: var(--bg-page);
                border-radius: var(--radius-md);
                border: 1px solid var(--border-color);
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 768px) {
                .grid {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }

                .topbar {
                    padding: 0 20px;
                }

                .hero-bubble {
                    flex-direction: column;
                    text-align: center;
                    padding: 30px 24px;
                    gap: 20px;
                }

                .hero-content {
                    text-align: center;
                }

                .btn-row {
                    justify-content: center;
                    flex-direction: column;
                    gap: 10px;
                }

                .main-btn, .secondary-btn {
                    width: 100%;
                    justify-content: center;
                }
            }
    </style>
</head>

<body>
    <header class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
            Uspješno plaćanje
        </div>
    </header>

    <main class="page">
        <div class="shell">
            <section class="hero">
                <div class="hero-bubble">
                    <div class="hero-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                    </div>
                    <div class="hero-content">
                        <h1>Uplata uspješno evidentirana</h1>
                        <p>Vaša potvrda o rezervaciji je generisana. Možete preuzeti službeni PDF dokument za Vaše putovanje ili završiti proces.</p>
                        <div class="btn-row">
                            <button class="main-btn" type="button" id="downloadBtn" onclick="downloadPDF()">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 16px; height: 16px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                </svg>
                                Preuzmi potvrdu (PDF)
                            </button>
                            <button class="secondary-btn" type="button" onclick="window.location.href='/'">Završi</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="grid">
                <article class="card">
                    <div class="preview" id="tripPreview">
                        <div class="badge" id="paymentBadge">PLAĆANJE</div>
                        <div class="place" id="placeText">Destinacija <small>—</small></div>
                    </div>

                    <div class="card-head">
                        <div class="card-title">Detalji putovanja</div>
                    </div>

                    <div class="card-body">
                        <div class="row"><span>Period</span><strong id="periodText">—</strong></div>
                        <div class="row"><span>Smještaj</span><strong id="roomText">—</strong></div>
                        <div class="row"><span>Putnici</span><strong id="travelersText">—</strong></div>
                    </div>
                </article>

                <article class="card">
                    <div class="card-head">
                        <div class="card-title">Podaci o rezervaciji i uplati</div>
                    </div>
                    <div class="card-body">
                        <div class="row"><span>Broj rezervacije</span><strong id="codeText">—</strong></div>
                        <div class="row"><span>Datum transakcije</span><strong id="dateText">—</strong></div>
                        <div class="row"><span>Način plaćanja</span><strong id="methodText">—</strong></div>
                        <div class="row"><span>Ukupno uplaćeno</span><strong id="totalText">—</strong></div>

                        <div id="ratesBox" style="display:none;">
                            <div class="rates-container">
                                <div class="pill" id="ratesPill">Plaćanje na rate</div>
                                <div style="margin-top:10px; font-size:13px; color:var(--text-muted); line-height:1.6;">
                                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span>Broj mjeseci:</span><strong id="ratesMonthsText">—</strong></div>
                                    <div style="display:flex; justify-content:space-between;"><span>Mjesečna rata:</span><span><strong id="ratesMonthlyText">—</strong> KM</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </section>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        window.jsPDF = window.jspdf.jsPDF;
        let fontsReady = false;
        let regularB64 = '';
        let boldB64 = '';

        async function loadFontAsBase64(url) {
        try {
        const res = await fetch(url);
        if (!res.ok) throw new Error("Font nije pronađen");
        const buf = await res.arrayBuffer();
        let binary = '';
        const bytes = new Uint8Array(buf);
        const chunkSize = 0x8000;
        for (let i = 0; i < bytes.length; i += chunkSize) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
        }
        return btoa(binary);
        } catch (e) {
        console.warn("Greška pri učitavanju fonta: " + url, e);
        return null;
        }
        }

        async function preloadFonts() {
        regularB64 = await loadFontAsBase64('/fonts/DejaVuSans.ttf');
        boldB64 = await loadFontAsBase64('/fonts/DejaVuSans-Bold.ttf');
        fontsReady = !!regularB64;
        console.log("Učitavanje fontova završeno. Uspješno?", fontsReady);
        }

        function safe(key, fallback = '—') {
        const v = localStorage.getItem(key);
        return (v === null || v === undefined || String(v).trim() === '') ? fallback : v;
        }

        function getPaymentLabel(type) {
        if (type === 'bank') return 'BANKOVNI PRENOS';
        if (type === 'cash') return 'GOTOVINA';
        if (type === 'rates') return 'RATE';
        return 'KARTICA';
        }

        function normalizeUpperBs(s) {
        return String(s).toUpperCase()
        .replace(/Č/g, "C").replace(/Ć/g, "C")
        .replace(/Š/g, "S").replace(/Ž/g, "Z")
        .replace(/Đ/g, "DJ");
        }

        // GLAVNA FUNKCIJA KOJA SE POKREĆE ODMAH
        async function loadUi() {
        // 1. Prvo popunjavamo UI podatke iz lokalne memorije da korisnik ne gleda prazne crtice
        const dest = safe('reservationDestination', 'Destinacija');
        const country = safe('reservationCountry', '—');
        const image = safe('reservationImage', '/assets/bali.jpg');

        document.getElementById('placeText').innerHTML = `${dest} <small>${country}</small>`;
        document.getElementById('tripPreview').style.backgroundImage = `url('${image}')`;

        const dep = safe('reservationDepartureText', '—');
        const ret = safe('reservationReturnText', '—');
        document.getElementById('periodText').textContent = `${dep} - ${ret}`;

        document.getElementById('roomText').textContent = safe('reservationRoom');
        document.getElementById('travelersText').textContent = safe('reservationTravelers');

        document.getElementById('codeText').textContent = safe('finalReservationCode');
        document.getElementById('dateText').textContent = safe('reservationDate');

        const pType = safe('paymentType', 'card');
        const method = getPaymentLabel(pType);
        document.getElementById('methodText').textContent = method;
        document.getElementById('paymentBadge').textContent = method;

        document.getElementById('totalText').textContent = safe('reservationTotal', '0');

        if (pType === 'rates') {
        const m = safe('ratesMonths', '');
        const r = safe('ratesMonthly', '');
        if (m && r) {
        document.getElementById('ratesBox').style.display = 'block';
        document.getElementById('ratesMonthsText').textContent = m;
        document.getElementById('ratesMonthlyText').textContent = r;
        }
        }

        // 2. ODMAH šaljemo podatke na server (Bez čekanja fontova!)
        try {
        // Ispravljen ključ na 'reservationPaketId' kako bi odgovarao bazi i prethodnim stranicama
        const paketIdIzMemorije = safe('reservationPaketId', safe('selectedPackageId', '1'));
        const datumPolaskaRaw = safe('reservationDepartureText', '');
        const datumPovratkaRaw = safe('reservationReturnText', '');

        const formatirajZaBazu = (dateStr) => {
        if (!dateStr || dateStr === '—') return new Date().toISOString().split('T')[0];
        if (dateStr.includes('.')) {
        const dijelovi = dateStr.split('.');
        if (dijelovi.length >= 3) {
        return `${dijelovi[2].trim()}-${dijelovi[1].trim()}-${dijelovi[0].trim()}`;
        }
        }
        return dateStr;
        };

        const savedPassengers = JSON.parse(localStorage.getItem('savedPassengers') || '[]');

        const podaciZaBazu = {
        paketId: parseInt(paketIdIzMemorije) || 1,
        datumPolaska: formatirajZaBazu(datumPolaskaRaw),
        datumPovratka: formatirajZaBazu(datumPovratkaRaw),
        putnici: savedPassengers.map(p => ({
        ime: p.firstName || "—",
        prezime: p.lastName || "—",
        brojPasosa: p.passport || "—",
        drzavljanstvo: p.nationality || "—",
        telefon: p.phone || "",
        datumRodjenja: p.birthDate ? p.birthDate : null,
        posebniZahtjevi: p.requests || ""
        }))
        };

        const response = await fetch('/Rezervacija/KreirajRezervaciju', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(podaciZaBazu)
        });

        if (response.ok) {
        console.log("Rezervacija je uspješno upisana u bazu.");
        // Ovdje možete očistiti privremeni localStorage ako je potrebno
        } else {
        console.error("Server je vratio grešku prilikom upisivanja rezervacije.");
        }
        } catch (error) {
        console.error("Greška u komunikaciji sa serverom:", error);
        }

        // 3. Tek na samom kraju, u pozadini (asinhrono) pokrećemo učitavanje fontova za PDF
        // Na ovaj način fontovi ne blokiraju niti UI niti upis u bazu podataka!
        preloadFonts();
        }

        async function generatePDF(resCode) {
        const doc = new jsPDF();

        if (fontsReady && regularB64) {
        doc.addFileToVFS('DejaVuSans.ttf', regularB64);
        doc.addFont('DejaVuSans.ttf', 'DejaVuSans', 'normal', 'Identity-H');
        if (boldB64) {
        doc.addFileToVFS('DejaVuSans-Bold.ttf', boldB64);
        doc.addFont('DejaVuSans-Bold.ttf', 'DejaVuSans', 'bold', 'Identity-H');
        }
        doc.setFont('DejaVuSans', 'normal');
        }

        const danas = new Date();
        const dan = String(danas.getDate()).padStart(2, '0');
        const mjesec = String(danas.getMonth() + 1).padStart(2, '0');
        const godina = danas.getFullYear();
        const ispravanDatum = `${dan}.${mjesec}.${godina}.`;

        const selectedPaymentType = safe('paymentType', 'card');
        const paymentLabel = getPaymentLabel(selectedPaymentType);

        doc.setFillColor(43, 122, 128);
        doc.rect(0, 0, 210, 40, 'F');

        doc.setTextColor(255, 255, 255);
        doc.setFontSize(22);
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("INTERTRIPS", 105, 18, { align: "center" });

        doc.setFontSize(10);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text("Agencija za turizam | Sarajevo, BiH | www.intertrips.ba", 105, 28, { align: "center" });

        doc.setTextColor(0, 0, 0);
        doc.setFontSize(16);
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("POTVRDA REZERVACIJE", 20, 55);

        doc.setFontSize(10);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text(`Broj dokumenta: ${resCode}`, 20, 65);
        doc.text(`Datum izdavanja: ${ispravanDatum}`, 20, 71);
        doc.setDrawColor(200, 220, 220);
        doc.line(20, 77, 190, 77);

        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("DETALJI PUTOVANJA:", 20, 90);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text(`Destinacija: ${safe('reservationDestination', '')}`, 20, 98);
        doc.text(`Period: ${safe('reservationDepartureText', '')} - ${safe('reservationReturnText', '')}`, 20, 105);
        doc.text(`Smještaj: ${safe('reservationRoom', '')}`, 20, 112);
        doc.text(`Broj putnika: ${safe('reservationTravelers', '')}`, 20, 119);

        const tipPrevozaIzMemorije = safe('prevozTip', 'Autobus');
        let prevozIspis = 'Autobuski prevoz uključen u cijenu';

        if (tipPrevozaIzMemorije === 'Avion') {
        const brLeta = safe('flightNumber', '');
        const relacijaLeta = safe('flightRoute', '');
        if (brLeta) {
        prevozIspis = `Avion — Let: ${brLeta} ${relacijaLeta ? '(' + relacijaLeta + ')' : ''}`;
        } else {
        prevozIspis = 'Avionski prevoz uključen u cijenu';
        }
        }
        doc.text(`Prevoz: ${normalizeUpperBs(prevozIspis)}`, 20, 126);

        const passengersRaw = localStorage.getItem('savedPassengers');
        let firstPhone = '';
        try {
        const ps = passengersRaw ? JSON.parse(passengersRaw) : [];
        firstPhone = ps?.[0]?.phone || '';
        } catch { }
        if (firstPhone) doc.text(`Kontakt telefon: ${firstPhone}`, 20, 133);

        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("FINANSIJSKI PODACI:", 120, 90);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text(`Način plaćanja: ${normalizeUpperBs(paymentLabel)}`, 120, 98);

        doc.setFontSize(13);
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text(`UKUPNO: ${safe('reservationTotal', '')} KM`, 120, 108);

        if (selectedPaymentType === 'rates') {
        doc.setFontSize(10);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text(`Mjeseci: ${safe('ratesMonths', '')}`, 120, 118);
        doc.text(`Mjesečna rata: ${safe('ratesMonthly', '')} KM`, 120, 124);
        }

        doc.line(20, 139, 190, 139);

        doc.setFontSize(11);
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("PODACI O PUTNICIMA:", 20, 149);

        let passengers = [];
        try {
        if (passengersRaw) passengers = JSON.parse(passengersRaw);
        } catch (e) { console.error(e); }

        let currentY = 159;
        const colX = { rb: 22, ime: 32, tip: 80, dob: 98, pasos: 124, drz: 148, tel: 170 };

        if (passengers.length === 0) {
        doc.setFontSize(10);
        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        doc.text("Nema sačuvanih podataka o putnicima.", 20, currentY);
        } else {
        doc.setFontSize(9);
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.setFillColor(240, 248, 248);
        doc.rect(20, currentY - 5, 175, 7, 'F');

        doc.text("#", colX.rb, currentY);
        doc.text("Ime i Prezime", colX.ime, currentY);
        doc.text("Tip", colX.tip, currentY);
        doc.text("Datum rođ.", colX.dob, currentY);
        doc.text("Pasoš", colX.pasos, currentY);
        doc.text("Drž.", colX.drz, currentY);
        doc.text("Telefon", colX.tel, currentY);

        currentY += 8;

        passengers.forEach((p, index) => {
        if (currentY > 250) {
        doc.addPage();
        currentY = 30;
        doc.setFillColor(240, 248, 248);
        doc.rect(20, currentY - 5, 175, 7, 'F');
        if (fontsReady && boldB64) doc.setFont('DejaVuSans', 'bold');
        doc.text("#", colX.rb, currentY);
        doc.text("Ime i Prezime", colX.ime, currentY);
        doc.text("Tip", colX.tip, currentY);
        currentY += 8;
        }

        if (fontsReady) doc.setFont('DejaVuSans', 'normal');
        const pTypeFormatted = p.type === 'adult' ? 'Odrasli' : 'Dijete';
        const fullName = `${p.firstName || ''} ${p.lastName || ''}`;

        let formattedDate = p.birthDate || '—';
        if (p.birthDate && p.birthDate.includes('-')) {
        const parts = p.birthDate.split('-');
        if (parts.length === 3) formattedDate = `${parts[2]}.${parts[1]}.${parts[0]}.`;
        }

        doc.text(`${index + 1}.`, colX.rb, currentY);
        doc.text(normalizeUpperBs(fullName), colX.ime, currentY);
        doc.text(normalizeUpperBs(pTypeFormatted), colX.tip, currentY);
        doc.text(formattedDate, colX.dob, currentY);
        doc.text(normalizeUpperBs(p.passport || '—'), colX.pasos, currentY);
        doc.text(normalizeUpperBs(p.nationality || '—'), colX.drz, currentY);
        doc.text(p.phone ? String(p.phone) : '—', colX.tel, currentY);

        if (p.requests && p.requests.trim() !== "") {
        currentY += 5;
        doc.setFontSize(8);
        doc.text(`Napomena: ${p.requests}`, colX.ime, currentY);
        doc.setFontSize(9);
        }

        doc.setDrawColor(230, 240, 240);
        doc.line(20, currentY + 2, 190, currentY + 2);
        currentY += 8;
        });
        }

        let footerY = currentY + 15;
        if (footerY > 230) {
        doc.addPage();
        footerY = 40;
        }

        doc.setDrawColor(43, 122, 128);
        doc.setLineWidth(0.6);
        doc.circle(50, footerY + 10, 16);

        doc.setFontSize(7);
        doc.setTextColor(43, 122, 128);
        doc.text("INTERTRIPS d.o.o.", 50, footerY + 7, { align: "center" });
        doc.text("SARAJEVO", 50, footerY + 11, { align: "center" });
        doc.text("Faktura / Potvrda", 50, footerY + 15, { align: "center" });

        doc.setTextColor(0, 0, 0);
        doc.setFontSize(9);
        doc.text("__________________________", 130, footerY + 10);
        doc.text("Ovlašteno lice", 145, footerY + 16);

        doc.setFontSize(8);
        doc.setTextColor(150, 150, 150);
        doc.text("Ovaj dokument je validan bez pečata i potpisa ukoliko je generisan elektronskim putem.", 105, 285, { align: "center" });

        doc.save(`Potvrda_InterTrips_${resCode}.pdf`);
        }

        async function downloadPDF() {
        const btn = document.getElementById('downloadBtn');
        if (btn) {
        btn.disabled = true;
        btn.textContent = 'Generisanje...';
        }

        const resCode = safe('finalReservationCode', 'IT-0000-0000');
        await generatePDF(resCode);

        if (btn) {
        btn.disabled = false;
        btn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 16px; height: 16px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Preuzmi potvrdu (PDF)
            `;
        }
    }

    window.addEventListener('DOMContentLoaded', loadUi);
</script>
</body>
</html>