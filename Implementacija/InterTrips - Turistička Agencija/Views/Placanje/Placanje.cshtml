@{
    ViewData["Title"] = "InterTrips - Plaćanje";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f4f8f9;
                margin: 0;
                padding: 0;
            }

            .page {
                padding: 40px 24px 60px;
            }

            .topbar {
                height: 65px;
                background: rgba(255, 255, 255, 0.85);
                border-bottom: 1px solid rgba(95, 181, 187, 0.15);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 40px;
                position: sticky;
                top: 0;
                z-index: 50;
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
            }

            .logo {
                height: 38px;
                width: auto;
            }

            .secure {
                font-size: 13px;
                color: #1a3f42;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 8px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

                .secure::before {
                    content: "🔒";
                    font-size: 14px;
                }

            .center-shell {
                max-width: 1140px;
                margin: 0 auto;
            }

            .steps {
                display: flex;
                justify-content: center;
                gap: 32px;
                align-items: center;
                margin: 10px 0 35px;
                flex-wrap: wrap;
            }

            .step {
                display: flex;
                align-items: center;
                gap: 10px;
                color: #8da3a6;
                font-size: 13px;
                font-weight: 500;
            }

                .step .circle {
                    width: 28px;
                    height: 28px;
                    border-radius: 50%;
                    border: 2px solid rgba(95, 181, 187, 0.25);
                    display: grid;
                    place-items: center;
                    color: #1a3f42;
                    font-weight: 700;
                    font-size: 12px;
                    background: #ffffff;
                    transition: all 0.3s ease;
                }

                .step.active {
                    color: #1a3f42;
                    font-weight: 600;
                }

                    .step.active .circle {
                        background: linear-gradient(135deg, #6abfc6, #50a2a8);
                        color: #ffffff;
                        border-color: transparent;
                        box-shadow: 0 4px 10px rgba(106, 191, 198, 0.3);
                    }

            .booking-grid {
                display: grid;
                grid-template-columns: 1.6fr 1fr;
                gap: 28px;
                align-items: start;
            }

            .panel {
                background: #ffffff;
                border: 1px solid rgba(95, 181, 187, 0.15);
                border-radius: 20px;
                box-shadow: 0 10px 30px rgba(26, 63, 66, 0.03);
                overflow: hidden;
            }

            .panel-pad {
                padding: 30px;
            }

            .field-label {
                display: block;
                font-size: 11px;
                font-weight: 800;
                color: #1a3f42;
                margin: 18px 0 8px;
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .panel-pad > .field-label:first-child {
                margin-top: 0;
            }

            .input {
                width: 100%;
                box-sizing: border-box;
                background: #fdfdfd;
                border: 1px solid rgba(95, 181, 187, 0.25);
                color: #333;
                outline: none;
                border-radius: 12px;
                height: 46px;
                padding: 0 16px;
                font-size: 14px;
                font-family: inherit;
                transition: all 0.25s ease;
            }

                .input:focus {
                    border-color: #6abfc6;
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(106, 191, 198, 0.12);
                }

            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }

            .main-btn, .secondary-btn {
                height: 48px;
                padding: 0 24px;
                border-radius: 14px;
                border: none;
                cursor: pointer;
                font-weight: 700;
                font-size: 14px;
                font-family: inherit;
                transition: all 0.2s ease;
            }

            .main-btn {
                background: linear-gradient(135deg, #6abfc6, #50a2a8);
                color: #ffffff;
                box-shadow: 0 5px 15px rgba(106, 191, 198, 0.3);
            }

                .main-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 7px 20px rgba(106, 191, 198, 0.45);
                }

            .secondary-btn {
                background: #fff;
                border: 1px solid rgba(95, 181, 187, 0.3);
                color: #4d7073;
            }

                .secondary-btn:hover {
                    background: #f7fbfb;
                    color: #1a3f42;
                }

            .btn-row {
                display: flex;
                gap: 16px;
                justify-content: space-between;
                margin-top: 28px;
                border-top: 1px solid rgba(95, 181, 187, 0.1);
                padding-top: 20px;
            }

            .payment-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
                gap: 12px;
                margin-bottom: 20px;
            }

            .payment-option {
                border: 1px solid rgba(95, 181, 187, 0.2);
                border-radius: 14px;
                padding: 14px;
                background: #fdfdfd;
                color: #617d80;
                cursor: pointer;
                transition: all 0.25s ease;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

                .payment-option:hover {
                    border-color: rgba(106, 191, 198, 0.5);
                    background: #fff;
                }

                .payment-option strong {
                    font-size: 14px;
                    color: #1a3f42;
                }

                .payment-option small {
                    font-size: 11px;
                    color: #8da3a6;
                }

                .payment-option.active {
                    border-color: #6abfc6;
                    background: rgba(106, 191, 198, 0.08);
                    box-shadow: 0 4px 12px rgba(106, 191, 198, 0.08);
                }

                    .payment-option.active strong {
                        color: #1a3f42;
                    }

            .summary-card {
                position: sticky;
                top: 105px;
            }

            .summary-photo {
                height: 190px;
                position: relative;
            }

            .summary-rating {
                position: absolute;
                top: 16px;
                right: 16px;
                background: rgba(26, 63, 66, 0.85);
                padding: 4px 10px;
                border-radius: 30px;
                font-size: 12px;
                color: #ffd166;
                font-weight: 700;
                backdrop-filter: blur(4px);
            }

            .summary-place {
                position: absolute;
                left: 20px;
                bottom: 20px;
                font-weight: 800;
                font-size: 22px;
                color: #fff;
                text-shadow: 0 2px 4px rgba(0,0,0,0.4);
            }

                .summary-place small {
                    display: block;
                    font-size: 12px;
                    color: #e6f7f8;
                    font-weight: 500;
                    margin-top: 4px;
                    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
                }

            .summary-body {
                padding: 24px;
            }

            .summary-title {
                color: #1a3f42;
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 18px;
                letter-spacing: 0.8px;
            }

            .summary-row {
                display: flex;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 12px;
                font-size: 13px;
                color: #617d80;
            }

                .summary-row strong {
                    color: #1a3f42;
                    font-weight: 600;
                }

            .price-line {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 20px;
                padding-top: 16px;
                border-top: 1px solid rgba(95, 181, 187, 0.15);
                color: #1a3f42;
                font-weight: 700;
                font-size: 14px;
            }

            .total {
                color: #1a3f42;
                font-size: 26px;
                font-weight: 800;
            }

            #cardFields, #bankFields, #ratesFields {
                animation: fadeIn 0.4s ease;
            }

            #cardFields {
                display: block;
            }

            #bankFields {
                display: none;
            }

            #ratesFields {
                display: none;
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(4px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 980px) {
                .booking-grid {
                    grid-template-columns: 1fr;
                    gap: 24px;
                }

                .summary-card {
                    position: static;
                }

                .topbar {
                    padding: 0 20px;
                }
            }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure">Sigurno Plaćanje</div>
    </div>

    <div class="page">
        <div class="center-shell">
            <div class="steps">
                <div class="step active"><div class="circle">✓</div>Detalji putovanja</div>
                <div class="step active"><div class="circle">✓</div>Putnici</div>
                <div class="step active"><div class="circle">3</div>Plaćanje</div>
                <div class="step"><div class="circle">4</div>Potvrda</div>
            </div>

            <div class="booking-grid">
                <div class="panel panel-pad">
                    <label class="field-label">ODABERITE NAČIN PLAĆANJA</label>
                    <div class="payment-grid">
                        <div class="payment-option active" onclick="selectPayment(this, 'card')">
                            <strong>Kartica</strong>
                            <small>Visa / Mastercard</small>
                        </div>
                        <div class="payment-option" onclick="selectPayment(this, 'bank')">
                            <strong>Bank transfer</strong>
                            <small>Uplata na račun</small>
                        </div>
                        <div class="payment-option" onclick="selectPayment(this, 'cash')">
                            <strong>Gotovina</strong>
                            <small>Na licu mjesta</small>
                        </div>
                        <div class="payment-option" onclick="selectPayment(this, 'rates')">
                            <strong>Rate</strong>
                            <small>Mjesečna otplata</small>
                        </div>
                    </div>

                    <div id="cardFields">
                        <label class="field-label">BROJ KARTICE</label>
                        <input class="input" id="cardNumber" placeholder="1234 5678 9012 3456">
                        <div class="row">
                            <div>
                                <label class="field-label">IME NA KARTICI</label>
                                <input class="input" id="cardName" placeholder="Ime i prezime">
                            </div>
                            <div>
                                <label class="field-label">CVV</label>
                                <input class="input" id="cardCvv" placeholder="123">
                            </div>
                        </div>
                        <div class="row">
                            <div>
                                <label class="field-label">ISTEK</label>
                                <input class="input" id="cardExpiry" placeholder="MM/GG">
                            </div>
                            <div>
                                <label class="field-label">POŠTANSKI BROJ</label>
                                <input class="input" id="billingZip" placeholder="71000">
                            </div>
                        </div>
                    </div>

                    <div id="bankFields">
                        <label class="field-label">PODACI ZA UPLATU</label>
                        <div class="panel" style="padding:18px; background: #fdfdfd; margin-bottom:16px; border-color: rgba(95,181,187,0.25);">
                            <div style="font-size:13px; line-height:1.9; color: #333;">
                                <div><strong>Primalac:</strong> InterTrips d.o.o.</div>
                                <div><strong>Banka:</strong> UniCredit Bank</div>
                                <div><strong>Račun:</strong> 154-1234567890-12</div>
                                <div><strong>IBAN:</strong> BA39 1541 2345 6789 0123</div>
                            </div>
                        </div>
                        <label class="field-label">UČITAJ POTVRDU (opcionalno)</label>
                        <input class="input" type="file" id="bankProof" style="padding-top: 10px;">
                    </div>

                    <div id="ratesFields">
                        <label class="field-label">NA KOLIKO MJESECI PLAĆATE?</label>
                        <input class="input" id="ratesMonths" type="number" min="1" max="60" placeholder="npr. 12">
                        <p id="ratesMessage" style="font-size:13px; color: #50a2a8; font-weight: 600; margin-top:8px;"></p>

                        <div id="ratesSubMethod" style="display:none; margin-top:18px; padding-top: 14px; border-top: 1px dashed rgba(95,181,187,0.2);">
                            <label class="field-label">ODABERITE NAČIN PLAĆANJA RATA</label>
                            <div style="display:flex; flex-direction:column; gap:12px; margin-top: 8px;">
                                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; color:#1a3f42; font-size:13px; font-weight:500;">
                                    <input type="radio" name="rateSubMethod" value="Karticom" checked onchange="onRateSubMethodChange()" style="accent-color: #6abfc6; transform: scale(1.1);" />
                                    Karticom
                                </label>
                                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; color:#1a3f42; font-size:13px; font-weight:500;">
                                    <input type="radio" name="rateSubMethod" value="Gotovinom" onchange="onRateSubMethodChange()" style="accent-color: #6abfc6; transform: scale(1.1);" />
                                    Gotovinom
                                </label>
                                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; color:#1a3f42; font-size:13px; font-weight:500;">
                                    <input type="radio" name="rateSubMethod" value="Bankovni transfer" onchange="onRateSubMethodChange()" style="accent-color: #6abfc6; transform: scale(1.1);" />
                                    Bankovni transfer
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="secondary-btn" type="button" onclick="history.back()">← Nazad</button>
                        <button class="main-btn" type="button" onclick="payNow()">Plati sada</button>
                    </div>
                </div>

                <div>
                    <div class="panel summary-card">
                        <div class="summary-photo" id="summaryPhoto">
                            <div class="summary-rating">★ 4.8</div>
                            <div class="summary-place" id="summaryDest">Destinacija <small id="summaryCountry">—</small></div>
                        </div>
                        <div class="summary-body">
                            <div class="summary-title">SAŽETAK REZERVACIJE</div>
                            <div class="summary-row"><span>Polazak</span><strong id="summaryDeparture">—</strong></div>
                            <div class="summary-row"><span>Povratak</span><strong id="summaryReturn">—</strong></div>
                            <div class="summary-row"><span>Trajanje</span><strong id="summaryDuration">—</strong></div>
                            <div class="summary-row"><span>Putnici</span><strong id="summaryTravelers">—</strong></div>
                            <div class="summary-row"><span>Smještaj</span><strong id="summaryRoom">—</strong></div>
                            <div style="margin-top: 15px; margin-bottom: 15px; padding-top: 10px; border-top: 1px dashed rgba(95, 181, 187, 0.15);">
                                <label class="field-label" style="margin-top: 0; margin-bottom: 6px;">PROMO KOD / KUPON</label>
                                <div style="display: flex; gap: 8px;">
                                    <input class="input" id="couponCode" placeholder="Unesite kod" style="height: 38px; font-size: 13px;">
                                    <button class="main-btn" type="button" onclick="applyCoupon()" style="height: 38px; padding: 0 16px; border-radius: 12px; font-size: 13px; white-space: nowrap;">Primijeni</button>
                                </div>
                                <p id="couponMessage" style="font-size: 12px; margin-top: 6px; font-weight: 500; display: none;"></p>
                            </div>

                            <div class="price-line">
                                <span>Ukupno</span>
                                <span class="total" id="summaryTotal">$0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        let selectedPaymentType = 'card';

        function selectPayment(el, type) {
        selectedPaymentType = type;

        document.querySelectorAll('.payment-option').forEach(x => x.classList.remove('active'));
        el.classList.add('active');

        document.getElementById('ratesFields').style.display = (type === 'rates') ? 'block' : 'none';

        if (type === 'card') {
        document.getElementById('cardFields').style.display = 'block';
        document.getElementById('bankFields').style.display = 'none';
        } else if (type === 'bank') {
        document.getElementById('cardFields').style.display = 'none';
        document.getElementById('bankFields').style.display = 'block';
        } else if (type === 'cash') {
        document.getElementById('cardFields').style.display = 'none';
        document.getElementById('bankFields').style.display = 'none';
        } else if (type === 'rates') {
        const msg = document.getElementById('ratesMessage');
        if (msg) msg.textContent = '';
        updateRatesPreview();
        onRateSubMethodChange();
        }

        if (type !== 'rates') {
        const subWrap = document.getElementById('ratesSubMethod');
        if (subWrap) subWrap.style.display = 'none';
        }
        }

        function onRateSubMethodChange() {
        const checked = document.querySelector('input[name="rateSubMethod"]:checked');
        const subMethod = checked ? checked.value : 'Karticom';

        // Polja za karticu se prikazuju isključivo ako su izabrane rate i pod-metoda je 'Karticom'
        if (subMethod === 'Karticom' && selectedPaymentType === 'rates') {
        document.getElementById('cardFields').style.display = 'block';
        } else if (selectedPaymentType === 'rates') {
        document.getElementById('cardFields').style.display = 'none';
        }
        }

        function parseTotalKM(raw) {
        if (!raw) return 0;
        let s = String(raw).trim();
        s = s.replace(/KM/gi, '').replace(/\$/g, '').replace(/\s/g, '');
        if (s.includes('.') && s.includes(',')) {
        s = s.replace(/\./g, '');
        s = s.replace(',', '.');
        } else if (s.includes(',')) {
        s = s.replace(/,/g, '');
        } else if (s.includes('.')) {
        const parts = s.split('.');
        if (parts.length > 1 && parts[parts.length - 1].length === 3) {
        s = s.replace(/\./g, '');
        }
        }

        s = s.replace(/[^0-9.]/g, '');
        const n = parseFloat(s);
        return isNaN(n) ? 0 : n;
        }

        function updateRatesPreview() {
        const monthsEl = document.getElementById('ratesMonths');
        const msgEl = document.getElementById('ratesMessage');
        const subWrap = document.getElementById('ratesSubMethod');

        if (!monthsEl || !msgEl) return;
        if (!monthsEl.value) { msgEl.textContent = ''; if (subWrap) subWrap.style.display = 'none'; return; }

        const months = parseInt(monthsEl.value, 10);
        const totalRaw = localStorage.getItem('reservationTotal') || '0';
        const total = parseTotalKM(totalRaw);

        if (isNaN(months) || months < 1 || months > 60) {
        msgEl.textContent = 'Unesite broj mjeseci od 1 do 60.';
        if (subWrap) subWrap.style.display = 'none';
        return;
        }

        if (!total || total <= 0) {
        msgEl.textContent = 'Ukupan iznos nije ispravno postavljen.';
        return;
        }

        const rata = (total / months).toFixed(2);
        msgEl.textContent = `Vaša rata iznosi: ${rata} KM mjesečno za ${months} mjeseci.`;

        if (subWrap) subWrap.style.display = 'block';

        localStorage.setItem('ratesMonths', String(months));
        localStorage.setItem('ratesMonthly', String(rata));
        }

        function loadPaymentSummary() {
        const dest = localStorage.getItem('reservationDestination') || 'Destinacija';
        const country = localStorage.getItem('reservationCountry') || '—';
        const image = localStorage.getItem('reservationImage') || '/assets/bali.jpg';

        document.getElementById('summaryDest').innerHTML = `${dest} <small>${country}</small>`;
        document.getElementById('summaryDeparture').textContent = localStorage.getItem('reservationDeparture') || '—';
        document.getElementById('summaryReturn').textContent = localStorage.getItem('reservationReturn') || '—';
        document.getElementById('summaryDuration').textContent = localStorage.getItem('reservationDuration') || '—';
        document.getElementById('summaryTravelers').textContent = localStorage.getItem('reservationTravelers') || '—';
        document.getElementById('summaryRoom').textContent = localStorage.getItem('reservationRoom') || '—';
        document.getElementById('summaryTotal').textContent = localStorage.getItem('reservationTotal') || '$0';

        const photo = document.getElementById('summaryPhoto');
        if (photo) {
        photo.style.background = `linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.4)), url('${image}') center/cover no-repeat`;
        }
        }

        async function currentUserKey() {
        try {
        const res = await fetch('/Account/Me', { credentials: 'same-origin' });
        if (!res.ok) return 'guest';
        const me = await res.json();
        return me.userName || 'guest';
        } catch (e) {
        return 'guest';
        }
        }

        async function saveReservationToHistory(resCode) {
        const reservations = JSON.parse(localStorage.getItem('reservations') || '[]');
        const u = await currentUserKey();

        const reservation = {
        id: resCode,
        userName: u,
        createdAt: new Date().toISOString(),
        status: 'Aktivna',
        paketId: localStorage.getItem('reservationPaketId') || '',
        destination: localStorage.getItem('reservationDestination'),
        country: localStorage.getItem('reservationCountry'),
        departure: localStorage.getItem('reservationDeparture'),
        return: localStorage.getItem('reservationReturn'),
        travelers: localStorage.getItem('reservationTravelers'),
        room: localStorage.getItem('reservationRoom'),
        total: localStorage.getItem('reservationTotal'),
        paymentType: localStorage.getItem('paymentType'),
        passengers: JSON.parse(localStorage.getItem('savedPassengers') || '[]'),
        ratesMonths: localStorage.getItem('ratesMonths'),
        ratesMonthly: localStorage.getItem('ratesMonthly')
        };
        reservations.unshift(reservation);
        localStorage.setItem('reservations', JSON.stringify(reservations));
        }

        async function payNow() {
        function isCardExpired(expiryString) {
        if (!expiryString || !expiryString.includes('/')) return true;
        const parts = expiryString.split('/');
        if (parts.length !== 2) return true;

        const inputMonth = parseInt(parts[0], 10);
        const inputYear = parseInt('20' + parts[1], 10);

        if (isNaN(inputMonth) || isNaN(inputYear)) return true;

        const now = new Date();
        const currentMonth = now.getMonth() + 1;
        const currentYear = now.getFullYear();

        if (inputYear < currentYear) return true;
        if (inputYear === currentYear && inputMonth < currentMonth) return true;

        return false;
        }

        if (selectedPaymentType === 'card') {
        const cardName = document.getElementById('cardName').value.trim();
        const cardNumber = document.getElementById('cardNumber').value.trim();
        const cardExpiry = document.getElementById('cardExpiry') ? document.getElementById('cardExpiry').value.trim() : '';

        const cvvEl = document.getElementById('cardCvv');
        const zipEl = document.getElementById('billingZip');
        const cardCvv = cvvEl ? cvvEl.value.trim() : '';
        const billingZip = zipEl ? zipEl.value.trim() : '';

        if (!cardName || !cardNumber || isCardExpired(cardExpiry) || cardCvv.length !== 3 || billingZip.length !== 5) {
        window.location.href = "/Placanje/Neuspjeh?razlog=" + encodeURIComponent("Kartica je odbijena (nevalidni podaci, CVV ili poštanski broj).");
        return;
        }
        }

        if (selectedPaymentType === 'bank') {
        const day = new Date().getDay();
        if (day === 0 || day === 6) {
        window.location.href = "/Placanje/Neuspjeh?razlog=" + encodeURIComponent("Banka ne radi subotom i nedjeljom.");
        return;
        }
        }

        if (selectedPaymentType === 'rates') {
        const monthsVal = document.getElementById('ratesMonths').value;
        const months = parseInt(monthsVal, 10);
        const checked = document.querySelector('input[name="rateSubMethod"]:checked');
        const subMethod = checked ? checked.value : 'Karticom';

        if (!monthsVal || isNaN(months) || months < 1 || months > 60) {
        alert("Unesite validan broj mjeseci (1-60).");
        return;
        }

        if (subMethod === 'Karticom') {
        const cardName = document.getElementById('cardName').value.trim();
        const cardNumber = document.getElementById('cardNumber').value.trim();
        const cardExpiry = document.getElementById('cardExpiry') ? document.getElementById('cardExpiry').value.trim() : '';

        const cvvEl = document.getElementById('cardCvv');
        const zipEl = document.getElementById('billingZip');
        const cardCvv = cvvEl ? cvvEl.value.trim() : '';
        const billingZip = zipEl ? zipEl.value.trim() : '';

        if (!cardName || !cardNumber || isCardExpired(cardExpiry) || cardCvv.length !== 3 || billingZip.length !== 5) {
        window.location.href = "/Placanje/Neuspjeh?razlog=" + encodeURIComponent("Kartica je odbijena (nevalidni podaci, CVV ili poštanski broj za plaćanje na rate).");
        return;
        }
        }

        if (subMethod === 'Bankovni transfer') {
        const day = new Date().getDay();
        if (day === 0 || day === 6) {
        window.location.href = "/Placanje/Neuspjeh?razlog=" + encodeURIComponent("Banka ne radi subotom i nedjeljom.");
        return;
        }
        }

        localStorage.setItem('paymentType', 'Na rate (' + subMethod + ')');
        } else {
        localStorage.setItem('paymentType', selectedPaymentType === 'card' ? 'Kartica' : (selectedPaymentType === 'cash' ? 'Gotovina' : 'Bankovni prenos'));
        localStorage.removeItem('ratesMonths');
        localStorage.removeItem('ratesMonthly');
        }

        const urlParams = new URLSearchParams(window.location.search);
        const paketId = urlParams.get('paketId') || localStorage.getItem('reservationPaketId') || '1';
        localStorage.setItem('selectedPackageId', paketId);

        const resCode = 'IT-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('finalReservationCode', resCode);
        await saveReservationToHistory(resCode);

        window.location.href = "/Placanje/Uspjeh";
        }

        window.addEventListener('DOMContentLoaded', function () {
        loadPaymentSummary();

        document.getElementById('cardFields').style.display = 'block';
        document.getElementById('bankFields').style.display = 'none';
        document.getElementById('ratesFields').style.display = 'none';

        const monthsEl = document.getElementById('ratesMonths');
        if (monthsEl) {
        monthsEl.addEventListener('input', updateRatesPreview);
        monthsEl.addEventListener('change', updateRatesPreview);
        }

        const cardNumberEl = document.getElementById('cardNumber');
        const expiryEl = document.getElementById('cardExpiry');
        const cvvEl = document.getElementById('cardCvv');
        const zipEl = document.getElementById('billingZip');

        if (cardNumberEl) {
        cardNumberEl.setAttribute('inputmode', 'numeric');
        cardNumberEl.setAttribute('autocomplete', 'cc-number');
        cardNumberEl.maxLength = 19;
        cardNumberEl.addEventListener('input', () => {
        let digits = cardNumberEl.value.replace(/\D/g, '').slice(0, 16);
        const parts = digits.match(/.{1,4}/g) || [];
        cardNumberEl.value = parts.join(' ');

        if (digits.length === 16 && expiryEl) {
        expiryEl.focus();
        }
        });
        }

        if (expiryEl) {
        expiryEl.setAttribute('inputmode', 'numeric');
        expiryEl.setAttribute('autocomplete', 'cc-exp');
        expiryEl.maxLength = 5;

        expiryEl.addEventListener('input', () => {
        let digits = expiryEl.value.replace(/\D/g, '').slice(0, 4);

        if (digits.length >= 2) {
        let mm = parseInt(digits.slice(0, 2), 10);
        if (isNaN(mm) || mm <= 0) mm = 1;
        if (mm > 12) mm = 12;

        const mmStr = String(mm).padStart(2, '0');
        const rest = digits.slice(2);
        expiryEl.value = rest ? `${mmStr}/${rest}` : mmStr;
        } else {
        expiryEl.value = digits;
        }

        if (expiryEl.value.length === 5) {
        const parts = expiryEl.value.split('/');
        const inputMonth = parseInt(parts[0], 10);
        const inputYear = parseInt('20' + parts[1], 10);
        const now = new Date();
        const currentMonth = now.getMonth() + 1;
        const currentYear = now.getFullYear();

        if (inputYear < currentYear || (inputYear === currentYear && inputMonth < currentMonth)) {
        expiryEl.style.borderColor = 'red';
        } else {
        expiryEl.style.borderColor = '';
        }
        } else {
        expiryEl.style.borderColor = '';
        }
        });
        }

        if (cvvEl) {
        cvvEl.setAttribute('inputmode', 'numeric');
        cvvEl.maxLength = 3;
        cvvEl.addEventListener('input', () => {
        cvvEl.value = cvvEl.value.replace(/\D/g, '');
        });
        }

        if (zipEl) {
        zipEl.setAttribute('inputmode', 'numeric');
        zipEl.maxLength = 5;
        zipEl.addEventListener('input', () => {
        zipEl.value = zipEl.value.replace(/\D/g, '');
        });
        }
        });

        function applyCoupon() {
        const codeInput = document.getElementById('couponCode');
        const msgEl = document.getElementById('couponMessage');
        const totalEl = document.getElementById('summaryTotal');

        if (!codeInput || !msgEl || !totalEl) return;

        const unesenKod = codeInput.value.trim().toUpperCase();
        const totalRaw = localStorage.getItem('reservationTotal') || '0';
        let trenutnaCijena = parseTotalKM(totalRaw);

        if (unesenKod === "INTERTRIPS10") {
        let popust = trenutnaCijena * 0.10;
        let novaCijena = trenutnaCijena - popust;

        totalEl.textContent = `${novaCijena.toFixed(2)} KM`;
        msgEl.style.color = "#2b8a3e";
        msgEl.textContent = `Kupon uspješno primijenjen! Ušteđeno: ${popust.toFixed(2)} KM (10%).`;
        msgEl.style.display = "block";

        localStorage.setItem('reservationTotal', `${novaCijena.toFixed(2)} KM`);
        if (selectedPaymentType === 'rates') {
        updateRatesPreview();
        }
        } else if (unesenKod === "") {
        msgEl.style.color = "#cc5c5c";
        msgEl.textContent = "Molimo unesite kod kupona.";
        msgEl.style.display = "block";
        } else {
        msgEl.style.color = "#cc5c5c";
        msgEl.textContent = "Uneseni kupon nije validan ili je istekao.";
        msgEl.style.display = "block";
        }
        }
    </script>
</body>
</html>