@model InterTrips___Turistička_Agencija.Models.ViewModels.AdminRezervacijeVm
@{
    ViewData["Title"] = "Admin - Rezervacije korisnika";
    Layout = null;

    var danas = DateOnly.FromDateTime(DateTime.Today);

    var aktivneRezervacije = Model.Rezervacije?
        .Where(r => r.Paket == null || r.DatumPolaska.AddDays(r.Paket.TrajanjeNoci) > danas)
        .ToList();
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --primary: #0ea5e9;
                --danger: #ef4444;
            }

            .nav-item i {
                width: 20px;
                margin-right: 12px;
                font-size: 16px;
                text-align: center;
                transition: color 0.2s ease;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 0 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                color: #fff;
                text-decoration: none;
                font-weight: 700;
                font-size: 20px;
            }

            .sidebar .logo {
                height: 36px;
                object-fit: contain;
                filter: brightness(0) invert(1);
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1350px;
                width: calc(100% - 260px);
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 6px;
                    line-height: 1.5;
                }

            .btn-secondary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 38px;
                padding: 0 16px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                color: #475569;
                background: #fff;
                border: 1px solid var(--border);
                text-decoration: none;
                transition: all 0.15s ease;
            }

                .btn-secondary:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                    color: var(--text-dark);
                }

            .table-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                padding: 24px 32px 32px 32px;
            }

                .table-card h2 {
                    font-size: 16px;
                    font-weight: 600;
                    color: var(--text-dark);
                    margin-bottom: 20px;
                    padding-bottom: 4px;
                }

            .table-container {
                overflow-x: auto;
                margin: 0 -32px -32px -32px;
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 14px;
            }

                .custom-table th {
                    background: #f8fafc;
                    color: #475569;
                    font-weight: 600;
                    padding: 14px 32px;
                    border-bottom: 1px solid var(--border);
                    border-top: 1px solid var(--border);
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    font-size: 11px;
                }

                .custom-table td {
                    padding: 16px 32px;
                    border-bottom: 1px solid var(--border);
                    color: #334155;
                    vertical-align: middle;
                }

                .custom-table tr:last-child td {
                    border-bottom: none;
                }

                .custom-table tr:hover {
                    background: #f8fafc;
                }

            .res-id {
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                background: #f1f5f9;
                padding: 4px 8px;
                border-radius: 4px;
                color: #475569;
                font-size: 12px;
                font-weight: 600;
            }

            .user-email {
                font-weight: 500;
                color: var(--text-dark);
            }

            .package-title {
                font-weight: 600;
                color: var(--text-dark);
                display: block;
            }

            .destination-text {
                font-size: 13px;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .pax-badge {
                background: #f1f5f9;
                color: #334155;
                padding: 4px 8px;
                border-radius: 4px;
                font-weight: 600;
                font-size: 12px;
                display: inline-block;
            }

            .status-pill {
                display: inline-flex;
                align-items: center;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                background: #f0fdf4;
                color: #166534;
                border: 1px solid #bbf7d0;
                text-transform: capitalize;
            }

            .badge {
                display: inline-flex;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                background: #e0f2fe;
                color: #0369a1;
                margin-bottom: 8px;
            }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-links span {
                        display: none;
                    }

                    .sidebar .nav-item i {
                        margin-right: 0;
                        font-size: 18px;
                    }

                .logout-btn-nav {
                    padding: 10px 0;
                    font-size: 0;
                }

                    .logout-btn-nav::before {
                        content: "\f2f5";
                        font-family: "Font Awesome 6 Free";
                        font-weight: 900;
                        font-size: 16px;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                    width: calc(100% - 70px);
                }
            }

            @@media (max-width: 900px) {
                .dash-header {
                    flex-direction: column;
                    gap: 16px;
                }

                .table-card {
                    padding: 20px;
                }

                .table-container {
                    margin: 0 -20px -20px -20px;
                }

                .custom-table th, .custom-table td {
                    padding: 14px 20px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a asp-controller="Home" asp-action="Index" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a asp-controller="Administrator" asp-action="Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a asp-controller="Administrator" asp-action="Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a asp-controller="Administrator" asp-action="Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a asp-controller="Administrator" asp-action="Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a asp-controller="Administrator" asp-action="Rezervacije" class="nav-item active">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit" title="Odjavi se">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">

        <header class="dash-header">
            <div>
                <span class="badge">Sistemski Logovi</span>
                <h1>Rezervacije korisnika</h1>
                <p>Detaljan pregled, monitoring i evidencija svih aktivnih, potvrđenih i realizovanih aranžmana u bazi agencije.</p>
            </div>
            <a asp-controller="Destinacije" asp-action="Index" class="btn-secondary" target="_blank">👁️ Pregledaj sajt</a>
        </header>

        <div class="table-card">
            <h2>Lista prijavljenih putovanja</h2>

            @if (aktivneRezervacije == null || !aktivneRezervacije.Any())
            {
                <div style="text-align:center; padding: 48px; color: var(--text-muted); font-size: 14px; border: 1px dashed var(--border); border-radius: 8px;">
                    Trenutno nema aktivnih evidentiranih rezervacija u sistemu za korisnika <strong style="color: var(--text-dark);">@Model.KorisnikEmail</strong>.
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>ID Rezervacije</th>
                                <th>Korisnik (Email)</th>
                                <th>Paket / Aranžman</th>
                                <th>Destinacija</th>
                                <th>Broj Putnika</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in aktivneRezervacije)
                            {
                                <tr>
                                    <td><span class="res-id">#@r.Id</span></td>

                                    <td>
                                        <span class="user-email">
                                            @(r.Korisnik != null ? r.Korisnik.Email : "ID: " + r.KorisnikId)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="package-title">@(r.Paket?.Naziv ?? "Nespecificirano")</span>
                                    </td>

                                    <td>
                                        <div class="destination-text">
                                            @(r.Paket?.Destinacija != null ? $"{r.Paket.Destinacija.Naziv} ({r.Paket.Destinacija.Drzava})" : "—")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="pax-badge">
                                            @(r.Putnici != null && r.Putnici.Any() ? r.Putnici.Count : 1) PAX
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-pill">@r.Status.ToString().ToLower()</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

</body>
</html>