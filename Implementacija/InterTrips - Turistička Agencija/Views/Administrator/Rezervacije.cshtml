@model InterTrips___Turistička_Agencija.Models.ViewModels.AdminRezervacijeVm
@{
    ViewData["Title"] = "Admin - Rezervacije korisnika";
    Layout = null;

    var danas = DateTime.Today;

    var aktivneRezervacije = Model.Rezervacije?
        .Where(r => r.Paket == null || r.DatumPolaska.AddDays(r.Paket?.TrajanjeNoci ?? 0) > danas)
        .ToList();
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --danger: #ef4444;
                --secondary: #475569;
            }

            .nav-item i {
                width: 20px;
                margin-right: 12px;
                font-size: 16px;
                text-align: center;
                transition: color 0.2s ease;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 0 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                color: #fff;
                text-decoration: none;
                font-weight: 700;
                font-size: 20px;
            }

            .sidebar .logo {
                height: 36px;
                object-fit: contain;
                filter: brightness(0) invert(1);
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1350px;
                width: calc(100% - 260px);
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 6px;
                    line-height: 1.5;
                }

            .btn-secondary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 38px;
                padding: 0 16px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                color: #475569;
                background: #fff;
                border: 1px solid var(--border);
                text-decoration: none;
                transition: all 0.15s ease;
            }

                .btn-secondary:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                    color: var(--text-dark);
                }

            .btn-info {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                background-color: var(--primary);
                color: #fff;
                border: none;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition: background 0.15s;
            }

                .btn-info:hover {
                    background-color: var(--primary-hover);
                }

            .btn-pogledaj-detalje {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                background-color: var(--primary);
                color: #fff;
                border: none;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition: background 0.15s;
            }

                .btn-pogledaj-detalje:hover {
                    background-color: var(--primary-hover);
                }

            .table-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                padding: 24px 32px 32px 32px;
            }

                .table-card h2 {
                    font-size: 16px;
                    font-weight: 600;
                    color: var(--text-dark);
                    margin-bottom: 20px;
                    padding-bottom: 4px;
                }

            .table-container {
                overflow-x: auto;
                margin: 0 -32px -32px -32px;
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 14px;
            }

                .custom-table th {
                    background: #f8fafc;
                    color: #475569;
                    font-weight: 600;
                    padding: 14px 32px;
                    border-bottom: 1px solid var(--border);
                    border-top: 1px solid var(--border);
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    font-size: 11px;
                }

                .custom-table td {
                    padding: 16px 32px;
                    border-bottom: 1px solid var(--border);
                    color: #334155;
                    vertical-align: middle;
                }

                .custom-table tr:last-child td {
                    border-bottom: none;
                }

                .custom-table tr:hover {
                    background: #f8fafc;
                }

            .res-id {
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                background: #f1f5f9;
                padding: 4px 8px;
                border-radius: 4px;
                color: #475569;
                font-size: 12px;
                font-weight: 600;
            }

            .user-email {
                font-weight: 500;
                color: var(--text-dark);
            }

            .package-title {
                font-weight: 600;
                color: var(--text-dark);
                display: block;
            }

            .destination-text {
                font-size: 13px;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .pax-badge {
                background: #f1f5f9;
                color: #334155;
                padding: 4px 8px;
                border-radius: 4px;
                font-weight: 600;
                font-size: 12px;
                display: inline-block;
            }

            .status-pill {
                display: inline-flex;
                align-items: center;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                background: #f0fdf4;
                color: #166534;
                border: 1px solid #bbf7d0;
                text-transform: capitalize;
            }

            .badge {
                display: inline-flex;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                background: #e0f2fe;
                color: #0369a1;
                margin-bottom: 8px;
            }

            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(4px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 1000;
                opacity: 0;
                visibility: hidden;
                transition: all 0.25s ease;
            }

                .modal-overlay.active {
                    opacity: 1;
                    visibility: visible;
                }

            .modal-box {
                background: #fff;
                width: 100%;
                max-width: 650px;
                border-radius: 12px;
                box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
                overflow: hidden;
                transform: scale(0.95);
                transition: transform 0.25s ease;
            }

            .modal-overlay.active .modal-box {
                transform: scale(1);
            }

            .modal-header {
                padding: 20px 24px;
                background: #f8fafc;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .modal-header h3 {
                    font-size: 16px;
                    font-weight: 700;
                    color: var(--text-dark);
                }

            .close-modal {
                background: transparent;
                border: none;
                font-size: 18px;
                color: var(--text-muted);
                cursor: pointer;
            }

                .close-modal:hover {
                    color: var(--danger);
                }

            .modal-body {
                padding: 24px;
                max-height: 70vh;
                overflow-y: auto;
            }

            .details-section {
                margin-bottom: 20px;
            }

                .details-section h4 {
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    color: var(--primary);
                    margin-bottom: 10px;
                    border-bottom: 1px solid #f1f5f9;
                    padding-bottom: 4px;
                }

            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .info-item {
                font-size: 13px;
            }

            .info-label {
                color: var(--text-muted);
                margin-bottom: 2px;
                font-size: 11px;
                text-transform: uppercase;
            }

            .info-value {
                font-weight: 600;
                color: var(--text-dark);
            }

            .passengers-list {
                background: #f8fafc;
                border-radius: 8px;
                padding: 12px;
                border: 1px solid var(--border);
            }

            .passenger-row {
                font-size: 13px;
                padding: 6px 0;
                border-bottom: 1px solid #f1f5f9;
                display: flex;
                justify-content: space-between;
            }

                .passenger-row:last-child {
                    border-bottom: none;
                }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-links span {
                        display: none;
                    }

                    .sidebar .nav-item i {
                        margin-right: 0;
                        font-size: 18px;
                    }

                .logout-btn-nav {
                    padding: 10px 0;
                    font-size: 0;
                }

                    .logout-btn-nav::before {
                        content: "\f2f5";
                        font-family: "Font Awesome 6 Free";
                        font-weight: 900;
                        font-size: 16px;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                    width: calc(100% - 70px);
                }
            }

            @@media (max-width: 900px) {
                .dash-header {
                    flex-direction: column;
                    gap: 16px;
                }

                .table-card {
                    padding: 20px;
                }

                .table-container {
                    margin: 0 -20px -20px -20px;
                }

                .custom-table th, .custom-table td {
                    padding: 14px 20px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a asp-controller="Home" asp-action="Index" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a asp-controller="Administrator" asp-action="Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a asp-controller="Administrator" asp-action="Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a asp-controller="Administrator" asp-action="Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a asp-controller="Administrator" asp-action="Rezervacije" class="nav-item active">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> Izvještaji
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit" title="Odjavi se">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">
        <header class="dash-header">
            <div>
                <span class="badge">Sistemski Evidencija</span>
                <h1>Rezervacije korisnika</h1>
                <p>Detaljan pregled, monitoring i evidencija svih aktivnih, potvrđenih i potvrđenih aranžmana u bazi agencije.</p>
            </div>
            <a asp-controller="Destinacije" asp-action="Index" class="btn-secondary" target="_blank">👁️ Pregledaj sajt</a>
        </header>

        <div class="table-card">
            <h2>Lista prijavljenih putovanja</h2>

            @if (aktivneRezervacije == null || !aktivneRezervacije.Any())
            {
                <div style="text-align:center; padding: 48px; color: var(--text-muted); font-size: 14px; border: 1px dashed var(--border); border-radius: 8px;">
                    Trenutno nema aktivnih rezervacija u sistemu za korisnika <strong style="color: var(--text-dark);">@(Model?.KorisnikEmail ?? "Nespecificirano")</strong>.
                </div>
            }
            else
            {
                <div class="table-container" style="overflow-x: auto; width: 100%;">
                    <table class="custom-table" style="width: 100%; table-layout: fixed;">
                        <thead>
                            <tr>
                                <th style="width: 100px;">ID Rezervacije</th>
                                <th style="width: 200px;">Korisnik (Email)</th>
                                <th style="width: 200px;">Paket / Aranžman</th>
                                <th style="width: 180px;">Destinacija</th>
                                <th style="width: 110px;">Broj Putnika</th>
                                <th style="width: 120px;">Status</th>
                                <th style="text-align: right; width: 110px;">Akcije</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in aktivneRezervacije)
                            {
                                if (r == null) continue;
                                <tr>
                                    <td><span class="res-id">#@r.Id</span></td>

                                    <td style="word-break: break-all;">
                                        <span class="user-email">
                                            @(r.Korisnik != null ? r.Korisnik.Email : (!string.IsNullOrEmpty(r.KorisnikId) ? "ID: " + r.KorisnikId : "Gost"))
                                        </span>
                                    </td>

                                    <td style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@(r.Paket?.Naziv)">
                                        <span class="package-title">@(r.Paket?.Naziv ?? "Nespecificirano")</span>
                                    </td>

                                    <td style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <div class="destination-text">
                                            @(r.Paket?.Destinacija != null ? $"{r.Paket.Destinacija.Naziv} ({r.Paket.Destinacija.Drzava})" : "—")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="pax-badge">
                                            @(r.Putnici != null && r.Putnici.Any() ? r.Putnici.Count : 1) PAX
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-pill">@(r.Status != null ? r.Status.ToString().ToLower() : "nepoznato")</span>
                                    </td>

                                    <td style="text-align: right;">
                                        @{
                                            var putniciList = r.Putnici?.Select(p => (object)new
                                            {
                                                Ime = p.Ime ?? "",
                                                Prezime = p.Prezime ?? "",
                                                BrojPasosa = p.BrojPasosa ?? "—",
                                                Drzavljanstvo = p.Drzavljanstvo ?? "—",
                                                Telefon = p.Telefon ?? "—",
                                                DatumRodjenja = p.DatumRodjenja != null ? p.DatumRodjenja.ToString("dd.MM.yyyy") : "—",
                                                PosebniZahtjevi = p.PosebniZahtjevi ?? ""
                                            }).ToList() ?? new List<object>();

                                            var jsonPutnici = System.Text.Json.JsonSerializer.Serialize(putniciList);
                                            string tipPrevoza = (r.Paket?.Let != null) ? "Avion" : "Autobus";

                                        }
                                        <button class="btn-pogledaj-detalje"
                                                data-id="@r.Id"
                                                data-email="@(r.Korisnik?.Email ?? "Nepoznato")"
                                                data-status="@(r.Status != null ? r.Status.ToString() : "Nepoznato")"
                                                data-paket="@(r.Paket?.Naziv ?? "Nespecificirano")"
                                                data-destinacija="@(r.Paket?.Destinacija != null ? $"{r.Paket.Destinacija.Naziv}, {r.Paket.Destinacija.Drzava}" : "—")"
                                                data-polazak="@(r.DatumPolaska != DateTime.MinValue ? r.DatumPolaska.ToString("dd.MM.yyyy") : "—")"
                                                data-povratak="@(r.Paket != null && r.DatumPolaska != DateTime.MinValue ? r.DatumPolaska.AddDays(r.Paket.TrajanjeNoci).ToString("dd.MM.yyyy") : "—")"
                                                data-hotel="@(r.Paket?.Hotel != null ? r.Paket.Hotel.Naziv : "Nije uključeno")"
                                                data-hotelid="@(r.Paket?.Hotel != null ? r.Paket.Hotel.Id : 0)"
                                                data-let="@(r.Paket?.Let != null ? $"{r.Paket.Let.Aviokompanija} ({r.Paket.Let.BrojLeta})" : "Nije uključeno")"
                                                data-prevoz="@tipPrevoza"
                                                data-putnici="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(jsonPutnici))"
                                                style="cursor: pointer;">
                                            <i class="fa-solid fa-eye"></i> Detalji
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

    <div class="modal-overlay" id="detaljiModalOverlay">
        <div class="modal-box" style="max-width: 750px;">
            <div class="modal-header">
                <h3>Detalji rezervacije <span id="modalResId"></span></h3>
                <button class="close-modal" id="btnZatvoriModal"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">

                <div class="details-section">
                    <h4>Osnovne Informacije</h4>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Korisnik (Kupac)</div>
                            <div class="info-value" id="modalKorisnik"></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Status rezervacije</div>
                            <div class="info-value" id="modalStatus"></div>
                        </div>
                    </div>
                </div>

                <div class="details-section">
                    <h4>Aranžman & Destinacija</h4>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Naziv Paketa</div>
                            <div class="info-value" id="modalPaket"></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Lokacija</div>
                            <div class="info-value" id="modalDestinacija"></div>
                        </div>
                        <div class="info-item" style="margin-top: 8px;">
                            <div class="info-label">Datum polaska</div>
                            <div class="info-value" id="modalPolazak"></div>
                        </div>
                        <div class="info-item" style="margin-top: 8px;">
                            <div class="info-label">Datum povratka</div>
                            <div class="info-value" id="modalPovratak"></div>
                        </div>
                    </div>
                </div>

                <div class="details-section">
                    <h4>Logistika</h4>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Smještaj (Hotel)</div>
                            <div class="info-value">
                                <span id="modalHotelNaziv"></span>
                                <a id="modalHotelLink" href="#" class="btn-mini-link" style="display:none; margin-left: 10px; color: #0ea5e9; text-decoration: underline; font-size: 13px; font-weight: 600;">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Pogledaj detalje hotela
                                </a>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Vrsta prevoza</div>
                            <div class="info-value" id="modalPrevoz"></div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">Informacije o letu</div>
                            <div class="info-value" id="modalLet"></div>
                        </div>
                    </div>
                </div>

                <div class="details-section">
                    <h4>Prijavljeni putnici</h4>
                    <div class="passengers-list" id="modalPutniciLista" style="display: flex; flex-direction: column; gap: 12px;">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modalOverlay = document.getElementById("detaljiModalOverlay");
                const btnZatvori = document.getElementById("btnZatvoriModal");
                const detaljiButtons = document.querySelectorAll(".btn-pogledaj-detalje");

                const modalResId = document.getElementById("modalResId");
                const modalKorisnik = document.getElementById("modalKorisnik");
                const modalStatus = document.getElementById("modalStatus");
                const modalPaket = document.getElementById("modalPaket");
                const modalDestinacija = document.getElementById("modalDestinacija");
                const modalPolazak = document.getElementById("modalPolazak");
                const modalPovratak = document.getElementById("modalPovratak");
                const modalPrevoz = document.getElementById("modalPrevoz");
                const modalLet = document.getElementById("modalLet");
                const modalPutniciLista = document.getElementById("modalPutniciLista");

                const hotelNazivSpan = document.getElementById('modalHotelNaziv');
                const hotelLink = document.getElementById('modalHotelLink');

                function escapeHtml(str) {
                    if (!str) return "—";
                    return str.replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");
                }

                function otvoriModal() {
                    modalOverlay.classList.add("active");
                }

                function zatvoriModal() {
                    modalOverlay.classList.remove("active");
                }

                detaljiButtons.forEach(button => {
                    button.addEventListener("click", function () {
                        const id = this.getAttribute("data-id");
                        const email = this.getAttribute("data-email");
                        const paket = this.getAttribute("data-paket");
                        const destinacija = this.getAttribute("data-destinacija");
                        const polazak = this.getAttribute("data-polazak");
                        const povratak = this.getAttribute("data-povratak");
                        const status = this.getAttribute("data-status");
                        const hotel = this.getAttribute("data-hotel");
                        const hotelId = parseInt(this.getAttribute('data-hotelid')) || 0;
                        const prevoz = this.getAttribute("data-prevoz");
                        const letInfo = this.getAttribute("data-let");

                        let putniciData = [];
                        try {
                            putniciData = JSON.parse(this.getAttribute("data-putnici") || "[]");
                        } catch (e) {
                            console.error("Greška pri parsiranju podataka o putnicima.", e);
                        }

                        modalResId.innerText = "#" + id;
                        modalKorisnik.innerText = email;
                        modalStatus.innerHTML = `<span class="status-pill ${status.toLowerCase()}">${escapeHtml(status)}</span>`;
                        modalPaket.innerText = paket;
                        modalDestinacija.innerText = destinacija;
                        modalPolazak.innerText = polazak;
                        modalPovratak.innerText = povratak;
                        modalLet.innerText = letInfo;
                        hotelNazivSpan.innerText = hotel;

                        if (prevoz === "Avion") {
                            modalPrevoz.innerHTML = `<i class="fa-solid fa-plane" style="color: #0ea5e9;"></i> Avion`;
                        } else {
                            modalPrevoz.innerHTML = `<i class="fa-solid fa-bus" style="color: #475569;"></i> Autobus`;
                        }
                        if (hotelId > 0) {
                            hotelLink.href = `/Administrator/Hoteli/Details/${hotelId}`;
                            hotelLink.style.display = "inline-flex";
                        } else {
                            hotelLink.style.display = "none";
                        }

                        if (hotelNazivSpan && hotelLink) {
                            hotelNazivSpan.innerText = hotel;

                            if (hotelId > 0 && hotel !== "Nije uključeno") {
                                hotelLink.href = `/Administrator/HotelDetails/${hotelId}`;
                                hotelLink.style.display = 'inline-block';
                            } else {
                                hotelLink.style.display = 'none';
                            }
                        }

                        modalPutniciLista.innerHTML = "";
                        if (putniciData.length === 0) {
                            modalPutniciLista.innerHTML = `<div style="color: var(--text-muted); font-size: 13px;">Nema dodatnih registrovanih putnika (Samo nosilac rezervacije).</div>`;
                        } else {
                            putniciData.forEach((p, index) => {
                                const cistZahtjevi = escapeHtml(p.PosebniZahtjevi);
                                const zahtjeviHtml = p.PosebniZahtjevi ? `<div style="margin-top:4px; font-size:12px; color:#b91c1c; background:#fef2f2; padding:4px 8px; border-radius:4px; word-break: break-word;"><strong>Napomena:</strong> ${cistZahtjevi}</div>` : '';

                                modalPutniciLista.innerHTML += `
                                            <div class="passenger-row" style="background: #f8fafc; padding: 12px; border-radius: 6px; border: 1px solid #e2e8f0; display: block; width: 100%;">
                                                <div style="display:flex; justify-content:space-between; margin-bottom:4px; flex-wrap: wrap; gap: 8px;">
                                                    <strong>${index + 1}. ${escapeHtml(p.Ime)} ${escapeHtml(p.Prezime)}</strong>
                                                    <span style="color: var(--text-muted); font-size:13px;">Pasoš: <strong>${escapeHtml(p.BrojPasosa)}</strong></span>
                                                </div>
                                                <div style="font-size: 12px; color: #64748b; display:flex; gap:15px; flex-wrap:wrap;">
                                                    <span>Državljanstvo: ${escapeHtml(p.Drzavljanstvo)}</span>
                                                    <span>Datum rođenja: ${escapeHtml(p.DatumRodjenja)}</span>
                                                    <span>Tel: ${escapeHtml(p.Telefon)}</span>
                                                </div>
                                                ${zahtjeviHtml}
                                            </div>
                                        `;
                            });
                        }

                        otvoriModal();
                    });
                });

                btnZatvori.addEventListener("click", zatvoriModal);
                modalOverlay.addEventListener("click", function (e) {
                    if (e.target === modalOverlay) zatvoriModal();
                });

               
            });
    </script>
</body>
</html>