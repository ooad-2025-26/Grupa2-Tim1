@model InterTrips___Turistička_Agencija.Models.Destinacija

@{
    var isEdit = Model != null && Model.Id != 0;
    ViewData["Title"] = isEdit ? "Uredi destinaciju" : "Nova destinacija";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
            }

            .nav-item i {
                width: 20px;
                margin-right: 12px;
                font-size: 16px;
                text-align: center;
                transition: color 0.2s ease;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 0 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

                .sidebar .logo {
                    height: 36px;
                    object-fit: contain;
                    filter: brightness(0) invert(1);
                }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1200px;
            }

            .dash-header {
                margin-bottom: 32px;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 4px;
                }

            .form-layout {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 32px;
                align-items: start;
            }

            .card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                padding: 32px;
            }

            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin-bottom: 20px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
            }

            .field-label {
                font-size: 12px;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 6px;
                letter-spacing: 0.3px;
            }

            .input, .textarea {
                width: 100%;
                background: #fff;
                border: 1px solid var(--border);
                color: var(--text-dark);
                outline: none;
                border-radius: 8px;
                height: 42px;
                padding: 0 14px;
                font-size: 14px;
                transition: all 0.15s ease-in-out;
            }

                .input:focus, .textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
                }

                .input[type="file"] {
                    padding-top: 9px;
                    font-size: 13px;
                    cursor: pointer;
                }

            .textarea {
                height: 140px;
                padding: 12px 14px;
                resize: none;
            }

            .btnrow {
                display: flex;
                gap: 12px;
                justify-content: flex-end;
                margin-top: 32px;
                border-top: 1px solid var(--border);
                padding-top: 24px;
            }

            .btn {
                height: 42px;
                padding: 0 20px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 14px;
                border: 1px solid var(--border);
                background: #fff;
                color: var(--text-dark);
                transition: all 0.15s;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
            }

                .btn:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

            .btn-primary {
                background-color: var(--sidebar-bg);
                color: #fff;
                border: none;
            }

                .btn-primary:hover {
                    background-color: #1e293b;
                }

            .image-sidebar {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .preview-box {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 16px;
                box-shadow: var(--shadow);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .preview {
                width: 100%;
                height: auto;
                max-height: 240px;
                border-radius: 8px;
                object-fit: cover;
                border: 1px solid var(--border);
                transition: opacity 0.3s ease;
            }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar span, .sidebar .logout-btn-nav {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }

                .form-layout {
                    grid-template-columns: 1fr;
                    gap: 24px;
                }
            }

            @@media (max-width: 640px) {
                .row {
                    grid-template-columns: 1fr;
                    gap: 16px;
                }

                .btnrow {
                    flex-direction: column-reverse;
                }

                .btn {
                    width: 100%;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> Dashboard
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> Destinacije
            </a>
            <a href="/Administrator/Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> Paketi
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> Korisnici
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item active">
                <i class="fa-solid fa-calendar-check"></i> Rezervacije
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">

        <header class="dash-header">
            <h1>@ViewData["Title"]</h1>
            <p>Unesite ispravne parametre i geografske podatke za kreiranje ili izmjenu aranžmana.</p>
        </header>

        <div class="form-layout">

            <div class="card">
                <form asp-controller="Administrator"
                      asp-action="@(isEdit ? "DestinacijaEdit" : "DestinacijaCreate")"
                      asp-route-id="@(Model?.Id ?? 0)"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="form-group">
                            <label class="field-label">NAZIV DESTINACIJE</label>
                            <input class="input" asp-for="Naziv" placeholder="Npr. Rim" required />
                            <span asp-validation-for="Naziv" style="color:#ef4444; font-size:12px; font-weight: 500; display:block; margin-top:6px;"></span>
                        </div>
                        <div class="form-group">
                            <label class="field-label">DRŽAVA</label>
                            <input class="input" asp-for="Drzava" placeholder="Npr. Italija" required />
                            <span asp-validation-for="Drzava" style="color:#ef4444; font-size:12px; font-weight: 500; display:block; margin-top:6px;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            <label class="field-label">KATEGORIJA</label>
                            <input class="input" asp-for="Kategorija" placeholder="Beach / City / Adventure" />
                        </div>
                        <div class="form-group">
                            <label class="field-label">ZAMJENI / DODAJ SLIKU</label>
                            <input class="input" type="file" id="slikaInput" name="slika" accept="image/*" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 4px;">
                        <label class="field-label">DETALJAN OPIS DESTINACIJE</label>
                        <textarea class="textarea" asp-for="Opis" placeholder="Napišite profesionalni, privlačan opis lokacije, znamenitosti i ponude..."></textarea>
                    </div>

                    <div class="btnrow">
                        <a class="btn" asp-controller="Administrator" asp-action="Destinacije">Odustani</a>
                        <button class="btn btn-primary" type="submit">Sačuvaj promjene</button>
                    </div>
                </form>
            </div>

            <div class="image-sidebar">
                <div class="field-label">PREGLED SLIKE DESTINACIJE</div>
                <div class="preview-box">
                    @if (isEdit && !string.IsNullOrWhiteSpace(Model.SlikaUrl))
                    {
                        <img class="preview" id="slikaPreview" src="@Model.SlikaUrl" alt="Trenutna slika" />
                    }
                    else
                    {
                        <img class="preview" id="slikaPreview" src="/assets/bali.jpg" style="opacity: 0.35; filter: grayscale(20%);" alt="Nema slike" />
                    }
                </div>
            </div>

        </div>
    </main>

    <script>
            document.getElementById('slikaInput').addEventListener('change', function (event) {
                const [file] = this.files;
                if (file) {
                    const preview = document.getElementById('slikaPreview');
                    preview.src = URL.createObjectURL(file);
                    preview.style.opacity = "1";
                    preview.style.filter = "none";
                }
            });
    </script>
</body>
</html>