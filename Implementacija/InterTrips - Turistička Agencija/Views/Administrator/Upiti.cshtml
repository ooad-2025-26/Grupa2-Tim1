@model IEnumerable<InterTrips___Turistička_Agencija.Models.KontaktUpit>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "InterTrips Admin - Kontakt Upiti";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
                --success: #10b981;
                --danger: #ef4444;
                --destinacije-color: #f59e0b;
                --paketi-color: #6366f1;
                --korisnici-color: #ec4899;
                --rezervacije-color: #06b6d4;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 8px 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                text-decoration: none;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                display: block;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 16px;
                    text-align: center;
                    transition: color 0.2s ease;
                }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1300px;
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 4px;
                }

            .btn-secondary-top {
                display: inline-flex;
                align-items: center;
                padding: 10px 16px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                box-shadow: var(--shadow);
                transition: background 0.2s;
            }

                .btn-secondary-top:hover {
                    background: #f8fafc;
                }

            .alert {
                padding: 14px 20px;
                border-radius: 8px;
                margin-bottom: 24px;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .alert-success {
                background: #ecfdf5;
                color: #065f46;
                border: 1px solid #a7f3d0;
            }

            .alert-danger {
                background: #fef2f2;
                color: #991b1b;
                border: 1px solid #fca5a5;
            }

            .table-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .admin-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
                font-size: 14px;
            }

                .admin-table thead tr {
                    background-color: #f8fafc;
                    border-bottom: 1px solid var(--border);
                }

                .admin-table th {
                    padding: 16px 20px;
                    color: var(--text-dark);
                    font-weight: 600;
                }

                .admin-table td {
                    padding: 16px 20px;
                }

                .admin-table tbody tr {
                    border-bottom: 1px solid var(--border);
                    transition: all 0.2s ease;
                }
                    .admin-table tbody tr.novo-upit {
                        background-color: rgba(14, 165, 233, 0.04);
                    }

                    .admin-table tbody tr:hover {
                        background-color: #f1f5f9 !important;
                    }

            .text-truncate-custom {
                max-width: 300px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .btn-pregled {
                background: var(--primary);
                color: white;
                border: none;
                padding: 8px 14px;
                border-radius: 8px;
                font-size: 12.5px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
            }

                .btn-pregled:hover {
                    background: var(--primary-hover);
                }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-item span, .sidebar .logout-btn-nav {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }
            }
    </style>
</head>
<body>

    <div id="antiforgery-token-container" style="display: none;">
        @Html.AntiForgeryToken()
    </div>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a href="/Administrator/Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item active">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">

        <header class="dash-header">
            <div>
                <h1>Dolazni upiti korisnika</h1>
                <p>Upravljanje i pregled poruka poslanih kroz kontakt formu.</p>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
                <div style="background: var(--card-bg); padding: 6px 14px; border-radius: 8px; border: 1px solid var(--border); font-size: 13px; font-weight: 500;">
                    Ukupno: <span style="color: var(--text-dark); font-weight: 700;">@(Model != null ? Model.Count() : 0)</span>
                </div>
                <div style="background: var(--card-bg); padding: 6px 14px; border-radius: 8px; border: 1px solid var(--border); font-size: 13px; font-weight: 500;">
                    Novo: <span style="color: var(--primary); font-weight: 700;">@(Model != null ? Model.Count(u => !u.Procitano) : 0)</span>
                </div>
                <a href="/Destinacije" target="_blank" class="btn-secondary-top"><i class="fa-solid fa-arrow-up-right-from-square" style="margin-right: 6px;"></i> Pregledaj sajt</a>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <div class="table-card">
            @if (Model == null || !Model.Any())
            {
                <div style="padding: 60px; text-align: center; color: var(--text-muted);">
                    <i class="fa-regular fa-folder-open" style="font-size: 48px; color: var(--primary); margin-bottom: 15px; display:block;"></i>
                    <p style="font-size: 15px; font-weight: 600; margin: 0;">Trenutno nema pristiglih upita u bazi podataka.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width: 110px;">Status</th>
                                <th>Pošiljalac</th>
                                <th>Tema upita</th>
                                <th>Datum slanja</th>
                                <th style="text-align: right;">Akcija</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var upit in Model.OrderByDescending(u => u.DatumSlanja))
                            {
                                if (upit == null) continue;

                                <tr id="red-@upit.Id" class="@(upit.Procitano ? "" : "novo-upit")">
                                    <td>
                                        <span id="bedz-@upit.Id" style="display: inline-block; padding: 4px 8px; font-size: 11px; font-weight: 700; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.5px;
                                            background-color: @(upit.Procitano ? "#e2e8f0" : "rgba(14, 165, 233, 0.15)");
                                            color: @(upit.Procitano ? "#64748b" : "var(--primary)");">
                                            @(upit.Procitano ? "Pročitano" : "Novo")
                                        </span>
                                    </td>

                                    <td>
                                        <div style="font-weight: 600; color: var(--text-dark);">@upit.Ime</div>
                                        <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px; word-break: break-all;">@upit.Email</div>
                                    </td>

                                    <td class="text-truncate-custom" style="color: var(--text-dark); font-weight: @(upit.Procitano ? "400" : "600");" title="@upit.Tema">
                                        @upit.Tema
                                    </td>

                                    <td style="color: var(--text-muted); font-size: 13px; white-space: nowrap;">
                                        @upit.DatumSlanja.ToString("dd.MM.yyyy. HH:mm")
                                    </td>

                                    <td style="text-align: right;">
                                        <button class="btn-pregled"
                                                data-id="@upit.Id"
                                                data-ime="@upit.Ime"
                                                data-email="@upit.Email"
                                                data-tema="@upit.Tema"
                                                data-poruka="@upit.Poruka"
                                                data-datum="@upit.DatumSlanja.ToString("dd.MM.yyyy. HH:mm")"
                                                data-procitano="@upit.Procitano.ToString().ToLower()"
                                                onclick="pogledajUpit(this)">
                                            <i class="fa-regular fa-eye" style="margin-right: 5px;"></i> Detalji
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function escapeHtml(text) {
        if (!text) return '';
        return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
        }

        async function pogledajUpit(element) {
        const id = element.getAttribute("data-id");
        const ime = element.getAttribute("data-ime");
        const email = element.getAttribute("data-email");
        const tema = element.getAttribute("data-tema");
        const poruka = element.getAttribute("data-poruka");
        const datum = element.getAttribute("data-datum");
        const isProcitano = element.getAttribute("data-procitano") === "true";

        Swal.fire({
        title: `<p style="font-size:14px; color: var(--text-muted); margin-bottom:5px; font-weight:400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Tema: ${escapeHtml(tema)}</p><b style="color: var(--text-dark)">${escapeHtml(ime)}</b>`,
        html: `
        <div style="text-align: left; font-size: 13.5px; line-height: 1.6; color: var(--text-dark); background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid var(--border); max-height: 250px; overflow-y: auto; margin-top: 15px;">
        <strong>Poruka:</strong><br>
        <p style="white-space: pre-wrap; margin-top: 8px; color: #334155; word-break: break-word;">${escapeHtml(poruka)}</p>
        </div>
        <div style="text-align: left; margin-top: 12px; font-size: 12px; color: var(--text-muted);">
        <i class="fa-regular fa-envelope"></i> Email: <a href="mailto:${escapeHtml(email)}" style="color: var(--primary); text-decoration:none; font-weight:500; word-break: break-all;">${escapeHtml(email)}</a><br>
        <i class="fa-regular fa-clock"></i> Poslano: ${escapeHtml(datum)}
        </div>
        `,
        showCancelButton: true,
        confirmButtonColor: '#0ea5e9',
        cancelButtonColor: '#64748b',
        confirmButtonText: isProcitano ? 'Zatvori' : '<i class="fa-solid fa-check"></i> Označi kao pročitano',
        cancelButtonText: 'Nazad',
        showConfirmButton: !isProcitano
        }).then(async (result) => {
        if (result.isConfirmed && !isProcitano) {
        try {
        const tokenInput = document.querySelector('#antiforgery-token-container input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch(`/Administrator/MarkAsRead/${id}`, {
        method: 'POST',
        headers: {
        'RequestVerificationToken': token
        }
        });

        if (response.ok) {
        const bedz = document.getElementById(`bedz-${id}`);
        const red = document.getElementById(`red-${id}`);

        if (bedz) {
        bedz.innerText = "Pročitano";
        bedz.style.backgroundColor = "#e2e8f0";
        bedz.style.color = "#64748b";
        }
        if (red) {
        red.classList.remove("novo-upit");
        }

        element.setAttribute("data-procitano", "true");

        Swal.fire({
        icon: 'success',
        title: 'Ažurirano',
        text: 'Upit je označen kao pročitan.',
        timer: 1500,
        showConfirmButton: false
        });
        } else {
        Swal.fire({
        icon: 'error',
        title: 'Greška',
        text: 'Došlo je do problema prilikom ažuriranja statusa na serveru.'
        });
        }
        } catch (error) {
        console.error("Greška pri ažuriranju statusa:", error);
        Swal.fire({
        icon: 'error',
        title: 'Greška',
        text: 'Sistemska greška. Provjerite mrežnu konekciju.'
        });
        }
        }
        });
        }
    </script>
</body>
</html>