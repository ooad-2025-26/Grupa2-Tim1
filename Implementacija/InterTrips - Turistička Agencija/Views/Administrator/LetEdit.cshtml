@model InterTrips___Turistička_Agencija.Models.Let
@{
    ViewData["Title"] = "InterTrips - Uredi let";
    Layout = null;
    var destinacije = ViewBag.Destinacije as IEnumerable<InterTrips___Turistička_Agencija.Models.Destinacija>;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #1e293b;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
                --shadow-input: 0 2px 4px rgba(0, 0, 0, 0.02);
                --success: #10b981;
                --danger: #ef4444;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
                box-shadow: 4px 0 20px rgba(15, 23, 42, 0.15);
            }

                .sidebar .logo-area {
                    padding: 8px 12px 28px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                font-size: 20px;
                font-weight: 800;
                color: #ffffff;
                text-decoration: none;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .sidebar-logo-text::before {
                    content: "\f5b0";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    color: var(--sidebar-active);
                }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 6px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 16px;
                    text-align: center;
                    transition: transform 0.2s;
                }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                    .nav-item:hover i {
                        transform: translateX(2px);
                    }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #f87171;
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 8px;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                    border-color: #ef4444;
                    color: #ef4444;
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 50px;
                max-width: 1000px;
                width: 100%;
            }

            .dash-header {
                margin-bottom: 36px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #e2e8f0;
                padding-bottom: 20px;
            }

                .dash-header h1 {
                    font-size: 28px;
                    font-weight: 700;
                    color: #0f172a;
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 6px;
                }

            .btn-secondary-top {
                display: inline-flex;
                align-items: center;
                padding: 10px 18px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                box-shadow: var(--shadow-input);
                transition: all 0.2s;
            }

                .btn-secondary-top:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

            .card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 16px;
                box-shadow: var(--shadow);
                padding: 32px;
            }

                .card h2 {
                    font-size: 18px;
                    font-weight: 600;
                    color: #0f172a;
                    margin-bottom: 24px;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
            .full-width {
                grid-column: span 2;
            }

            .form-group {
                margin-bottom: 4px;
            }

            .field-label {
                display: block;
                font-size: 11px;
                font-weight: 700;
                color: var(--text-muted);
                margin-bottom: 6px;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .input-wrapper {
                position: relative;
                display: flex;
                align-items: center;
            }

                .input-wrapper i {
                    position: absolute;
                    left: 14px;
                    color: #94a3b8;
                    font-size: 15px;
                    pointer-events: none;
                }

            .input, .select {
                width: 100%;
                background: #fff;
                border: 1px solid var(--border);
                color: #0f172a;
                outline: none;
                border-radius: 8px;
                height: 44px;
                padding: 0 14px 0 40px; 
                font-size: 14px;
                transition: all 0.2s ease-in-out;
                font-family: inherit;
                box-shadow: var(--shadow-input);
            }

            .select {
                cursor: pointer;
                appearance: none;
                -webkit-appearance: none;
                background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%2364748b' d='M0 0l5 5 5-5z'/></svg>");
                background-repeat: no-repeat;
                background-position: right 14px center;
                padding-right: 40px;
            }

                .input:focus, .select:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12), var(--shadow-input);
                    background-color: #fff;
                }

            .field-validation-error {
                color: var(--danger);
                font-size: 12px;
                font-weight: 500;
                margin-top: 6px;
                display: block;
            }

            .alert {
                padding: 14px 20px;
                border-radius: 8px;
                margin-bottom: 24px;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
                box-shadow: var(--shadow-input);
            }

            .alert-danger {
                background: #fef2f2;
                color: #991b1b;
                border: 1px solid #fee2e2;
            }

            .form-actions {
                display: flex;
                justify-content: flex-end;
                gap: 12px;
                margin-top: 32px;
                padding-top: 20px;
                border-top: 1px solid #e2e8f0;
            }

            .main-btn {
                padding: 0 24px;
                height: 44px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                font-weight: 600;
                font-size: 14px;
                background-color: var(--primary);
                color: #fff;
                transition: all 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 2px 4px rgba(14, 165, 233, 0.2);
            }

                .main-btn:hover {
                    background-color: var(--primary-hover);
                    box-shadow: 0 4px 8px rgba(14, 165, 233, 0.3);
                }

                .main-btn:disabled {
                    background-color: #94a3b8;
                    cursor: not-allowed;
                    box-shadow: none;
                }

            .cancel-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 20px;
                height: 44px;
                border-radius: 8px;
                border: 1px solid var(--border);
                background: #fff;
                color: var(--text-dark);
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.2s;
            }

                .cancel-btn:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-item span, .sidebar .logout-btn-nav span {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }
            }

           @@media (max-width: 768px) {
                .form-grid {
                    grid-template-columns: 1fr;
                }

                .full-width {
                    grid-column: span 1;
                }

                .form-actions {
                    flex-direction: column-reverse;
                }

                .cancel-btn, .main-btn {
                    width: 100%;
                    justify-content: center;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item active">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a href="/Administrator/Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Odjavi se</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="main-content">
        <header class="dash-header">
            <div>
                <h1>Uredi Let: @(Model != null ? Model.BrojLeta : "N/A")</h1>
                <p>Izmijenite podatke o avio-liniji, avioprevozniku i preostalim sjedištima.</p>
            </div>
            <div>
                <a href="/Administrator/Letovi" class="btn-secondary-top">
                    <i class="fa-solid fa-arrow-left" style="margin-right: 8px;"></i> Nazad na letove
                </a>
            </div>
        </header>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <div class="card">
            <h2><i class="fa-solid fa-pen-to-square" style="color: var(--primary);"></i> Podaci o letu</h2>

            <form id="letEditForm" asp-controller="Administrator" asp-action="LetEdit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" style="color: var(--danger); font-size: 13px; font-weight: 600; margin-bottom: 20px;"></div>

                <div class="form-grid">

                    <div class="form-group">
                        <label class="field-label">Broj leta</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-hashtag"></i>
                            <input class="input" id="inputBrojLeta" asp-for="BrojLeta" type="text" maxlength="20" required placeholder="Npr. JU-100">
                        </div>
                        <span asp-validation-for="BrojLeta" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="field-label">Aviokompanija</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-building"></i>
                            <input class="input" id="inputAviokompanija" asp-for="Aviokompanija" type="text" maxlength="100" required placeholder="Npr. Turkish Airlines">
                        </div>
                        <span asp-validation-for="Aviokompanija" class="field-validation-error"></span>
                    </div>

                    <div class="form-group full-width">
                        <label class="field-label">Polazak sa</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-plane-departure"></i>
                            <input class="input" id="inputPolazak" asp-for="Polazak" type="text" maxlength="100" required placeholder="Npr. Aerodrom Sarajevo (SJJ)">
                        </div>
                        <span asp-validation-for="Polazak" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="field-label">Odredište (Destinacija)</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-plane-arrival"></i>
                            <select class="select" asp-for="Odrediste" required id="selectOdrediste">
                                <option value="">-- Odaberite destinaciju --</option>
                                @if (destinacije != null && destinacije.Any())
                                {
                                    foreach (var d in destinacije)
                                    {
                                        <option value="@d.Naziv">@d.Naziv (@d.Drzava)</option>
                                    }
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Odrediste" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="field-label">Slobodna sjedišta (Kapacitet)</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-chair"></i>
                            <input class="input" id="inputSlobodnaSjedista" asp-for="SlobodnaSjedista" type="number" min="0" max="1000" step="1" required>
                        </div>
                        <span asp-validation-for="SlobodnaSjedista" class="field-validation-error"></span>
                    </div>

                </div>

                <div class="form-actions">
                    <a href="/Administrator/Letovi" class="cancel-btn">Otkaži</a>
                    <button class="main-btn" type="submit" id="submitBtn">
                        <i class="fa-solid fa-floppy-disk"></i> Spasi izmjene
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.getElementById('inputSlobodnaSjedista')?.addEventListener('input', function () {
        let val = parseInt(this.value);
        if (val < 0 && this.value !== "") this.value = 0;
        if (val > 1000) this.value = 1000;
        });

        document.getElementById('letEditForm')?.addEventListener('submit', function (e) {
        if (window.jQuery && jQuery(this).valid && !jQuery(this).valid()) {
        return;
        }

        const brojLetaInput = document.getElementById('inputBrojLeta');
        const polazakInput = document.getElementById('inputPolazak');
        const avioInput = document.getElementById('inputAviokompanija');
        const submitBtn = document.getElementById('submitBtn');

        if (brojLetaInput) brojLetaInput.value = brojLetaInput.value.trim();
        if (polazakInput) polazakInput.value = polazakInput.value.trim();
        if (avioInput) avioInput.value = avioInput.value.trim();

        if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = "<i class='fa-solid fa-spinner fa-spin'></i> Spašavanje u toku...";
        }
        });
    </script>
</body>
</html>