@model InterTrips___Turistička_Agencija.Models.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "InterTrips - Admin panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
                --success: #10b981;
                --danger: #ef4444;
                --destinacije-color: #f59e0b;
                --paketi-color: #6366f1;
                --korisnici-color: #ec4899;
                --rezervacije-color: #06b6d4;
                --upiti-color: #14b8a6;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 8px 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                text-decoration: none;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                display: block;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 16px;
                    text-align: center;
                    transition: color 0.2s ease;
                }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1300px;
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 4px;
                }

            .btn-secondary-top {
                display: inline-flex;
                align-items: center;
                padding: 10px 16px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                box-shadow: var(--shadow);
                transition: background 0.2s;
            }

                .btn-secondary-top:hover {
                    background: #f8fafc;
                }

            .alert {
                padding: 14px 20px;
                border-radius: 8px;
                margin-bottom: 24px;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .alert-success {
                background: #ecfdf5;
                color: #065f46;
                border: 1px solid #a7f3d0;
            }

            .alert-danger {
                background: #fef2f2;
                color: #991b1b;
                border: 1px solid #fca5a5;
            }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 24px;
                margin-bottom: 32px;
            }

            .stat-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 24px;
                box-shadow: var(--shadow);
                display: flex;
                flex-direction: column;
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                    border-color: rgba(14, 165, 233, 0.3);
                }

                .stat-card span {
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .stat-card strong {
                    font-size: 32px;
                    font-weight: 700;
                    color: var(--text-dark);
                    margin-top: 8px;
                }

            .categories-section-title {
                font-size: 18px;
                font-weight: 600;
                margin-top: 40px;
                margin-bottom: 16px;
                color: var(--text-dark);
            }

            .categories-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 24px;
            }

            .category-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 28px;
                box-shadow: var(--shadow);
                display: flex;
                align-items: flex-start;
                gap: 20px;
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
            }

                .category-card:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .category-card.cat-destinacije {
                    border-left: 4px solid var(--destinacije-color);
                }

                    .category-card.cat-destinacije:hover {
                        border-color: var(--destinacije-color);
                    }

                .category-card.cat-paketi {
                    border-left: 4px solid var(--paketi-color);
                }

                    .category-card.cat-paketi:hover {
                        border-color: var(--paketi-color);
                    }

                .category-card.cat-izvjestaji {
                    border-left: 4px solid var(--success);
                }

                    .category-card.cat-izvjestaji:hover {
                        border-color: var(--success);
                    }

                .category-card.cat-korisnici {
                    border-left: 4px solid var(--korisnici-color);
                }

                    .category-card.cat-korisnici:hover {
                        border-color: var(--korisnici-color);
                    }

                .category-card.cat-rezervacije {
                    border-left: 4px solid var(--rezervacije-color);
                }

                    .category-card.cat-rezervacije:hover {
                        border-color: var(--rezervacije-color);
                    }

                .category-card.cat-upiti {
                    border-left: 4px solid var(--upiti-color);
                }

                    .category-card.cat-upiti:hover {
                        border-color: var(--upiti-color);
                    }

            .category-icon {
                width: 48px;
                height: 48px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .category-details h3 {
                font-size: 16px;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 4px;
            }

            .category-details p {
                font-size: 13px;
                color: var(--text-muted);
                line-height: 1.5;
            }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-item span, .sidebar .logout-btn-nav {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }

                .stats-grid, .categories-grid {
                    grid-template-columns: 1fr;
                    gap: 16px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item active">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a href="/Administrator/Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji i Analitika</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">

        <header class="dash-header">
            <div>
                <h1>Pregled sistema</h1>
                <p>Dobrodošli nazad. Trenutno stanje Vaše agencije.</p>
            </div>
            <div>
                <a href="/Destinacije" target="_blank" class="btn-secondary-top">
                    <i class="fa-solid fa-arrow-up-right-from-square" style="margin-right: 6px;"></i> Pregledaj sajt
                </a>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <section class="stats-grid">
            <a href="/Administrator/Destinacije" class="stat-card">
                <span>Aktivne Destinacije</span>
                <strong id="destCount">@Model.DestinacijeCount</strong>
            </a>
            <a href="/Administrator/Korisnici" class="stat-card">
                <span>Aktivni Korisnici</span>
                <strong id="userCount">@Model.KorisniciCount</strong>
            </a>
            <a href="/Administrator/Rezervacije" class="stat-card">
                <span>Ukupno Rezervacija</span>
                <strong id="bookingCount">@Model.RezervacijeCount</strong>
            </a>
        </section>

        <h2 class="categories-section-title">Kategorije upravljanja</h2>

        <section class="categories-grid">

            <a href="/Administrator/Destinacije" class="category-card cat-destinacije">
                <div class="category-icon" style="background: rgba(245, 158, 11, 0.1); color: var(--destinacije-color);">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>
                <div class="category-details">
                    <h3>Upravljanje Destinacijama</h3>
                    <p>Pregledajte postojeće destinacije, dodajte nove turističke lokacije ili uredite podatke i slike ponuda.</p>
                </div>
            </a>

            <a href="/Administrator/Paketi" class="category-card cat-paketi">
                <div class="category-icon" style="background: rgba(99, 101, 241, 0.1); color: var(--paketi-color);">
                    <i class="fa-solid fa-cubes"></i>
                </div>
                <div class="category-details">
                    <h3>Turistički Paketi</h3>
                    <p>Kreirajte i ažurirajte aranžmane, dodjeljujte letove i hotele, te definišite cijene paketa.</p>
                </div>
            </a>

            <a href="/Administrator/Izvjestaj" class="category-card cat-izvjestaji">
                <div class="category-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div class="category-details">
                    <h3>Izvještaji i Analitika</h3>
                    <p>Statistički uvid u stopu konverzije aranžmana i automatski proračun popularnosti destinacija kroz OOAD algoritam.</p>
                </div>
            </a>

            <a href="/Administrator/Korisnici" class="category-card cat-korisnici">
                <div class="category-icon" style="background: rgba(236, 72, 153, 0.1); color: var(--korisnici-color);">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div class="category-details">
                    <h3>Korisnički Nalozi</h3>
                    <p>Administracija registrovanih korisnika, agenata i klijenata. Pregled aktivnosti i uređivanje prava pristupa.</p>
                </div>
            </a>

            <a href="/Administrator/Rezervacije" class="category-card cat-rezervacije">
                <div class="category-icon" style="background: rgba(6, 182, 212, 0.1); color: var(--rezervacije-color);">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="category-details">
                    <h3>Rezervacije i Plaćanja</h3>
                    <p>Pratite statuse rezervacija klijenta, uplate, popunjenost kapaciteta i odobrene kupone.</p>
                </div>
            </a>

            <a href="/Administrator/Upiti" class="category-card cat-upiti">
                <div class="category-icon" style="background: rgba(20, 184, 166, 0.1); color: var(--upiti-color);">
                    <i class="fa-solid fa-inbox"></i>
                </div>
                <div class="category-details">
                    <h3>Kontakt Upiti</h3>
                    <p>Pregledajte poruke i pitanja posjetitelja poslana kroz kontakt formu. Odgovorite direktno klijentima.</p>
                </div>
            </a>

        </section>
    </main>
</body>
</html>