@model InterTrips___Turistička_Agencija.Models.Paket

@{
    var isEdit = Model != null && Model.Id != 0;
    ViewData["Title"] = isEdit ? "InterTrips - Uredi Paket" : "InterTrips - Novi Paket";
    Layout = null;

    var destinacije = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Destinacije;
    var statusi = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Statusi;

    var renderModel = Model ?? new InterTrips___Turistička_Agencija.Models.Paket();

    if (renderModel.DatumPolaska == DateTime.MinValue)
    {
        renderModel.DatumPolaska = DateTime.Now;
    }
    if (renderModel.DatumPovratka == DateTime.MinValue)
    {
        renderModel.DatumPovratka = DateTime.Now.AddDays(7);
    }
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --danger: #ef4444;
                --sidebar-footer-bg: #1e293b;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 8px 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                text-decoration: none;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                display: block;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 16px;
                    text-align: center;
                }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1100px;
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 4px;
                }

            .btn-secondary-top {
                height: 40px;
                padding: 0 16px;
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-weight: 600;
                font-size: 14px;
                display: inline-flex;
                align-items: center;
                text-decoration: none;
                transition: all 0.15s;
                box-shadow: var(--shadow);
            }

                .btn-secondary-top:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

            .card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                padding: 32px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 24px;
            }

            .full-width {
                grid-column: span 2;
            }

            .form-group-custom {
                display: flex;
                flex-direction: column;
            }

            .field-label-custom {
                font-size: 12px;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 6px;
                letter-spacing: 0.3px;
                text-transform: uppercase;
            }

            .input-custom, .select-custom {
                width: 100%;
                height: 44px;
                padding: 0 14px;
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-size: 14px;
                transition: all 0.15s ease-in-out;
                outline: none;
                box-sizing: border-box;
            }

            .select-custom {
                appearance: none;
                background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
                background-repeat: no-repeat;
                background-position: right 14px center;
                background-size: 16px;
                padding-right: 40px;
            }

                .input-custom:focus, .select-custom:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
                }

            .err-custom {
                color: var(--danger);
                font-size: 12px;
                font-weight: 500;
                display: block;
                margin-top: 6px;
            }

            .validation-summary-custom {
                background: rgba(239, 68, 68, 0.06);
                border: 1px solid rgba(239, 68, 68, 0.2);
                padding: 14px;
                border-radius: 8px;
                color: var(--danger);
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 24px;
            }

            .btnrow-custom {
                display: flex;
                justify-content: flex-end;
                gap: 12px;
                margin-top: 32px;
                padding-top: 24px;
                border-top: 1px solid var(--border);
            }

            .btn-cancel {
                height: 44px;
                padding: 0 24px;
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.15s;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
            }

                .btn-cancel:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

            .btn-submit-custom {
                height: 44px;
                padding: 0 24px;
                background-color: var(--sidebar-bg);
                border: none;
                border-radius: 8px;
                color: #ffffff;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.15s;
            }

                .btn-submit-custom:hover {
                    background-color: #1e293b;
                }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-item span, .sidebar .logout-btn-nav {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }
            }

            @@media (max-width: 640px) {
                .form-grid {
                    grid-template-columns: 1fr;
                    gap: 16px;
                }

                .full-width {
                    grid-column: span 1;
                }

                .btnrow-custom {
                    flex-direction: column-reverse;
                }

                .btn-cancel, .btn-submit-custom {
                    width: 100%;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a href="/Administrator/Paketi" class="nav-item active">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">
        <header class="dash-header">
            <div>
                <h1>@ViewData["Title"]</h1>
                <p>Postavljanje operativnih parametara, cijena i kapaciteta za turistički aranžman.</p>
            </div>
            <div>
                <a href="/Administrator/Paketi" class="btn-secondary-top">
                    <i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i> Nazad na listu
                </a>
            </div>
        </header>

        <div class="card">
            <form asp-controller="Administrator" asp-action="@(isEdit ? "PaketEdit" : "PaketCreate")" method="post" id="paketModalForm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" value="@renderModel.Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary-custom"></div>
                }

                <div class="form-grid">

                    <div class="form-group-custom full-width">
                        <label class="field-label-custom">Naziv turističkog paketa</label>
                        <input class="input-custom" asp-for="Naziv" value="@renderModel.Naziv" placeholder="Npr. Rim — Proljećna čarolija (8 dana)" required />
                        <span class="err-custom" asp-validation-for="Naziv"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Pripadajuća destinacija</label>
                        <select class="select-custom" asp-for="DestinacijaId" asp-items="destinacije" required>
                            <option value="">-- Odaberite destinaciju --</option>
                        </select>
                        <span class="err-custom" asp-validation-for="DestinacijaId"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Status paketa na sajtu</label>
                        <select class="select-custom" asp-for="Status" asp-items="statusi"></select>
                        <span class="err-custom" asp-validation-for="Status"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Početna cijena (BAM)</label>
                        <input class="input-custom" asp-for="CijenaOd" type="number" step="0.01" min="1" placeholder="0.00" required />
                        <span class="err-custom" asp-validation-for="CijenaOd"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Dužina boravka (Noćenja)</label>
                        <input class="input-custom" id="TrajanjeNoci" asp-for="TrajanjeNoci" value="@renderModel.TrajanjeNoci" type="number" min="1" max="90" placeholder="Npr. 7" required />
                        <span class="err-custom" asp-validation-for="TrajanjeNoci"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Datum polaska</label>
                        <input class="input-custom" id="DatumPolaska" type="date" asp-for="DatumPolaska" value="@renderModel.DatumPolaska.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <span class="err-custom" asp-validation-for="DatumPolaska"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Datum povratka</label>
                        <input class="input-custom" id="DatumPovratka" type="date" asp-for="DatumPovratka" value="@renderModel.DatumPovratka.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        <span class="err-custom" asp-validation-for="DatumPovratka"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Ukupan kapacitet (Broj mjesta)</label>
                        <input class="input-custom" asp-for="Kapacitet" value="@renderModel.Kapacitet" type="number" min="1" max="1000" placeholder="Npr. 30" required />
                        <span class="err-custom" asp-validation-for="Kapacitet"></span>
                    </div>

                    <div class="form-group-custom">
                        <label class="field-label-custom">Dozvoljeni tip prevoza</label>
                        <select class="select-custom" asp-for="DostupniPrevoz">
                            <option value="SamoAvion">Samo Avion</option>
                            <option value="SamoAutobus">Samo Autobus</option>
                            <option value="Oboje">Oboje (Mogućnost izbora)</option>
                        </select>
                        <span class="err-custom" asp-validation-for="DostupniPrevoz"></span>
                    </div>

                </div>

                <div class="btnrow-custom">
                    <a href="/Administrator/Paketi" class="btn-cancel">Odustani</a>
                    <button class="btn-submit-custom" type="submit">
                        <i class="fa-solid fa-floppy-disk" style="margin-right: 6px;"></i> Sačuvaj promjene
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
        // Popravka nekompatibilnosti jQuery unobtrusive validacije sa standardnim HTML5 date formatom
        if ($.validator && $.validator.methods) {
        $.validator.methods.date = function (value, element) {
        return this.optional(element) || !isNaN(Date.parse(value)) || /^\d{4}-\d{2}-\d{2}$/.test(value);
        };
        }

        function izracunajDatumPovratka() {
        var datumPolaskaVrijednost = $('#DatumPolaska').val();
        var nocenja = parseInt($('#TrajanjeNoci').val());

        if (datumPolaskaVrijednost && !isNaN(nocenja) && nocenja > 0) {
        var polazak = new Date(datumPolaskaVrijednost);
        polazak.setDate(polazak.getDate() + nocenja);

        var godina = polazak.getFullYear();
        var mjesec = String(polazak.getMonth() + 1).padStart(2, '0');
        var dan = String(polazak.getDate()).padStart(2, '0');

        var noviDatumPovratka = `${godina}-${mjesec}-${dan}`;
        $('#DatumPovratka').val(noviDatumPovratka);

        // Trigger validacije nakon automatske promjene datuma
        if ($('#paketModalForm').validate) {
        $('#DatumPovratka').valid();
        }
        }
        }

        $('#DatumPolaska, #TrajanjeNoci').on('input change', function () {
        izracunajDatumPovratka();
        });
        });
    </script>
</body>
</html>