@model InterTrips___Turistička_Agencija.Models.PlanPutovanjaTemplate
@{
    ViewData["Title"] = "Admin - Plan putovanja (template)";
    Layout = null;
    var paketNaziv = Model.Paket?.Naziv ?? $"Paket #{Model.PaketId}";
    var dest = Model.Paket?.Destinacija;
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #f8fafc;
            --sidebar-bg: #0f172a;
            --sidebar-text: #94a3b8;
            --sidebar-active: #38bdf8;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --card-bg: #ffffff;
            --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
            --primary: #0ea5e9;
            --danger: #ef4444;
        }

        .nav-item i {
            width: 20px;
            margin-right: 12px;
            font-size: 16px;
            text-align: center;
            transition: color 0.2s ease;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-dark);
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            color: #fff;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .sidebar .logo-area {
            padding: 0 12px 32px;
            border-bottom: 1px solid #1e293b;
            margin-bottom: 24px;
        }

        .sidebar-logo-text {
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 20px;
        }

        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-item:hover {
            background: #1e293b;
            color: #fff;
        }

        .nav-item.active {
            background: rgba(14, 165, 233, 0.15);
            color: var(--sidebar-active);
            font-weight: 600;
        }

        .sidebar-footer {
            padding-top: 16px;
            border-top: 1px solid #1e293b;
        }

        .logout-btn-nav {
            width: 100%;
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #ef4444;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn-nav:hover {
            background: rgba(239, 68, 68, 0.1);
        }

        .main-content {
            margin-left: 260px;
            flex-grow: 1;
            padding: 40px 48px;
            max-width: 1250px;
            width: calc(100% - 260px);
        }

        .dash-header {
            margin-bottom: 32px;
        }

        .dash-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        .dash-header p {
            color: var(--text-muted);
            font-size: 14px;
            margin-top: 6px;
            line-height: 1.5;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 32px;
            margin-bottom: 24px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .napomena-box {
            display: flex;
            gap: 16px;
            align-items: flex-end;
            background: #fdf8f6;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #fee2e2;
            margin-bottom: 32px;
        }

        .field-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .input, .textarea {
            width: 100%;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 6px;
            height: 40px;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            color: var(--text-dark);
            outline: none;
            transition: all 0.15s ease;
        }

        .textarea {
            height: 84px;
            padding: 12px 14px;
            resize: none;
        }

        .input:focus, .textarea:focus {
            border-color: #94a3b8;
            box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.1);
        }

        .row2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .btn {
            height: 38px;
            padding: 0 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            border: 1px solid var(--border);
            background: #fff;
            color: #475569;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            gap: 6px;
        }

        .btn:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: var(--text-dark);
        }

        .btn-primary {
            border: none;
            color: #fff;
            background: var(--sidebar-bg);
        }

        .btn-primary:hover {
            background: #1e293b;
            color: #fff;
        }

        .btn-danger {
            border: 1px solid rgba(239, 68, 68, 0.2);
            background: rgba(239, 68, 68, 0.02);
            color: var(--danger);
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.08);
            border-color: var(--danger);
        }

        .actions {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: flex-end;
        }

        .badge {
            display: inline-flex;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            background: #e2e8f0;
            color: #334155;
        }

        .badge-info {
            background: #e0f2fe;
            color: #0369a1;
        }

        .grid-row {
            display: grid;
            grid-template-columns: 80px 100px 1fr 100px auto;
            gap: 24px;
            align-items: start;
            padding: 20px 12px;
            border-bottom: 1px solid var(--border);
            transition: all 0.15s ease;
        }

        .grid-row:last-child {
            border-bottom: none;
        }

        .grid-row:hover {
            background: #f8fafc;
        }

        .timeline-number {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            background: var(--sidebar-bg);
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
        }

        .time-display {
            font-weight: 600;
            font-size: 14px;
            background: #f0fdf4;
            padding: 4px 8px;
            border-radius: 4px;
            display: inline-block;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .item-title {
            font-weight: 600;
            font-size: 15px;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        .item-description {
            color: var(--text-muted);
            font-size: 13.5px;
            line-height: 1.6;
        }

        .char-counter {
            display: block;
            text-align: right;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        @@media (max-width: 1024px) {
            .sidebar {
                width: 70px;
                padding: 24px 8px;
            }

            .sidebar .logo-area, .sidebar .nav-item span {
                display: none;
            }

            .sidebar .nav-item i {
                margin-right: 0;
                font-size: 18px;
            }

            .logout-btn-nav {
                padding: 10px 0;
                font-size: 0;
            }

            .logout-btn-nav::before {
                content: "\f2f5";
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                font-size: 16px;
            }

            .main-content {
                margin-left: 70px;
                padding: 32px 24px;
                width: calc(100% - 70px);
            }
        }

        @@media (max-width: 850px) {
            .grid-row {
                grid-template-columns: 1fr;
                gap: 12px;
                padding: 24px 12px;
            }

            .grid-row > div {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }

            .grid-row .actions {
                width: 100%;
                justify-content: flex-start;
                border-top: 1px solid var(--border);
                padding-top: 12px;
                margin-top: 4px;
            }

            .napomena-box {
                flex-direction: column;
                align-items: stretch;
            }

            .napomena-box button {
                width: 100%;
                margin-top: 0;
            }

            .row2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a asp-controller="Home" asp-action="Index" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a asp-controller="Administrator" asp-action="Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a asp-controller="Administrator" asp-action="Paketi" class="nav-item active">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a asp-controller="Administrator" asp-action="Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a asp-controller="Administrator" asp-action="Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit" title="Odjavi se">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">
        <header class="dash-header">
            <h1>Plan putovanja <span style="font-weight: 300; color: var(--text-muted);">/ Template</span></h1>
            <p>
                Konfigurišite hronološke stavke, dnevne rute i satnice aktivnosti za aranžman:
                <span class="badge badge-info">@paketNaziv</span>
                @if (dest != null)
                {
                    <span> u sklopu lokacije <strong>@dest.Naziv (@dest.Drzava)</strong></span>
                }
            </p>
        </header>

        <div class="card">
            <form asp-controller="Administrator" asp-action="PlanTemplateSaveNapomena" method="post" class="napomena-box">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div style="flex: 1;">
                    <label class="field-label" style="color: #991b1b;">Krovna napomena plana (prikazuje se korisnicima)</label>
                    <input class="input" name="napomena" value="@Model.Napomena" style="border-color: #fca5a5;" placeholder="Npr. Plan puta je podložan blagim izmjenama u zavisnosti od reda letenja i vremenskih uslova..." />
                </div>
                <button type="submit" class="btn btn-primary" style="height: 40px; background: #991b1b;">Sačuvaj</button>
            </form>

            <div class="section-title">
                <div>Nova stavka ili dan</div>
                <span class="badge">Ukupno stavki: @Model.Stavke.Count</span>
            </div>

            <form asp-controller="Administrator" asp-action="PlanTemplateDodajStavku" method="post" style="background: #f8fafc; padding: 24px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 48px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@Model.Id" />

                <div class="row2">
                    <div>
                        <label class="field-label">Redni broj koraka / dan</label>
                        <input class="input" type="number" name="redniBroj" min="1" value="@(Model.Stavke.Any() ? Model.Stavke.Max(s => s.RedniBroj) + 1 : 1)" required />
                    </div>

                    <div>
                        <label class="field-label">Vrijeme (Opciono)</label>
                        <input class="input" type="time" name="vrijeme" />
                    </div>
                </div>

                <div style="margin-bottom: 16px;">
                    <label class="field-label">Naslov etape ili aktivnosti</label>
                    <input class="input" name="Naziv" maxlength="160" required placeholder="Npr. Dan 1 - Okupljanje grupe na aerodromu i let za destinaciju" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label class="field-label">Detaljne informacije i opis</label>
                    <textarea id="opisTextArea" class="textarea" name="opis" maxlength="600" placeholder="Unesite opise transfera, hotelskog smještaja, opcionalnih izleta ili slobodnih aktivnosti za ovu stavku..."></textarea>
                    <small id="charCounter" class="char-counter">Preostalo karaktera: 600</small>
                </div>

                <div class="actions">
                    @if (Model.PaketId != null)
                    {
                        <a class="btn" href="/PlanPutovanja/Preview?paketId=@Model.PaketId" target="_blank">👁️ Pregledaj na sajtu</a>
                    }
                    <button class="btn btn-primary" type="submit">Unesi u plan putovanja</button>
                </div>
            </form>

            <div class="section-title" style="border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 8px;">
                <div>Hronološki slijed plana</div>
            </div>

            @if (!Model.Stavke.Any())
            {
                <div class="item-description" style="font-style: italic; text-align: center; padding: 48px; background: #f8fafc; border-radius: 8px; border: 1px dashed var(--border);">
                    Plan putovanja je trenutno prazan. Koristite gornju formu da definišete strukturu aranžmana.
                </div>
            }
            else
            {
                foreach (var s in Model.Stavke.OrderBy(x => x.RedniBroj))
                {
                    <div class="grid-row">
                        <div>
                            <span class="field-label" style="font-size: 10px; margin-bottom: 4px;">Pozicija</span>
                            <div class="timeline-number">@s.RedniBroj</div>
                        </div>

                        <div>
                            <span class="field-label" style="font-size: 10px; margin-bottom: 4px;">Satnica</span>
                            @if (s.Vrijeme.HasValue)
                            {
                                <span class="time-display">@s.Vrijeme.Value.ToString(@"hh\:mm") h</span>
                            }
                            else
                            {
                                <span class="muted" style="font-size: 13px; color: var(--text-muted);">— : —</span>
                            }
                        </div>

                        <div style="padding-right: 16px;">
                            <div class="item-title">@s.Naziv</div>
                            <div class="item-description">@s.Opis</div>
                        </div>

                        <div>
                            <span class="field-label" style="font-size: 10px; margin-bottom: 4px;">Status</span>
                            <span class="badge" style="background: #f0fdf4; color: #166534; font-size: 11px;">Aktivan</span>
                        </div>

                        <div class="actions">
                            <form asp-controller="Administrator" asp-action="PlanTemplateObrisiStavku" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Da li ste sigurni da želite obrisati stavku: @s.Naziv?')">Ukloni</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const textarea = document.getElementById("opisTextArea");
            const counter = document.getElementById("charCounter");
            const maxLength = 600;

            if (textarea && counter) {
                textarea.addEventListener("input", function () {
                    const remaining = maxLength - textarea.value.length;
                    counter.textContent = `Preostalo karaktera: ${remaining}`;

                    if (remaining <= 20) {
                        counter.style.color = "var(--danger)";
                    } else {
                        counter.style.color = "var(--text-muted)";
                    }
                });
            }
        });
    </script>
</body>
</html>