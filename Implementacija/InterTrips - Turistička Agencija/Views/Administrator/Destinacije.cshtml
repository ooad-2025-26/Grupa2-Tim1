@model InterTrips___Turistička_Agencija.Models.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "InterTrips - Destinacije";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            :root {
                --bg-main: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-text: #94a3b8;
                --sidebar-active: #38bdf8;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --primary: #0ea5e9;
                --primary-hover: #0284c7;
                --border: #e2e8f0;
                --card-bg: #ffffff;
                --shadow: 0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
                --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
                --success: #10b981;
                --danger: #ef4444;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-dark);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 260px;
                background-color: var(--sidebar-bg);
                color: #fff;
                padding: 24px 16px;
                display: flex;
                flex-direction: column;
                position: fixed;
                height: 100vh;
                left: 0;
                top: 0;
                z-index: 100;
            }

                .sidebar .logo-area {
                    padding: 8px 12px 32px;
                    border-bottom: 1px solid #1e293b;
                    margin-bottom: 24px;
                }

            .sidebar-logo-text {
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                text-decoration: none;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                display: block;
            }

            .nav-links {
                display: flex;
                flex-direction: column;
                gap: 4px;
                flex-grow: 1;
            }

            .nav-item {
                display: flex;
                align-items: center;
                padding: 12px 16px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .nav-item i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 16px;
                    text-align: center;
                }

                .nav-item:hover {
                    background: #1e293b;
                    color: #fff;
                }

                .nav-item.active {
                    background: rgba(14, 165, 233, 0.15);
                    color: var(--sidebar-active);
                    font-weight: 600;
                }

            .sidebar-footer {
                padding-top: 16px;
                border-top: 1px solid #1e293b;
            }

            .logout-btn-nav {
                width: 100%;
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.25);
                color: #ef4444;
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                font-weight: 600;
                font-size: 13px;
                transition: all 0.2s;
            }

                .logout-btn-nav:hover {
                    background: rgba(239, 68, 68, 0.1);
                }

            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 40px 48px;
                max-width: 1400px;
            }

            .dash-header {
                margin-bottom: 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .dash-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: var(--text-dark);
                    letter-spacing: -0.5px;
                }

                .dash-header p {
                    color: var(--text-muted);
                    font-size: 14px;
                    margin-top: 4px;
                }

            .btn-secondary-top {
                display: inline-flex;
                align-items: center;
                padding: 10px 16px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-dark);
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                box-shadow: var(--shadow);
                transition: background 0.2s;
            }

                .btn-secondary-top:hover {
                    background: #f8fafc;
                }

            .alert {
                padding: 14px 20px;
                border-radius: 8px;
                margin-bottom: 24px;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .alert-success {
                background: #ecfdf5;
                color: #065f46;
                border: 1px solid #a7f3d0;
            }

            .alert-danger {
                background: #fef2f2;
                color: #991b1b;
                border: 1px solid #fca5a5;
            }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 24px;
                margin-bottom: 32px;
            }

            .stat-card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 24px;
                box-shadow: var(--shadow);
                display: flex;
                flex-direction: column;
            }

                .stat-card span {
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .stat-card strong {
                    font-size: 32px;
                    font-weight: 700;
                    color: var(--text-dark);
                    margin-top: 8px;
                }

            .content-grid {
                display: grid;
                grid-template-columns: 350px 1fr;
                gap: 32px;
                align-items: start;
            }

            .card {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                box-shadow: var(--shadow);
                padding: 28px;
            }

                .card h2 {
                    font-size: 18px;
                    font-weight: 600;
                    color: var(--text-dark);
                    margin-bottom: 24px;
                }

            .form-group {
                margin-bottom: 16px;
            }

            .field-label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 6px;
            }

            .input, .textarea {
                width: 100%;
                background: #fff;
                border: 1px solid var(--border);
                color: var(--text-dark);
                outline: none;
                border-radius: 8px;
                height: 42px;
                padding: 0 14px;
                font-size: 14px;
                transition: all 0.15s ease-in-out;
            }

                .input:focus, .textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
                }

                .input[type="file"] {
                    padding-top: 9px;
                    font-size: 13px;
                    cursor: pointer;
                }

            .textarea {
                height: 100px;
                padding: 12px 14px;
                resize: none;
            }

            .main-btn {
                width: 100%;
                height: 44px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                font-weight: 600;
                font-size: 14px;
                background-color: var(--sidebar-bg);
                color: #fff;
                transition: background 0.2s;
                margin-top: 8px;
            }

                .main-btn:hover {
                    background-color: #1e293b;
                }

            /* NOVI MODERNIZOVANI GRID ZA KARTICE DESTINACIJA */
            .dest-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 24px;
                padding: 4px;
            }

            .dest-card-item {
                background: var(--card-bg);
                border: 1px solid var(--border);
                border-radius: 12px;
                overflow: hidden;
                box-shadow: var(--shadow);
                display: flex;
                flex-direction: column;
                transition: transform 0.2s, box-shadow 0.2s;
            }

                .dest-card-item:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-md);
                }

            .dest-card-img-wrapper {
                position: relative;
                width: 100%;
                height: 180px;
                background: #e2e8f0;
            }

            .dest-card-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .dest-card-placeholder {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f1f5f9;
                color: #cbd5e1;
                font-size: 2.5rem;
            }

            .dest-card-badge {
                position: absolute;
                top: 12px;
                left: 12px;
                background: rgba(15, 23, 42, 0.85);
                color: #fff;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
                backdrop-filter: blur(4px);
            }

            .dest-card-body {
                padding: 16px;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

            .dest-card-title {
                font-size: 16px;
                font-weight: 700;
                color: var(--text-dark);
                margin-bottom: 4px;
            }

            .dest-card-location {
                font-size: 13px;
                color: var(--text-muted);
                display: flex;
                align-items: center;
                gap: 6px;
                margin-bottom: 12px;
            }

                .dest-card-location i {
                    color: var(--primary);
                }

            .dest-card-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
                margin-top: auto;
                padding-top: 12px;
                border-top: 1px solid var(--border);
            }

            .btn-card-action {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 9px;
                font-size: 13px;
                font-weight: 600;
                border-radius: 8px;
                text-decoration: none;
                cursor: pointer;
                border: 1px solid var(--border);
                background: #fff;
                color: var(--text-dark);
                transition: all 0.15s;
            }

                .btn-card-action:hover {
                    background: #f1f5f9;
                    border-color: #cbd5e1;
                }

                .btn-card-action.btn-card-delete {
                    color: #ef4444;
                    border-color: rgba(239, 68, 68, 0.15);
                    background: rgba(239, 68, 68, 0.02);
                }

                    .btn-card-action.btn-card-delete:hover {
                        background: #fef2f2;
                        border-color: #f87171;
                    }

            @@media (max-width: 1200px) {
                .content-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 1024px) {
                .sidebar {
                    width: 70px;
                    padding: 24px 8px;
                }

                    .sidebar .logo-area, .sidebar .nav-item span, .sidebar .logout-btn-nav {
                        display: none;
                    }

                .main-content {
                    margin-left: 70px;
                    padding: 32px 24px;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                    gap: 16px;
                }
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo-area">
            <a href="/" class="sidebar-logo-text">InterTrips</a>
        </div>

        <nav class="nav-links">
            <a href="/Administrator/Index" class="nav-item">
                <i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span>
            </a>
            <a href="/Administrator/Destinacije" class="nav-item active">
                <i class="fa-solid fa-map-location-dot"></i> <span>Destinacije</span>
            </a>
            <a href="/Administrator/Letovi" class="nav-item">
                <i class="fa-solid fa-plane"></i> <span>Letovi</span>
            </a>
            <a href="/Administrator/Hoteli" class="nav-item">
                <i class="fa-solid fa-hotel"></i> <span>Hoteli</span>
            </a>
            <a href="/Administrator/Paketi" class="nav-item">
                <i class="fa-solid fa-cubes"></i> <span>Paketi</span>
            </a>
            <a href="/Administrator/Korisnici" class="nav-item">
                <i class="fa-solid fa-users"></i> <span>Korisnici</span>
            </a>
            <a href="/Administrator/Rezervacije" class="nav-item">
                <i class="fa-solid fa-calendar-check"></i> <span>Rezervacije</span>
            </a>
            <a href="/Administrator/Upiti" class="nav-item">
                <i class="fa-solid fa-inbox"></i> <span>Kontakt Upiti</span>
            </a>
            <a href="/Administrator/Izvjestaj" class="nav-item">
                <i class="fa-solid fa-chart-line"></i> <span>Izvještaji</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="logout-btn-nav" type="submit">Odjavi se</button>
            </form>
        </div>
    </aside>

    <main class="main-content">
        <header class="dash-header">
            <div>
                <h1>Upravljanje Destinacijama</h1>
                <p>Dodajte nove lokacije ili uredite postojeće destinacije u sistemu.</p>
            </div>
            <div>
                <a href="/Destinacije" target="_blank" class="btn-secondary-top">Pregledaj sajt</a>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }

        <section class="stats-grid">
            <div class="stat-card">
                <span>Aktivne Destinacije</span>
                <strong id="destCount">@Model.DestinacijeCount</strong>
            </div>
           
            <div class="stat-card">
                <span>Ukupno Rezervacija</span>
                <strong id="bookingCount">@Model.RezervacijeCount</strong>
            </div>
        </section>

        <div class="content-grid">
            <div class="card">
                <h2>Nova destinacija</h2>
                <form id="createDestForm" asp-controller="Administrator" asp-action="DestinacijaCreate" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="field-label">NAZIV DESTINACIJE</label>
                        <input class="input" id="inputNaziv" name="Naziv" type="text" placeholder="Npr. Rim" required maxlength="100">
                        <span id="errorNaziv" style="color:#ef4444; font-size:12px; display:none; margin-top:4px;"></span>
                    </div>

                    <div class="form-group">
                        <label class="field-label">DRŽAVA</label>
                        <input class="input" id="inputDrzava" name="Drzava" type="text" placeholder="Npr. Italija" required maxlength="100">
                        <span id="errorDrzava" style="color:#ef4444; font-size:12px; display:none; margin-top:4px;"></span>
                    </div>

                    <div class="form-group">
                        <label class="field-label">KATEGORIJA</label>
                        <input class="input" name="Kategorija" type="text" placeholder="Npr. City Break" maxlength="50">
                    </div>

                    <div class="form-group">
                        <label class="field-label">KRATKI OPIS</label>
                        <textarea class="textarea" name="Opis" placeholder="Unesite opis destinacije..." maxlength="2000"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="field-label">SLIKA PONUDE</label>
                        <input class="input" type="file" id="slikaInput" name="slika" accept="image/jpeg, image/png, image/webp">
                        <span id="slikaError" style="color:#ef4444; font-size:12px; display:none; margin-top:4px;"></span>
                    </div>

                    <button class="main-btn" type="submit" id="submitBtn">Kreiraj destinaciju</button>
                </form>
            </div>

            <div>
                <h2 style="font-size: 18px; font-weight: 600; margin-bottom: 24px;">Dostupne Destinacije</h2>

                @if (Model.Destinacije != null && Model.Destinacije.Any())
                {
                    <div class="dest-grid" id="destList">
                        @foreach (var d in Model.Destinacije)
                        {
                            <div class="dest-card-item">
                                <div class="dest-card-img-wrapper">
                                    @if (!string.IsNullOrEmpty(d.SlikaUrl))
                                    {
                                        <img src="@d.SlikaUrl" class="dest-card-img" alt="@d.Naziv" />
                                    }
                                    else
                                    {
                                        <div class="dest-card-placeholder">
                                            <i class="fa-solid fa-image"></i>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(d.Kategorija))
                                    {
                                        <span class="dest-card-badge">@d.Kategorija</span>
                                    }
                                </div>

                                <div class="dest-card-body">
                                    <h3 class="dest-card-title">@d.Naziv</h3>
                                    <div class="dest-card-location">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <span>@d.Drzava</span>
                                    </div>

                                    <div class="dest-card-actions">
                                        <a class="btn-card-action" asp-controller="Administrator" asp-action="DestinacijaEdit" asp-route-id="@d.Id">
                                            <i class="fa-regular fa-pen-to-square"></i> Uredi
                                        </a>
                                        <form asp-controller="Administrator" asp-action="DestinacijaDelete" asp-route-id="@d.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button class="btn-card-action btn-card-delete" type="submit" onclick="return confirm('PAŽNJA: Brisanjem destinacije \u201e@d.Naziv\u201c obrisat ćete i sve povezane pakete i aranžmane ako postoje! Da li ste sigurni?')">
                                                <i class="fa-regular fa-trash-can"></i> Obriši
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card" style="text-align: center; color: var(--text-muted); padding: 40px;">
                        <i class="fa-solid fa-map-route" style="font-size: 2rem; margin-bottom: 12px; color: #cbd5e1; display: block;"></i>
                        Trenutno nema dostupnih destinacija.
                    </div>
                }
            </div>
        </div>
    </main>

    <script>
            document.getElementById('slikaInput')?.addEventListener('change', function () {
                const file = this.files[0];
                const errorSpan = document.getElementById('slikaError');

                if (errorSpan) {
                    errorSpan.style.display = "none";
                    errorSpan.textContent = "";
                }

                if (file) {
                    const validTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        errorSpan.textContent = "Format fajla nije podržan. Dozvoljene su samo slike (JPG, PNG, WEBP).";
                        errorSpan.style.display = "block";
                        this.value = "";
                        return;
                    }

                    const maxSize = 5 * 1024 * 1024;
                    if (file.size > maxSize) {
                        errorSpan.textContent = "Slika je prevelika. Maksimalna dozvoljena veličina je 5MB.";
                        errorSpan.style.display = "block";
                        this.value = "";
                        return;
                    }
                }
            });

            document.getElementById('createDestForm').addEventListener('submit', function (e) {
                const nazivInput = document.getElementById('inputNaziv');
                const drzavaInput = document.getElementById('inputDrzava');
                const submitBtn = document.getElementById('submitBtn');

                const errorNaziv = document.getElementById('errorNaziv');
                const errorDrzava = document.getElementById('errorDrzava');

                let isValid = true;

                if (errorNaziv) { errorNaziv.style.display = "none"; errorNaziv.textContent = ""; }
                if (errorDrzava) { errorDrzava.style.display = "none"; errorDrzava.textContent = ""; }

                if (nazivInput && nazivInput.value.trim() === "") {
                    errorNaziv.textContent = "Naziv destinacije ne može sadržavati samo razmake.";
                    errorNaziv.style.display = "block";
                    isValid = false;
                }

                if (drzavaInput && drzavaInput.value.trim() === "") {
                    errorDrzava.textContent = "Naziv države ne može sadržavati samo razmake.";
                    errorDrzava.style.display = "block";
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();
                } else {
                    if (nazivInput) nazivInput.value = nazivInput.value.trim();
                    if (drzavaInput) drzavaInput.value = drzavaInput.value.trim();

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerText = "Kreiranje u toku...";
                    }
                }
            });

            const filterGeografskiUnos = function () {
                this.value = this.value.replace(/[0-9<>:"/\\|?*+=_@@#$%%^&*()]/g, '');
            };

            document.getElementById('inputNaziv')?.addEventListener('input', filterGeografskiUnos);
            document.getElementById('inputDrzava')?.addEventListener('input', filterGeografskiUnos);
    </script>
</body>
</html>