<body>
    @RenderBody()

    @if (User?.Identity?.IsAuthenticated == true)
    {
        var profileHref = User.IsInRole("Admin") ? "/Admin"
                        : User.IsInRole("Agent") ? "/Agent"
                        : "/";

        <div class="footer-auth-nav" style="text-align: center; padding: 20px; font-size: 14px;">
            <a id="authLink" href="@profileHref" style="margin-right: 15px;">Profil (@User.Identity.Name)</a>
            <form method="post" action="/Account/Logout" style="display:inline;">
                <button type="submit" style="cursor:pointer;">Odjava</button>
            </form>
        </div>
    }
    else
    {
        <div class="footer-auth-nav" style="text-align: center; padding: 20px;">
            <a id="authLink" href="/Korisnik/Login">Prijava</a>
        </div>
    }

    @RenderSection("Scripts", required: false)
</body>