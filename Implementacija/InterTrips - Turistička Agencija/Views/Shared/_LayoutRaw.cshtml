<body>
    @RenderBody()

    @if (User?.Identity?.IsAuthenticated == true)
    {
        var profileHref = User.IsInRole("Admin") ? "/Admin"
                        : User.IsInRole("Agent") ? "/Agent"
                        : "/";

        <a id="authLink" href="@profileHref">Profil (@User.Identity.Name)</a>
        <form method="post" action="/Account/Logout" style="display:inline;">
            <button type="submit">Odjava</button>
        </form>
    }
    else
    {
        <a id="authLink" href="/Korisnik/Login">Prijava</a>
    }
    <form method="post" action="/Account/Logout" style="display:inline;">
        <button type="submit" style="background:none;border:none;color:inherit;cursor:pointer;padding:0;">
            Odjava
        </button>
    </form>
    @RenderSection("Scripts", required: false)
</body>