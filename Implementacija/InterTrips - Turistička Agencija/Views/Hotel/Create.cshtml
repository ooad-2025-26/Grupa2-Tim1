@page
@model InterTrips___Turistička_Agencija.Models.Hotel

@{
    ViewData["Title"] = "Dodaj novi hotel";
}

<div class="container mt-4">
    <h2>Dodaj novi hotel</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Naziv" class="control-label">Naziv hotela</label>
                    <input asp-for="Naziv" class="form-control" placeholder="Unesite naziv hotela" />
                    <span asp-validation-for="Naziv" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Lokacija" class="control-label">Adresa</label>
                    <input asp-for="Lokacija" class="form-control" placeholder="Unesite adresu hotela" />
                    <span asp-validation-for="Lokacija" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BrojZvjezdica" class="control-label">Broj zvjezdica (1-5)</label>
                    <input asp-for="BrojZvjezdica" type="number" class="form-control" min="1" max="5" />
                    <span asp-validation-for="BrojZvjezdica" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Spasi hotel</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Nazad na listu</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}