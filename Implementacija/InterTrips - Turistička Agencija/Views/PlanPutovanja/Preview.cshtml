@model InterTrips___Turistička_Agencija.Models.PlanPutovanjaTemplate
@{
    ViewData["Title"] = "Plan putovanja";
    Layout = "_Layout";
}

<style>
    .hero-banner {
        background: linear-gradient(rgba(26, 63, 66, 0.4), rgba(26, 63, 66, 0.65)), url('/assets/world-map-bg.jpg') center/cover no-repeat;
        position: relative;
        padding: 80px 18px;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 0 0 30px 30px;
    }

    .hero-glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 24px;
        padding: 35px 50px;
        max-width: 800px;
        width: 100%;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .package-badge {
        display: inline-block;
        background: rgba(106, 191, 198, 0.15);
        color: #1a3f42;
        padding: 6px 16px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 16px;
        border: 1px solid rgba(106, 191, 198, 0.25);
    }

    .main-title {
        font-size: 38px;
        font-weight: 800;
        color: #1a3f42;
        margin: 0 0 12px 0;
        letter-spacing: -0.5px;
    }

    .subtitle-info {
        font-size: 15px;
        color: #555;
        font-weight: 500;
        margin: 0;
        line-height: 1.5;
    }

    .itinerary-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 40px 18px 60px 18px;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #738a8c;
        font-weight: 600;
        background: #fff;
        border-radius: 16px;
        border: 1px dashed rgba(95, 181, 187, 0.3);
    }

    .note-box {
        margin-bottom: 35px;
        padding: 20px;
        border-radius: 16px;
        border-left: 5px solid #6abfc6;
        background: #fff;
        box-shadow: 0 10px 25px rgba(95, 181, 187, 0.05);
    }

    .note-title {
        color: #1a3f42;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .note-text {
        font-size: 14px;
        color: #555;
        line-height: 1.6;
        white-space: pre-line;
    }

    .timeline {
        position: relative;
        margin-top: 20px;
        padding-left: 20px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 3px;
            background: linear-gradient(to bottom, #6abfc6 0%, rgba(134, 191, 224, 0.2) 100%);
            border-radius: 999px;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 25px;
        padding: 24px;
        border-radius: 18px;
        border: 1px solid rgba(95, 181, 187, 0.12);
        background: #ffffff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.015);
        transition: all 0.3s ease;
    }

        .timeline-item:hover {
            transform: translateX(4px);
            border-color: rgba(106, 191, 198, 0.4);
            box-shadow: 0 12px 28px rgba(95, 181, 187, 0.06);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -25px;
            top: 28px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #6abfc6;
            border: 3px solid #fff;
            box-shadow: 0 0 0 3px rgba(106, 191, 198, 0.25);
            z-index: 2;
        }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .day-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a3f42;
        letter-spacing: -0.3px;
    }

    .time-badge {
        color: #4d7073;
        font-weight: 700;
        background: rgba(106, 191, 198, 0.12);
        padding: 5px 14px;
        border-radius: 8px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .day-description {
        margin-top: 12px;
        color: #555;
        line-height: 1.65;
        font-size: 14.5px;
    }

    .back-wrapper {
        margin-top: 35px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 26px;
        border-radius: 30px;
        background: linear-gradient(135deg, #6abfc6, #50a2a8);
        color: #fff !important;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(106, 191, 198, 0.3);
        transition: all 0.2s ease;
    }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(106, 191, 198, 0.45);
        }
</style>

<header class="hero-banner">
    <div class="hero-glass-card">
        @if (Model != null)
        {
            <span class="package-badge">
                @{
                    var nazivPaketa = Model.Paket?.Naziv ?? $"Paket #{Model.PaketId}";
                }
                @nazivPaketa.ToUpper()
            </span>
        }
        else
        {
            <span class="package-badge" style="background: rgba(198,40,40,0.1); color: #c62828;">GREŠKA</span>
        }

        <h1 class="main-title">Plan putovanja</h1>

        <p class="subtitle-info">
            @if (Model?.Paket?.Destinacija != null)
            {
                <span>Pogledajte detaljan pregled aktivnosti i plan putovanja za destinaciju <strong>@Model.Paket.Destinacija.Naziv</strong> (@Model.Paket.Destinacija.Drzava).</span>
            }
            else
            {
                <span>Odaberite destinaciju putovanja, pogledajte plan i aktivnosti po danima.</span>
            }
        </p>
    </div>
</header>

<div class="itinerary-container">

    @if (Model == null)
    {
        <div class="empty-state">
            Nema definisanog plana putovanja za ovaj paket.
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Napomena))
        {
            <div class="note-box">
                <span class="note-title">📌 Važne napomene:</span>
                <div class="note-text">@Model.Napomena</div>
            </div>
        }

        @if (Model.Stavke == null || !Model.Stavke.Any())
        {
            <div class="empty-state">
                🗓️ Plan i program putovanja će uskoro biti objavljen.
            </div>
        }
        else
        {
            <div class="timeline">
                @foreach (var s in Model.Stavke.OrderBy(x => x.RedniBroj))
                {
                    <div class="timeline-item">
                        <div class="timeline-header">
                            <div class="day-title">
                                Dan @s.RedniBroj: @s.Naziv
                            </div>
                            @if (s.Vrijeme.HasValue)
                            {
                                <div class="time-badge">
                                    🕒 @s.Vrijeme.Value.ToString(@"hh\:mm")
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(s.Opis))
                        {
                            <div class="day-description">
                                @s.Opis
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    <div class="back-wrapper">
        <a class="btn-back" href="javascript:history.back()">← Nazad na paket</a>
    </div>
</div>