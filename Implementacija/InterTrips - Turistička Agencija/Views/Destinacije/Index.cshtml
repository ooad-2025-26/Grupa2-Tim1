
@{
    ViewData["Title"] = "Turističke destinacije";
    Layout = "_Layout";
}

@functions {
    string ImgFor(string? destName)
    {
        var n = (destName ?? "").ToLowerInvariant();
        if (n.Contains("santorini")) return "/assets/destination1.jpg";
        if (n.Contains("kyoto")) return "/assets/destination2.jpg";
        if (n.Contains("machu")) return "/assets/destination3.jpg";
        if (n.Contains("dubai")) return "/assets/destination4.jpg";
        if (n.Contains("paris")) return "/assets/destination5.jpg";
        if (n.Contains("bali")) return "/assets/destination6.jpg";
        return "/assets/destination1.jpg";
    }
}


<style>
    :root {
        --bg: #eaf7f7;
        --bg-soft: #f6fcfc;
        --card: rgba(255,255,255,0.82);
        --line: rgba(95,181,187,0.16);
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --accent: #86d9ff;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 16px 36px rgba(63,116,128,0.10);
        --field: rgba(255,255,255,0.92);
        --success: #36d399;
        --danger: #ff8fa3;
    }

    .hero {
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(rgba(125,207,207,0.16), rgba(167,216,255,0.18)), url('/assets/destinations-hero.jpg') center/cover no-repeat;
        border-bottom: 1px solid rgba(95,181,187,0.10);
        padding: 40px 18px;
    }

        .hero > div {
            background: rgba(255,255,255,0.68);
            border: 1px solid rgba(95,181,187,0.14);
            padding: 28px 24px;
            border-radius: 22px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(8px);
            max-width: 760px;
        }

    .tag {
        display: inline-block;
        padding: 5px 14px;
        border: 1px solid rgba(95,181,187,0.35);
        border-radius: 999px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .6px;
        margin-bottom: 14px;
        background: rgba(125,207,207,0.10);
    }

    .hero h1 {
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.05;
        font-weight: 800;
        margin-bottom: 12px;
        color: var(--text);
    }

        .hero h1 span {
            color: var(--primary-dark);
        }

    .hero p {
        max-width: 700px;
        margin: 0 auto;
        color: var(--muted);
        line-height: 1.7;
        font-size: 14px;
    }

    .section {
        padding: 28px 24px 56px;
    }

    .container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .filters {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 18px;
    }

    .search {
        width: 290px;
        max-width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.84);
        border: 1px solid rgba(95,181,187,0.18);
        border-radius: 999px;
        padding: 0 14px;
        height: 40px;
        box-shadow: var(--shadow);
    }

        .search input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 13px;
        }

    .chip-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .chip {
        border: 1px solid rgba(95,181,187,0.18);
        background: rgba(255,255,255,0.75);
        color: rgba(36,65,74,0.82);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 12px;
        cursor: pointer;
    }

        .chip.active {
            background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
            color: #18424a;
            border-color: transparent;
            font-weight: 700;
        }

    .section-title {
        margin: 22px 0 20px;
        color: var(--muted);
        font-size: 13px;
    }

        .section-title strong {
            color: var(--primary-dark);
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .card {
        background: var(--card);
        border: 1px solid rgba(95,181,187,0.14);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        min-height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(63,116,128,0.15);
        }

        .card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
            display: block;
        }

    .card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .tag-small {
        display: inline-block;
        background: rgba(125,207,207,0.12);
        border: 1px solid rgba(95,181,187,0.16);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .rating {
        background: rgba(30,127,136,0.10);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .card h3 {
        font-size: 18px;
        margin-top: 2px;
        color: var(--text);
    }

    .country {
        font-size: 12px;
        color: var(--muted);
    }

    .desc {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.7;
        min-height: 54px;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        margin-top: auto;
        padding-top: 10px;
    }

        .price-row .from {
            font-size: 12px;
            color: var(--muted);
        }

    .price {
        color: var(--primary-dark);
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
    }

    .status {
        display: inline-block;
        margin-top: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        width: fit-content;
    }

        .status.available {
            background: rgba(54,211,153,0.12);
            color: #1f8f68;
            border: 1px solid rgba(54,211,153,0.25);
        }

        .status.soldout {
            background: rgba(255,143,163,0.12);
            color: #c04f67;
            border: 1px solid rgba(255,143,163,0.25);
        }

    .reserve-btn {
        margin-top: 10px;
        width: 100%;
        height: 44px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
        color: #18424a;
        font-weight: 800;
        cursor: pointer;
        transition: filter 0.2s ease;
    }

        .reserve-btn:hover {
            filter: brightness(1.03);
        }

    @@media (max-width: 980px) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 700px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .section {
            padding: 22px 16px 48px;
        }
    }
</style>

<section class="hero">
    <div>
        <div class="tag">TURISTIČKE DESTINACIJE</div>
        <h1>Pregled <span>destinacija</span></h1>
        <p>Odaberite destinaciju putovanja, pogledajte cijenu, trajanje i dostupnost, te nastavite na proces rezervacije.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="filters">
            <div class="search">
                <span style="color:var(--primary-dark); font-size:14px;">⌕</span>
                <input type="text" placeholder="Pretražite pakete...">
            </div>

            <div class="chip-row">
                <button class="chip active">Sve destinacije</button>
            </div>
        </div>

        <div class="section-title">Prikazano <strong>@Model.Count</strong> turističkih paketa</div>

        <div class="grid">
            @foreach (var p in Model)
            {
                <article class="card">
                    <img src="@ImgFor(p.Destinacija?.Naziv)" alt="@p.Naziv">
                    <div class="card-body">
                        <div class="card-top">
                            <span class="tag-small">
                                @(string.IsNullOrWhiteSpace(p.Destinacija?.Kategorija) ? "Paket" : p.Destinacija!.Kategorija)
                            </span>
                            <span class="rating">★ 4.8</span>
                        </div>

                        <h3>@p.Naziv</h3>

                        <div class="country">
                            @p.Destinacija?.Drzava • @p.TrajanjeNoci noći
                        </div>

                        <div class="desc">
                            @(string.IsNullOrWhiteSpace(p.Destinacija?.Opis) ? "Opis nije unesen." : p.Destinacija!.Opis)
                        </div>

                        <div class="status @(p.Status == InterTrips___Turistička_Agencija.Enums.StatusPaketa.Dostupan ? "available" : "soldout")">
                            @(p.Status == InterTrips___Turistička_Agencija.Enums.StatusPaketa.Dostupan ? "Dostupan" : "Rasprodano")
                        </div>

                        <div class="price-row">
                            <div class="from">Od</div>
                            <div class="price">@p.CijenaOd.ToString("0.##") BAM</div>
                        </div>

                        <button class="reserve-btn" onclick="window.location.href='/Rezervacija/Rezervacija?paketId=@p.Id'">
                            Rezerviši paket
                        </button>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
<footer class="footer">
    <div class="footer-grid">
        <div>
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
            </a>
            <p>Otkrijte najbolje destinacije na svijetu.</p>
        </div>

        <div>
            <h4>Istraži</h4>
            <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
            <a href="#">Putni vodiči</a>
            <a href="#">Najbolja iskustva</a>
        </div>

        <div>
            <h4>Kompanija</h4>
            <a asp-controller="Home" asp-action="ONama">O nama</a>
            <a href="#">Karijere</a>
            <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>
        </div>

        <div>
            <h4>Podrška</h4>
            <a href="#">Centar za pomoć</a>
            <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
            <a href="#">Uvjeti korištenja</a>
        </div>
    </div>
    <div class="footer-bottom">© 2026 InterTrips. Sva prava zadržana.</div>
</footer>