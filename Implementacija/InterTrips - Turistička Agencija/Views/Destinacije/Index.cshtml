@model IEnumerable<InterTrips___Turistička_Agencija.Models.Paket>

@{
    ViewData["Title"] = "Turističke destinacije";
    Layout = "_Layout";
}

<style>
    :root {
        --bg: #eaf7f7;
        --bg-soft: #f6fcfc;
        --card: rgba(255,255,255,0.82);
        --line: rgba(95,181,187,0.16);
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --accent: #86d9ff;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 16px 36px rgba(63,116,128,0.10);
        --field: rgba(255,255,255,0.92);
        --success: #36d399;
        --danger: #ff8fa3;
        --top10-dark: #1d3b41;
        --top10-card: #244950;
        --top10-gold: #f8be21;
    }

    .hero {
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(rgba(125,207,207,0.16), rgba(167,216,255,0.18)), url('/assets/destinations-hero.jpg') center/cover no-repeat;
        border-bottom: 1px solid rgba(95,181,187,0.10);
        padding: 40px 18px;
    }

        .hero > div {
            background: rgba(255,255,255,0.68);
            border: 1px solid rgba(95,181,187,0.14);
            padding: 28px 24px;
            border-radius: 22px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(8px);
            max-width: 760px;
        }

    .tag {
        display: inline-block;
        padding: 5px 14px;
        border: 1px solid rgba(95,181,187,0.35);
        border-radius: 999px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .6px;
        margin-bottom: 14px;
        background: rgba(125,207,207,0.10);
    }

    .hero h1 {
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.05;
        font-weight: 800;
        margin-bottom: 12px;
        color: var(--text);
    }

        .hero h1 span {
            color: var(--primary-dark);
        }

    .hero p {
        max-width: 700px;
        margin: 0 auto;
        color: var(--muted);
        line-height: 1.7;
        font-size: 14px;
    }

    .section {
        padding: 28px 24px 56px;
    }

    .container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .top10-wrapper {
        background: var(--top10-dark);
        padding: 35px;
        border-radius: 24px;
        margin-bottom: 45px;
        box-shadow: 0 20px 40px rgba(29,59,65,0.25);
    }

    .top10-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .top10-title {
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
        margin: 4px 0 0 0;
    }

    .top10-controls {
        display: flex;
        gap: 8px;
    }

    .top10-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.25);
        background: transparent;
        color: #ffffff;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

        .top10-btn:hover:not(:disabled) {
            background: var(--top10-gold);
            border-color: var(--top10-gold);
            color: var(--top10-dark);
        }

        .top10-btn:disabled {
            opacity: 0.15;
            cursor: not-allowed;
        }

    .top10-container {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding: 10px 2px;
    }

    .top10-slider {
        display: flex;
        gap: 20px;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        width: 100%;
    }

    .top10-card {
        flex: 0 0 calc(33.333% - 14px);
        box-sizing: border-box;
        background: var(--top10-card);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.04);
        position: relative;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .top10-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3);
            border-color: rgba(248,190,33,0.25);
        }

    .top10-img-container {
        position: relative;
        width: 100%;
        height: 190px;
        overflow: hidden;
    }

    .top10-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .badge-rank {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(29, 59, 65, 0.8);
        backdrop-filter: blur(6px);
        color: var(--top10-gold);
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        border: 1px solid rgba(248,190,33,0.25);
    }

    .top10-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 8px;
    }

    .top10-meta {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--top10-gold);
        letter-spacing: 0.5px;
    }

    .top10-card h4 {
        color: #ffffff;
        margin: 2px 0 0 0;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.4;
    }

    .top10-loc {
        color: #a0b0b5;
        font-size: 13px;
    }

    .top10-footer {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .top10-price {
        color: #ffffff;
        font-size: 18px;
        font-weight: 800;
    }

    .top10-btn-action {
        background: var(--top10-gold);
        color: var(--top10-dark);
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease;
    }

        .top10-btn-action:hover {
            background: #e2ad1e;
        }

    .filters {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 18px;
    }

    .search {
        width: 290px;
        max-width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.84);
        border: 1px solid rgba(95,181,187,0.18);
        border-radius: 999px;
        padding: 0 14px;
        height: 40px;
        box-shadow: var(--shadow);
    }

        .search input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 13px;
        }

    .chip-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .chip {
        border: 1px solid rgba(95,181,187,0.18);
        background: rgba(255,255,255,0.75);
        color: rgba(36,65,74,0.82);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 12px;
        cursor: pointer;
    }

        .chip.active {
            background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
            color: #18424a;
            border-color: transparent;
            font-weight: 700;
        }

    .section-title {
        margin: 22px 0 20px;
        color: var(--muted);
        font-size: 13px;
    }

        .section-title strong {
            color: var(--primary-dark);
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .card {
        background: var(--card);
        border: 1px solid rgba(95,181,187,0.14);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        min-height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(63,116,128,0.15);
        }

        .card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
            display: block;
        }

    .card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .tag-small {
        display: inline-block;
        background: rgba(125,207,207,0.12);
        border: 1px solid rgba(95,181,187,0.16);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .rating {
        background: rgba(30,127,136,0.10);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .card h3 {
        font-size: 18px;
        margin-top: 2px;
        color: var(--text);
    }

    .country {
        font-size: 12px;
        color: var(--muted);
    }

    .desc {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.7;
        min-height: 54px;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        margin-top: auto;
        padding-top: 10px;
    }

        .price-row .from {
            font-size: 12px;
            color: var(--muted);
        }

    .price {
        color: var(--primary-dark);
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
    }

    .status {
        display: inline-block;
        margin-top: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        width: fit-content;
    }

        .status.available {
            background: rgba(54,211,153,0.12);
            color: #1f8f68;
            border: 1px solid rgba(54,211,153,0.25);
        }

        .status.soldout {
            background: rgba(255,143,163,0.12);
            color: #c04f67;
            border: 1px solid rgba(255,143,163,0.25);
        }

    .reserve-btn {
        margin-top: 10px;
        width: 100%;
        height: 44px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
        color: #18424a;
        font-weight: 800;
        cursor: pointer;
        transition: filter 0.2s ease;
    }

        .reserve-btn:hover:not(:disabled) {
            filter: brightness(1.03);
        }

        .reserve-btn:disabled {
            background: #ccc;
            color: #666;
            cursor: not-allowed;
            filter: none;
        }

    /* Elegantni stilovi za vremenski timeline polaska i dolaska */
    .travel-timeline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(95, 181, 187, 0.05);
        border: 1px dashed rgba(95, 181, 187, 0.2);
        border-radius: 10px;
        padding: 8px 12px;
        margin: 6px 0;
        font-size: 12px;
    }

    .timeline-point {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .timeline-point .label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--muted);
            font-weight: 600;
        }

    .top10-card .timeline-point .label {
        color: #a0b0b5;
    }

    .timeline-point .time {
        font-weight: 700;
        color: var(--text);
    }

    .top10-card .timeline-point .time {
        color: #ffffff;
    }

    .timeline-arrow {
        color: var(--primary);
        font-size: 14px;
        opacity: 0.7;
        padding: 0 4px;
    }

    @@media (max-width: 980px) {
        .grid, .top10-slider .top10-card {
            grid-template-columns: 1fr 1fr;
        }

        .top10-slider .top10-card {
            flex: 0 0 calc(50% - 10px);
        }
    }

    @@media (max-width: 700px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .top10-slider .top10-card {
            flex: 0 0 100%;
        }

        .section {
            padding: 22px 16px 48px;
        }
    }
</style>

<section class="hero">
    <div>
        <div class="tag">TURISTIČKE DESTINACIJE</div>
        <h1>Pregled <span>destinacija</span></h1>
        <p>Odaberite destinaciju putovanja, pogledajte cijenu, trajanje i dostupnost, te nastavite na proces rezervacije.</p>
    </div>
</section>

<section class="section">
    <div class="container">

        @if (ViewBag.OoadTop10 != null)
        {
            var top10Paketi = (List<InterTrips___Turistička_Agencija.Models.Paket>)ViewBag.OoadTop10;

            <div class="top10-wrapper">
                <div class="top10-header">
                    <div>
                        <span style="color: var(--top10-gold); font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">ALGORITAMSKI RANGIRANO • TOP 10 NAJTRAŽENIJIH</span>
                        <h3 class="top10-title" style="color: #ffffff;">Ekskluzivni <em style="color: var(--top10-gold); font-style: normal; font-weight: 800;">Top 10</em> Paketi</h3>
                    </div>
                    <div class="top10-controls">
                        <button class="top10-btn" id="topPrev" type="button">‹</button>
                        <button class="top10-btn" id="topNext" type="button">›</button>
                    </div>
                </div>

                <div class="top10-container">
                    <div class="top10-slider" id="top10Slider">
                        @{
                            int brojac = 1;
                        }
                        @foreach (var p in top10Paketi)
                        {
                            int rezervisanoTop = p.Rezervacije?.Count ?? 0;
                            bool jePopunjenTop = p.Kapacitet > 0 && rezervisanoTop >= p.Kapacitet;

                            double fiksnaOcjena = 4.8;
                            double izracunatiScore = (rezervisanoTop * 0.7) + (fiksnaOcjena * 0.3);

                            <div class="top10-card">
                                <div class="badge-rank">
                                    <span style="color:var(--top10-gold); font-weight:900;">#@brojac</span> RANG LISTA
                                </div>
                                <div class="top10-img-container">
                                    <img src="@(string.IsNullOrEmpty(p.Destinacija?.SlikaUrl) ? "/assets/destination1.jpg" : p.Destinacija.SlikaUrl)" alt="@p.Naziv">
                                </div>
                                <div class="top10-body">
                                    <div class="top10-meta">
                                        <span>@(string.IsNullOrWhiteSpace(p.Destinacija?.Kategorija) ? "Premium" : p.Destinacija.Kategorija)</span>
                                        <span style="color: var(--top10-gold); background: rgba(248,190,33,0.15); padding: 2px 8px; border-radius: 12px; font-size:10px;">
                                            Score: @izracunatiScore.ToString("0.0")
                                        </span>
                                    </div>
                                    <h4>@p.Naziv</h4>
                                    <div class="top10-loc">
                                        @p.Destinacija?.Drzava • @p.TrajanjeNoci noći
                                    </div>

                                    <div class="travel-timeline">
                                        <div class="timeline-point">
                                            <span class="label">Polazak</span>
                                            <span class="time">@(p.DatumPolaska != null ? ((DateTime)p.DatumPolaska).ToString("dd.MM.yyyy. u HH:mm") : "--:--")</span>
                                        </div>
                                        <div class="timeline-arrow">➔</div>
                                        <div class="timeline-point" style="text-align: right;">
                                            <span class="label">Povratak</span>
                                            <span class="time">@(p.DatumPolaska != null ? ((DateTime)p.DatumPolaska).AddDays(p.TrajanjeNoci).ToString("dd.MM.yyyy.") : "--:--")</span>
                                        </div>
                                    </div>

                                    <div class="top10-footer">
                                        <div class="top10-price">@p.CijenaOd.ToString("0.##") BAM</div>
                                        @if (jePopunjenTop)
                                        {
                                            <a href="javascript:void(0);" class="top10-btn-action" style="background: #555; color: #aaa; cursor: not-allowed; pointer-events: none;">Popunjeno</a>
                                        }
                                        else
                                        {
                                            <a href="/Rezervacija/Rezervacija?paketId=@p.Id" class="top10-btn-action">Rezerviši</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            brojac++;
                        }
                    </div>
                </div>
            </div>
        }

        <div class="filters">
            <div class="search">
                <span style="color:var(--primary-dark); font-size:14px;">⌕</span>
                <input type="text" placeholder="Pretražite pakete...">
            </div>

            <div class="chip-row">
                <button class="chip active">Sve destinacije</button>
            </div>
        </div>

        <div class="section-title">Prikazano <strong>@Model.Count()</strong> turističkih paketa</div>

        <div class="grid">
            @foreach (var p in Model)
            {
                int trenutneRezervacije = p.Rezervacije?.Count ?? 0;
                bool jePopunjen = trenutneRezervacije >= p.Kapacitet;

                <article class="card">
                    <img src="@(string.IsNullOrEmpty(p.Destinacija?.SlikaUrl) ? "/assets/destination1.jpg" : p.Destinacija.SlikaUrl)" alt="@p.Naziv">
                    <div class="card-body">
                        <div class="card-top">
                            <span class="tag-small">
                                @(string.IsNullOrWhiteSpace(p.Destinacija?.Kategorija) ? "Paket" : p.Destinacija!.Kategorija)
                            </span>
                            <span class="rating">★ 4.8</span>
                        </div>

                        <h3>@p.Naziv</h3>

                        <div class="country">
                            @p.Destinacija?.Drzava • @p.TrajanjeNoci noći
                        </div>

                        <div class="travel-timeline">
                            <div class="timeline-point">
                                <span class="label">Polazak</span>
                                <span class="time">@(p.DatumPolaska != null ? ((DateTime)p.DatumPolaska).ToString("dd.MM.yyyy. u HH:mm") : "--:--")</span>
                            </div>
                            <div class="timeline-arrow">➔</div>
                            <div class="timeline-point" style="text-align: right;">
                                <span class="label">Povratak</span>
                                <span class="time">@(p.DatumPolaska != null ? ((DateTime)p.DatumPolaska).AddDays(p.TrajanjeNoci).ToString("dd.MM.yyyy.") : "--:--")</span>
                            </div>
                        </div>

                        <div class="desc">
                            @(string.IsNullOrWhiteSpace(p.Destinacija?.Opis) ? "Opis nije unesen." : p.Destinacija!.Opis)
                        </div>

                        @if (jePopunjen)
                        {
                            <div class="status soldout">
                                Popunjeno
                            </div>
                        }

                        <div class="price-row">
                            <div class="from">Od</div>
                            <div class="price">@p.CijenaOd.ToString("0.##") BAM</div>
                        </div>

                        @if (jePopunjen)
                        {
                            <button class="reserve-btn" disabled>
                                Popunjeno
                            </button>
                        }
                        else
                        {
                            <button class="reserve-btn" onclick="window.location.href='/Rezervacija/Rezervacija?paketId=@p.Id'">
                                Rezerviši paket
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<footer class="footer">
    <div class="footer-grid">
        <div>
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
            </a>
            <p>Otkrijte najbolje destinacije na svijetu.</p>
        </div>

        <div>
            <h4>Istraži</h4>
            <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
        </div>

        <div>
            <h4>Kompanija</h4>
            <a asp-controller="Home" asp-action="ONama">O nama</a>
            <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>
        </div>

        <div>
            <h4>Podrška</h4>
            <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
        </div>
    </div>
    <div class="footer-bottom">© 2026 InterTrips. Sva prava zadržana.</div>
</footer>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const slider = document.getElementById('top10Slider');
        const prevBtn = document.getElementById('topPrev');
        const nextBtn = document.getElementById('topNext');

        if (!slider || !prevBtn || !nextBtn) return;

        let currentIndex = 0;

        function getCardsPerView() {
            if (window.innerWidth <= 700) return 1;
            if (window.innerWidth <= 980) return 2;
            return 3;
        }

        function updateSlider() {
            const cards = slider.querySelectorAll('.top10-card');
            if (cards.length === 0) return;

            const perView = getCardsPerView();
            const maxIdx = Math.max(0, cards.length - perView);

            if (currentIndex > maxIdx) currentIndex = maxIdx;

            const cardWidth = cards[0].getBoundingClientRect().width;
            const gap = 20;

            slider.style.transform = `translateX(-${currentIndex * (cardWidth + gap)}px)`;

            prevBtn.disabled = currentIndex === 0;
            nextBtn.disabled = currentIndex >= maxIdx;
        }

        nextBtn.addEventListener('click', function () {
            const cards = slider.querySelectorAll('.top10-card');
            if (currentIndex < cards.length - getCardsPerView()) {
                currentIndex++;
                updateSlider();
            }
        });

        prevBtn.addEventListener('click', function () {
            if (currentIndex > 0) {
                currentIndex--;
                updateSlider();
            }
        });

        window.addEventListener('resize', updateSlider);
        setTimeout(updateSlider, 250);
    });
</script>