@model IEnumerable<InterTrips___Turistička_Agencija.Models.Paket>

@{
    ViewData["Title"] = "InterTrips - Početna";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<style>
    .hero-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        align-items: center;
        margin-top: 30px;
        margin-bottom: 40px;
        width: 100%;
    }

    .btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 14px 28px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        text-align: center;
        min-width: 200px;
    }

    .btn-gold {
        background-color: #f8be21;
        color: #1d3b41;
        border: 2px solid #f8be21;
    }

    .btn-light {
        background-color: transparent;
        color: #ffffff;
        border: 2px solid #ffffff;
    }

        .btn-light:hover {
            background-color: #ffffff;
            color: #1d3b41;
            transform: translateY(-2px);
        }

    .btn-gold:hover {
        background-color: #e2ad1e;
        border-color: #e2ad1e;
        transform: translateY(-2px);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .section-header .see-all {
            color: #f8be21;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: var(--transition);
        }

            .section-header .see-all:hover {
                text-decoration: underline;
            }

    .slider-controls {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .slider-btn {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 2px solid #ffffff;
        background: transparent;
        color: #ffffff;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease-in-out;
        user-select: none;
    }

        .slider-btn:hover {
            background: #f8be21;
            border-color: #f8be21;
            color: #1d3b41;
            transform: translateY(-2px);
        }

        .slider-btn:disabled {
            opacity: 0.2 !important;
            cursor: not-allowed !important;
            transform: none !important;
        }

    .slider-container {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding: 10px 0;
    }

    .destinations-slider {
        display: flex;
        gap: 24px;
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        width: 100%;
    }

        .destinations-slider .card {
            flex: 0 0 calc(33.333% - 16px);
            box-sizing: border-box;
            background: #244950;
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

            .destinations-slider .card img {
                width: 100%;
                height: 220px;
                object-fit: cover;
            }

    .card-content {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-bottom-action {
        margin-top: auto;
        padding-top: 15px;
    }

    .btn-card-reserve {
        display: block;
        width: 100%;
        padding: 11px;
        background-color: #f8be21;
        color: #1d3b41;
        text-align: center;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s;
    }

        .btn-card-reserve:hover {
            background-color: #e2ad1e;
            transform: translateY(-1px);
        }

    .testimonials-grid {
        display: flex;
        gap: 24px;
        width: 100%;
        margin-top: 30px;
    }

    .testimonial {
        flex: 0 0 calc(33.333% - 16px);
        box-sizing: border-box;
        background: #244950;
        padding: 30px;
        border-radius: 12px;
        margin: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

        .testimonial p {
            font-style: italic;
            line-height: 1.6;
            color: #e0e0e0;
            margin-bottom: 20px;
        }

    .stars {
        color: #f8be21;
        font-size: 18px;
        margin-bottom: 15px;
    }

    .testimonial-user {
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .testimonial-user img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #f8be21;
        }

        .testimonial-user footer {
            font-weight: bold;
            color: #ffffff;
            font-size: 15px;
        }

        .testimonial-user span {
            font-size: 13px;
            color: #a0b0b5;
            display: block;
        }

    @@media (max-width: 992px) {
        .destinations-slider .card,
        .testimonial {
            flex: 0 0 calc(50% - 12px);
        }

        .testimonials-grid {
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 600px) {
        .destinations-slider .card,
        .testimonial {
            flex: 0 0 100%;
        }
    }

    .cta-box {
        position: relative;
        background: url('/assets/cta.jpg') center/cover no-repeat !important;
        border-radius: 22px;
        padding: 40px;
        min-height: 260px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        overflow: hidden;
    }

        .cta-box::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
            z-index: 1;
        }

        .cta-box > div,
        .cta-box .btn {
            position: relative;
            z-index: 2;
        }

        .cta-box h3 {
            color: #ffffff !important;
            font-size: clamp(1.5rem, 2.5vw, 1.8rem) !important;
            font-weight: 700 !important;
            line-height: 1.3 !important;
            margin-bottom: 8px;
        }

        .cta-box p {
            color: rgba(255, 255, 255, 0.9) !important;
            font-size: 14px !important;
        }

        .cta-box .section-label {
            color: #f8be21 !important;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 6px;
        }

    .full-width-footer {
        background-color: #1d3b41; 
        width: 100%;
        padding: 60px 20px 30px 20px;
        margin-top: 50px;
    }

    .footer-content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
    }
</style>

<div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="badge">ISTRAŽITE SVIJET</span>
        <h1>REZERVIŠITE PUTOVANJE</h1>
        <h2>uz InterTrips sistem</h2>
        <p>Otkrijte pažljivo odabrane destinacije, jedinstvena putna iskustva i nezaboravna putovanja širom svijeta.</p>

        <div class="hero-actions">
            <a class="btn btn-gold" asp-controller="Destinacije" asp-action="Index">Istražite destinacije</a>
            <a class="btn btn-light" asp-controller="Destinacije" asp-action="Index">Pogledajte istaknuta putovanja</a>
        </div>

        <div class="hero-stats">
            <div class="stat"><strong>120+</strong><span>Destinacija</span></div>
            <div class="stat"><strong>50K+</strong><span>Zadovoljnih putnika</span></div>
            <div class="stat"><strong>4.9/5</strong><span>Prosječna ocjena</span></div>
        </div>
    </div>
</div>

<main style="padding: 40px 20px; max-width: 1200px; margin: 0 auto;">

    <section class="section section-dark" style="background: #1d3b41; padding: 40px; border-radius: 22px; margin-bottom: 50px;">
        <div class="section-header">
            <div>
                <span class="section-label" style="color:#f8be21; font-weight:700; font-size:12px; letter-spacing:1px; display:block;">ODABRANO ZA VAS</span>
                <h3 style="color:#ffffff; margin: 5px 0 0 0; font-size:28px;">Istaknute <em style="color:#f8be21; font-style:normal;">destinacije</em></h3>
            </div>
            <div style="display: flex; align-items: center; gap: 25px;">
                <a asp-controller="Destinacije" asp-action="Index" class="see-all">Pogledajte sve destinacije →</a>
                <div class="slider-controls">
                    <button class="slider-btn" id="prevBtn" type="button">&larr;</button>
                    <button class="slider-btn" id="nextBtn" type="button">&rarr;</button>
                </div>
            </div>
        </div>

        <div class="slider-container">
            <div class="destinations-slider" id="destinationsSlider">
                @if (Model != null && Model.Any())
                {
                    @foreach (var stavka in Model)
                    {
                        <article class="card">
                            @{
                                var slika = !string.IsNullOrEmpty(stavka.SlikaUrl) ? stavka.SlikaUrl :
                                            (!string.IsNullOrEmpty(stavka.Destinacija?.SlikaUrl) ? stavka.Destinacija.SlikaUrl : "/assets/default-destination.jpg");
                            }
                            <img src="@slika" alt="@stavka.Naziv">

                            <div class="card-content">
                                <div class="card-top" style="display:flex; justify-content:space-between; margin-bottom:10px; color:#a0b0b5; font-size:13px;">
                                    <span class="tag" style="background:rgba(248,190,33,0.2); color:#f8be21; padding:3px 8px; border-radius:4px;">@(stavka.Destinacija?.Kategorija ?? "Preporučeno")</span>
                                    <span class="rating" style="color:#f8be21;">★ 4.8</span>
                                </div>
                                <h4 style="color:#ffffff; margin:0 0 8px 0; font-size:18px;">@stavka.Naziv</h4>
                                <p style="color:#a0b0b5; font-size:14px; margin:0 0 15px 0;">@(stavka.Destinacija?.Drzava ?? "Nepoznato")</p>

                                <div class="card-bottom-action">
                                    <a asp-controller="Rezervacija" asp-action="Rezervacija" asp-route-id="@stavka.Id" class="btn-card-reserve">
                                        Rezerviši putovanje
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <p style="padding: 40px; color: #ffffff; text-align: center; width: 100%; font-weight: 500;">
                        Trenutno nema istaknutih destinacija u bazi podataka.
                    </p>
                }
            </div>
        </div>
    </section>

    <section class="section" style="margin-bottom: 50px;">
        <div class="center-title" style="text-align:center; margin-bottom:30px;">
            <span class="section-label" style="color:#2aa9b0; font-weight:700; font-size:12px; letter-spacing:1px;">ZAŠTO INTERTRIPS</span>
            <h3 style="color:#1d3b41; font-size:28px; margin-top:5px;">Putujte pametnije, <em style="color:#2aa9b0; font-style:normal;">doživite više</em></h3>
        </div>
        <div class="features-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:24px;">
            <div class="feature-card" style="background:#244950; padding:25px; border-radius:12px; color:#ffffff;">
                <h4 style="margin-top:0; color:#f8be21;">Pažljivo odabrana iskustva</h4>
                <p style="color:#e0e0e0; font-size:14px; margin-bottom:0;">Svakom destinacijom vodimo računa o kvalitetu i detaljima.</p>
            </div>
            <div class="feature-card" style="background:#244950; padding:25px; border-radius:12px; color:#ffffff;">
                <h4 style="margin-top:0; color:#f8be21;">Sigurno i pouzdano</h4>
                <p style="color:#e0e0e0; font-size:14px; margin-bottom:0;">Uživajte u putovanju uz jednostavnu rezervaciju i podršku.</p>
            </div>
            <div class="feature-card" style="background:#244950; padding:25px; border-radius:12px; color:#ffffff;">
                <h4 style="margin-top:0; color:#f8be21;">Podrška 24/7</h4>
                <p style="color:#e0e0e0; font-size:14px; margin-bottom:0;">Dostupni smo kad god Vam zatreba pomoć.</p>
            </div>
        </div>
    </section>

    <section class="section" style="margin-bottom: 50px;">
        <div class="center-title" style="text-align:center; margin-bottom:30px;">
            <span class="section-label" style="color:#2aa9b0; font-weight:700; font-size:12px; letter-spacing:1px;">PRIČE PUTNIKA</span>
            <h3 style="color:#1d3b41; font-size:28px; margin-top:5px;">Voljeni od istraživača <em style="color:#2aa9b0; font-style:normal;">širom svijeta</em></h3>
        </div>
        <div class="testimonials-grid">
            <blockquote class="testimonial">
                <div>
                    <div class="stars">★★★★★</div>
                    <p>“InterTrips je naš medeni mjesec na Santoriniju učinio savršenim. Svaki detalj je bio isplaniran bez ijedne greške.”</p>
                </div>
                <div class="testimonial-user">
                    <img src="~/assets/user1.jpg" alt="Sophie Laurent">
                    <div><footer>Sophie Laurent</footer><span>Santorini, Grčka</span></div>
                </div>
            </blockquote>

            <blockquote class="testimonial">
                <div>
                    <div class="stars">★★★★★</div>
                    <p>“Trek kroz Patagoniju bio je avantura života. Vodiči su bili izuzetno profesionalni, a organizacija na vrhunskom nivou.”</p>
                </div>
                <div class="testimonial-user">
                    <img src="~/assets/user2.jpg" alt="James Okafor">
                    <div><footer>James Okafor</footer><span>Patagonija, Argentina</span></div>
                </div>
            </blockquote>

            <blockquote class="testimonial">
                <div>
                    <div class="stars">★★★★★</div>
                    <p>“Istraživanje Kjota kroz njihove pakete je bilo nevjerovatno. Spoj tradicije i komfora koji nigdje drugo nismo pronašli.”</p>
                </div>
                <div class="testimonial-user">
                    <img src="~/assets/user3.jpg" alt="Ema Hadžić">
                    <div><footer>Ema Hadžić</footer><span>Kjoto, Japan</span></div>
                </div>
            </blockquote>
        </div>
    </section>

    <section class="cta section" style="margin-bottom: 50px;">
        <div class="cta-box">
            <div>
                <span class="section-label">ZAPOČNITE PUTOVANJE</span>
                <h3>Spremni za istraživanje svijeta?</h3>
                <p>Pridružite se hiljadama putnika koji vjeruju InterTripsu.</p>
            </div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-gold">Počnite besplatno →</a>
        </div>
    </section>

    <section class="newsletter" style="margin-bottom:0px; background:#244950; padding:40px; border-radius:22px; text-align:center;">
        <div>
            <span class="section-label" style="color:#f8be21; font-weight:700; font-size:12px; letter-spacing:1px;">NEWSLETTER</span>
            <h3 style="color:#ffffff; margin:5px 0 15px 0; font-size:26px;">Budite prvi koji saznaju o novim ponudama</h3>
        </div>
        <form class="newsletter-form" id="newsletterForm" style="display:flex; justify-content:center; gap:10px; max-width:500px; margin:0 auto;">
            <input type="email" id="emailInput" name="email" placeholder="Unesite Vašu e-mail adresu" required style="padding:12px 20px; border-radius:50px; border:none; flex-grow:1; font-size:15px;" />
            <button type="submit" class="btn btn-gold" style="min-width:150px; padding:12px 20px;">Pretplatite se</button>
        </form>
        <p id="newsletterMessage" style="margin-top:12px; font-size:13px; color:#f8be21; font-weight:600; display:none;"></p>
    </section>

</main>
<footer class="footer full-width-footer">
    <div class="footer-content-wrapper">
        <div class="footer-grid">
            <div>
                <a href="/" class="logo-link">
                    <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
                </a>
                <p>InterTrips - sistem za upravljanje turističkim paketima, rezervacijama i putnim informacijama.</p>
            </div>
            <div>
                <h4>Istraži</h4>
                <p><a href="/destinacije">Destinacije</a></p>
            </div>
            <div>
                <h4>Kompanija</h4>
                <p><a href="/">Početna</a></p>
                <p><a href="/home/onama">O nama</a></p>
                <p><a href="/home/kontakt">Kontakt</a></p>
            </div>
            <div>
                <h4>Podrška</h4>
                <p><a href="/home/privacy">Politika privatnosti</a></p>
            </div>
        </div>

        <div class="copyright">
            <div>© 2026 InterTrips. Sva prava zadržana.</div>
            <div>Napravljen s &lt;3 za putni svijet</div>
        </div>
    </div>
</footer>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const slider = document.getElementById('destinationsSlider');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            let currentIndex = 0;

            function getCardsPerView() {
                if (window.innerWidth <= 600) return 1;
                if (window.innerWidth <= 992) return 2;
                return 3;
            }

            function updateSliderPosition() {
                if (!slider || !prevBtn || !nextBtn) return;
                const cards = slider.querySelectorAll('.card');
                if (cards.length === 0) return;

                const cardsPerView = getCardsPerView();
                const maxIndex = Math.max(0, cards.length - cardsPerView);

                if (currentIndex > maxIndex) currentIndex = maxIndex;

                const cardWidth = cards[0].getBoundingClientRect().width;
                const gap = 24;

                const moveAmount = currentIndex * (cardWidth + gap);
                slider.style.transform = `translateX(-${moveAmount}px)`;

                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= maxIndex;
            }

            if (nextBtn && prevBtn) {
                nextBtn.addEventListener('click', function () {
                    const cards = slider.querySelectorAll('.card');
                    const maxIndex = cards.length - getCardsPerView();
                    if (currentIndex < maxIndex) {
                        currentIndex++;
                        updateSliderPosition();
                    }
                });

                prevBtn.addEventListener('click', function () {
                    if (currentIndex > 0) {
                        currentIndex--;
                        updateSliderPosition();
                    }
                });
            }

            window.addEventListener('resize', updateSliderPosition);
            setTimeout(updateSliderPosition, 200);

            // Newsletter
            const newsletterForm = document.getElementById('newsletterForm');
            const newsletterMessage = document.getElementById('newsletterMessage');

            if (newsletterForm) {
                newsletterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const emailInput = document.getElementById('emailInput');
                    const emailValue = emailInput ? emailInput.value : '';
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                    fetch('/Newsletter/Subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: 'email=' + encodeURIComponent(emailValue)
                    })
                        .then(async response => {
                            if (response.ok) {
                                newsletterForm.style.display = 'none';
                                if (newsletterMessage) {
                                    newsletterMessage.style.display = 'block';
                                    newsletterMessage.textContent = 'Hvala Vam na korištenju usluga InterTripsa. Vaš InterTrips team <3';
                                }
                            } else {
                                alert("Greška prilikom pretplate.");
                            }
                        });
                });
            }
        });
    </script>
}