@model List<InterTrips___Turistička_Agencija.Models.Paket>
@using InterTrips___Turistička_Agencija.Enums
@{
    ViewData["Title"] = "O nama";
    Layout = "_Layout";
}

<style>
    :root {
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 16px 36px rgba(63,116,128,0.08);
        --transition: all 0.25s ease;
    }

    .hero {
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        background: linear-gradient(rgba(106,191,198,0.18), rgba(134,191,224,0.14)), url('/assets/about-hero.jpg') center/cover no-repeat;
        border-bottom: 1px solid rgba(95,181,187,0.12);
    }

        .hero .inner {
            max-width: 820px;
            padding: 40px 24px;
            background: rgba(255,255,255,0.75);
            border: 1px solid rgba(95,181,187,0.2);
            border-radius: 22px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(8px);
            margin: 20px;
        }

        .hero h1 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            color: var(--text);
            margin: 10px 0;
            font-weight: 800;
        }

        .hero .tag {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: var(--primary-dark);
        }

        .hero p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }

    .section {
        padding: 80px 24px;
    }

    .container {
        max-width: 1140px;
        margin: 0 auto;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 40px;
        align-items: center;
    }

    .eyebrow {
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
    }

    .title {
        font-size: clamp(1.9rem, 4vw, 3rem);
        line-height: 1.1;
        font-weight: 800;
        margin-bottom: 20px;
        color: var(--text);
    }

        .title span {
            color: var(--primary-dark);
            font-style: italic;
            font-weight: 400;
        }

    .about-text p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 16px;
        max-width: 560px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 30px;
        max-width: 560px;
    }

    .stat {
        background: #fff;
        border: 1px solid rgba(95,181,187,0.16);
        border-radius: 14px;
        padding: 20px 14px;
        text-align: center;
        box-shadow: var(--shadow);
        transition: transform 0.2s ease;
    }

        .stat:hover {
            transform: translateY(-3px);
        }

        .stat strong {
            display: block;
            color: var(--primary-dark);
            font-size: 22px;
            margin-bottom: 4px;
        }

        .stat small {
            color: var(--muted);
            font-size: 12px;
            font-weight: 500;
        }

    .photo-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .photo {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
        height: 220px;
        background: #fff;
        border: 1px solid rgba(95,181,187,0.10);
        transition: transform 0.3s ease;
    }

        .photo:hover {
            transform: scale(1.02);
        }

        .photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .values {
        background-color: rgba(42, 169, 176, 0.02);
    }

    .values-head {
        text-align: center;
        margin-bottom: 40px;
    }

        .values-head h2 {
            font-size: clamp(1.7rem, 4vw, 2.6rem);
            font-weight: 800;
            line-height: 1.2;
            color: var(--text);
        }

            .values-head h2 span {
                display: block;
                color: var(--primary-dark);
                font-style: italic;
                font-weight: 400;
                margin-top: 6px;
            }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .value-card {
        background: #fff;
        border: 1px solid rgba(95,181,187,0.12);
        border-radius: 16px;
        padding: 26px 20px;
        text-align: center;
        box-shadow: var(--shadow);
        transition: var(--transition);
    }

        .value-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

    .value-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        margin: 0 auto 16px;
        background: rgba(106,191,198,0.14);
        color: var(--primary-dark);
        font-size: 20px;
    }

    .value-card h3 {
        font-size: 14px;
        margin-bottom: 10px;
        color: var(--text);
        font-weight: 700;
    }

    .value-card p {
        font-size: 12px;
        line-height: 1.7;
        color: var(--muted);
        margin: 0;
    }

    .team-head {
        text-align: center;
        margin-bottom: 45px;
    }

        .team-head h2 {
            font-size: clamp(1.7rem, 4vw, 2.6rem);
            font-weight: 800;
            line-height: 1.2;
            color: var(--text);
        }

            .team-head h2 span {
                display: block;
                color: var(--primary-dark);
                font-style: italic;
                font-weight: 400;
                margin-top: 6px;
            }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    .member {
        text-align: center;
        padding: 16px 12px;
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow);
        border: 1px solid rgba(95,181,187,0.05);
        transition: var(--transition);
    }

        .member:hover {
            transform: translateY(-4px);
        }

    .avatar {
        width: 80px;
        height: 80px;
        margin: 0 auto 16px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid rgba(95,181,187,0.25);
        background: #fff;
        box-shadow: var(--shadow);
    }

        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .member h3 {
        font-size: 14px;
        margin-bottom: 4px;
        color: var(--text);
        font-weight: 700;
    }

    .member .role {
        color: var(--primary-dark);
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .member p {
        font-size: 11px;
        line-height: 1.6;
        color: var(--muted);
        max-width: 220px;
        margin: 0 auto;
    }

    .contact {
        background-color: rgba(134,191,224,0.03);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .contact-box h2 {
        font-size: clamp(1.7rem, 4vw, 2.6rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 16px;
        color: var(--text);
    }

        .contact-box h2 span {
            display: block;
            color: var(--primary-dark);
            font-style: italic;
            font-weight: 400;
            margin-top: 6px;
        }

    .contact-box p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 24px;
    }

    .contact-list {
        display: grid;
        gap: 16px;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        font-size: 13px;
        color: var(--text);
    }

        .contact-item .ico {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            border: 1px solid rgba(95,181,187,0.35);
            color: var(--primary-dark);
            display: grid;
            place-items: center;
            flex: 0 0 28px;
            font-size: 13px;
            background: rgba(106,191,198,0.08);
        }

    .map {
        height: 320px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(95,181,187,0.15);
        box-shadow: var(--shadow);
        background: #eee;
    }

        .map iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

    @@media (max-width: 980px) {
        .about-grid, .contact-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .values-grid, .team-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .values-grid, .team-grid, .stats {
            grid-template-columns: 1fr;
        }

        .section {
            padding: 60px 16px;
        }
    }
</style>

<section class="hero">
    <div class="inner">
        <div class="tag">NAŠA PRIČA</div>
        <h1>InterTrips - turistički sistem</h1>
        <p>InterTrips je sistem za upravljanje turističkom agencijom koji omogućava rezervacije, praćenje putovanja, planiranje i pregled ponude paketa.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="about-grid">
            <div class="about-text">
                <div class="eyebrow">KO SMO MI</div>
                <div class="title">Više od agencije, <span>vaš sistem za putovanja</span></div>
                <p>InterTrips is razvijen kako bi klijentima omogućio jednostavan pregled i rezervaciju turističkih paketa, a agentima i administratorima alat za upravljanje ponudom.</p>
                <p>Sistem obuhvata rezervacije, plaćanja, notifikacije, pregled putnika i plan putovanja.</p>
                <p>Naš cilj je da proces organizacije putovanja bude brz, pregledan i pouzdan.</p>

                <div class="stats">
                    <div class="stat">
                        <strong>8+</strong>
                        <small>Godina iskustva</small>
                    </div>
                    <div class="stat">
                        <strong>80+</strong>
                        <small>Destinacija</small>
                    </div>
                    <div class="stat">
                        <strong>50K+</strong>
                        <small>Zadovoljnih putnika</small>
                    </div>
                </div>
            </div>

            <div class="photo-grid">
                <div class="photo">
                    <img src="~/assets/about-map.jpg" alt="Mapa svijeta">
                </div>
                <div class="photo">
                    <img src="~/assets/about-market.jpg" alt="Putnici i lokalna kultura">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section values">
    <div class="container">
        <div class="values-head">
            <div class="eyebrow">NAŠE VRIJEDNOSTI</div>
            <h2>Šta nas pokreće <span>svaki dan</span></h2>
        </div>

        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">❤</div>
                <h3>Strast prema putovanjima</h3>
                <p>Svaki paket kreiramo s ciljem da putovanje bude nezaboravno i dobro organizovano.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">✓</div>
                <h3>Povjerenje i transparentnost</h3>
                <p>Jasne cijene, pouzdane informacije i pregledan proces rezervacije.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">✈</div>
                <h3>Odgovorno putovanje</h3>
                <p>Biramo provjerene partnere, hotele i letove kako bismo osigurali kvalitet usluge.</p>
            </div>
            <div class="value-card">
                <div class="value-icon">☼</div>
                <h3>Putnik na prvom mjestu</h3>
                <p>Rezervacije, podrška i komunikacija prilagođeni su potrebama korisnika.</p>
            </div>
        </div>
    </div>
</section>

<section class="section team">
    <div class="container">
        <div class="team-head">
            <div class="eyebrow">UPOZNAJTE TIM</div>
            <h2>Ljudi iza<br><span>InterTripsa</span></h2>
        </div>

        <div class="team-grid">
            <div class="member">
                <div class="avatar"><img src="~/assets/team-amela.jpg" alt="Amela Obhođaš"></div>
                <h3>Amela Obhođaš</h3>
                <div class="role">Voditeljica tima</div>
                <p>Koordinira projekat i razvoj sistema.</p>
            </div>

            <div class="member">
                <div class="avatar"><img src="~/assets/team-benjamin.jpg" alt="Benjamin Bikić"></div>
                <h3>Benjamin Bikić</h3>
                <div class="role">Specijalista za destinacije</div>
                <p>Brine o ponudama i paketima putovanja.</p>
            </div>

            <div class="member">
                <div class="avatar"><img src="~/assets/team-hamza.jpg" alt="Hamza Jašarević"></div>
                <h3>Hamza Jašarević</h3>
                <div class="role">Tehnička podrška</div>
                <p>Održava stabilnost i rad platforme.</p>
            </div>

            <div class="member">
                <div class="avatar"><img src="~/assets/team-zerina.jpg" alt="Zerina Avdušinović"></div>
                <h3>Zerina Avdušinović</h3>
                <div class="role">Marketing i komunikacije</div>
                <p>Vodi promocije i komunikaciju sa korisnicima.</p>
            </div>
        </div>
    </div>
</section>

<section class="section contact">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-box">
                <div class="eyebrow">KONTAKTIRAJTE NAS</div>
                <h2>Tu smo <span>uvijek za Vas</span></h2>
                <p>Za informacije o paketima, rezervacijama, plaćanju ili planiranju putovanja, naš tim vam stoji na raspolaganju.</p>

                <div class="contact-list">
                    <div class="contact-item">
                        <div class="ico">📍</div>
                        <div>
                            <strong>Adresa</strong><br>
                            Ferhadija 12, 71000 Sarajevo, BiH
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="ico">☎</div>
                        <div>
                            <strong>Telefon</strong><br>
                            +387 33 123 456
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="ico">✉</div>
                        <div>
                            <strong>E-mail</strong><br>
                            info@intertrips.ba
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="ico">⏰</div>
                        <div>
                            <strong>Radno vrijeme</strong><br>
                            Pon-Pet: 09:00-18:00
                        </div>
                    </div>
                </div>
            </div>

            <div class="map">
                <iframe src="https://maps.google.com/maps?q=Ferhadija%2012,%20Sarajevo&t=&z=15&ie=UTF8&iwloc=&output=embed"
                        allowfullscreen
                        loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a href="index.html" class="logo-link">
                    <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
                </a>
                <p>InterTrips - sistem za upravljanje turističkim paketima i rezervacijama.</p>
                <div class="social">
                    <span>ig</span>
                    <span>x</span>
                    <span>f</span>
                    <span>yt</span>
                </div>
            </div>

            <<div>
                <h4>Istraži</h4>
                <p><a asp-controller="Destinacije" asp-action="Index">Destinacije</a></p>
                <p><a asp-controller="Destinacije" asp-action="Index">Putni vodiči</a></p>
                <p>
                    <a asp-controller="Destinacije" asp-action="Index">Najbolja iskustva</a>
                </p>
            </div>

            <div>
                <h4>Kompanija</h4>
                <p><a asp-controller="Home" asp-action="ONama">O nama</a></p>
                <p><a asp-controller="Home" asp-action="Kontakt">Kontakt</a></p>
            </div>
            <div>
                <h4>Podrška</h4>
                <p><a href="#">Centar za pomoć</a></p>
                <p>
                    <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
                </p>
                <p>
                    <a asp-controller="Home" asp-action="Privacy">Uvjeti korištenja</a>
                </p>
            </div>
        </div>

        <div class="copyright">
            <div>© 2025 InterTrips. Sva prava zadržana.</div>
            <div>Napravljen s ❤ za putni svijet</div>
        </div>
    </div>
</footer>