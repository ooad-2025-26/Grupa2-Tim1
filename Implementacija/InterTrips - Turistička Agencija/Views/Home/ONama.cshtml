@{
    ViewData["Title"] = "O nama";
    Layout = "_LayoutRaw";
}

<!DOCTYPE html>
<html lang="bs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>InterTrips - O nama</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/style.css">
  <style>
    .hero{
      min-height:260px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      position:relative;
      background:
        linear-gradient(rgba(106,191,198,0.18), rgba(134,191,224,0.14)),
        url('/assets/about-hero.jpg') center/cover no-repeat;
      border-bottom:1px solid rgba(95,181,187,0.12);
    }

    .hero .inner{
      max-width:820px;
      padding:40px 18px;
      background: rgba(255,255,255,0.68);
      border: 1px solid rgba(95,181,187,0.16);
      border-radius: 22px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(8px);
    }

    .hero p{
      color: var(--muted);
    }

    .section{
      padding:72px 24px;
    }

    .container{
      max-width:1140px;
      margin:0 auto;
    }

    .about-grid{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:26px;
      align-items:center;
    }

    .eyebrow{
      color:var(--primary-dark);
      font-size:10px;
      font-weight:800;
      letter-spacing:1px;
      margin-bottom:12px;
    }

    .title{
      font-size:clamp(1.9rem, 4vw, 3rem);
      line-height:1.05;
      font-weight:800;
      margin-bottom:12px;
      color: var(--text);
    }

    .title span{
      color:var(--primary-dark);
      font-style:italic;
      font-weight:400;
    }

    .about-text p{
      color:var(--muted);
      font-size:13px;
      line-height:1.9;
      margin-bottom:12px;
      max-width:560px;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
      margin-top:26px;
      max-width:560px;
    }

    .stat{
      background:rgba(255,255,255,0.78);
      border:1px solid rgba(95,181,187,0.16);
      border-radius:12px;
      padding:16px 14px;
      text-align:center;
      box-shadow:var(--shadow);
    }

    .stat strong{
      display:block;
      color:var(--primary-dark);
      font-size:18px;
      margin-bottom:2px;
    }

    .stat small{
      color:var(--muted);
      font-size:11px;
    }

    .photo-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
      align-items:end;
    }

    .photo{
      border-radius:16px;
      overflow:hidden;
      box-shadow:var(--shadow);
      min-height:170px;
      background:#fff;
      border:1px solid rgba(95,181,187,0.10);
    }

    .photo img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .values{
      padding-top:24px;
    }

    .values-head{
      text-align:center;
      margin-bottom:30px;
    }

    .values-head h2{
      font-size:clamp(1.7rem, 4vw, 2.6rem);
      font-weight:800;
      line-height:1.1;
      color: var(--text);
    }

    .values-head h2 span{
      display:block;
      color:var(--primary-dark);
      font-style:italic;
      font-weight:400;
      margin-top:4px;
    }

    .values-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:16px;
    }

    .value-card{
      background:rgba(255,255,255,0.78);
      border:1px solid rgba(95,181,187,0.16);
      border-radius:14px;
      padding:22px 16px;
      text-align:center;
      min-height:154px;
      box-shadow:var(--shadow);
    }

    .value-icon{
      width:40px;
      height:40px;
      border-radius:50%;
      display:grid;
      place-items:center;
      margin:0 auto 14px;
      background:rgba(106,191,198,0.14);
      color:var(--primary-dark);
      font-size:18px;
    }

    .value-card h3{
      font-size:13px;
      margin-bottom:8px;
      color: var(--text);
    }

    .value-card p{
      font-size:11px;
      line-height:1.7;
      color:var(--muted);
    }

    .team{
      padding-top:86px;
    }

    .team-head{
      text-align:center;
      margin-bottom:34px;
    }

    .team-head h2{
      font-size:clamp(1.7rem, 4vw, 2.6rem);
      font-weight:800;
      line-height:1.1;
      color: var(--text);
    }

    .team-head h2 span{
      display:block;
      color:var(--primary-dark);
      font-style:italic;
      font-weight:400;
      margin-top:4px;
    }

    .team-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:22px;
    }

    .member{
      text-align:center;
      padding:8px 6px;
    }

    .avatar{
      width:60px;
      height:60px;
      margin:0 auto 14px;
      border-radius:50%;
      overflow:hidden;
      border:2px solid rgba(95,181,187,0.55);
      background:#fff;
      box-shadow:var(--shadow);
    }

    .avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .member h3{
      font-size:13px;
      margin-bottom:4px;
      color: var(--text);
    }

    .member .role{
      color:var(--primary-dark);
      font-size:11px;
      margin-bottom:8px;
    }

    .member p{
      font-size:10px;
      line-height:1.7;
      color:var(--muted);
      max-width:220px;
      margin:0 auto;
    }

    .contact{
      padding-top:96px;
    }

    .contact-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:30px;
      align-items:start;
    }

    .contact-box h2{
      font-size:clamp(1.7rem, 4vw, 2.6rem);
      font-weight:800;
      line-height:1.1;
      margin-bottom:14px;
      color: var(--text);
    }

    .contact-box h2 span{
      display:block;
      color:var(--primary-dark);
      font-style:italic;
      font-weight:400;
      margin-top:4px;
    }

    .contact-box p{
      color:var(--muted);
      font-size:13px;
      line-height:1.8;
      margin-bottom:18px;
      max-width:420px;
    }

    .contact-list{
      display:grid;
      gap:12px;
      margin-top:22px;
    }

    .contact-item{
      display:flex;
      align-items:flex-start;
      gap:10px;
      font-size:12px;
      color: var(--text);
    }

    .contact-item .ico{
      width:22px;
      height:22px;
      border-radius:7px;
      border:1px solid rgba(95,181,187,0.35);
      color:var(--primary-dark);
      display:grid;
      place-items:center;
      flex:0 0 22px;
      font-size:11px;
      margin-top:1px;
      background: rgba(106,191,198,0.08);
    }

    .map{
      height:260px;
      border-radius:16px;
      overflow:hidden;
      border:1px solid rgba(95,181,187,0.12);
      box-shadow:var(--shadow);
      background:#eee;
    }

    .map iframe{
      width:100%;
      height:100%;
      border:0;
    }

    .footer{
      padding:34px 24px 24px;
      background: linear-gradient(180deg, #d8ecec 0%, #c6e0e4 100%);
    }

    .footer-grid{
      display:grid;
      grid-template-columns:1.5fr 1fr 1fr 1fr;
      gap:24px;
      align-items:start;
    }

    .footer .logo{ margin-bottom:14px; }

    .footer p, .footer a{
      font-size:12px;
      color:var(--muted);
      line-height:1.8;
    }

    .footer h4{
      color:var(--primary-dark);
      font-size:11px;
      margin-bottom:12px;
      text-transform:uppercase;
      letter-spacing:.7px;
    }

    .social{
      display:flex;
      gap:10px;
      margin-top:12px;
    }

    .social span{
      width:26px;
      height:26px;
      border-radius:50%;
      background:rgba(106,191,198,0.16);
      display:grid;
      place-items:center;
      font-size:11px;
      color:#2b6d75;
    }

    .copyright{
      display:flex;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
      margin-top:22px;
      padding-top:16px;
      border-top:1px solid rgba(95,181,187,0.12);
      color:var(--muted);
      font-size:11px;
    }

    @@media (max-width: 980px){
      .about-grid, .contact-grid, .footer-grid{ grid-template-columns:1fr; }
      .values-grid, .team-grid{ grid-template-columns:repeat(2,1fr); }
    }

    @@media (max-width: 700px){
      .nav{ gap:14px; font-size:11px; flex-wrap:wrap; justify-content:flex-end; }
      .values-grid, .team-grid, .stats{ grid-template-columns:1fr; }
      .section{ padding:56px 16px; }
      .topbar{ padding:0 14px; }
    }
  </style>
</head>
<body>
<header class="topbar">
  <a asp-controller="Home" asp-action="Index" class="logo-link">
    <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
  </a>

  <nav class="nav">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
    <a class="active" asp-controller="Home" asp-action="ONama">O nama</a>
    <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>

<a class="pill" asp-controller="Rezervacija" asp-action="Rezervacija">Rezerviraj</a>
    <a class="fill" asp-controller="Korisnik" asp-action="Login">Prijava</a>
  </nav>
</header>
  <style>
  .topbar{
      height:56px;
      background: rgba(255,255,255,0.82);
      border-bottom:1px solid rgba(95,181,187,0.14);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 26px;
      position:sticky;
      top:0;
      z-index:50;
      backdrop-filter: blur(10px);
    }

    .logo-link{ display:inline-block; }
    .logo{
      width:80px;
      height:40px;
      object-fit:contain;
      display:block;
    }

    .nav{
      display:flex;
      align-items:center;
      gap:20px;
      font-size:12px;
      font-weight:600;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .nav a{ color:rgba(36,65,74,0.88); }
    .nav a.active{ color:var(--primary-dark); }

    .nav .pill{
      padding:6px 14px;
      border-radius:999px;
      border:1px solid var(--primary);
      color:var(--primary-dark);
      background:rgba(125,207,207,0.08);
    }

    .nav .fill{
      padding:6px 14px;
      border-radius:999px;
      background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
      color:#18424a;
    }
  </style>

  <section class="hero">
    <div class="inner">
      <div class="tag">NAŠA PRIČA</div>
      <h1>InterTrips - turistički sistem</h1>
      <p>InterTrips je sistem za upravljanje turističkom agencijom koji omogućava rezervacije, praćenje putovanja, planiranje i pregled ponude paketa.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <div class="eyebrow">KO SMO MI</div>
          <div class="title">Više od agencije, <span>vaš sistem za putovanja</span></div>
          <p>InterTrips je razvijen kako bi klijentima omogućio jednostavan pregled i rezervaciju turističkih paketa, a agentima i administratorima alat za upravljanje ponudom.</p>
          <p>Sistem obuhvata rezervacije, plaćanja, notifikacije, pregled putnika i plan putovanja.</p>
          <p>Naš cilj je da proces organizacije putovanja bude brz, pregledan i pouzdan.</p>

          <div class="stats">
            <div class="stat">
              <strong>8+</strong>
              <small>Godina iskustva</small>
            </div>
            <div class="stat">
              <strong>80+</strong>
              <small>Destinacija</small>
            </div>
            <div class="stat">
              <strong>50K+</strong>
              <small>Zadovoljnih putnika</small>
            </div>
          </div>
        </div>

        <div class="photo-grid">
          <div class="photo" style="height:170px;">
            <img src="~/assets/about-map.jpg" alt="Mapa svijeta">
          </div>
          <div class="photo" style="height:170px;">
            <img src="~/assets/about-market.jpg" alt="Putnici i lokalna kultura">
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section values">
    <div class="container">
      <div class="values-head">
        <div class="eyebrow">NAŠE VRIJEDNOSTI</div>
        <h2>Šta nas pokreće <span>svaki dan</span></h2>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">❤</div>
          <h3>Strast prema putovanjima</h3>
          <p>Svaki paket kreiramo s ciljem da putovanje bude nezaboravno i dobro organizovano.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">✓</div>
          <h3>Povjerenje i transparentnost</h3>
          <p>Jasne cijene, pouzdane informacije i pregledan proces rezervacije.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">✈</div>
          <h3>Odgovorno putovanje</h3>
          <p>Biramo provjerene partnere, hotele i letove kako bismo osigurali kvalitet usluge.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">☼</div>
          <h3>Putnik na prvom mjestu</h3>
          <p>Rezervacije, podrška i komunikacija prilagođeni su potrebama korisnika.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section team">
    <div class="container">
      <div class="team-head">
        <div class="eyebrow">UPOZNAJTE TIM</div>
        <h2>Ljudi iza<br><span>InterTripsa</span></h2>
      </div>

      <div class="team-grid">
        <div class="member">
          <div class="avatar"><img src="~/assets/team-amela.jpg" alt="Amela Obhođaš"></div>
          <h3>Amela Obhođaš</h3>
          <div class="role">Voditeljica tima</div>
          <p>Koordinira projekat i razvoj sistema.</p>
        </div>

        <div class="member">
          <div class="avatar"><img src="~/assets/team-benjamin.jpg" alt="Benjamin Bikić"></div>
          <h3>Benjamin Bikić</h3>
          <div class="role">Specijalista za destinacije</div>
          <p>Brine o ponudama i paketima putovanja.</p>
        </div>

        <div class="member">
          <div class="avatar"><img src="~/assets/team-hamza.jpg" alt="Hamza Jašarević"></div>
          <h3>Hamza Jašarević</h3>
          <div class="role">Tehnička podrška</div>
          <p>Održava stabilnost i rad platforme.</p>
        </div>

        <div class="member">
          <div class="avatar"><img src="~/assets/team-zerina.jpg" alt="Zerina Avdušinović"></div>
          <h3>Zerina Avdušinović</h3>
          <div class="role">Marketing i komunikacije</div>
          <p>Vodi promocije i komunikaciju sa korisnicima.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-box">
          <div class="eyebrow">KONTAKTIRAJTE NAS</div>
          <h2>Tu smo <span>uvijek za Vas</span></h2>
          <p>Za informacije o paketima, rezervacijama, plaćanju ili planiranju putovanja, naš tim vam stoji na raspolaganju.</p>

          <div class="contact-list">
            <div class="contact-item">
              <div class="ico">📍</div>
              <div>
                <strong>Adresa</strong><br>
                Ferhadija 12, 71000 Sarajevo, BiH
              </div>
            </div>

            <div class="contact-item">
              <div class="ico">☎</div>
              <div>
                <strong>Telefon</strong><br>
                +387 33 123 456
              </div>
            </div>

            <div class="contact-item">
              <div class="ico">✉</div>
              <div>
                <strong>E-mail</strong><br>
                info@intertrips.ba
              </div>
            </div>

            <div class="contact-item">
              <div class="ico">⏰</div>
              <div>
                <strong>Radno vrijeme</strong><br>
                Pon-Pet: 09:00-18:00
              </div>
            </div>
          </div>
        </div>

        <div class="map">
          <iframe
            src="https://www.google.com/maps?q=Sarajevo&output=embed"
            allowfullscreen
            loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a href="index.html" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
          </a>
          <p>InterTrips - sistem za upravljanje turističkim paketima i rezervacijama.</p>
          <div class="social">
            <span>ig</span>
            <span>x</span>
            <span>f</span>
            <span>yt</span>
          </div>
        </div>

        <<div>
  <h4>Istraži</h4>
  <p><a asp-controller="Destinacije" asp-action="Index">Destinacije</a></p>
  <p><a href="#">Putni vodiči</a></p>
  <p><a href="#">Najbolja iskustva</a></p>
</div>

<div>
  <h4>Kompanija</h4>
  <p><a asp-controller="Home" asp-action="ONama">O nama</a></p>
  <p><a asp-controller="Home" asp-action="Kontakt">Kontakt</a></p>
</div>
        <div>
          <h4>Podrška</h4>
          <p><a href="#">Centar za pomoć</a></p>
          <p><a href="#">Politika privatnosti</a></p>
          <p><a href="#">Uvjeti korištenja</a></p>
        </div>
      </div>

      <div class="copyright">
        <div>© 2025 InterTrips. Sva prava zadržana.</div>
        <div>Napravljen s ❤ za putni svijet</div>
      </div>
    </div>
  </footer>
</body>
</html>