@{
ViewData["Title"] = "Politika privatnosti";
Layout = "_Layout";
}

@section Styles {
    <style>
        :root {
            --primary: #2aa9b0;
            --primary-dark: #1e7f88;
            --primary-light: rgba(42, 169, 176, 0.08);
            --text: #1e353d;
            --muted: #5f7c86;
            --bg: #f8fafc;
            --shadow: 0 20px 40px rgba(36, 65, 74, 0.04);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .page {
            max-width: 900px;
            margin: 50px auto 80px;
            padding: 0 24px;
        }

        .card {
            background: #ffffff;
            border: 1px solid rgba(95, 181, 187, 0.1);
            border-radius: 24px;
            box-shadow: var(--shadow);
            padding: 0;
            overflow: hidden;
            counter-reset: section;
        }

        .page-header-block {
            background: linear-gradient(135deg, rgba(42, 169, 176, 0.05) 0%, rgba(96, 197, 204, 0.15) 100%);
            padding: 60px 60px 40px 60px;
            border-bottom: 1px solid rgba(42, 169, 176, 0.1);
            position: relative;
        }

        .header-meta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-dark);
            margin-bottom: 16px;
            box-shadow: 0 4px 10px rgba(42, 169, 176, 0.05);
            border: 1px solid rgba(42, 169, 176, 0.1);
        }

            .header-meta i {
                font-size: 14px;
            }

        h1 {
            color: var(--text);
            margin: 0;
            font-size: clamp(2.2rem, 5vw, 2.8rem);
            font-weight: 800;
            letter-spacing: -0.5px;
            line-height: 1.2;
        }

        .card-body-content {
            padding: 40px 60px 60px 60px;
        }

        h2 {
            margin-top: 45px;
            margin-bottom: 18px;
            color: var(--text);
            font-size: 20px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card h2::before {
            counter-increment: section;
            content: counter(section);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 28px;
            background: var(--primary-light);
            color: var(--primary-dark);
            font-size: 13px;
            font-weight: 700;
            border-radius: 8px;
        }

        p {
            color: var(--muted);
            line-height: 1.8;
            font-size: 15px;
            margin-bottom: 20px;
        }

            p strong {
                color: var(--text);
            }

        ul {
            list-style: none;
            margin: 16px 0 24px 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        li {
            color: var(--muted);
            line-height: 1.7;
            font-size: 15px;
            position: relative;
            padding-left: 28px;
        }

            li::before {
                content: "";
                position: absolute;
                left: 6px;
                top: 10px;
                width: 6px;
                height: 6px;
                background: var(--primary);
                border-radius: 50%;
            }

            li strong {
                color: var(--text);
                font-weight: 600;
            }

        .link-style {
            color: var(--primary-dark);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            border-bottom: 1.5px dashed rgba(42, 169, 176, 0.4);
            padding-bottom: 1px;
        }

            .link-style:hover {
                color: var(--primary);
                border-bottom-style: solid;
                border-color: var(--primary);
            }

        .back-link-box {
            margin-top: 50px;
            padding-top: 24px;
            border-top: 1px solid #f1f5f9;
        }

        .back-link {
            color: var(--muted);
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
        }

            .back-link:hover {
                color: var(--primary-dark);
                transform: translateX(-5px);
            }

    </style>
}

<main class="page">
    <div class="card">
        <div class="page-header-block">
            <div class="header-meta">
                <i class="fa-solid fa-shield-halved"></i> Sigurnost podataka
            </div>
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="card-body-content">
            <p>
                Turistička agencija <strong>InterTrips d.o.o.</strong> izuzetno poštuje Vašu privatnost i posvećena je zaštiti Vaših ličnih podataka.
                Ova Politika privatnosti objašnjava kako prikupljamo, koristimo, čuvamo i štitimo podatke koje nam povjerite prilikom korištenja naše platforme,
                rezervacije aranžmana ili prijave na naš newsletter.
            </p>

            <h2>Podaci koje prikupljamo</h2>
            <p>U svrhu pružanja turističkih usluga i organizacije putovanja, prikupljamo sljedeće kategorije podataka:</p>
            <ul>
                <li><strong>Osnovni identifikacijski podaci:</strong> Ime i prezime, adresa e-pošte i lozinka koje unosite prilikom registracije Vašeg korisničkog profila.</li>
                <li><strong>Podaci o rezervacijama:</strong> Odabrana destinacija, paket aranžman, datum polaska i povratka, tip smještaja, te specifični zahtjevi vezani za putovanje.</li>
            </ul>

            <h2>Svrha obrade podataka</h2>
            <p>Vaše lične podatke obrađujemo isključivo u sljedeće svrhe:</p>
            <ul>
                <li>Uspješno kreiranje, obrada, praćenje i upravljanje Vašim rezervacijama turističkih aranžmana.</li>
                <li>Autentifikacija korisnika i omogućavanje pristupa panelu "Moje rezervacije" i korisničkom profilu.</li>
            </ul>

            <h2>Dijeljenje podataka sa trećim stranama</h2>
            <p>
                InterTrips Vaše podatke ne prodaje niti neovlašteno ustupa trećim licima. Prosljeđivanje podataka vrši se isključivo onim partnerima čije je učešće neophodno za realizaciju Vašeg putovanja:
            </p>
            <ul>
                <li>Hotelskim operaterima i pružaocima smještajnih usluga radi rezervacije soba.</li>
                <li>Prevoznicima (aviokompanije, autobuski prevoznici) radi izdavanja karata.</li>
            </ul>

            <h2>Sigurnost i čuvanje podataka</h2>
            <p>
                Primjenjujemo savremene tehničke i organizacijske mjere zaštite kako bismo osigurali da Vaši podaci budu zaštićeni od gubitka, zloupotrebe ili neovlaštenog pristupa. Vaši povjerljivi podaci za komunikaciju sa email serverima skladište se na sigurnim unutrašnjim lokacijama u sistemu (User Secrets).
            </p>

            <h2>Vaša prava</h2>
            <p>U skladu sa važećim propisima o zaštiti ličnih podataka, imate pravo da zatražite uvid u Vaše podatke, ispravku ili brisanje profila i povlačenje pristanka za newsletter.</p>

            <h2>Kontakt i podrška</h2>
            <p>
                Za sva pitanja možete nas kontaktirati direktno putem naše zvanične forme na stranici
                <a asp-controller="Home" asp-action="Kontakt" class="link-style">Kontakt</a>.
            </p>

            <div class="back-link-box">
                <a asp-controller="Home" asp-action="Index" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i> Nazad na početnu
                </a>
            </div>
        </div>
    </div>
</main>