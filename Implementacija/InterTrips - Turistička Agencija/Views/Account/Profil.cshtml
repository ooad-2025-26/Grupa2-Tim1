@{
    ViewData["Title"] = "InterTrips - Profil";
    Layout = "_LayoutRaw";
}

<style>
    :root {
        --bg: #eaf7f7;
        --bg-soft: #f6fcfc;
        --card: rgba(255,255,255,0.82);
        --line: rgba(95,181,187,0.16);
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --accent: #86d9ff;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 16px 36px rgba(63,116,128,0.10);
        --field: rgba(255,255,255,0.92);
        --success: #36d399;
        --danger: #ff8fa3;
    }

    .profile-hero {
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 36px 18px;
        background: linear-gradient(rgba(125,207,207,0.16), rgba(167,216,255,0.18)), url('/assets/contact-hero.jpg') center/cover no-repeat;
        border-bottom: 1px solid rgba(95,181,187,0.10);
    }

    html, body, button, input, textarea, select {
        font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }

    .profile-hero h1,
    .head-left h2,
    .section-title {
        font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        font-weight: 800;
    }

    .profile-hero .inner {
            max-width: 820px;
            background: rgba(255,255,255,0.68);
            border: 1px solid rgba(95,181,187,0.14);
            border-radius: 22px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(8px);
            padding: 26px 22px;
        }

    .tag {
        display: inline-block;
        padding: 5px 14px;
        border: 1px solid rgba(95,181,187,0.35);
        border-radius: 999px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .6px;
        margin-bottom: 12px;
        background: rgba(125,207,207,0.10);
    }

    .profile-hero h1 {
        font-size: clamp(2rem, 4.5vw, 3.2rem);
        line-height: 1.05;
        font-weight: 900;
        color: var(--text);
        margin-bottom: 10px;
    }

    .profile-hero p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
    }

    .section {
        padding: 28px 24px 56px;
    }

    .container {
        max-width: 1020px;
        margin: 0 auto;
    }

    .card {
        background: var(--card);
        border: 1px solid rgba(95,181,187,0.14);
        border-radius: 18px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 18px 18px 14px;
        border-bottom: 1px solid rgba(95,181,187,0.12);
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(10px);
    }

    .head-left h2 {
        margin: 0;
        font-size: 18px;
        color: var(--text);
        font-weight: 900;
    }

    .head-left .sub {
        margin-top: 4px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
    }

    .actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .pill {
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary-dark);
        background: rgba(125,207,207,0.08);
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        height: 38px;
    }

    .fill {
        padding: 6px 14px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #7dcfcf, #a7d8ff);
        color: #18424a;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        height: 38px;
    }

    .card-body {
        padding: 18px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 14px;
    }

    .label {
        display: block;
        font-size: 11px;
        font-weight: 800;
        color: var(--primary-dark);
        margin: 10px 0 8px;
        letter-spacing: .6px;
    }

    .input {
        width: 100%;
        height: 42px;
        border-radius: 12px;
        border: 1px solid rgba(95,181,187,0.18);
        background: rgba(255,255,255,0.92);
        color: var(--text);
        padding: 0 14px;
        outline: none;
        font-size: 13px;
    }

        .input[disabled] {
            background: rgba(255,255,255,0.60);
            color: rgba(36,65,74,0.70);
        }

    .divider {
        border: none;
        border-top: 1px solid rgba(95,181,187,0.14);
        margin: 18px 0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 900;
        color: var(--text);
        margin: 0 0 6px;
    }

    .hint {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.7;
        margin: 0 0 14px;
    }

    .msg {
        display: none;
        margin-top: 12px;
        font-size: 13px;
        font-weight: 800;
        color: var(--primary-dark);
    }

    @@media (max-width: 900px) {
        .grid-2, .grid-3 {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="profile-hero">
    <div class="inner">
        <div class="tag">KORISNIČKI PROFIL</div>
        <h1>Moj <span style="color:var(--primary-dark);">profil</span></h1>
        <p>Uredite svoje podatke i upravljajte pristupom računu.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="card">
            <div class="card-head">
                <div class="head-left">
                    <h2>Podaci o računu</h2>
                    <div class="sub">Demo verzija: podaci se čuvaju lokalno u browseru</div>
                </div>

                <div class="actions">
                    <a class="pill" href="/">Početna</a>
                    <a class="pill" href="/Destinacije">Destinacije</a>
                    <button class="fill" id="logoutBtnProfile" type="button">Odjava</button>
                </div>
            </div>

            <div class="card-body">
                <form id="profileForm">
                    <div class="grid-2">
                        <div>
                            <label class="label">IME I PREZIME</label>
                            <input id="displayName" class="input" type="text" placeholder="Vaše ime i prezime" />
                        </div>

                        <div>
                            <label class="label">USERNAME / EMAIL</label>
                            <input id="usernameOrEmail" class="input" type="text" placeholder="npr. alex@example.com" />
                        </div>

                        <div>
                            <label class="label">ULOGA</label>
                            <input id="role" class="input" type="text" disabled />
                        </div>

                        <div>
                            <label class="label">INICIJAL</label>
                            <input id="initial" class="input" type="text" disabled />
                        </div>
                    </div>

                    <hr class="divider" />

                    <h3 class="section-title">Promjena lozinke</h3>
                    <p class="hint">
                        Ako imate spremljenu lozinku, unesite trenutnu. Ako nemate, prvo je postavite.
                    </p>

                    <div class="grid-3">
                        <div>
                            <label class="label">TRENUTNA LOZINKA</label>
                            <input id="currentPassword" class="input" type="password" placeholder="••••••••" />
                        </div>

                        <div>
                            <label class="label">NOVA LOZINKA</label>
                            <input id="newPassword" class="input" type="password" placeholder="Min. 6 znakova" />
                        </div>

                        <div>
                            <label class="label">POTVRDI NOVU</label>
                            <input id="confirmPassword" class="input" type="password" placeholder="Ponovite lozinku" />
                        </div>
                    </div>

                    <div style="display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:18px;">
                        <button type="button" id="resetBtn" class="pill" style="cursor:pointer;">Poništi</button>
                        <button type="submit" class="fill">Sačuvaj promjene</button>
                    </div>

                    <div id="saveMsg" class="msg"></div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function loadProfile() {
            try {
                const response = await fetch('/Account/Me', {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    window.location.href = '/Account/Login';
                    return;
                }

                const user = await response.json();

                document.getElementById('displayName').value =
                    user.fullName || user.userName || '';

                document.getElementById('usernameOrEmail').value =
                    user.email || user.userName || '';

                document.getElementById('role').value =
                    user.role || 'Korisnik';

                document.getElementById('initial').value =
                    (user.userName || 'U').charAt(0).toUpperCase();

            } catch (err) {
                console.error(err);
                window.location.href = '/Account/Login';
            }
        }

        function showMsg(text) {
            const el = document.getElementById('saveMsg');
            el.style.display = 'block';
            el.textContent = text;

            setTimeout(() => {
                el.style.display = 'none';
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', function () {

            loadProfile();

            document.getElementById('logoutBtnProfile')
                .addEventListener('click', async function () {

                    await fetch('/Account/Logout', {
                        method: 'POST',
                        credentials: 'same-origin'
                    });

                    window.location.href = '/';
                });

            document.getElementById('resetBtn')
                .addEventListener('click', function () {

                    document.getElementById('currentPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';

                    loadProfile();

                    showMsg('Poništene izmjene.');
                });

            document.getElementById('profileForm')
                .addEventListener('submit', async function (e) {

                    e.preventDefault();

                    const data = {
                        fullName: document.getElementById('displayName').value,
                        email: document.getElementById('usernameOrEmail').value,
                        currentPassword: document.getElementById('currentPassword').value,
                        newPassword: document.getElementById('newPassword').value,
                        confirmPassword: document.getElementById('confirmPassword').value
                    };

                    try {

                        const response = await fetch('/Account/UpdateProfile', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            credentials: 'same-origin',
                            body: JSON.stringify(data)
                        });

                        if (response.ok) {
                            showMsg('Profil uspješno ažuriran.');
                        }
                        else {
                            alert('Greška pri spremanju profila.');
                        }

                    } catch (err) {
                        console.error(err);
                        alert('Greška u komunikaciji sa serverom.');
                    }
                });
        });
    </script>
}