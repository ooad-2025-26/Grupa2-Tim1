@{
    ViewData["Title"] = "InterTrips - Profil";
    Layout = "_LayoutRaw";
}

<style>
    :root {
        --bg: #eaf7f7;
        --bg-soft: #f6fcfc;
        --card: rgba(255,255,255,0.85);
        --line: rgba(95,181,187,0.16);
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --accent: #86d9ff;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 20px 40px rgba(63,116,128,0.08);
        --field: rgba(255,255,255,0.95);
        --success: #10b981;
        --danger: #ef4444;
    }

    html, body, button, input, textarea, select {
        font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }

    body {
        background-color: #f4fafb;
        color: var(--text);
        margin: 0;
    }

    .profile-hero {
        min-height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 20px;
        background: linear-gradient(rgba(125,207,207,0.2), rgba(167,216,255,0.25)), url('/assets/contact-hero.jpg') center/cover no-repeat;
        border-bottom: 1px solid rgba(95,181,187,0.12);
    }

        .profile-hero .inner {
            max-width: 850px;
            background: rgba(255,255,255,0.75);
            border: 1px solid rgba(95,181,187,0.2);
            border-radius: 24px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 32px 24px;
        }

    .tag {
        display: inline-block;
        padding: 4px 14px;
        border: 1px solid rgba(95,181,187,0.35);
        border-radius: 999px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        margin-bottom: 14px;
        background: rgba(125,207,207,0.12);
        text-transform: uppercase;
    }

    .profile-hero h1 {
        font-size: clamp(2.2rem, 5vw, 3.5rem);
        line-height: 1.1;
        font-weight: 900;
        color: var(--text);
        margin: 0 0 12px;
        letter-spacing: -1px;
    }

    .profile-hero p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
        margin: 0;
    }

    .section {
        padding: 40px 24px 60px;
    }

    .container {
        max-width: 1050px;
        margin: 0 auto;
    }

    .card {
        background: var(--card);
        border: 1px solid rgba(95,181,187,0.16);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 24px 32px;
        border-bottom: 1px solid rgba(95,181,187,0.12);
        background: rgba(255,255,255,0.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .head-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .user-avatar-circle {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        box-shadow: 0 4px 10px rgba(42, 169, 176, 0.3);
    }

    .head-left h2 {
        margin: 0;
        font-size: 20px;
        color: var(--text);
        font-weight: 800;
    }

    .head-left .sub {
        margin-top: 2px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
    }

    .actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .pill {
        padding: 8px 18px;
        border-radius: 30px;
        border: 1px solid var(--primary);
        color: var(--primary-dark);
        background: rgba(125,207,207,0.06);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        height: 40px;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .pill:hover {
            background: rgba(125,207,207,0.15);
            transform: translateY(-1px);
        }

    .fill {
        padding: 8px 22px;
        border-radius: 30px;
        border: none;
        background: linear-gradient(135deg, #6abfc6, #86bfe0);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        height: 40px;
        box-sizing: border-box;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px rgba(106, 191, 198, 0.2);
    }

        .fill:hover {
            filter: brightness(1.05);
            transform: translateY(-1px);
            box-shadow: 0 6px 12px rgba(106, 191, 198, 0.3);
        }

    .card-body {
        padding: 32px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
    }

    .label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 8px;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .input {
        width: 100%;
        height: 44px;
        border-radius: 10px;
        border: 1px solid rgba(95,181,187,0.25);
        background: var(--field);
        color: var(--text);
        padding: 0 16px;
        outline: none;
        font-size: 14px;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.2s ease;
    }

        .input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(42, 169, 176, 0.15);
            background: #fff;
        }

        .input[disabled] {
            background: rgba(239, 246, 246, 0.7);
            color: var(--muted);
            border-color: rgba(95,181,187,0.12);
            cursor: not-allowed;
        }

    .divider {
        border: none;
        border-top: 1px solid rgba(95,181,187,0.15);
        margin: 32px 0;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 6px;
    }

    .hint {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.6;
        margin: 0 0 20px;
    }

    .msg {
        display: none;
        margin-top: 16px;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 16px;
        border-radius: 8px;
        text-align: center;
        animation: fadeIn 0.3s ease;
    }

        .msg.success {
            display: block !important;
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .msg.danger {
            display: block !important;
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .grid-2, .grid-3 {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .card-head {
            padding: 20px;
        }

        .card-body {
            padding: 20px;
        }
    }

    body > a[href*="Account/Login"],
    body > a[href*="Profil"],
    body > a[href*="Logout"],
    body > button,
    #profileForm ~ a,
    main ~ a,
    body > [href*="test@intertrips.ba"] {
        display: none !important;
    }
</style>

<section class="profile-hero">
    <div class="inner">
        <div class="tag">Korisnički panel</div>
        <h1>MOJ <span style="color:var(--primary-dark);">PROFIL</span></h1>
        <p>Ažurirajte lične podatke, kontakt informacije i upravljajte sigurnosnim postavkama vašeg računa.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="card">
            <div class="card-head">
                <div class="head-left">
                    <div class="user-avatar-circle" id="userAvatar">U</div>
                    <div>
                        <h2>Podaci o računu</h2>
                        <div class="sub">Pregled i modifikacija vašeg ličnog kartona</div>
                    </div>
                </div>

                <div class="actions">
                    <a class="pill" href="/">Početna</a>
                    <a class="pill" href="/Destinacije">Destinacije</a>
                    <button class="fill" id="logoutBtnProfile" type="button" style="background: #e53e3e; box-shadow: 0 4px 6px rgba(229, 62, 62, 0.2);">Odjava</button>
                </div>
            </div>

            <div class="card-body">
                <form id="profileForm">
                    @Html.AntiForgeryToken() <h3 class="section-title" style="margin-bottom: 16px;">Osnovne informacije</h3>
                    <div class="grid-2">
                        <div>
                            <label class="label">Ime i prezime</label>
                            <input id="displayName" class="input" type="text" placeholder="Vaše ime i prezime" required />
                        </div>

                        <div>
                            <label class="label">Korisničko ime / Email adresa</label>
                            <input id="usernameOrEmail" class="input" type="email" placeholder="npr. ime@@example.com" required />
                        </div>
                    </div>

                    <div class="grid-3" style="margin-top: 16px;">
                        <div>
                            <label class="label">Broj telefona</label>
                            <input id="phoneNumber" class="input" type="tel" placeholder="Npr. +387 61 123 456" />
                        </div>

                        <div>
                            <label class="label">Grad i država</label>
                            <input id="location" class="input" type="text" placeholder="Npr. Sarajevo, BiH" />
                        </div>

                        <div>
                            <label class="label">Datum rođenja</label>
                            <input id="birthDate" class="input" type="date" />
                        </div>
                    </div>

                    <div class="grid-2" style="margin-top: 16px;">
                        <div>
                            <label class="label">Sistemska uloga</label>
                            <input id="role" class="input" type="text" disabled />
                        </div>
                        <div>
                            <label class="label">Status naloga</label>
                            <input id="accountStatus" class="input" type="text" value="Aktivan nalog" disabled style="color: var(--success); font-weight: 600;" />
                        </div>
                    </div>

                    <hr class="divider" />

                    <h3 class="section-title">Promjena lozinke</h3>
                    <p class="hint">
                        Za izmjenu pristupne lozinke ispunite sva tri polja ispod. Ukoliko ne želite mijenjati lozinku, ostavite ih praznim.
                    </p>

                    <div class="grid-3">
                        <div>
                            <label class="label">Trenutna lozinka</label>
                            <input id="currentPassword" class="input" type="password" placeholder="Trenutna lozinka" />
                        </div>

                        <div>
                            <label class="label">Nova lozinka</label>
                            <input id="newPassword" class="input" type="password" placeholder="Minimalno 6 znakova" />
                        </div>

                        <div>
                            <label class="label">Potvrda nove lozinke</label>
                            <input id="confirmPassword" class="input" type="password" placeholder="Ponovite lozinku" />
                        </div>
                    </div>

                    <div style="display:flex; justify-content:flex-end; gap:12px; flex-wrap:wrap; margin-top:28px;">
                        <button type="button" id="resetBtn" class="pill" style="cursor:pointer; border-color: rgba(95,181,187,0.4);">Poništi unos</button>
                        <button type="submit" class="fill">Sačuvaj sve izmjene</button>
                    </div>

                    <div id="saveMsg" class="msg"></div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        async function loadProfile() {
            try {
                const response = await fetch('/Account/Me', {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    window.location.href = '/Account/Login';
                    return;
                }

                const user = await response.json();

                document.getElementById('displayName').value = user.fullName || user.userName || '';
                document.getElementById('usernameOrEmail').value = user.email || user.userName || '';
                document.getElementById('role').value = user.role || 'Korisnik';
                document.getElementById('phoneNumber').value = user.phoneNumber || '';
                document.getElementById('location').value = user.location || '';

                if (user.birthDate) {
                    document.getElementById('birthDate').value = user.birthDate.split('T')[0];
                } else {
                    document.getElementById('birthDate').value = '';
                }

                const initialLetter = (user.fullName || user.userName || 'U').charAt(0).toUpperCase();
                document.getElementById('userAvatar').textContent = initialLetter;

            } catch (err) {
                console.error(err);
                window.location.href = '/Account/Login';
            }
        }

        function showMsg(text, type = 'success') {
            const el = document.getElementById('saveMsg');
            el.className = 'msg ' + type;
            el.textContent = text;
            el.style.display = 'block'; 

            setTimeout(() => {
                el.style.display = 'none';
            }, 4000);
        }

        document.addEventListener('DOMContentLoaded', function () {

            loadProfile();

            document.getElementById('logoutBtnProfile')
                .addEventListener('click', async function () {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    await fetch('/Account/Logout', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        credentials: 'same-origin'
                    });
                    window.location.href = '/';
                });

            document.getElementById('resetBtn')
                .addEventListener('click', function () {
                    document.getElementById('currentPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';

                    loadProfile();
                    showMsg('Forma je vraćena na originalne podatke.', 'success');
                });

            document.getElementById('profileForm')
                .addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const nPassword = document.getElementById('newPassword').value;
                    const cPassword = document.getElementById('confirmPassword').value;

                    if (nPassword !== cPassword) {
                        showMsg('Nova lozinka i potvrda se ne podudaraju!', 'danger');
                        return;
                    }

                    const data = {
                        fullName: document.getElementById('displayName').value,
                        email: document.getElementById('usernameOrEmail').value,
                        phoneNumber: document.getElementById('phoneNumber').value,
                        location: document.getElementById('location').value,
                        birthDate: document.getElementById('birthDate').value,
                        currentPassword: document.getElementById('currentPassword').value,
                        newPassword: nPassword,
                        confirmPassword: cPassword
                    };

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const response = await fetch('/Account/UpdateProfile', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            credentials: 'same-origin',
                            body: JSON.stringify(data)
                        });

                        if (response.ok) {
                            showMsg('Profil je uspješno ažuriran i sačuvan.', 'success');
                            document.getElementById('currentPassword').value = '';
                            document.getElementById('newPassword').value = '';
                            document.getElementById('confirmPassword').value = '';
                            const currentName = document.getElementById('displayName').value;
                            document.getElementById('userAvatar').textContent = currentName.charAt(0).toUpperCase();
                        }
                        else {
                            showMsg('Greška pri čuvanju podataka na serveru.', 'danger');
                        }

                    } catch (err) {
                        console.error(err);
                        showMsg('Greška u komunikaciji sa serverom.', 'danger');
                    }
                });
        });
    </script>
}