@model List<InterTrips___Turistička_Agencija.Models.Paket>
@using InterTrips___Turistička_Agencija.Enums
@{
    ViewData["Title"] = "InterTrips - Sigurna Rezervacija";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
        :root {
        --brand-primary: #0f766e; 
        --brand-dark: #111827; 
        --brand-light: #f0fdfa; 
        --brand-accent: #0d9488;
        --text-main: #374151; 
        --text-muted: #6b7280; 
        --bg-page: #f8fafc; 
        --border-color: #e2e8f0; 
        --success-bg: #f0fdf4;
        --success-color: #166534;
        --radius-lg: 16px;
        --radius-md: 10px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .summary-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e7eb;
        overflow: hidden;
        position: sticky;
        top: 20px;
        }

        .summary-photo {
        height: 160px;
        position: relative;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        padding: 20px;
        background-color: #cbd5e0;
        }

        .summary-photo::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 100%);
        z-index: 1;
        }

        
        .summary-place {
        position: relative;
        z-index: 2;
        font-weight: 700;
        font-size: 20px;
        color: #ffffff !important;
        }

        .summary-body {
        padding: 24px;
        }

        .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        color: var(--text-muted);
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 8px;
        }

        .summary-row span:first-child {
        font-weight: 500;
        }

        .summary-row strong, .summary-row span:last-child {
        color: var(--brand-dark);
        font-weight: 600;
        }

        .price-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        }

        .price-line span:first-child {
        font-weight: 600;
        color: var(--brand-dark);
        font-size: 14px;
        }

        .total {
        color: var(--brand-primary);
        font-size: 24px;
        font-weight: 800;
        }

        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-page);
        color: var(--text-main);
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        }

        #login-block, #booking-view {
        display: none;
        }

        #login-block.active, #booking-view.active {
        display: block;
        }

        .topbar {
        height: 70px;
        background: #ffffff;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
        position: sticky;
        top: 0;
        z-index: 100;
        }

        .logo-link {
        display: flex;
        align-items: center;
        }

        .logo {
        height: 38px;
        }

        .secure-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--success-color);
        background: var(--success-bg);
        padding: 6px 14px;
        border-radius: 30px;
        border: 1px solid #bbf7d0;
        }

        .page {
        padding: 40px 20px 80px;
        }

        .center-shell {
        max-width: 1140px;
        margin: 0 auto;
        }

        .intro {
        text-align: center;
        margin-bottom: 35px;
        }

        .badge {
        display: inline-block;
        background: var(--brand-light);
        color: var(--brand-primary);
        font-size: 12px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 30px;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        }

        .intro h1 {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 10px;
        color: var(--brand-dark);
        letter-spacing: -0.5px;
        }

        .intro p {
        color: var(--text-muted);
        font-size: 15px;
        max-width: 540px;
        margin: 0 auto;
        line-height: 1.5;
        }

        .steps {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 40px;
        }

        .step {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 500;
        }

        .step .circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #e2e8f0;
        display: grid;
        place-items: center;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 12px;
        }

        .step.active {
        color: var(--brand-primary);
        font-weight: 600;
        }

        .step.active .circle {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .booking-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 30px;
        align-items: start;
        }

        .panel {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        margin-bottom: 24px;
        overflow: hidden;
        }

        .panel-pad {
        padding: 30px;
        }

        .form-group {
        margin-bottom: 20px;
        }

        .field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--brand-dark);
        margin-bottom: 8px;
        }

        .input, .select, .textarea {
        width: 100%;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        height: 46px;
        padding: 0 14px;
        font-size: 14px;
        font-family: inherit;
        color: var(--brand-dark);
        outline: none;
        box-sizing: border-box;
        transition: var(--transition);
        }

        .input:focus, .select:focus, .textarea:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
        }

        .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        }

        .custom-radio-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        }

        .custom-radio-card {
        position: relative;
        cursor: pointer;
        }

        .custom-radio-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        }

        .radio-card-content {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        transition: var(--transition);
        }

        .custom-radio-card:hover .radio-card-content {
        border-color: var(--text-muted);
        }

        .custom-radio-card input[type="radio"]:checked + .radio-card-content {
        border-color: var(--brand-primary);
        background-color: var(--brand-light);
        }

        .radio-card-text {
        display: flex;
        flex-direction: column;
        }

        .radio-card-content strong {
        font-size: 14px;
        color: var(--brand-dark);
        }

        .radio-card-content small {
        color: var(--text-muted);
        font-size: 12px;
        }

        .adult-child {
        display: flex;
        gap: 24px;
        }

        .counter-block {
        flex: 1;
        }

        .counter {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        width: 140px;
        padding: 4px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        }

        .counter button {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        border: none;
        background: #f1f5f9;
        color: var(--brand-dark);
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: grid;
        place-items: center;
        }

        .counter button:hover {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .counter span {
        font-weight: 700;
        font-size: 15px;
        color: var(--brand-dark);
        }

        #kidsNotice {
        background: #fef3c7;
        border: 1px solid #fde68a;
        color: #92400e;
        padding: 10px 14px;
        border-radius: var(--radius-md);
        font-size: 12px;
        font-weight: 500;
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        }

        .main-btn, .secondary-btn {
        height: 46px;
        border-radius: var(--radius-md);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-sizing: border-box;
        gap: 6px;
        }

        .main-btn {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .main-btn:hover {
        background: var(--brand-accent);
        }

        .secondary-btn {
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--brand-dark);
        }

        .secondary-btn:hover {
        background: #f8fafc;
        border-color: var(--text-muted);
        }

        .full-btn {
        width: 100%;
        }

       


        .total {
        color: var(--brand-primary);
        font-size: 24px;
        font-weight: 800;
        }

        .benefits {
        padding: 20px 24px;
        }

        .benefits ul {
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        }

        .benefits li {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-main);
        font-size: 13px;
        font-weight: 500;
        }

        .benefits li i {
        color: var(--brand-primary);
        width: 16px;
        height: 16px;
        }

        .login-block {
        max-width: 480px;
        margin: 40px auto 0;
        text-align: center;
        background: #ffffff;
        padding: 40px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-md);
        }

        .login-icon-box {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        margin: 0 auto 20px;
        background: var(--brand-light);
        color: var(--brand-primary);
        }

        .login-block h2 {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 8px;
        color: var(--brand-dark);
        }

        .login-block p {
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 24px;
        }

        .reason-box {
        background: var(--bg-page);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        text-align: left;
        padding: 20px;
        margin-bottom: 24px;
        }

        .reason-box h3 {
        font-size: 12px;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0 0 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        }

        .reason-box ul {
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
        }

        .reason-box li {
        list-style: none;
        font-size: 13px;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .reason-box li i {
        color: var(--brand-primary);
        width: 14px;
        height: 14px;
        }

        .login-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        }

        .login-btn {
        flex: 1;
        }

        .back-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 20px;
        color: var(--text-muted);
        font-size: 13px;
        text-decoration: none;
        transition: var(--transition);
        font-weight: 500;
        }

        .back-link:hover {
        color: var(--brand-primary);
        }

        @@media (max-width: 1024px) {
        .booking-grid {
        grid-template-columns: 1fr;
        }

        .summary-card {
        position: static;
        }
        }

        @@media (max-width: 768px) {
        .row, .custom-radio-group {
        grid-template-columns: 1fr;
        }

        .topbar {
        padding: 0 20px;
        }

        .steps {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding-left: 20px;
        }

        .login-actions {
        flex-direction: column;
        }

        .benefits ul {
        grid-template-columns: 1fr;
        }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure-badge">
            <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i> Sigurna rezervacija
        </div>
    </div>

    <div class="page">
        <div class="center-shell">

            <section id="login-block" class="login-block @(User?.Identity?.IsAuthenticated == true ? "" : "active")" style="display: @(User?.Identity?.IsAuthenticated == true ? "none" : "block");">
                <div class="login-icon-box" style="display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
                    <i data-lucide="lock" style="width: 48px; height: 48px; color: var(--brand-primary, #007bff);"></i>
                </div>
                <h2>Prijava je obavezna</h2>
                <p>Da biste rezervisali putovanje i pristupili procesu plaćanja, morate biti prijavljeni na vaš InterTrips račun.</p>

                <div class="reason-box">
                    <h3>Zašto se prijaviti?</h3>
                    <ul>
                        <li><i data-lucide="check"></i> Sigurno čuvanje podataka o rezervaciji</li>
                        <li><i data-lucide="check"></i> Pregled historije svih vaših putovanja</li>
                        <li><i data-lucide="check"></i> Obavještenja o statusu rezervacije</li>
                        <li><i data-lucide="check"></i> Ekskluzivne ponude za prijavljene korisnike</li>
                    </ul>
                </div>
                <div class="login-actions">
                    <a class="main-btn login-btn" href="/Account/Login">Prijavite se</a>
                    <button class="secondary-btn login-btn" type="button" onclick="window.location.href='/Account/Login'">Registrujte se</button>
                </div>

                <a class="back-link" href="/"><i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i> Povratak na početnu</a>
            </section>

            <section id="booking-view" class="booking-view @(User?.Identity?.IsAuthenticated == true ? "active" : "")" style="display: @(User?.Identity?.IsAuthenticated == true ? "block" : "none");">
                <div class="intro">
                    <div class="badge">REZERVACIJA PUTOVANJA</div>
                    <h1>Kreiranje rezervacije</h1>
                    <p>Unesite podatke za odabrani turistički paket i nastavite na unos podataka putnika.</p>
                </div>

                <div class="steps">
                    <div class="step active"><div class="circle">1</div> Detalji putovanja</div>
                    <div class="step"><div class="circle">2</div> Podaci o putnicima</div>
                    <div class="step"><div class="circle">3</div> Sigurno plaćanje</div>
                    <div class="step"><div class="circle">4</div> Potvrda</div>
                </div>

                <div class="booking-grid">
                    <div class="left-column">
                        <div class="panel panel-pad">

                            <div class="form-group">
                                <label class="field-label">Odaberite paket</label>
                                <select class="select" id="destinationSelect" onchange="handlePackageChange()">
                                    <option value="">-- Odaberite paket --</option>
                                    @if (Model != null)
                                    {
                                        foreach (var p in Model)
                                        {
                                            if (p.Status == StatusPaketa.Rasprodan) continue;

                                            bool isSelected = ViewBag.SelectedPackageId != null && (int)ViewBag.SelectedPackageId == p.Id;

                                            <option value="@p.Id"
                                                    selected="@(isSelected ? "selected" : null)"
                                                    data-img="@p.Destinacija?.SlikaUrl"
                                                    data-price="@p.CijenaOd"
                                                    data-destinacija="@p.Destinacija?.Naziv"
                                                    data-drzava="@p.Destinacija?.Drzava"
                                                    data-hotel="@(p.Hotel != null ? p.Hotel.Naziv + " " + string.Concat(Enumerable.Repeat("★", p.Hotel.BrojZvjezdica)) : "Uključen smještaj")"
                                                    data-let="@(p.Let != null ? p.Let.BrojLeta : "")"
                                                    data-let-relacija="@(p.Let != null ? p.Let.Polazak + " → " + p.Let.Odrediste : "")"
                                                    data-let-kompanija="@(p.Let != null ? p.Let.Aviokompanija : "")"
                                                    data-let-vrijeme="@(p.Let != null ? p.Let.VrijemePolaska.Value.ToString(@"hh\:mm") : "")"
                                                    data-prevoz-tip="@p.DostupniPrevoz"
                                                    data-polazak="@p.DatumPolaska.ToString("yyyy-MM-dd")"
                                                    data-povratak="@p.DatumPovratka.ToString("yyyy-MM-dd")">
                                                @p.Naziv (@p.Destinacija?.Naziv)
                                            </option>
                                        }
                                    }
                                </select>

                                <input type="hidden" id="departureDate" value="" />
                                <input type="hidden" id="returnDate" value="" />
                            </div>

                            <div id="prevozSekcija" class="form-group" style="display: none;">
                                <label class="field-label">Tip prevoza</label>
                                <div class="custom-radio-group">
                                    <label class="custom-radio-card">
                                        <input type="radio" name="tipPrevoza" id="prevozAvion" value="Avion" checked onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <i data-lucide="plane" style="color: var(--brand-primary); width: 18px; height: 18px;"></i>
                                            <div class="radio-card-text">
                                                <strong>Avion</strong>
                                                <small>+10% na osnovicu</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card" id="prevozBusOpcija">
                                        <input type="radio" name="tipPrevoza" id="prevozBus" value="Bus" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <i data-lucide="bus" style="color: var(--brand-primary); width: 18px; height: 18px;"></i>
                                            <div class="radio-card-text">
                                                <strong>Autobus</strong>
                                                <small>Standardna cijena</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group">
                                <a id="planLink" class="secondary-btn" href="#" style="display:none; height: 38px; font-size: 13px; padding: 0 14px;">
                                    <i data-lucide="map" style="width: 14px; height: 14px;"></i> Pogledaj plan putovanja
                                </a>
                            </div>

                            <div class="adult-child form-group">
                                <div class="counter-block">
                                    <label class="field-label">Odrasli</label>
                                    <div class="counter">
                                        <button type="button" onclick="changeCount('adults', -1)">−</button>
                                        <span id="adultsCount">2</span>
                                        <button type="button" onclick="changeCount('adults', 1)">+</button>
                                    </div>
                                </div>
                                <div class="counter-block">
                                    <label class="field-label">Djeca</label>
                                    <div class="counter">
                                        <button type="button" onclick="changeCount('children', -1)">−</button>
                                        <span id="childrenCount">0</span>
                                        <button type="button" onclick="changeCount('children', 1)">+</button>
                                    </div>
                                    <div id="kidsNotice" style="display:none;">
                                        <i data-lucide="info" style="width: 14px; height: 14px;"></i> Djeca do 17 godina ne plaćaju aranžman!
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="field-label" style="margin-bottom: 12px;">Vrsta smještaja</label>
                                <div class="custom-radio-group">
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="standardna soba" checked onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Standardna soba</strong>
                                                <small>Uključeno u cijenu</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="deluxe soba" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Deluxe soba</strong>
                                                <small>+200 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="suite" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Suite</strong>
                                                <small>+500 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="president suite" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>President suite</strong>
                                                <small>+1200 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <button class="main-btn full-btn" style="margin-top: 15px;" onclick="goToPassengers()">
                                Nastavi na unos putnika <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="right-column">
                        <div class="panel summary-card">
                            <div class="summary-photo" id="summaryPhoto" style="background-image: url('/assets/bali.jpg'); min-height: 150px; background-size: cover; background-position: center;">
                                <div class="summary-place" id="summaryDestination" style="color: #fff; text-shadow: 1px 1px 4px rgba(0,0,0,0.8); padding: 10px; font-weight: bold;">Odaberite destinaciju</div>
                            </div>

                            <div class="summary-body">
                                <div class="summary-row">
                                    <span><i data-lucide="users" class="summary-icon"></i> Putnici</span>
                                    <strong id="summaryTravelers">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="calendar" class="summary-icon"></i> Trajanje</span>
                                    <strong id="summaryNights">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="hotel" class="summary-icon"></i> Hotel</span>
                                    <strong id="summaryHotel">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="door-open" class="summary-icon"></i> Smještaj</span>
                                    <strong id="summaryRoom">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="navigation" class="summary-icon"></i> Odabrani prevoz</span>
                                    <strong id="summaryPrevoz">—</strong>
                                </div>

                                <hr class="summary-divider">

                                <div id="flightSummarySection">
                                    <div class="summary-row">
                                        <span><i data-lucide="plane" class="summary-icon"></i> Detalji leta</span>
                                        <strong id="summaryLet">—</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span><i data-lucide="plane-takeoff" class="summary-icon"></i> Polazak</span>
                                        <strong id="summaryDeparture">—</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span><i data-lucide="plane-landing" class="summary-icon"></i> Povratak</span>
                                        <strong id="summaryReturn">—</strong>
                                    </div>
                                </div>

                                <div id="busSummarySection" style="display: none;">
                                    <div class="summary-row">
                                        <span><i data-lucide="bus" class="summary-icon"></i> Prevoz</span>
                                        <strong>Autobuski aranžman</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span><i data-lucide="calendar-days" class="summary-icon"></i> Polazak</span>
                                        <strong id="summaryBusDeparture">—</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span><i data-lucide="calendar-days" class="summary-icon"></i> Povratak</span>
                                        <strong id="summaryBusReturn">—</strong>
                                    </div>
                                </div>

                                <hr class="summary-divider">

                                <div class="price-line">
                                    <span>Ukupna cijena aranžmana:</span>
                                    <span class="total" id="summaryTotal">0.00 KM</span>
                                </div>
                            </div>
                        </div>

                        <div class="panel benefits" style="margin-top: 20px;">
                            <ul>
                                <li><i data-lucide="lock"></i> SSL sigurnost podataka</li>
                                <li><i data-lucide="calendar-x"></i> Besplatno otkazivanje 48h</li>
                                <li><i data-lucide="phone-call"></i> Podrška agencije 24/7</li>
                                <li><i data-lucide="badge-check"></i> Garancija najbolje cijene</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="center-shell" style="margin-top: 20px;">
        @if (Model != null && ViewBag.SelectedPackageId != null)
        {
            var odabraniPaket = ((IEnumerable<dynamic>)Model).FirstOrDefault(p => p.Id == ViewBag.SelectedPackageId);
            if (odabraniPaket != null && odabraniPaket.Let != null)
            {
                <div class="card mt-3" style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden;">
                    <div class="card-header bg-info text-white" style="background: #0284c7; color: white; padding: 12px 16px;">
                        <h4 style="margin:0;">Detalji leta iz baze</h4>
                    </div>
                    <div class="card-body" style="padding: 16px; background: #f8fafc;">
                        <p><strong>Aviokompanija:</strong> @odabraniPaket.Let.Aviokompanija</p>
                        <p><strong>Broj leta:</strong> @odabraniPaket.Let.BrojLeta</p>
                        <p><strong>Polazak:</strong> @odabraniPaket.Let.VrijemePolaska.ToString("dd.MM.yyyy HH:mm")</p>
                        <p><strong>Dolazak:</strong> @odabraniPaket.Let.VrijemeDolaska.ToString("dd.MM.yyyy HH:mm")</p>
                    </div>
                </div>
            }
        }
    </div>

    <script>
        lucide.createIcons();

        const destinationSelect = document.getElementById('destinationSelect');
        const departureDate = document.getElementById('departureDate');
        const returnDate = document.getElementById('returnDate');
        const adultsCount = document.getElementById('adultsCount');
        const childrenCount = document.getElementById('childrenCount');
        const summaryTotal = document.getElementById('summaryTotal');
        const summaryRoom = document.getElementById('summaryRoom');
        const kidsNotice = document.getElementById('kidsNotice');
        const prevozSekcija = document.getElementById('prevozSekcija');
        const prevozBusOpcija = document.getElementById('prevozBusOpcija');
        const prevozAvion = document.getElementById('prevozAvion');
        const prevozBus = document.getElementById('prevozBus');
        const summaryPrevoz = document.getElementById('summaryPrevoz');

        const ROOM_EXTRAS = {
        "standardna soba": 0,
        "deluxe soba": 200,
        "suite": 500,
        "president suite": 1200
        };

        window.addEventListener('DOMContentLoaded', function () {
        if (adultsCount) {
        adultsCount.textContent = localStorage.getItem('reservationAdults') || "2";
        }
        if (childrenCount) {
        const kids = localStorage.getItem('reservationChildren') || "0";
        childrenCount.textContent = kids;
        if (kidsNotice) kidsNotice.style.display = parseInt(kids, 10) > 0 ? 'flex' : 'none';
        }
        handlePackageChange();
        });

        function handlePackageChange() {
        const select = document.getElementById('destinationSelect');
        if (!select) return;
        const selectedOpt = select.options[select.selectedIndex];

        if (!selectedOpt || select.value === "") {
        if (departureDate) departureDate.value = "";
        if (returnDate) returnDate.value = "";
        resetSummary();
        return;
        }

        if (departureDate) departureDate.value = selectedOpt.getAttribute('data-polazak') || "";
        if (returnDate) returnDate.value = selectedOpt.getAttribute('data-povratak') || "";

        const prevozTip = selectedOpt.getAttribute('data-prevoz-tip');
        if (prevozTip === 'Oboje') {
        if (prevozSekcija) prevozSekcija.style.display = 'block';
        if (prevozBusOpcija) prevozBusOpcija.style.display = 'block';
        const avionCard = prevozAvion ? prevozAvion.closest('.custom-radio-card') : null;
        if (avionCard) avionCard.style.display = 'block';
        if (prevozAvion && prevozBus && !prevozAvion.checked && !prevozBus.checked) {
        prevozAvion.checked = true;
        }
        } else {
        if (prevozSekcija) prevozSekcija.style.display = 'none';
        if (prevozTip === 'SamoAutobus') {
        if (prevozBus) prevozBus.checked = true;
        if (prevozAvion) prevozAvion.checked = false;
        } else {
        if (prevozAvion) prevozAvion.checked = true;
        if (prevozBus) prevozBus.checked = false;
        }
        }

        const planLink = document.getElementById('planLink');
        if (planLink) {
        planLink.href = `/PlanPutovanja/Preview?paketId=${selectedOpt.value}`;
        planLink.style.display = 'inline-flex';
        }

        updateSummary();
        }

        function formatDate(dateStr) {
        if (!dateStr) return "—";
        const date = new Date(dateStr);

        if (isNaN(date.getTime())) {
        const numbers = dateStr.match(/\d+/g);
        if (numbers && numbers.length >= 3) {
        if (dateStr.includes('.')) {
        return `${numbers[0].padStart(2, '0')}.${numbers[1].padStart(2, '0')}.${numbers[2]}.`;
        }
        return `${numbers[2].padStart(2, '0')}.${numbers[1].padStart(2, '0')}.${numbers[0]}.`;
        }
        return "—";
        }

        const dan = String(date.getDate()).padStart(2, '0');
        const mjesec = String(date.getMonth() + 1).padStart(2, '0');
        const godina = date.getFullYear();

        return `${dan}.${mjesec}.${godina}.`;
        }

        function changeCount(type, val) {
        if (type === 'adults' && adultsCount) {
        let current = parseInt(adultsCount.textContent, 10) || 2;
        current += val;
        if (current < 1) current = 1; 
        adultsCount.textContent = current;
        localStorage.setItem('reservationAdults', current);
        } else if (type === 'children' && childrenCount) {
        let current = parseInt(childrenCount.textContent, 10) || 0;
        current += val;
        if (current < 0) current = 0; 
        if (current > 10) current = 10; 
        childrenCount.textContent = current;
        localStorage.setItem('reservationChildren', current);
        if (kidsNotice) kidsNotice.style.display = current > 0 ? 'flex' : 'none';
        }
        updateSummary();
        }

        function parseLocalDate(dateString) {
        const parts = dateString.split('-');
        return new Date(parts[0], parts[1] - 1, parts[2]);
        }

        function updateSummary() {
        const select = document.getElementById('destinationSelect');
        if (!select || select.value === "") {
        resetSummary();
        return;
        }

        const selectedOpt = select.options[select.selectedIndex];

        const basePrice = parseFloat(selectedOpt.getAttribute('data-price')) || 0;
        const destName = selectedOpt.getAttribute('data-destinacija') || "—";
        const country = selectedOpt.getAttribute('data-drzava') || "";
        const hotel = selectedOpt.getAttribute('data-hotel') || '—';
        const imgUrl = selectedOpt.getAttribute('data-img');
        const prevozTip = selectedOpt.getAttribute('data-prevoz-tip');

        const adults = parseInt(document.getElementById('adultsCount')?.textContent || "2");
        const children = parseInt(document.getElementById('childrenCount')?.textContent || "0");

        const roomTypeRadio = document.querySelector('input[name="roomType"]:checked');
        const roomTypeValue = roomTypeRadio ? roomTypeRadio.value : 'standardna soba';
        const transportType = document.querySelector('input[name="tipPrevoza"]:checked')?.value || 'Autobus';

        const depDateVal = departureDate ? departureDate.value : '';
        const retDateVal = returnDate ? returnDate.value : '';

        if (document.getElementById('summaryDeparture')) document.getElementById('summaryDeparture').textContent = formatDate(depDateVal);
        if (document.getElementById('summaryReturn')) document.getElementById('summaryReturn').textContent = formatDate(retDateVal);

        if (depDateVal && retDateVal) {
        const d1 = parseLocalDate(depDateVal);
        const d2 = parseLocalDate(retDateVal);
        let brojDana = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));

        if (brojDana < 0) {
        if (document.getElementById('summaryNights')) document.getElementById('summaryNights').textContent = "Greška u datumima";
        } else if (brojDana === 0) {
        if (document.getElementById('summaryNights')) document.getElementById('summaryNights').textContent = "1 dan (Jednodnevni izlet)";
        } else {
        if (document.getElementById('summaryNights')) document.getElementById('summaryNights').textContent = `${brojDana} dana / ${brojDana - 1} noćenja`;
        }
        } else {
        if (document.getElementById('summaryNights')) document.getElementById('summaryNights').textContent = "—";
        }

        if (document.getElementById('summaryDestination')) {
        document.getElementById('summaryDestination').textContent = country ? `${destName}, ${country}` : destName;
        }

        if (imgUrl && imgUrl.trim() !== "") {
        document.getElementById('summaryPhoto').style.backgroundImage = `url('${imgUrl}')`;
        } else {
        document.getElementById('summaryPhoto').style.backgroundImage = "url('/assets/bali.jpg')";
        }

        if (document.getElementById('summaryTravelers')) document.getElementById('summaryTravelers').textContent = `Odrasli: ${adults}, Djeca: ${children}`;
        if (document.getElementById('summaryHotel')) document.getElementById('summaryHotel').textContent = hotel;

        if (summaryRoom) {
        summaryRoom.textContent = roomTypeValue.charAt(0).toUpperCase() + roomTypeValue.slice(1);
        }

        const flight = selectedOpt.getAttribute('data-let');
        const kompanija = selectedOpt.getAttribute('data-let-kompanija');
        const vrijeme = selectedOpt.getAttribute('data-let-vrijeme');
        const fullPolazak = selectedOpt.getAttribute('data-let-full-polazak');
        const fullDolazak = selectedOpt.getAttribute('data-let-full-dolazak');

        const flightSection = document.getElementById('flightSummarySection');
        const busSection = document.getElementById('busSummarySection');
        const dbFlightCard = document.getElementById('dbFlightDetailsCard');

        if (transportType === 'Avion') {
        if (summaryPrevoz) summaryPrevoz.textContent = '✈️ Avion';
        if (flight && flight.trim() !== "") {
        if (document.getElementById('summaryLet')) document.getElementById('summaryLet').textContent = `${flight} (${kompanija}) - ${vrijeme}`;

        if (document.getElementById('dbFlightCompany')) document.getElementById('dbFlightCompany').textContent = kompanija;
        if (document.getElementById('dbFlightNumber')) document.getElementById('dbFlightNumber').textContent = flight;
        if (document.getElementById('dbFlightDepTime')) document.getElementById('dbFlightDepTime').textContent = fullPolazak;
        if (document.getElementById('dbFlightArrTime')) document.getElementById('dbFlightArrTime').textContent = fullDolazak;
        if (dbFlightCard) dbFlightCard.style.display = 'block';
        } else {
        if (document.getElementById('summaryLet')) document.getElementById('summaryLet').textContent = 'Uključen let';
        if (dbFlightCard) dbFlightCard.style.display = 'none';
        }
        if (flightSection) flightSection.style.display = 'block';
        if (busSection) busSection.style.display = 'none';
        } else {
        if (summaryPrevoz) summaryPrevoz.textContent = '🚌 Autobus';
        if (flightSection) flightSection.style.display = 'none';
        if (busSection) busSection.style.display = 'block';
        if (dbFlightCard) dbFlightCard.style.display = 'none';
        if (document.getElementById('summaryBusDeparture')) document.getElementById('summaryBusDeparture').textContent = formatDate(depDateVal);
        if (document.getElementById('summaryBusReturn')) document.getElementById('summaryBusReturn').textContent = formatDate(retDateVal);
        }


        let total = basePrice * adults;
        if (prevozTip === 'Oboje' && transportType === 'Avion') {
        total += (basePrice * 0.10) * adults;
        }

        const extraPerPerson = (typeof ROOM_EXTRAS !== 'undefined' && ROOM_EXTRAS[roomTypeValue.toLowerCase()]) || 0;
        total += extraPerPerson * adults;

        if (summaryTotal) {
        summaryTotal.textContent = `${total.toFixed(2)} KM`;
        }

        try {
        localStorage.setItem('reservationTotal', `${total.toFixed(2)} KM`);
        localStorage.setItem('selectedPackageId', selectedOpt.value);
        } catch (e) {
        console.warn("Problem sa lokalnim skladištem:", e);
        }
        }

        function resetSummary() {
        if (document.getElementById('summaryDestination')) document.getElementById('summaryDestination').textContent = "Odaberite destinaciju";
        if (document.getElementById('summaryPhoto')) document.getElementById('summaryPhoto').style.backgroundImage = "url('/assets/bali.jpg')";
        if (document.getElementById('summaryDeparture')) document.getElementById('summaryDeparture').textContent = "—";
        if (document.getElementById('summaryReturn')) document.getElementById('summaryReturn').textContent = "—";
        if (document.getElementById('summaryTravelers')) document.getElementById('summaryTravelers').textContent = "Odrasli: 2, Djeca: 0";
        if (document.getElementById('summaryNights')) document.getElementById('summaryNights').textContent = "—";
        if (summaryPrevoz) summaryPrevoz.textContent = "—";
        if (document.getElementById('summaryLet')) document.getElementById('summaryLet').textContent = "—";
        if (document.getElementById('summaryHotel')) document.getElementById('summaryHotel').textContent = "—";
        if (summaryRoom) summaryRoom.textContent = "Standardna soba";
        if (summaryTotal) summaryTotal.textContent = "0.00 KM";
        }

        function goToPassengers() {
        const select = document.getElementById('destinationSelect');

        if (!select || select.value === "") {
        alert("Molimo vas da odaberete turistički paket prije nastavka.");
        select.focus();
        return;
        }

        const selectedOpt = select.options[select.selectedIndex];

        const paketNaziv = selectedOpt.getAttribute('data-destinacija') || "—";
        const drzavaNaziv = selectedOpt.getAttribute('data-drzava') || "";
        const hotelNaziv = selectedOpt.getAttribute('data-hotel') || "—";
        const imgUrl = selectedOpt.getAttribute('data-img') || "";

        const flight = selectedOpt.getAttribute('data-let') || "";
        const kompanija = selectedOpt.getAttribute('data-let-kompanija') || "";
        const vrijeme = selectedOpt.getAttribute('data-let-vrijeme') || "";
        let letRuta = (flight) ? `${flight} (${kompanija}) - ${vrijeme}` : "Uključen let";

        const adultsRaw = document.getElementById('adultsCount')?.textContent || "2";
        const childrenRaw = document.getElementById('childrenCount')?.textContent || "0";

        const adults = parseInt(adultsRaw.replace(/\D/g, ""), 10) || 2;
            const children = parseInt(childrenRaw.replace(/\D/g, ""), 10) || 0;
            const ukupnoPutnika = adults + children;

        const transportType = document.querySelector('input[name="tipPrevoza"]:checked')?.value || 'Autobus';
        const roomTypeRadio = document.querySelector('input[name="roomType"]:checked');
        const roomTypeValue = roomTypeRadio ? roomTypeRadio.value : 'standardna soba';

        const trajanjeNoćenja = document.getElementById('summaryNights')?.textContent?.trim() || "—";
        const ukupnaCijena = document.getElementById('summaryTotal')?.textContent?.trim() || "0.00 KM";

        const depDateVal = departureDate ? departureDate.value : '';
        const retDateVal = returnDate ? returnDate.value : '';

        const polazakDatum = formatDate(depDateVal);
        const povratakDatum = formatDate(retDateVal);

        localStorage.setItem('reservationPaketId', select.value);
        localStorage.setItem('reservationTravelers', ukupnoPutnika.toString());
        localStorage.setItem('reservationAdults', adults.toString());
        localStorage.setItem('reservationChildren', children.toString());

        localStorage.setItem('reservationDestination', paketNaziv);
        localStorage.setItem('reservationCountry', drzavaNaziv);
        localStorage.setItem('reservationHotelName', hotelNaziv);
        localStorage.setItem('reservationRoom', roomTypeValue);
        localStorage.setItem('reservationNights', trajanjeNoćenja);
        localStorage.setItem('reservationTotal', ukupnaCijena);
        localStorage.setItem('reservationPrevozTip', transportType);
        localStorage.setItem('reservationDeparture', polazakDatum);
        localStorage.setItem('reservationReturn', povratakDatum);
        localStorage.setItem('reservationFlightRoute', letRuta);

        if (imgUrl && imgUrl.trim() !== "" && imgUrl !== "none") {
        localStorage.setItem('reservationImage', imgUrl);
        } else {
        localStorage.setItem('reservationImage', '/assets/bali.jpg');
        }

        localStorage.removeItem('savedPassengers');
        window.location.href = `/Rezervacija/Putnici?paketId=${select.value}&odrasli=${adults}&djeca=${children}`;
        }
    </script>
    </body>
    </html>