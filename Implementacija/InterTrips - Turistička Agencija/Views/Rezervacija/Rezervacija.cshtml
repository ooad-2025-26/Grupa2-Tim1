@{
    ViewData["Title"] = "InterTrips - Rezervacija";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
            .page {
                padding: 34px 24px 56px;
            }

            .topbar {
                height: 56px;
                background: rgba(255,255,255,0.80);
                border-bottom: 1px solid rgba(95,181,187,0.12);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 26px;
                position: sticky;
                top: 0;
                z-index: 50;
                backdrop-filter: blur(10px);
            }

            .secure {
                font-size: 12px;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .secure::before {
                    content: "🛡";
                    color: var(--primary-dark);
                }

            .center-shell {
                max-width: 1140px;
                margin: 0 auto;
            }

            .intro {
                text-align: center;
                padding: 22px 0 24px;
            }

                .intro h1 {
                    font-size: clamp(2rem, 4vw, 3.2rem);
                    line-height: 1.1;
                    font-weight: 800;
                    margin-bottom: 8px;
                    color: var(--text);
                }

                    .intro h1 span {
                        color: var(--primary-dark);
                    }

                .intro p {
                    color: var(--muted);
                    font-size: 13px;
                    max-width: 580px;
                    margin: 0 auto;
                    line-height: 1.6;
                }

            .steps {
                display: flex;
                justify-content: center;
                gap: 48px;
                align-items: center;
                margin: 18px 0 28px;
                flex-wrap: wrap;
            }

            .step {
                text-align: center;
                color: var(--muted);
                font-size: 11px;
            }

                .step .circle {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    border: 1px solid rgba(95,181,187,0.35);
                    display: grid;
                    place-items: center;
                    margin: 0 auto 8px;
                    color: var(--primary-dark);
                    background: rgba(255,255,255,0.65);
                }

                .step.active {
                    color: var(--text);
                    font-weight: 600;
                }

                    .step.active .circle {
                        background: linear-gradient(135deg, #6abfc6, #86bfe0);
                        color: #ffffff;
                        border-color: transparent;
                    }

            .booking-grid {
                display: grid;
                grid-template-columns: 1.7fr 1fr;
                gap: 20px;
                align-items: start;
            }

            .panel {
                background: rgba(255,255,255,0.84);
                border: 1px solid rgba(95,181,187,0.16);
                border-radius: 16px;
                box-shadow: var(--shadow);
                backdrop-filter: blur(10px);
            }

            .panel-pad {
                padding: 18px;
            }

            .field-label {
                display: block;
                font-size: 11px;
                font-weight: 700;
                color: var(--primary-dark);
                margin: 12px 0 8px;
                letter-spacing: 0.6px;
            }

            .input, .select, .textarea {
                width: 100%;
                background: rgba(255,255,255,0.94);
                border: 1px solid rgba(95,181,187,0.18);
                color: var(--text);
                outline: none;
                border-radius: 10px;
                height: 40px;
                padding: 0 14px;
                font-size: 13px;
            }

            .textarea {
                height: 92px;
                padding: 12px 14px;
                resize: none;
            }

                .input::placeholder,
                .textarea::placeholder {
                    color: rgba(95,124,134,0.7);
                }

            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            .adult-child {
                display: flex;
                gap: 24px;
                margin: 8px 0 6px;
                flex-wrap: wrap;
            }

            .counter-block {
                min-width: 180px;
            }

            .counter {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                margin-top: 6px;
            }

                .counter button {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    border: none;
                    background: rgba(106,191,198,0.14);
                    color: var(--primary-dark);
                    font-size: 18px;
                    cursor: pointer;
                }

                .counter span {
                    min-width: 18px;
                    text-align: center;
                    font-weight: 700;
                    font-size: 16px;
                    color: var(--text);
                }

            .room-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 8px;
            }

            .room-option {
                border: 1px solid rgba(95,181,187,0.18);
                border-radius: 10px;
                padding: 12px;
                background: rgba(255,255,255,0.78);
                color: var(--muted);
                cursor: pointer;
                min-height: 58px;
                transition: 0.2s ease;
            }

                .room-option.active {
                    border-color: var(--primary-dark);
                    background: rgba(106,191,198,0.14);
                    color: var(--text);
                }

                .room-option strong {
                    display: block;
                    font-size: 13px;
                    margin-bottom: 2px;
                    color: var(--text);
                }

                .room-option small {
                    color: var(--muted);
                    font-size: 11px;
                }

            .destination-cards {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 14px;
                margin-top: 14px;
            }

            .destination-card {
                border: 1px solid rgba(95,181,187,0.18);
                border-radius: 14px;
                overflow: hidden;
                background: rgba(255,255,255,0.78);
                cursor: pointer;
                transition: 0.2s ease;
                box-shadow: var(--shadow);
            }

                .destination-card:hover {
                    transform: translateY(-2px);
                    border-color: var(--primary-dark);
                }

                .destination-card img {
                    width: 100%;
                    height: 120px;
                    object-fit: cover;
                    display: block;
                }

                .destination-card strong,
                .destination-card small {
                    display: block;
                    padding: 0 12px;
                }

                .destination-card strong {
                    margin-top: 10px;
                    font-size: 14px;
                    color: var(--text);
                }

                .destination-card small {
                    margin: 4px 0 12px;
                    color: var(--muted);
                    font-size: 12px;
                }

            .main-btn, .secondary-btn {
                height: 46px;
                border-radius: 12px;
                border: none;
                cursor: pointer;
                font-weight: 700;
                font-size: 14px;
                transition: 0.2s ease;
            }

            .main-btn {
                background: linear-gradient(135deg, #6abfc6, #86bfe0);
                color: #ffffff;
            }

                .main-btn:hover {
                    filter: brightness(1.03);
                }

            .secondary-btn {
                background: transparent;
                border: 1px solid rgba(95,181,187,0.25);
                color: var(--text);
            }

                .secondary-btn:hover {
                    background: rgba(106,191,198,0.08);
                }

            .full-btn {
                width: 100%;
                margin-top: 14px;
            }

            .summary-card {
                overflow: hidden;
            }

            .summary-photo {
                height: 170px;
                background: linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/bali.jpg') center/cover no-repeat;
                position: relative;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            .summary-rating {
                position: absolute;
                top: 12px;
                right: 12px;
                background: rgba(31,63,71,0.86);
                padding: 4px 8px;
                border-radius: 999px;
                font-size: 11px;
                color: #8ecae6;
                font-weight: 700;
            }

            .summary-place {
                position: absolute;
                left: 14px;
                bottom: 14px;
                font-weight: 700;
                font-size: 18px;
                color: #fff;
            }

                .summary-place small {
                    display: block;
                    font-size: 11px;
                    color: #dff4f5;
                    font-weight: 500;
                    margin-top: 2px;
                }

            .summary-body {
                padding: 16px;
            }

            .summary-title {
                color: var(--primary-dark);
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 14px;
            }

            .summary-row {
                display: flex;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 10px;
                font-size: 12px;
                color: var(--muted);
            }

                .summary-row strong {
                    color: var(--text);
                    font-size: 12px;
                }

            .price-line {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 14px;
                padding-top: 12px;
                border-top: 1px solid rgba(95,181,187,0.12);
            }

            .total {
                color: var(--primary-dark);
                font-size: 24px;
                font-weight: 800;
            }

            .benefits {
                margin-top: 14px;
                padding: 16px;
            }

                .benefits li {
                    list-style: none;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 12px;
                    color: var(--muted);
                    font-size: 12px;
                }

                    .benefits li::before {
                        content: "✓";
                        color: var(--primary-dark);
                        font-weight: 700;
                    }

            .booking-view, .login-block {
                display: none;
            }

                .booking-view.active, .login-block.active {
                    display: block;
                }

            .login-block {
                max-width: 520px;
                margin: 40px auto 0;
                text-align: center;
            }

            .login-hero {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                border: 1px solid rgba(95,181,187,0.20);
                display: grid;
                place-items: center;
                margin: 0 auto 22px;
                color: var(--primary-dark);
                background: rgba(255,255,255,0.78);
                font-size: 28px;
            }

            .login-block h2 {
                font-size: 26px;
                margin-bottom: 8px;
                color: var(--text);
            }

            .login-block p {
                color: var(--muted);
                font-size: 13px;
                line-height: 1.6;
            }

            .reason-box {
                margin: 22px auto 0;
                width: 100%;
                max-width: 420px;
                background: rgba(255,255,255,0.80);
                border: 1px solid rgba(95,181,187,0.16);
                border-radius: 14px;
                text-align: left;
                padding: 14px 16px;
                box-shadow: var(--shadow);
            }

                .reason-box h3 {
                    font-size: 12px;
                    color: var(--primary-dark);
                    margin-bottom: 10px;
                }

                .reason-box ul {
                    display: grid;
                    gap: 10px;
                }

                .reason-box li {
                    list-style: none;
                    font-size: 12px;
                    color: var(--muted);
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }

                    .reason-box li::before {
                        content: "⬤";
                        color: var(--primary-dark);
                        font-size: 8px;
                    }

            .login-actions {
                display: flex;
                gap: 12px;
                justify-content: center;
                margin-top: 22px;
                flex-wrap: wrap;
            }

            .login-btn {
                height: 40px;
                min-width: 150px;
                padding: 0 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                line-height: 1;
                font-size: 13px;
            }

            .back-link {
                display: inline-block;
                margin-top: 16px;
                color: var(--muted);
                font-size: 12px;
            }

            @@media (max-width: 980px) {
                .booking-grid {
                    grid-template-columns: 1fr;
                }

                .destination-cards {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 700px) {
                .row, .room-grid {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    padding: 0 16px;
                }

                .page {
                    padding: 18px 12px;
                }
            }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure">Sigurna rezervacija</div>
    </div>

    <div class="page">
        <div class="center-shell">
            <section id="login-block" class="login-block active">
                <div class="login-hero">🔒</div>
                <h2>Prijava je obavezna</h2>
                <p>Da biste rezervisali putovanje i pristupili procesu plaćanja, morate biti prijavljeni na vaš InterTrips račun.</p>

                <div class="reason-box">
                    <h3>ZAŠTO SE PRIJAVITI?</h3>
                    <ul>
                        <li>Sigurno čuvanje podataka o rezervaciji</li>
                        <li>Pregled historije svih vaših putovanja</li>
                        <li>Obavještenja o statusu rezervacije</li>
                        <li>Ekskluzivne ponude za prijavljene korisnike</li>
                    </ul>
                </div>

                <div class="login-actions">
                    <!-- MVC: umjesto login.html -->
                    <a class="main-btn login-btn" href="/korisnik/login">Prijavite se</a>
                    <button class="secondary-btn login-btn" type="button" onclick="window.location.href='/korisnik/login'">Registrujte se</button>
                </div>

                <a class="back-link" href="/">← Povratak na početnu</a>
            </section>

            <section id="booking-view" class="booking-view">
                <div class="intro">
                    <div class="badge">REZERVACIJA PUTOVANJA</div>
                    <h1>Kreiranje <span>rezervacije</span></h1>
                    <p>Unesite podatke za odabrani turistički paket i nastavite na unos podataka putnika.</p>
                </div>

                <div class="steps">
                    <div class="step active"><div class="circle">1</div>Detalji putovanja</div>
                    <div class="step"><div class="circle">2</div>Putnici</div>
                    <div class="step"><div class="circle">3</div>Plaćanje</div>
                    <div class="step"><div class="circle">4</div>Potvrda</div>
                </div>

                <div class="booking-grid">
                    <div class="panel panel-pad">
                        <label class="field-label">ODABERITE PAKET</label>
                        <select class="select" id="destinationSelect">
                            <option value="">-- Odaberite paket --</option>
                            <option value="santorini">Santorini, Grčka, od $1299</option>
                            <option value="kyoto">Kyoto, Japan, od $1850</option>
                            <option value="machupicchu">Machu Picchu, Peru, od $2200</option>
                            <option value="dubai">Dubai, UAE, od $1560</option>
                            <option value="paris">Paris, Francuska, od $1420</option>
                            <option value="bali">Bali, Indonezija, od $1980</option>
                        </select>

                        <div class="destination-cards">
                            <div class="destination-card" onclick="selectDestination('santorini')">
                                <img src="~/assets/destination1.jpg" alt="Santorini">
                                <strong>Santorini</strong>
                                <small>Grčka</small>
                            </div>

                            <div class="destination-card" onclick="selectDestination('kyoto')">
                                <img src="~/assets/destination2.jpg" alt="Kyoto">
                                <strong>Kyoto</strong>
                                <small>Japan</small>
                            </div>

                            <div class="destination-card" onclick="selectDestination('machupicchu')">
                                <img src="~/assets/destination3.jpg" alt="Machu Picchu">
                                <strong>Machu Picchu</strong>
                                <small>Peru</small>
                            </div>

                            <div class="destination-card" onclick="selectDestination('dubai')">
                                <img src="~/assets/destination4.jpg" alt="Dubai">
                                <strong>Dubai</strong>
                                <small>UAE</small>
                            </div>

                            <div class="destination-card" onclick="selectDestination('paris')">
                                <img src="~/assets/destination5.jpg" alt="Paris">
                                <strong>Paris</strong>
                                <small>Francuska</small>
                            </div>

                            <div class="destination-card" onclick="selectDestination('bali')">
                                <img src="~/assets/destination6.jpg" alt="Bali">
                                <strong>Bali</strong>
                                <small>Indonezija</small>
                            </div>
                        </div>

                        <div class="row">
                            <div>
                                <label class="field-label">DATUM POLASKA</label>
                                <input class="input" type="date" id="departureDate" />
                            </div>
                            <div>
                                <label class="field-label">DATUM POVRATKA</label>
                                <input class="input" type="date" id="returnDate" />
                            </div>
                        </div>

                        <div class="adult-child">
                            <div class="counter-block">
                                <label class="field-label">ODRASLI</label>
                                <div class="counter">
                                    <button type="button" onclick="changeCount('adults', -1)">−</button>
                                    <span id="adultsCount">2</span>
                                    <button type="button" onclick="changeCount('adults', 1)">+</button>
                                </div>
                            </div>

                            <div class="counter-block">
                                <label class="field-label">DJECA (DO 12 GOD.)</label>
                                <div class="counter">
                                    <button type="button" onclick="changeCount('children', -1)">−</button>
                                    <span id="childrenCount">0</span>
                                    <button type="button" onclick="changeCount('children', 1)">+</button>
                                </div>
                            </div>
                        </div>

                        <label class="field-label">VRSTA SMJEŠTAJA</label>
                        <div class="room-grid">
                            <div class="room-option active" onclick="selectRoom(this)">
                                <strong>Standardna soba</strong>
                                <small>Uključeno u cijenu</small>
                            </div>
                            <div class="room-option" onclick="selectRoom(this)">
                                <strong>Deluxe soba</strong>
                                <small>+$200/osobi</small>
                            </div>
                            <div class="room-option" onclick="selectRoom(this)">
                                <strong>Suite</strong>
                                <small>+$500/osobi</small>
                            </div>
                            <div class="room-option" onclick="selectRoom(this)">
                                <strong>Privatna vila</strong>
                                <small>+$1200/osobi</small>
                            </div>
                        </div>

                        <button class="main-btn full-btn" type="button" onclick="goToPassengers()">Nastavi na podatke putnika →</button>
                    </div>

                    <div>
                        <div class="panel summary-card">
                            <div class="summary-photo" id="summaryPhoto">
                                <div class="summary-rating">★ 4.8</div>
                                <div class="summary-place" id="summaryDestination">Odaberite destinaciju <small id="summaryCountry">—</small></div>
                            </div>
                            <div class="summary-body">
                                <div class="summary-title">SAŽETAK REZERVACIJE</div>
                                <div class="summary-row"><span>Polazak</span><strong id="summaryDeparture">—</strong></div>
                                <div class="summary-row"><span>Povratak</span><strong id="summaryReturn">—</strong></div>
                                <div class="summary-row"><span>Putnici</span><strong id="summaryTravelers">2 odraslih</strong></div>
                                <div class="summary-row"><span>Smještaj</span><strong id="summaryRoom">Standardna soba</strong></div>
                                <div class="price-line">
                                    <span>Ukupno</span>
                                    <span class="total" id="summaryTotal">$0</span>
                                </div>
                            </div>
                        </div>

                        <div class="panel benefits">
                            <ul>
                                <li>SSL enkripcija podataka</li>
                                <li>Besplatno otkazivanje 48h</li>
                                <li>Podrška 24/7</li>
                                <li>Garancija najbolje cijene</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
            const destinationSelect = document.getElementById('destinationSelect');
            const departureDate = document.getElementById('departureDate');
            const returnDate = document.getElementById('returnDate');
            const adultsCount = document.getElementById('adultsCount');
            const childrenCount = document.getElementById('childrenCount');
            const summaryPhoto = document.getElementById('summaryPhoto');
            const summaryDestination = document.getElementById('summaryDestination');
            const summaryDeparture = document.getElementById('summaryDeparture');
            const summaryReturn = document.getElementById('summaryReturn');
            const summaryTravelers = document.getElementById('summaryTravelers');
            const summaryRoom = document.getElementById('summaryRoom');
            const summaryTotal = document.getElementById('summaryTotal');

            const ROOM_PRICES = { standard: 0, deluxe: 200, suite: 500, villa: 1200 };

            function selectDestination(value) {
                destinationSelect.value = value;
                updateSummary();
            }

            function getSelectedRoomValue() {
                const activeRoom = document.querySelector('.room-option.active strong');
                if (!activeRoom) return 'standard';
                const text = activeRoom.textContent.toLowerCase();
                if (text.includes('deluxe')) return 'deluxe';
                if (text.includes('suite')) return 'suite';
                if (text.includes('privatna vila')) return 'villa';
                return 'standard';
            }

            function updateSummary() {
                const basePrices = {
                    santorini: 1299,
                    kyoto: 1850,
                    machupicchu: 2200,
                    dubai: 1560,
                    paris: 1420,
                    bali: 1980
                };

                if (destinationSelect.value === 'santorini') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination1.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Santorini <small>Grčka</small>';
                } else if (destinationSelect.value === 'kyoto') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination2.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Kyoto <small>Japan</small>';
                } else if (destinationSelect.value === 'machupicchu') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination3.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Machu Picchu <small>Peru</small>';
                } else if (destinationSelect.value === 'dubai') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination4.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Dubai <small>UAE</small>';
                } else if (destinationSelect.value === 'paris') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination5.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Paris <small>Francuska</small>';
                } else if (destinationSelect.value === 'bali') {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/destination6.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Bali <small>Indonezija</small>';
                } else {
                    summaryPhoto.style.background = "linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.12)), url('/assets/bali.jpg') center/cover no-repeat";
                    summaryDestination.innerHTML = 'Odaberite destinaciju <small>—</small>';
                }

                summaryDeparture.textContent = departureDate.value || '—';
                summaryReturn.textContent = returnDate.value || '—';

                const adults = parseInt(adultsCount.textContent) || 0;
                const children = parseInt(childrenCount.textContent) || 0;
                let travelerText = `${adults} odraslih`;
                if (children > 0) travelerText += `, ${children} djece`;
                summaryTravelers.textContent = travelerText;

                const activeRoom = document.querySelector('.room-option.active strong');
                summaryRoom.textContent = activeRoom ? activeRoom.textContent : 'Standardna soba';

                let nights = 1;
                if (departureDate.value && returnDate.value) {
                    const dep = new Date(departureDate.value);
                    const ret = new Date(returnDate.value);
                    nights = Math.max(1, Math.ceil((ret - dep) / (1000 * 60 * 60 * 24)));
                }

                const selectedRoom = getSelectedRoomValue();
                const basePrice = basePrices[destinationSelect.value] || 0;
                const roomExtra = ROOM_PRICES[selectedRoom] || 0;
                const total = (basePrice + roomExtra) * Math.max(1, adults) * nights;

                summaryTotal.textContent = '$' + total.toLocaleString('en-US');
            }

            function changeCount(type, delta) {
                const adultsEl = document.getElementById('adultsCount');
                const childrenEl = document.getElementById('childrenCount');

                if (type === 'adults') {
                    adultsEl.textContent = Math.max(1, parseInt(adultsEl.textContent) + delta);
                } else {
                    childrenEl.textContent = Math.max(0, parseInt(childrenEl.textContent) + delta);
                }
                updateSummary();
            }

            function selectRoom(el) {
                document.querySelectorAll('.room-option').forEach(x => x.classList.remove('active'));
                el.classList.add('active');
                updateSummary();
            }

            function goToPassengers() {
                const destination = destinationSelect.value;
                const departure = departureDate.value;
                const ret = returnDate.value;
                const adults = document.getElementById('adultsCount').textContent;
                const children = document.getElementById('childrenCount').textContent;
                const activeRoom = document.querySelector('.room-option.active strong');

                if (!destination || !departure || !ret) {
                    alert('Molim vas popunite paket, datum polaska i datum povratka.');
                    return;
                }

                let destName = 'Destinacija';
                let country = '—';
                let image = '/assets/bali.jpg';

                if (destination === 'santorini') {
                    destName = 'Santorini';
                    country = 'Grčka';
                    image = '/assets/destination1.jpg';
                } else if (destination === 'kyoto') {
                    destName = 'Kyoto';
                    country = 'Japan';
                    image = '/assets/destination2.jpg';
                } else if (destination === 'machupicchu') {
                    destName = 'Machu Picchu';
                    country = 'Peru';
                    image = '/assets/destination3.jpg';
                } else if (destination === 'dubai') {
                    destName = 'Dubai';
                    country = 'UAE';
                    image = '/assets/destination4.jpg';
                } else if (destination === 'paris') {
                    destName = 'Paris';
                    country = 'Francuska';
                    image = '/assets/destination5.jpg';
                } else if (destination === 'bali') {
                    destName = 'Bali';
                    country = 'Indonezija';
                    image = '/assets/destination6.jpg';
                }

                const travelersText = adults + ' odraslih' + (parseInt(children) > 0 ? ', ' + children + ' djece' : '');
                const roomText = activeRoom ? activeRoom.textContent.trim() : 'Standardna soba';

                const depDate = new Date(departure);
                const retDate = new Date(ret);
                const nights = Math.max(1, Math.ceil((retDate - depDate) / (1000 * 60 * 60 * 24)));

                localStorage.setItem('reservationDestination', destName);
                localStorage.setItem('reservationCountry', country);
                localStorage.setItem('reservationImage', image);
                localStorage.setItem('reservationDeparture', departure);
                localStorage.setItem('reservationReturn', ret);
                localStorage.setItem('reservationTravelers', travelersText);
                localStorage.setItem('reservationRoom', roomText);
                localStorage.setItem('reservationDuration', nights + ' noći');
                localStorage.setItem('reservationTotal', summaryTotal.textContent);

                window.location.href = '/rezervacija/putnici';
            }

            destinationSelect.addEventListener('change', updateSummary);
            departureDate.addEventListener('change', updateSummary);
            returnDate.addEventListener('change', updateSummary);

            window.addEventListener('DOMContentLoaded', function () {
                const isLoggedIn = localStorage.getItem('isLoggedIn');
                const loginBlock = document.getElementById('login-block');
                const bookingView = document.getElementById('booking-view');

                if (isLoggedIn === 'true') {
                    loginBlock.classList.remove('active');
                    bookingView.classList.add('active');
                } else {
                    loginBlock.classList.add('active');
                    bookingView.classList.remove('active');
                }

                updateSummary();
            });
    </script>
</body>
</html>