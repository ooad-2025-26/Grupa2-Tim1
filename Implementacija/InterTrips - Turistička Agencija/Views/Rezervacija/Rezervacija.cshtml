@model List<InterTrips___Turistička_Agencija.Models.Paket>
@using InterTrips___Turistička_Agencija.Enums
@{
    ViewData["Title"] = "InterTrips - Sigurna Rezervacija";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
        :root {
        --brand-primary: #0f766e; /* Premium duboka tirkizna */
        --brand-dark: #111827; /* Skoro crna za tekst i naslove */
        --brand-light: #f0fdfa; /* Svijetla pozadina za isticanje */
        --brand-accent: #0d9488; /* Svijetla tirkizna za interakcije */
        --text-main: #374151; /* Neutralna tamna za tijelo teksta */
        --text-muted: #6b7280; /* Siva za pomoćne tekstove */
        --bg-page: #f8fafc; /* Čista, lagano siva pozadina stranice */
        --border-color: #e2e8f0; /* Prefinjeni tanki obrubi */
        --success-bg: #f0fdf4;
        --success-color: #166534;
        --radius-lg: 16px;
        --radius-md: 10px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-page);
        color: var(--text-main);
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        }

        #login-block, #booking-view {
        display: none;
        }

        #login-block.active, #booking-view.active {
        display: block;
        }

        /* Topbar / Navigacija */
        .topbar {
        height: 70px;
        background: #ffffff;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
        position: sticky;
        top: 0;
        z-index: 100;
        }

        .logo-link {
        display: flex;
        align-items: center;
        }

        .logo {
        height: 38px;
        }

        .secure-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--success-color);
        background: var(--success-bg);
        padding: 6px 14px;
        border-radius: 30px;
        border: 1px solid #bbf7d0;
        }

        /* Glavni kontejner */
        .page {
        padding: 40px 20px 80px;
        }

        .center-shell {
        max-width: 1140px;
        margin: 0 auto;
        }

        .intro {
        text-align: center;
        margin-bottom: 35px;
        }

        .badge {
        display: inline-block;
        background: var(--brand-light);
        color: var(--brand-primary);
        font-size: 12px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 30px;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        }

        .intro h1 {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 10px;
        color: var(--brand-dark);
        letter-spacing: -0.5px;
        }

        .intro p {
        color: var(--text-muted);
        font-size: 15px;
        max-width: 540px;
        margin: 0 auto;
        line-height: 1.5;
        }

        /* Stepper - Koraci */
        .steps {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 40px;
        }

        .step {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 500;
        }

        .step .circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #e2e8f0;
        display: grid;
        place-items: center;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 12px;
        }

        .step.active {
        color: var(--brand-primary);
        font-weight: 600;
        }

        .step.active .circle {
        background: var(--brand-primary);
        color: #ffffff;
        }

        /* Grid raspored */
        .booking-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 30px;
        align-items: start;
        }

        .panel {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        margin-bottom: 24px;
        overflow: hidden;
        }

        .panel-pad {
        padding: 30px;
        }

        /* Forme i elementi unosa */
        .form-group {
        margin-bottom: 20px;
        }

        .field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--brand-dark);
        margin-bottom: 8px;
        }

        .input, .select, .textarea {
        width: 100%;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        height: 46px;
        padding: 0 14px;
        font-size: 14px;
        font-family: inherit;
        color: var(--brand-dark);
        outline: none;
        box-sizing: border-box;
        transition: var(--transition);
        }

        .input:focus, .select:focus, .textarea:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
        }

        .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        }

        /* Radio kartice */
        .custom-radio-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        }

        .custom-radio-card {
        position: relative;
        cursor: pointer;
        }

        .custom-radio-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        }

        .radio-card-content {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        transition: var(--transition);
        }

        .custom-radio-card:hover .radio-card-content {
        border-color: var(--text-muted);
        }

        .custom-radio-card input[type="radio"]:checked + .radio-card-content {
        border-color: var(--brand-primary);
        background-color: var(--brand-light);
        }

        .radio-card-text {
        display: flex;
        flex-direction: column;
        }

        .radio-card-content strong {
        font-size: 14px;
        color: var(--brand-dark);
        }

        .radio-card-content small {
        color: var(--text-muted);
        font-size: 12px;
        }

        /* Brojači putnika */
        .adult-child {
        display: flex;
        gap: 24px;
        }

        .counter-block {
        flex: 1;
        }

        .counter {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        width: 140px;
        padding: 4px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        }

        .counter button {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        border: none;
        background: #f1f5f9;
        color: var(--brand-dark);
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: grid;
        place-items: center;
        }

        .counter button:hover {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .counter span {
        font-weight: 700;
        font-size: 15px;
        color: var(--brand-dark);
        }

        #kidsNotice {
        background: #fef3c7;
        border: 1px solid #fde68a;
        color: #92400e;
        padding: 10px 14px;
        border-radius: var(--radius-md);
        font-size: 12px;
        font-weight: 500;
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        }

        /* Dugmad */
        .main-btn, .secondary-btn {
        height: 46px;
        border-radius: var(--radius-md);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-sizing: border-box;
        gap: 6px;
        }

        .main-btn {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .main-btn:hover {
        background: var(--brand-accent);
        }

        .secondary-btn {
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--brand-dark);
        }

        .secondary-btn:hover {
        background: #f8fafc;
        border-color: var(--text-muted);
        }

        .full-btn {
        width: 100%;
        }

        /* Desna kolona - Pregled */
        .summary-card {
        position: sticky;
        top: 100px;
        }

        .summary-photo {
        height: 160px;
        position: relative;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        padding: 20px;
        background-color: #cbd5e0;
        }

        .summary-photo::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 100%);
        z-index: 1;
        }

        .summary-place {
        position: relative;
        z-index: 2;
        font-weight: 700;
        font-size: 20px;
        color: #ffffff !important;
        }

        .summary-body {
        padding: 24px;
        }

        .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        color: var(--text-muted);
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 8px;
        }

        .summary-row span:first-child {
        font-weight: 500;
        }

        .summary-row strong, .summary-row span:last-child {
        color: var(--brand-dark);
        font-weight: 600;
        }

        .price-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        }

        .price-line span:first-child {
        font-weight: 600;
        color: var(--brand-dark);
        font-size: 14px;
        }

        .total {
        color: var(--brand-primary);
        font-size: 24px;
        font-weight: 800;
        }

        /* Prednosti */
        .benefits {
        padding: 20px 24px;
        }

        .benefits ul {
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        }

        .benefits li {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-main);
        font-size: 13px;
        font-weight: 500;
        }

        .benefits li i {
        color: var(--brand-primary);
        width: 16px;
        height: 16px;
        }

        /* Login Sekcija */
        .login-block {
        max-width: 480px;
        margin: 40px auto 0;
        text-align: center;
        background: #ffffff;
        padding: 40px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-md);
        }

        .login-icon-box {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        margin: 0 auto 20px;
        background: var(--brand-light);
        color: var(--brand-primary);
        }

        .login-block h2 {
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 8px;
        color: var(--brand-dark);
        }

        .login-block p {
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 24px;
        }

        .reason-box {
        background: var(--bg-page);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        text-align: left;
        padding: 20px;
        margin-bottom: 24px;
        }

        .reason-box h3 {
        font-size: 12px;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0 0 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        }

        .reason-box ul {
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
        }

        .reason-box li {
        list-style: none;
        font-size: 13px;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .reason-box li i {
        color: var(--brand-primary);
        width: 14px;
        height: 14px;
        }

        .login-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        }

        .login-btn {
        flex: 1;
        }

        .back-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 20px;
        color: var(--text-muted);
        font-size: 13px;
        text-decoration: none;
        transition: var(--transition);
        font-weight: 500;
        }

        .back-link:hover {
        color: var(--brand-primary);
        }

        @@media (max-width: 1024px) {
        .booking-grid {
        grid-template-columns: 1fr;
        }

        .summary-card {
        position: static;
        }
        }

        @@media (max-width: 768px) {
        .row, .custom-radio-group {
        grid-template-columns: 1fr;
        }

        .topbar {
        padding: 0 20px;
        }

        .steps {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding-left: 20px;
        }

        .login-actions {
        flex-direction: column;
        }

        .benefits ul {
        grid-template-columns: 1fr;
        }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo">
        </a>
        <div class="secure-badge">
            <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i> Sigurna rezervacija
        </div>
    </div>

    <div class="page">
        <div class="center-shell">

            <section id="login-block" class="login-block @(User?.Identity?.IsAuthenticated == true ? "" : "active")">
                <div class="login-icon-box">
                    <i data-lucide="lock" style="width: 24px; height: 24px;"></i>
                </div>
                <h2>Prijava je obavezna</h2>
                <p>Da biste rezervisali putovanje i pristupili procesu plaćanja, morate biti prijavljeni na vaš InterTrips račun.</p>

                <div class="reason-box">
                    <h3>Zašto se prijaviti?</h3>
                    <ul>
                        <li><i data-lucide="check"></i> Sigurno čuvanje podataka o rezervaciji</li>
                        <li><i data-lucide="check"></i> Pregled historije svih vaših putovanja</li>
                        <li><i data-lucide="check"></i> Obavještenja o statusu rezervacije</li>
                        <li><i data-lucide="check"></i> Ekskluzivne ponude za prijavljene korisnike</li>
                    </ul>
                </div>

                <div class="login-actions">
                    <a class="main-btn login-btn" href="/Account/Login">Prijavite se</a>
                    <button class="secondary-btn login-btn" type="button" onclick="window.location.href='/Account/Register'">Registrujte se</button>
                </div>

                <a class="back-link" href="/"><i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i> Povratak na početnu</a>
            </section>

            <section id="booking-view" class="booking-view @(User?.Identity?.IsAuthenticated == true ? "active" : "")">
                <div class="intro">
                    <div class="badge">REZERVACIJA PUTOVANJA</div>
                    <h1>Kreiranje rezervacije</h1>
                    <p>Unesite podatke za odabrani turistički paket i nastavite na unos podataka putnika.</p>
                </div>

                <div class="steps">
                    <div class="step active"><div class="circle">1</div> Detalji putovanja</div>
                    <div class="step"><div class="circle">2</div> Podaci o putnicima</div>
                    <div class="step"><div class="circle">3</div> Sigurno plaćanje</div>
                    <div class="step"><div class="circle">4</div> Potvrda</div>
                </div>

                <div class="booking-grid">
                    <div class="left-column">
                        <div class="panel panel-pad">

                            <div class="form-group">
                                <label class="field-label">Odaberite paket</label>
                                <select class="select" id="destinationSelect" onchange="handlePackageChange()">
                                    <option value="">-- Odaberite paket --</option>
                                    @if (Model != null)
                                    {
                                        foreach (var p in Model)
                                        {
                                            if (p.Status == StatusPaketa.Rasprodan) continue;

                                            var terminiList = p.DostupniTermini ?? new List<InterTrips___Turistička_Agencija.Models.TerminPutovanja>();

                                            var terminiJson = System.Text.Json.JsonSerializer.Serialize(terminiList.Select(t => new
                                            {
                                                id = t.Id,
                                                polazak = t.DatumPolaska.ToString("yyyy-MM-dd"),
                                                returnDate = t.DatumPovratka.ToString("yyyy-MM-dd"),
                                                tekst = t.DatumPolaska.ToString("dd.MM.yyyy") + " - " + t.DatumPovratka.ToString("dd.MM.yyyy") + (t.Popunjeno >= t.Kapacitet ? " (Popunjeno)" : "")
                                            }));

                                            <option value="@p.Id"
                                                    data-img="@p.Destinacija?.SlikaUrl"
                                                    data-price="@p.CijenaOd"
                                                    data-destinacija="@p.Destinacija?.Naziv"
                                                    data-drzava="@p.Destinacija?.Drzava"
                                                    data-hotel="@(p.Hotel != null ? p.Hotel.Naziv + " " + string.Concat(Enumerable.Repeat("★", p.Hotel.BrojZvjezdica)) : "Uključen smještaj")"
                                                    data-let="@(p.Let != null ? p.Let.BrojLeta : "")"
                                                    data-prevoz-tip="@p.DostupniPrevoz"
                                                    data-termini="@terminiJson">
                                                @p.Naziv (@p.Destinacija?.Naziv)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group" style="display: none;">
                                <label class="field-label">Dostupni termini putovanja</label>
                                <select class="select" id="dateTerminSelect" disabled>
                                    <option value="">-- Prvo odaberite paket --</option>
                                </select>
                                <input type="hidden" id="departureDate" />
                                <input type="hidden" id="returnDate" />
                            </div>

                            <div id="prevozSekcija" class="form-group" style="display: none;">
                                <label class="field-label">Tip prevoza</label>
                                <div class="custom-radio-group">
                                    <label class="custom-radio-card">
                                        <input type="radio" name="tipPrevoza" id="prevozAvion" value="Avion" checked onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <i data-lucide="plane" style="color: var(--brand-primary); width: 18px; height: 18px;"></i>
                                            <div class="radio-card-text">
                                                <strong>Avion</strong>
                                                <small>+10% na osnovicu</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card" id="prevozBusOpcija">
                                        <input type="radio" name="tipPrevoza" id="prevozBus" value="Bus" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <i data-lucide="bus" style="color: var(--brand-primary); width: 18px; height: 18px;"></i>
                                            <div class="radio-card-text">
                                                <strong>Autobus</strong>
                                                <small>Standardna cijena</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group">
                                <a id="planLink" class="secondary-btn" href="#" style="display:none; height: 38px; font-size: 13px; padding: 0 14px;">
                                    <i data-lucide="map" style="width: 14px; height: 14px;"></i> Pogledaj plan putovanja
                                </a>
                            </div>

                            <div class="adult-child form-group">
                                <div class="counter-block">
                                    <label class="field-label">Odrasli</label>
                                    <div class="counter">
                                        <button type="button" onclick="changeCount('adults', -1)">−</button>
                                        <span id="adultsCount">2</span>
                                        <button type="button" onclick="changeCount('adults', 1)">+</button>
                                    </div>
                                </div>
                                <div class="counter-block">
                                    <label class="field-label">Djeca</label>
                                    <div class="counter">
                                        <button type="button" onclick="changeCount('children', -1)">−</button>
                                        <span id="childrenCount">0</span>
                                        <button type="button" onclick="changeCount('children', 1)">+</button>
                                    </div>
                                    <div id="kidsNotice" style="display:none;">
                                        <i data-lucide="info" style="width: 14px; height: 14px;"></i> Djeca do 17 godina ne plaćaju aranžman!
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="field-label" style="margin-bottom: 12px;">Vrsta smještaja</label>
                                <div class="custom-radio-group">
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="standardna soba" checked onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Standardna soba</strong>
                                                <small>Uključeno u cijenu</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="deluxe soba" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Deluxe soba</strong>
                                                <small>+200 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="suite" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>Suite</strong>
                                                <small>+500 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="custom-radio-card">
                                        <input type="radio" name="roomType" value="president suite" onchange="updateSummary()" />
                                        <div class="radio-card-content">
                                            <div class="radio-card-text">
                                                <strong>President suite</strong>
                                                <small>+1200 BAM / osobi</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <button class="main-btn full-btn" style="margin-top: 15px;" onclick="goToPassengers()">
                                Nastavi na unos putnika <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="right-column">
                        <div class="panel summary-card">
                            <div class="summary-photo" id="summaryPhoto" style="background-image: url('@Url.Content("~/assets/bali.jpg")');">
                                <div class="summary-place" id="summaryDestination">Odaberite destinaciju</div>
                            </div>
                            <div class="summary-body">
                                <div class="summary-row"><span>Polazak</span><span id="summaryDeparture">—</span></div>
                                <div class="summary-row"><span>Povratak</span><span id="summaryReturn">—</span></div>
                                <div class="summary-row"><span>Putnici</span><span id="summaryTravelers">Odrasli: 2, Djeca: 0</span></div>
                                <div class="summary-row"><span>Trajanje</span><span id="summaryNights">—</span></div>
                                <div class="summary-row"><span>Prevoz</span><strong id="summaryPrevoz">—</strong></div>
                                <div class="summary-item">
                                    <span class="label">Informacije o letu:</span>
                                    <span id="summaryLet" class="value">—</span>
                                </div>
                                <div class="summary-row">
                                    <span>Hotel / Smještaj:</span>
                                    <strong id="summaryHotel">—</strong>
                                </div>
                                <div class="summary-row"><span>Smještaj</span><strong id="summaryRoom">Standardna soba</strong></div>
                                <div class="price-line">
                                    <span>Ukupno za uplatu</span>
                                    <span class="total" id="summaryTotal">0.00 KM</span>
                                </div>
                            </div>
                        </div>

                        <div class="panel benefits">
                            <ul>
                                <li><i data-lucide="lock"></i> SSL sigurnost podataka</li>
                                <li><i data-lucide="calendar-x"></i> Besplatno otkazivanje 48h</li>
                                <li><i data-lucide="phone-call"></i> Podrška agencije 24/7</li>
                                <li><i data-lucide="badge-check"></i> Garancija najbolje cijene</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
        lucide.createIcons();

        const destinationSelect = document.getElementById('destinationSelect');
        const dateTerminSelect = document.getElementById('dateTerminSelect');
        const departureDate = document.getElementById('departureDate');
        const returnDate = document.getElementById('returnDate');
        const adultsCount = document.getElementById('adultsCount');
        const childrenCount = document.getElementById('childrenCount');
        const summaryTotal = document.getElementById('summaryTotal');
        const summaryRoom = document.getElementById('summaryRoom');
        const kidsNotice = document.getElementById('kidsNotice');
        const prevozSekcija = document.getElementById('prevozSekcija');
        const prevozBusOpcija = document.getElementById('prevozBusOpcija');
        const prevozAvion = document.getElementById('prevozAvion');
        const prevozBus = document.getElementById('prevozBus');
        const summaryPrevoz = document.getElementById('summaryPrevoz');

        let globalNights = 0;

        const ROOM_EXTRAS = {
        "standardna soba": 0,
        "deluxe soba": 200,
        "suite": 500,
        "president suite": 1200
        };

        window.addEventListener('DOMContentLoaded', function () {
        handlePackageChange();
        });

        function handlePackageChange() {
        const selectedOpt = destinationSelect.options[destinationSelect.selectedIndex];
        if (!selectedOpt || selectedOpt.value === "") {
        document.getElementById('planLink').style.display = 'none';
        prevozSekcija.style.display = 'none';
        dateTerminSelect.innerHTML = `<option value="">-- Prvo odaberite paket --</option>`;
        resetSummary();
        return;
        }

        const terminiData = selectedOpt.getAttribute('data-termini');
        let termini = [];
        try {
        termini = JSON.parse(terminiData) || [];
        } catch (e) {
        console.error("Greška pri čitanju termina", e);
        }

        if (termini.length > 0) {
        const fiksniTermin = termini[0];

        dateTerminSelect.innerHTML = `<option value="${fiksniTermin.id}" selected>${fiksniTermin.tekst}</option>`;

        departureDate.value = fiksniTermin.polazak;
        returnDate.value = fiksniTermin.povratak; 

        const d1 = new Date(fiksniTermin.polazak);
        const d2 = new Date(fiksniTermin.povratak);
        const razlikaUvremenu = d2.getTime() - d1.getTime();
        globalNights = Math.ceil(razlikaUvremenu / (1000 * 3600 * 24));
        } else {
        dateTerminSelect.innerHTML = `<option value="">Nema dostupnih termina</option>`;
        departureDate.value = "";
        returnDate.value = "";
        globalNights = 0;
        }

        const prevozTip = selectedOpt.getAttribute('data-prevoz-tip');
        if (prevozTip === 'Oboje') {
        prevozSekcija.style.display = 'block';
        prevozBusOpcija.style.display = 'block';
        const avionCard = prevozAvion.closest('.custom-radio-card');
        if (avionCard) avionCard.style.display = 'block';
        if (!prevozAvion.checked && !prevozBus.checked) {
        prevozAvion.checked = true;
        }
        } else {
        prevozSekcija.style.display = 'none';
        if (prevozTip === 'SamoAutobus') {
        prevozBus.checked = true;
        prevozAvion.checked = false;
        } else {
        prevozAvion.checked = true;
        prevozBus.checked = false;
        }
        }

        const planLink = document.getElementById('planLink');
        planLink.href = `/Paketi/Detalji/${selectedOpt.value}`;
        planLink.style.display = 'inline-flex';

        const hotelInfo = selectedOpt.getAttribute('data-hotel');
        document.getElementById('summaryHotel').textContent = hotelInfo ? hotelInfo : "—";

        updateSummary();
        }

        function formatDate(dateStr) {
        if (!dateStr) return "—";

          const date = new Date(dateStr);

        if (isNaN(date.getTime())) {
        const numbers = dateStr.match(/\d+/g);
        if (numbers && numbers.length >= 3) {
        if (dateStr.includes('.')) {
        return `${numbers[0].padStart(2, '0')}.${numbers[1].padStart(2, '0')}.${numbers[2]}.`;
        }
        return `${numbers[2].padStart(2, '0')}.${numbers[1].padStart(2, '0')}.${numbers[0]}.`;
        }
        return "—";
        }

        const dan = String(date.getDate()).padStart(2, '0');
        const mjesec = String(date.getMonth() + 1).padStart(2, '0'); 
        const godina = date.getFullYear();

        return `${dan}.${mjesec}.${godina}.`;
        }

        function changeCount(type, val) {
        if (type === 'adults') {
        let current = parseInt(adultsCount.textContent);
        current += val;
        if (current < 1) current = 1;
        adultsCount.textContent = current;
        } else if (type === 'children') {
        let current = parseInt(childrenCount.textContent);
        current += val;
        if (current < 0) current = 0;
        childrenCount.textContent = current;
        kidsNotice.style.display = current > 0 ? 'flex' : 'none';
        }
        updateSummary();
        }

        function updateSummary() {
        const selectedOpt = destinationSelect.options[destinationSelect.selectedIndex];
        if (!selectedOpt || selectedOpt.value === "") {
        resetSummary();
        return;
        }

        const basePrice = parseFloat(selectedOpt.getAttribute('data-price')) || 0;
        const destName = selectedOpt.getAttribute('data-destinacija');
        const country = selectedOpt.getAttribute('data-drzava');
        const hotel = selectedOpt.getAttribute('data-hotel');
        const flight = selectedOpt.getAttribute('data-let');
        const imgUrl = selectedOpt.getAttribute('data-img');
        const prevozTip = selectedOpt.getAttribute('data-prevoz-tip');

        const adults = parseInt(adultsCount.textContent);
        const children = parseInt(childrenCount.textContent);

        const transportRadio = document.querySelector('input[name="tipPrevoza"]:checked');
        const transportType = transportRadio ? transportRadio.value : 'Bus';

        const roomTypeRadio = document.querySelector('input[name="roomType"]:checked');
        const roomTypeValue = roomTypeRadio ? roomTypeRadio.value : 'standardna soba';

        document.getElementById('summaryDestination').textContent = `${destName}, ${country}`;
        if (imgUrl) {
        document.getElementById('summaryPhoto').style.backgroundImage = `url('${imgUrl}')`;
        }

        document.getElementById('summaryDeparture').textContent = formatDate(departureDate.value);
        document.getElementById('summaryReturn').textContent = formatDate(returnDate.value);
        document.getElementById('summaryTravelers').textContent = `Odrasli: ${adults}, Djeca: ${children}`;
        document.getElementById('summaryNights').textContent = globalNights > 0 ? `${globalNights} noćenja` : "—";

        if (transportType === 'Avion') {
        document.getElementById('summaryPrevoz').textContent = '✈️ Avion';
        document.getElementById('summaryLet').textContent = flight ? flight : 'Uključen let';
        document.getElementById('summaryLet').closest('.summary-item').style.display = 'block';
        } else {
        document.getElementById('summaryPrevoz').textContent = '🚌 Autobus';
        document.getElementById('summaryLet').closest('.summary-item').style.display = 'none';
        }

        document.getElementById('summaryHotel').textContent = hotel ? hotel : '—';
        summaryRoom.textContent = roomTypeValue.charAt(0).toUpperCase() + roomTypeValue.slice(1);

        let total = basePrice * adults;
        if (prevozTip === 'Oboje' && transportType === 'Avion') {
        total += (basePrice * 0.10) * adults;
        }

        const extraPerPerson = ROOM_EXTRAS[roomTypeValue.toLowerCase()] || 0;
        total += extraPerPerson * adults;

        summaryTotal.textContent = `${total.toFixed(2)} KM`;
        try {
        localStorage.setItem('reservationTotal', `${total.toFixed(2)} KM`);
        localStorage.setItem('selectedPackageId', selectedOpt.value);
        } catch (e) {
        console.warn("Problem sa lokalnim skladištem (privatni mod ili restrikcija):", e);
        }
        localStorage.setItem('reservationTotal', `${total.toFixed(2)} KM`);
        localStorage.setItem('selectedPackageId', selectedOpt.value);
        }

        function resetSummary() {
        document.getElementById('summaryDestination').textContent = "Odaberite destinaciju";
        document.getElementById('summaryPhoto').style.backgroundImage = "url('/assets/bali.jpg')";
        document.getElementById('summaryDeparture').textContent = "—";
        document.getElementById('summaryReturn').textContent = "—";
        document.getElementById('summaryTravelers').textContent = "Odrasli: 2, Djeca: 0";
        document.getElementById('summaryNights').textContent = "—";
        document.getElementById('summaryPrevoz').textContent = "—";
        document.getElementById('summaryLet').textContent = "—";
        document.getElementById('summaryHotel').textContent = "—";
        summaryRoom.textContent = "Standardna soba";
        summaryTotal.textContent = "0.00 KM";
        }

        function goToPassengers() {
        if (destinationSelect.value === "") {
        alert("Molimo vas da odaberete turistički paket prije nastavka.");
        destinationSelect.focus();
        return;
        }
        if (dateTerminSelect.value === "") {
        alert("Sistem nije uspio učitati fiksni termin za ovaj paket.");
        return;
        }

        const transportRadio = document.querySelector('input[name="tipPrevoza"]:checked');
        const transportType = transportRadio ? transportRadio.value : 'Bus';

        const roomTypeRadio = document.querySelector('input[name="roomType"]:checked');
        const roomTypeValue = roomTypeRadio ? roomTypeRadio.value : 'standardna soba';
    
        window.location.href = `/Rezervacija/Putnici?paketId=${destinationSelect.value}&terminId=${dateTerminSelect.value}&polazak=${departureDate.value}&odrasli=${adultsCount.textContent}&djeca=${childrenCount.textContent}&prevoz=${encodeURIComponent(transportType)}&smjestaj=${encodeURIComponent(roomTypeValue)}`;
        }
    </script>
</body>
</html>