@{
    ViewData["Title"] = "InterTrips - Moje rezervacije";
    Layout = "_Layout";
}

<header class="hero hero--reservations">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="badge">REZERVACIJE</span>
        <h1 style="letter-spacing:1px;">MOJE REZERVACIJE</h1>
        <p>Pregledajte Vaše rezervacije, status i po potrebi otkažite rezervaciju.</p>
    </div>
</header>

<main>
    <section class="section">
        <div class="section-header" style="margin-bottom:14px;">
            <div>
                <span class="section-label">PREGLED</span>
                <h3>Vaših <em>rezervacija !</em></h3>
            </div>
        </div>

        <div class="reservations-shell" style="max-width:1140px; margin:0 auto;">
            <div id="reservationsList" class="reservations-list"></div>

            <p id="emptyMsg" style="display:none; color:var(--muted); font-weight:600; margin-top:10px;">
                Nemate rezervacija.
            </p>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="footer-grid">
        <div>
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
            </a>
            <p>Otkrijte najbolje destinacije na svijetu.</p>
        </div>

        <div>
            <h4>Istraži</h4>
            <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
            <a href="#">Putni vodiči</a>
            <a href="#">Najbolja iskustva</a>
        </div>

        <div>
            <h4>Kompanija</h4>
            <a asp-controller="Home" asp-action="ONama">O nama</a>
            <a href="#">Karijere</a>
            <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>
        </div>

        <div>
            <h4>Podrška</h4>
            <a href="#">Centar za pomoć</a>
            <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
            <a href="#">Uvjeti korištenja</a>
        </div>
    </div>
    <div class="footer-bottom">© 2026 InterTrips. Sva prava zadržana.</div>
</footer>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <style>
        :root {
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --text: #24414a;
        --muted: #5f7c86;
        --shadow: 0 16px 36px rgba(63,116,128,0.10);
        }

        .hero--reservations {
        position: relative;
        min-height: 360px;
        background: url('/assets/mojeRezervacije.jpg') center/cover no-repeat;
        }

        .hero--reservations .hero-overlay {
        background: linear-gradient(90deg, rgba(10,34,40,0.78) 0%, rgba(10,34,40,0.55) 55%, rgba(10,34,40,0.25) 100%), radial-gradient(900px 340px at 25% 35%, rgba(106,191,198,0.26), transparent 60%);
        }

        .hero--reservations .hero-content {
        max-width: 720px;
        margin: 0 auto;
        padding: 34px 34px 30px;
        border-radius: 22px;
        background: rgba(10, 34, 40, 0.35);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(12px);
        box-shadow: 0 22px 60px rgba(0,0,0,0.22);
        text-align: center;
        }

        .hero--reservations .badge {
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.22);
        color: rgba(255,255,255,0.92);
        }

        .hero--reservations .hero-content h1 {
        color: #ffffff;
        text-shadow: 0 18px 40px rgba(0,0,0,0.35);
        }

        .hero--reservations .hero-content p {
        color: rgba(255,255,255,0.88);
        text-shadow: 0 18px 40px rgba(0,0,0,0.25);
        }

        .section .section-header h3,
        .section .center-title h3 {
        color: var(--text);
        }

        .section .section-header h3 em,
        .section .center-title h3 em {
        color: var(--primary-dark);
        }

        .reservations-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
        }

        .r-card {
        background: rgba(255,255,255,0.86);
        border: 1px solid rgba(95,181,187,0.16);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 16px;
        backdrop-filter: blur(10px);
        }

        .r-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 10px;
        }

        .r-code {
        font-weight: 900;
        color: var(--primary-dark);
        }

        .r-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid rgba(95,181,187,0.18);
        background: rgba(106,191,198,0.10);
        color: var(--primary-dark);
        }

        .r-badge.cancel {
        background: rgba(255,0,0,0.08);
        border-color: rgba(255,0,0,0.15);
        color: #b42318;
        }

        .r-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 18px;
        margin-top: 6px;
        }

        .r-line {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        color: var(--muted);
        font-size: 13px;
        border-bottom: 1px solid rgba(95,181,187,0.10);
        padding: 8px 0;
        }

        .r-line strong {
        color: var(--text);
        }

        .r-actions {
        margin-top: 12px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        }

        .btn-cancel {
        height: 40px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 900;
        padding: 0 14px;
        background: rgba(255,0,0,0.08);
        border: 1px solid rgba(255,0,0,0.18);
        color: #b42318;
        }

        .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid rgba(95,181,187,0.18);
        background: rgba(106,191,198,0.12);
        color: var(--primary-dark);
        }

        .pill:hover {
        filter: brightness(1.02);
        }

        @@media (max-width: 760px) {
        .r-grid {
        grid-template-columns: 1fr;
        }
        }
    </style>

    <script>
        let ucitaneRezervacije = [];

        function ukloniKvacice(tekst) {
        if (!tekst) return '—';
        return String(tekst)
        .replace(/[ČĆčć]/g, 'C')
        .replace(/[Žž]/g, 'Z')
        .replace(/[Šš]/g, 'S')
        .replace(/[Đđ]/g, 'Dj');
        }

        async function getReservationsForCurrentUser() {
        try {
        const response = await fetch('/Rezervacija/GetMojeRezervacije', {
        method: 'GET',
        credentials: 'same-origin'
        });

        if (!response.ok) {
        console.error("Greška pri dohvatanju rezervacija.");
        return [];
        }

        return await response.json();
        } catch (error) {
        console.error("Greška:", error);
        return [];
        }
        }

        async function cancelReservation(id) {
        const confirmed = confirm('Da li ste sigurni da želite otkazati ovu rezervaciju?');
        if (!confirmed) return;

        try {
        const response = await fetch(`/Rezervacija/OtkaziRezervaciju?id=${id}`, {
        method: 'POST',
        credentials: 'same-origin'
        });

        if (response.ok) {
        alert("Rezervacija je uspješno otkazana.");
        await renderReservations();
        } else {
        alert("Greška pri otkazivanju rezervacije.");
        }
        } catch (error) {
        console.error("Greška:", error);
        alert("Greška u komunikaciji sa serverom.");
        }
        }

        function badgeHtml(status) {
        if (status === 'Otkazana') {
        return '<span class="r-badge cancel">OTKAZANA</span>';
        }
        if (status === 'Potvrdjena' || status === 'Potvrđena') {
        return '<span class="r-badge success" style="background:#36d399;color:#fff;">POTVRĐENA</span>';
        }
        return '<span class="r-badge">AKTIVNA</span>';
        }

        function planButtonHtml(r) {
        if (!r || !r.paketId) return '';
        return `
        <a class="pill" style="text-decoration:none;" href="/PlanPutovanja/Preview?paketId=${encodeURIComponent(r.paketId)}">
        Plan putovanja
        </a>
        `;
        }

        function downloadPdfByIndex(index) {
        const r = ucitaneRezervacije[index];
        if (!r) {
        alert("Greška: Podaci o rezervaciji nisu pronađeni.");
        return;
        }

        const pick = (...vals) => {
        for (const v of vals) {
        if (v === null || v === undefined) continue;
        const s = String(v).trim();
        if (s !== '') return s;
        }
        return '';
        };

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        doc.setFillColor(10, 34, 40);
        doc.rect(0, 0, 210, 40, 'F');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(22);
        doc.setTextColor(255, 255, 255);
        doc.text("INTERTRIPS - POTVRDA REZERVACIJE", 15, 26);

        doc.setFontSize(11);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(100, 100, 100);
        doc.text(`Datum izdavanja dokumenta: ${new Date().toLocaleDateString('bs-BA')}`, 15, 50);

        doc.setDrawColor(95, 181, 187);
        doc.setLineWidth(0.5);
        doc.line(15, 55, 195, 55);

        const brPutnika = r.brojPutnika || r.BrojPutnika || (r.putnici ? r.putnici.length : 1);

        doc.setFontSize(14);
        doc.setFont("helvetica", "bold");
        doc.setTextColor(10, 34, 40);
        doc.text(`Rezervacija koda: #${pick(r.id, r.Id, '—')}`, 15, 68);
        doc.text(`Status: ${ukloniKvacice(pick(r.status, r.Status, 'Aktivna')).toUpperCase()}`, 130, 68);

        doc.setFontSize(12);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(40, 40, 40);

        let y = 85;
        const stavke = [
        { label: "Destinacija:", info: `${ukloniKvacice(pick(r.destinacija, r.Destinacija, '—'))} ${pick(r.drzava, r.Drzava, '') ? '(' + ukloniKvacice(pick(r.drzava, r.Drzava)) + ')' : ''}` },
        { label: "Naziv paketa:", info: ukloniKvacice(pick(r.paketNaziv, r.PaketNaziv, '—')) },
        { label: "Datum polaska:", info: pick(r.datumPolaska, r.DatumPolaska, '—') },
        { label: "Datum povratka:", info: pick(r.datumPovratka, r.DatumPovratka, '—') },
        { label: "Ukupan broj putnika:", info: String(brPutnika) }
        ];

        stavke.forEach(item => {
        doc.setFont("helvetica", "bold");
        doc.text(item.label, 15, y);
        doc.setFont("helvetica", "normal");
        doc.text(String(item.info), 65, y);
        y += 10;
        });

        const listaPutnika = r.putnici || r.putniciRezervacije || r.Putnici;

        if (listaPutnika && listaPutnika.length > 0) {
        y += 10;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(13);
        doc.setTextColor(10, 34, 40);
        doc.text("Spisak putnika na rezervaciji:", 15, y);
        y += 6;

        const colX = { rb: 15, ime: 25, dob: 80, pasos: 110, drz: 140, tel: 165 };
        const tableWidth = 180;

        doc.setFillColor(40, 55, 60);
        doc.rect(colX.rb, y, tableWidth, 8, 'F');

        doc.setFont("helvetica", "bold");
        doc.setFontSize(9);
        doc.setTextColor(255, 255, 255);
        doc.text("R.b.", colX.rb + 2, y + 5.5);
        doc.text("Ime i Prezime", colX.ime + 2, y + 5.5);
        doc.text("Datum rod.", colX.dob + 2, y + 5.5);
        doc.text("Pasos", colX.pasos + 2, y + 5.5);
        doc.text("Drz.", colX.drz + 2, y + 5.5);
        doc.text("Telefon", colX.tel + 2, y + 5.5);

        y += 8;
        doc.setTextColor(40, 40, 40);

        listaPutnika.forEach((p, i) => {
        if (y > 270) {
        doc.addPage();
        y = 20;
        }

        const imePrezime = ukloniKvacice(`${pick(p.ime, p.Ime, '')} ${pick(p.prezime, p.Prezime, '')}`.trim()) || '—';
        const pasos = pick(p.brojPasosa, p.BrojPasosa, '—');
        const drz = ukloniKvacice(pick(p.drzavljanstvo, p.Drzavljanstvo, '—'));
        const dob = pick(p.datumRodjenja, p.DatumRodjenja, p.birthDate, p.BirthDate, '—');
        const tel = pick(p.telefon, p.Telefon, p.phone, p.Phone, '—');
        const req = pick(p.posebniZahtjevi, p.PosebniZahtjevi, p.requests, p.Requests, '');

        doc.setFillColor(i % 2 === 0 ? 245 : 255, i % 2 === 0 ? 248 : 255, i % 2 === 0 ? 248 : 255);
        doc.rect(colX.rb, y, tableWidth, 8, 'F');

        doc.setDrawColor(210, 225, 225);
        doc.setLineWidth(0.2);
        doc.rect(colX.rb, y, tableWidth, 8, 'D');

        doc.setFontSize(9);
        doc.setFont("helvetica", "normal");
        doc.text(`${i + 1}.`, colX.rb + 2, y + 5.5);

        doc.setFont("helvetica", "bold");
        doc.text(imePrezime, colX.ime + 2, y + 5.5);

        doc.setFont("helvetica", "normal");
        doc.text(String(dob), colX.dob + 2, y + 5.5);
        doc.text(String(pasos), colX.pasos + 2, y + 5.5);
        doc.text(String(drz), colX.drz + 2, y + 5.5);
        doc.text(String(tel), colX.tel + 2, y + 5.5);

        y += 8;

        if (req && req !== "Nema") {
        if (y > 270) { doc.addPage(); y = 20; }

        doc.setFont("helvetica", "italic");
        doc.setFontSize(8);
        doc.setTextColor(110, 110, 110);

        const lines = doc.splitTextToSize(`Napomena: ${ukloniKvacice(req)}`, 175);
        doc.text(lines, colX.ime + 2, y);
        y += (lines.length * 4) + 2;

        doc.setTextColor(40, 40, 40);
        }
        });
        }

        y += 15;
        if (y > 280) { doc.addPage(); y = 20; }

        doc.setFont("helvetica", "italic");
        doc.setFontSize(10);
        doc.setTextColor(120, 120, 120);
        doc.text("Hvala Vam na povjerenju! Vas InterTrips tim.", 15, y);

        doc.save(`Rezervacija_InterTrips_${pick(r.id, r.Id, '—')}.pdf`);
        }

        async function renderReservations() {
        const listEl = document.getElementById('reservationsList');
        const emptyMsg = document.getElementById('emptyMsg');

        if (!listEl) return;

        let sveRezervacije = await getReservationsForCurrentUser();
        const danas = new Date(2026, 4, 20);
        danas.setHours(0, 0, 0, 0);

        ucitaneRezervacije = sveRezervacije.filter(r => {
        const datumString = r.datumPovratka || r.DatumPovratka;
        if (!datumString) return true;

        let povratak;

        if (datumString.includes('.')) {
        const parts = datumString.split('.');
        povratak = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
        } else {
        ptvratak = new Date(datumString);
        }

        if (isNaN(povratak.getTime())) return true; // Zaštita od neispravnog datuma

        povratak.setHours(0, 0, 0, 0);
        return povratak > danas;
        });

        if (!ucitaneRezervacije || ucitaneRezervacije.length === 0) {
        listEl.innerHTML = '';
        if (emptyMsg) emptyMsg.style.display = 'block';
        return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';

        listEl.innerHTML = ucitaneRezervacije.map((r, index) => {
        const isCancelled = r.status === 'Otkazana';
        const currentId = r.id || r.Id || '';
        const cancelBtn = isCancelled ? '' : `
        <button class="btn-cancel" type="button" onclick="cancelReservation('${currentId}')">
        Otkaži rezervaciju
        </button>
        `;

        const planBtn = planButtonHtml(r);
        const stvarniBrojPutnika = r.brojPutnika || r.BrojPutnika || (r.putnici ? r.putnici.length : 1);
        const pdfBtn = `
        <button class="pill" type="button" style="cursor:pointer;" onclick="downloadPdfByIndex(${index})">
        📄 Preuzmi PDF
        </button>
        `;

        return `
        <div class="r-card">
        <div class="r-top">
        <div class="r-code">#${currentId || '—'}</div>
        ${badgeHtml(r.status)}
        </div>
        <div class="r-grid">
        <div class="r-line">
        <span>Destinacija</span>
        <strong>${r.destinacija || r.Destinacija || '—'} ${r.drzava ? '(' + r.drzava + ')' : ''}</strong>
        </div>
        <div class="r-line">
        <span>Paket</span>
        <strong>${r.paketNaziv || r.PaketNaziv || '—'}</strong>
        </div>
        <div class="r-line">
        <span>Period</span>
        <strong>${r.datumPolaska || r.DatumPolaska || '—'} - ${r.datumPovratka || r.DatumPovratka || '—'}</strong>
        </div>
        <div class="r-line">
        <span>Broj putnika</span>
        <strong>${stvarniBrojPutnika}</strong>
        </div>
        <div class="r-line">
        <span>Status</span>
        <strong>${r.status || r.Status || 'Aktivna'}</strong>
        </div>
        </div>
        <div class="r-actions">
        ${planBtn}
        ${pdfBtn}
        ${cancelBtn}
        </div>
        </div>
        `;
        }).join('');
        }

        window.addEventListener('DOMContentLoaded', renderReservations);
    </script>
}