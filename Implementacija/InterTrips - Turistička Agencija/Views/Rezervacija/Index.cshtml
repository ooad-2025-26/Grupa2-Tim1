@using InterTrips___Turistička_Agencija.Models
@{
    ViewData["Title"] = "InterTrips - Moje rezervacije";
    Layout = "_Layout";
}

<header class="hero hero--reservations">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="badge">REZERVACIJE</span>
        <h1>MOJE REZERVACIJE</h1>
        <p>Pregledajte Vaše aktivne aranžmane, preuzmite dokumentaciju ili upravljajte statusom rezervacije.</p>
    </div>
</header>

<main class="reservations-main">
    <section class="section">
        <div class="section-container">
            <div class="section-header-elegant">
                <span class="section-label">PREGLED ARANŽMANA</span>
                <h3>Vaše <span>rezervacije</span></h3>
            </div>

            <div class="reservations-shell">
                <div id="reservationsList" class="reservations-grid-layout"></div>

                <div id="emptyMsg" class="empty-state-box" style="display:none;">
                    <div class="empty-icon">📂</div>
                    <h4>Trenutno nemate aktivnih rezervacija</h4>
                    <p>Pretražite naše pakete i pronađite sljedeću idealnu destinaciju.</p>
                    <a asp-controller="Destinacije" asp-action="Index" class="btn-primary-elegant">Istraži destinacije</a>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
            </a>
            <p>Otkrijte najbolje destinacije na svijetu uz profesionalnu uslugu i podršku.</p>
        </div>

        <div class="footer-links">
            <h4>Istraži</h4>
            <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
            <a href="#">Putni vodiči</a>
            <a href="#">Najbolja iskustva</a>
        </div>

        <div class="footer-links">
            <h4>Kompanija</h4>
            <a asp-controller="Home" asp-action="ONama">O nama</a>
            <a href="#">Karijere</a>
            <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>
        </div>

        <div class="footer-links">
            <h4>Podrška</h4>
            <a href="#">Centar za pomoć</a>
            <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
            <a href="#">Uvjeti korištenja</a>
        </div>
    </div>
    <div class="footer-bottom">© 2026 InterTrips. Sva prava zadržana.</div>
</footer>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <style>
        :root {
        --primary: #2aa9b0;
        --primary-dark: #1e7f88;
        --primary-light: rgba(42, 169, 176, 0.1);
        --text-dark: #1c333b;
        --text-muted: #647c85;
        --bg-light: #f8fafb;
        --border-subtle: rgba(42, 169, 176, 0.15);
        --shadow-sm: 0 4px 12px rgba(63, 116, 128, 0.05);
        --shadow-md: 0 12px 30px rgba(63, 116, 128, 0.08);
        --radius-md: 12px;
        --radius-lg: 18px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .hero--reservations {
        position: relative;
        min-height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/assets/mojeRezervacije.jpg') center/cover no-repeat;
        padding: 40px 20px;
        }

        .hero--reservations .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(10,34,40,0.85) 0%, rgba(15,50,59,0.6) 100%);
        }

        .hero--reservations .hero-content {
        position: relative;
        z-index: 2;
        max-width: 680px;
        width: 100%;
        padding: 40px;
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(16px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        text-align: center;
        }

        .hero--reservations h1 {
        color: #ffffff;
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin: 12px 0;
        }

        .hero--reservations p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 1.05rem;
        line-height: 1.6;
        margin: 0;
        }

        .hero--reservations .badge {
        background: rgba(42, 169, 176, 0.3);
        border: 1px solid var(--primary);
        color: #ffffff;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        display: inline-block;
        }

        .reservations-main {
        background-color: var(--bg-light);
        padding: 60px 0;
        }

        .section-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 20px;
        }

        .section-header-elegant {
        margin-bottom: 35px;
        }

        .section-header-elegant .section-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 2px;
        display: block;
        margin-bottom: 6px;
        }

        .section-header-elegant h3 {
        font-size: 1.8rem;
        color: var(--text-dark);
        margin: 0;
        font-weight: 600;
        }

        .section-header-elegant h3 span {
        color: var(--primary-dark);
        position: relative;
        }

        .reservations-grid-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        }

        .r-card {
        background: #ffffff;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 24px;
        transition: var(--transition);
        }

        .r-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: rgba(42, 169, 176, 0.3);
        }

        .r-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        padding-bottom: 16px;
        border-bottom: 1px dashed var(--border-subtle);
        margin-bottom: 18px;
        }

        .r-code {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 6px;
        }

        .r-code::before {
        content: "🆔";
        font-size: 14px;
        }

        .r-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        }

        .r-badge.active {
        background: rgba(42, 169, 176, 0.1);
        color: var(--primary-dark);
        border: 1px solid rgba(42, 169, 176, 0.2);
        }

        .r-badge.success {
        background: rgba(46, 204, 113, 0.1);
        color: #27ae60;
        border: 1px solid rgba(46, 204, 113, 0.2);
        }

        .r-badge.cancel {
        background: rgba(231, 76, 60, 0.1);
        color: #c0392b;
        border: 1px solid rgba(231, 76, 60, 0.2);
        }

        .r-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        }

        .r-line {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 4px 0;
        }

        .r-line span {
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        }

        .r-line strong {
        color: var(--text-dark);
        font-size: 14px;
        font-weight: 600;
        }

        /* Akcije / Dugmad */
        .r-actions {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid rgba(0,0,0,0.04);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        }

        .btn-elegant-action {
        height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        border: 1px solid transparent;
        }

        .btn-elegant-action.plan {
        background: #ffffff;
        border-color: var(--border-subtle);
        color: var(--primary-dark);
        }

        .btn-elegant-action.plan:hover {
        background: var(--primary-light);
        border-color: var(--primary);
        }

        .btn-elegant-action.pdf {
        background: var(--primary-dark);
        color: #ffffff;
        }

        .btn-elegant-action.pdf:hover {
        background: #17656d;
        box-shadow: 0 4px 12px rgba(30, 127, 136, 0.25);
        }

        .btn-elegant-action.cancel {
        background: transparent;
        color: var(--text-muted);
        border-color: transparent;
        }

        .btn-elegant-action.cancel:hover {
        background: rgba(231, 76, 60, 0.08);
        color: #c0392b;
        border-color: rgba(231, 76, 60, 0.15);
        }

        .empty-state-box {
        background: #ffffff;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 50px 30px;
        text-align: center;
        max-width: 500px;
        margin: 40px auto 0;
        box-shadow: var(--shadow-sm);
        }

        .empty-icon {
        font-size: 44px;
        margin-bottom: 16px;
        }

        .empty-state-box h4 {
        color: var(--text-dark);
        margin: 0 0 10px 0;
        font-size: 1.25rem;
        }

        .empty-state-box p {
        color: var(--text-muted);
        font-size: 14px;
        margin: 0 0 24px 0;
        line-height: 1.5;
        }

        .btn-primary-elegant {
        display: inline-flex;
        background: var(--primary-dark);
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        transition: var(--transition);
        }

        .btn-primary-elegant:hover {
        background: #17656d;
        transform: translateY(-1px);
        }

        @@media (max-width: 768px) {
        .r-top {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        }

        .r-actions {
        justify-content: flex-start;
        width: 100%;
        }

        .btn-elegant-action {
        flex: 1 1 calc(50% - 6px);
        font-size: 12px;
        padding: 0 12px;
        }

        .btn-elegant-action.cancel {
        flex: 1 1 100%;
        }
        }
    </style>

    <script>
        let ucitaneRezervacije = [];

        function ukloniKvacice(tekst) {
        if (!tekst) return '—';
        return String(tekst)
        .replace(/[ČĆčć]/g, 'C')
        .replace(/[Žž]/g, 'Z')
        .replace(/[Šš]/g, 'S')
        .replace(/[Đđ]/g, 'Dj');
        }

        async function getReservationsForCurrentUser() {
        try {
        const response = await fetch('/Rezervacija/GetMojeRezervacije', {
        method: 'GET',
        credentials: 'same-origin'
        });
        if (!response.ok) return [];
        return await response.json();
        } catch (error) {
        console.error("Greška pri preuzimanju rezervacija:", error);
        return [];
        }
        }

        async function cancelReservation(id) {
        const confirmed = confirm('Da li ste sigurni da želite otkazati ovu rezervaciju?');
        if (!confirmed) return;

        try {
        const response = await fetch(`/Rezervacija/OtkaziRezervaciju?id=${id}`, {
        method: 'POST',
        credentials: 'same-origin'
        });

        if (response.ok) {
        alert("Rezervacija je uspješno otkazana.");
        await renderReservations();
        } else {
        alert("Greška pri otkazivanju rezervacije.");
        }
        } catch (error) {
        console.error("Greška:", error);
        alert("Greška u komunikaciji sa serverom.");
        }
        }

        function badgeHtml(status) {
        if (status === 'Otkazana') return '<span class="r-badge cancel">Otkazana</span>';
        if (status === 'Potvrdjena' || status === 'Potvrđena') return '<span class="r-badge success">Potvrđena</span>';
        return '<span class="r-badge active">Aktivna</span>';
        }

        function planButtonHtml(r) {
        if (!r) return '';
        const pId = r.paketId || r.PaketId;
        if (!pId) return '';
        return `
        <a class="btn-elegant-action plan" href="/PlanPutovanja/Preview?paketId=${encodeURIComponent(pId)}">
        Plan putovanja
        </a>
        `;
        }

        function downloadPdfByIndex(index) {
        const r = ucitaneRezervacije[index];
        if (!r) return;

        const pick = (...vals) => {
        for (const v of vals) {
        if (v !== null && v !== undefined && String(v).trim() !== '') return String(v).trim();
        }
        return '—';
        };

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        const danasnjiDan = new Date();
        const dan = String(danasnjiDan.getDate()).padStart(2, '0');
        const mjesec = String(danasnjiDan.getMonth() + 1).padStart(2, '0');
        const godina = danasnjiDan.getFullYear();
        const ispravanDatumIzdavanja = `${dan}.${mjesec}.${godina}.`;

        doc.setFillColor(10, 34, 40);
        doc.rect(0, 0, 210, 40, 'F');
        doc.setFont("helvetica", "bold");
        doc.setFontSize(22);
        doc.setTextColor(255, 255, 255);
        doc.text("INTERTRIPS - POTVRDA REZERVACIJE", 15, 26);

        doc.setFontSize(11);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(100, 100, 100);
        doc.text(`Datum izdavanja dokumenta: ${ispravanDatumIzdavanja}`, 15, 50);

        doc.setDrawColor(95, 181, 187);
        doc.line(15, 55, 195, 55);

        const brPutnika = r.brojPutnika || r.BrojPutnika || (r.putnici ? r.putnici.length : 1);

        doc.setFontSize(14);
        doc.setFont("helvetica", "bold");
        doc.setTextColor(10, 34, 40);
        doc.text(`Rezervacija koda: #${pick(r.id, r.Id)}`, 15, 68);
        doc.text(`Status: ${ukloniKvacice(pick(r.status, r.Status, 'Aktivna')).toUpperCase()}`, 130, 68);

        let y = 85;
        const stavke = [
        { label: "Destinacija:", info: `${ukloniKvacice(pick(r.destinacija, r.Destinacija))} ${r.drzava || r.Drzava ? '(' + ukloniKvacice(pick(r.drzava, r.Drzava)) + ')' : ''}` },
        { label: "Naziv paketa:", info: ukloniKvacice(pick(r.paketNaziv, r.PaketNaziv)) },
        { label: "Datum polaska:", info: pick(r.datumPolaska, r.DatumPolaska) },
        { label: "Datum povratka:", info: pick(r.datumPovratka, r.DatumPovratka) },
        { label: "Ukupan broj putnika:", info: String(brPutnika) }
        ];

        stavke.forEach(item => {
        doc.setFont("helvetica", "bold"); doc.text(item.label, 15, y);
        doc.setFont("helvetica", "normal"); doc.text(String(item.info), 65, y);
        y += 10;
        });

        y += 5;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(13);
        doc.setTextColor(10, 34, 40);
        doc.text("SPISAK PUTNIKA I DETALJI OSOBNIH DOKUMENATA", 15, y);
        y += 8;

        doc.setFillColor(240, 245, 245);
        doc.rect(15, y - 5, 180, 8, 'F');
        doc.setFontSize(10);
        doc.setTextColor(10, 34, 40);

        doc.text("Ime i Prezime", 17, y);
        doc.text("Telefon", 60, y);
        doc.text("Drzavljanstvo", 100, y);
        doc.text("Dat. Rodj.", 135, y);
        doc.text("Broj Pasosa", 165, y);

        doc.setDrawColor(200, 220, 220);
        doc.line(15, y + 4, 195, y + 4);
        y += 10;

        doc.setFont("helvetica", "normal");
        doc.setFontSize(9.5);
        doc.setTextColor(50, 50, 50);

        if (r.putnici && Array.isArray(r.putnici) && r.putnici.length > 0) {
        r.putnici.forEach((p) => {
        if (y > 275) {
        doc.addPage();
        y = 25;
        }

        const imePrezime = ukloniKvacice(pick(p.imePrezime, p.ImePrezime, `${p.ime || ''} ${p.prezime || ''}`.trim()));
        const tel = pick(p.brojTelefona, p.BrojTelefona, p.telefon, p.Telefon);
        const drzavljanstvo = ukloniKvacice(pick(p.drzavljanstvo, p.Drzavljanstvo));

        let rawDate = pick(p.datumRodjenja, p.DatumRodjenja, p.rodjenje, p.Rodjenje);
        let datRodj = rawDate;
        if (rawDate && rawDate.includes('-')) {
        const dijelovi = rawDate.split('T')[0].split('-');
        if (dijelovi.length === 3) {
        datRodj = `${dijelovi[2]}.${dijelovi[1]}.${dijelovi[0]}.`;
        }
        }

        const pasos = pick(p.brojPasosa, p.BrojPasosa, p.pasos, p.Pasos);

        doc.text(imePrezime, 17, y);
        doc.text(tel, 60, y);
        doc.text(drzavljanstvo, 100, y);
        doc.text(datRodj, 135, y);
        doc.text(pasos, 165, y);

        doc.line(15, y + 4, 195, y + 4);
        y += 9;
        });
        } else {
        doc.text("Nosilac rezervacije (Glavni putnik)", 17, y);
        doc.text(pick(r.korisnikEmail, r.KorisnikEmail, "—"), 60, y);
        doc.text("BiH", 100, y);
        doc.text("—", 135, y);
        doc.text("—", 165, y);
        doc.line(15, y + 4, 195, y + 4);
        }

        doc.save(`Rezervacija_InterTrips_${pick(r.id, r.Id)}.pdf`);
        }

        async function renderReservations() {
        const listEl = document.getElementById('reservationsList');
        const emptyMsg = document.getElementById('emptyMsg');
        if (!listEl) return;

        let sveRezervacije = await getReservationsForCurrentUser();

        const danas = new Date(2026, 4, 20);
        danas.setHours(0, 0, 0, 0);

        ucitaneRezervacije = sveRezervacije.filter(r => {
        const datumString = r.datumPovratka || r.DatumPovratka;
        if (!datumString) return true;

        let povratak;
        if (datumString.includes('.')) {
        const parts = datumString.split('.');
        povratak = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
        } else {
        povratak = new Date(datumString);
        }
        if (isNaN(povratak.getTime())) return true;
        povratak.setHours(0, 0, 0, 0);
        return povratak > danas;
        });

        if (!ucitaneRezervacije || ucitaneRezervacije.length === 0) {
        listEl.innerHTML = '';
        if (emptyMsg) emptyMsg.style.display = 'block';
        return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';

        listEl.innerHTML = ucitaneRezervacije.map((r, index) => {
        const isCancelled = r.status === 'Otkazana';
        const currentId = r.id || r.Id || '';

        const cancelBtn = isCancelled ? '' : `
        <button class="btn-elegant-action cancel" type="button" onclick="cancelReservation('${currentId}')">Otkaži rezervaciju</button>
        `;

        const planBtn = planButtonHtml(r);
        const stvarniBrojPutnika = r.brojPutnika || r.BrojPutnika || (r.putnici ? r.putnici.length : 1);
        const pdfBtn = `
        <button class="btn-elegant-action pdf" type="button" onclick="downloadPdfByIndex(${index})">
        Preuzmi PDF
        </button>
        `;

        const dest = r.destinacija || r.Destinacija || '—';
        const drz = r.drzava || r.Drzava ? '(' + (r.drzava || r.Drzava) + ')' : '';

        return `
        <div class="r-card">
        <div class="r-top">
        <div class="r-code">Kod rezervacije: <strong>#${currentId || '—'}</strong></div>
        ${badgeHtml(r.status)}
        </div>
        <div class="r-grid">
        <div class="r-line"><span>Destinacija</span><strong>${dest} ${drz}</strong></div>
        <div class="r-line"><span>Turistički Paket</span><strong>${r.paketNaziv || r.PaketNaziv || '—'}</strong></div>
        <div class="r-line"><span>Period Putovanja</span><strong>${r.datumPolaska || r.DatumPolaska || '—'} - ${r.datumPovratka || r.DatumPovratka || '—'}</strong></div>
        <div class="r-line"><span>Broj Putnika</span><strong>${stvarniBrojPutnika} osobe</strong></div>
        </div>
        <div class="r-actions">
        ${planBtn}
        ${pdfBtn}
        ${cancelBtn}
        </div>
        </div>
        `;
        }).join('');
        }

        window.addEventListener('DOMContentLoaded', renderReservations);
    </script>
}