@using InterTrips___Turistička_Agencija.Models
@{
    ViewData["Title"] = "InterTrips - Moje rezervacije";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .reservations-main {
    background-color: #f4f7f6;
    min-height: 80vh;
    padding-bottom: 60px;
    }

    .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=2021') center/cover no-repeat;
    opacity: 0.12;
    z-index: 1;
    }

    .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 35px 20px 0 20px;
    }

    .section-header-elegant {
    margin-bottom: 25px;
    }

    .section-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #2aa9b0;
    letter-spacing: 1.5px;
    display: block;
    margin-bottom: 4px;
    }

    .section-header-elegant h3 {
    font-size: 1.7rem;
    color: #0a2228;
    margin: 0;
    font-weight: 700;
    }

    .section-header-elegant h3 span {
    color: #1e7f88;
    }

    .reservations-grid-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
    }

    .reservation-panel {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(10, 34, 40, 0.03);
    border: 1px solid rgba(42, 169, 176, 0.1);
    overflow: hidden;
    transition: box-shadow 0.3s ease;
    }

    .reservation-panel:hover {
    box-shadow: 0 6px 18px rgba(10, 34, 40, 0.07);
    }

    .res-card-header {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    background: #ffffff;
    }

    .res-info-block h4 {
    font-size: 1.25rem;
    color: #0a2228;
    margin: 0 0 6px 0;
    font-weight: 700;
    }

    .res-meta-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    }

    .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f0f5f6;
    color: #435d62;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    }

    .meta-pill i {
    color: #1e7f88;
    }

    .res-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    }

    .qr-container-box {
    background: #ffffff;
    padding: 5px;
    border: 1px solid #e4ecee;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    }

    .res-card-details {
    background: #fafcfb;
    border-top: 1px dashed rgba(42, 169, 176, 0.18);
    padding: 20px;
    }

    .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
    }

    .detail-item {
    background: #ffffff;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid #e8f0f2;
    }

    .detail-label {
    font-size: 0.72rem;
    color: #718d92;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 2px;
    letter-spacing: 0.5px;
    }

    .detail-value {
    font-size: 0.92rem;
    color: #0a2228;
    font-weight: 600;
    }

    .table-responsive {
    overflow-x: auto;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e8f0f2;
    }

    .elegant-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
    }

    .elegant-table th {
    background-color: #0a2228;
    color: #ffffff;
    padding: 10px 14px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    }

    .elegant-table td {
    padding: 10px 14px;
    border-bottom: 1px solid #f0f5f6;
    color: #334d52;
    }

    .elegant-table tr:last-child td {
    border-bottom: none;
    }

    .hero--reservations {
    position: relative;
    background: linear-gradient(135deg, #051418 0%, #0a2228 100%);
    padding: 45px 20px;
    min-height: 180px;
    text-align: center;
    color: #ffffff;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    }

    .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
    }

    .hero-content .badge {
    background-color: #2aa9b0;
    color: #051216;
    padding: 5px 12px;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 50px;
    letter-spacing: 1px;
    display: inline-block;
    margin-bottom: 10px;
    }

    .hero-content h1 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
    color: #ffffff;
    text-shadow: none;
    }

    .hero-content p {
    font-size: 0.95rem;
    color: #a4bcc0; 
    margin: 0;
    font-weight: 400;
    }

    .status-badge {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    }

    .btn-download {
    background-color: #1e7f88;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: background-color 0.2s, transform 0.1s;
    }

    .btn-download:hover {
    background-color: #13585f;
    }

    .btn-download:disabled {
    background-color: #a4bcc0;
    }

    .btn-cancel {
    background-color: #fff;
    color: #dc3545;
    border: 1px solid #f8d7da;
    padding: 10px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.2s ease;
    }

    .btn-cancel:hover {
    background-color: #dc3545;
    color: #ffffff;
    border-color: #dc3545;
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15);
    }

    .empty-state-box {
    background: #ffffff;
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    max-width: 500px;
    margin: 30px auto;
    border: 1px dashed rgba(42, 169, 176, 0.3);
    }

    .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
    color: #2aa9b0;
    }

    .empty-state-box h4 {
    font-size: 1.25rem;
    color: #0a2228;
    margin-bottom: 5px;
    font-weight: 700;
    }

    .empty-state-box p {
    color: #536e73;
    font-size: 0.88rem;
    margin-bottom: 15px;
    }

    .btn-primary-elegant {
    background-color: #0a2228;
    color: #ffffff;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    }

    @@media (max-width: 768px) {
    .res-card-header {
    flex-direction: column;
    align-items: flex-start;
    }

    .res-actions-wrapper {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
    }
    }

    .status-badge.status-otkazano {
    background-color: #fce8e6;
    color: #a71d2a;
    border: 1px solid #f5c2c7;
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: bold;
    }

    .status-badge.status-ceka {
    background-color: #e6f7f0; 
    color: #10b981;
    border: 1px solid #a7f3d0;
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: bold;
    }
</style>

<header class="hero hero--reservations">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="badge">KORISNIČKI PANEL</span>
        <h1>Moje rezervacije</h1>
        <p>Pregledajte aktivne aranžmane, provjerite podatke putnika ili pogledajte plan putovanja.</p>
    </div>
</header>

<main class="reservations-main">
    <section class="section">
        <div class="section-container">
            <div class="section-header-elegant">
                <span class="section-label">EVIDENCE PANEL</span>
                <h3>Pregled ugovorenih <span>putovanja</span></h3>
            </div>

            <div class="reservations-shell">
                <div id="reservationsList" class="reservations-grid-layout"></div>

                <div id="emptyMsg" class="empty-state-box" style="display:none;">
                    <div class="empty-icon">📂</div>
                    <h4>Trenutno nemate aktivnih rezervacija</h4>
                    <p>Pretražite naše pakete i pronađite sljedeću idealnu destinaciju u ponudi.</p>
                    <a asp-controller="Destinacije" asp-action="Index" class="btn-primary-elegant">Istraži destinacije</a>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    function escapeHtml(str) {
    if (!str) return '';
    return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    async function renderReservations() {
    try {
    const response = await fetch('/Rezervacija/GetMojeRezervacije');
    const data = await response.json();
    const list = document.getElementById('reservationsList');
    const empty = document.getElementById('emptyMsg');

    if (!list) return;

    if (!data || data.length === 0) {
    list.innerHTML = "";
    if (empty) empty.style.display = 'block';
    return;
    } else {
    if (empty) empty.style.display = 'none';
    }

    list.innerHTML = data.map(r => {
    const resCode = `IT-${String(r.id).padStart(4, '0')}`;
    const jeOtkazana = (r.status === 2 || r.status === "Otkazana");

    let putniciHtml = '';
    if (r.putnici && r.putnici.length > 0) {
    r.putnici.forEach((p, idx) => {
    const tipZackica = p.tipPutnika ? ` <span style="font-size: 0.75rem; background: #e4ecee; padding: 2px 6px; border-radius: 4px; color: #1e7f88;">${escapeHtml(p.tipPutnika)}</span>` : '';
    const polZackica = p.pol ? ` (${escapeHtml(p.pol)})` : '';
    putniciHtml += `
    <tr>
    <td style="text-align:center; font-weight:bold;">${idx + 1}.</td>
    <td><b>${escapeHtml(p.ime)} ${escapeHtml(p.prezime)}</b>${polZackica}${tipZackica}</td>
    <td>${p.datumRodjenja ? formatirajDatum(p.datumRodjenja) : '—'}</td>
    <td style="font-family:monospace; font-weight:600;">${p.brojPasosa ? escapeHtml(p.brojPasosa) : '—'}</td>
    <td>${p.drzavljanstvo ? escapeHtml(p.drzavljanstvo) : '—'}</td>
    <td>${p.telefon ? escapeHtml(p.telefon) : '—'}</td>
    </tr>
    `;
    });
    } else {
    putniciHtml = `<tr><td colspan="6" style="text-align:center; color:#a4bcc0; padding:15px;">Nema registrovanih putnika za ovu rezervaciju.</td></tr>`;
    }

    let statusKlasa = jeOtkazana ? 'status-otkazano' : 'status-ceka';
    let statusTekst = jeOtkazana ? 'Otkazano' : 'PLAĆENO (Potvrđeno)';
    let sakrijOtkaziDugme = jeOtkazana ? 'display: none;' : '';
    let prikaziQrKod = !jeOtkazana;

    return `
    <div class="reservation-panel" id="panel_${r.id}" style="${jeOtkazana ? 'opacity: 0.85; border-left: 4px solid #dc3545;' : ''}">
    <div class="res-card-header">
    <div class="res-info-block">
    <h4 style="${jeOtkazana ? 'text-decoration: line-through; color: #6c757d;' : ''}">${escapeHtml(r.paketNaziv)}</h4>
    <div class="res-meta-pills">
    <div class="meta-pill">
    <i class="fa-solid fa-hashtag"></i>
    <span><b>Kôd:</b> ${resCode}</span>
    </div>
    <div class="meta-pill">
    <i class="fa-regular fa-calendar-days"></i>
    <span>${r.period || (formatirajDatum(r.datumPolaska) + ' - ' + formatirajDatum(r.datumPovratka))}</span>
    </div>
    <div class="meta-pill">
    <span class="status-badge ${statusKlasa}">${statusTekst}</span>
    </div>
    </div>
    </div>

    <div class="res-actions-wrapper">
    ${prikaziQrKod ? `<div class="qr-container-box" id="qr_${r.id}" title="Verifikacija" style="width:48px; height:48px;"></div>` : '<div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:#dc3545;">🚫</div>'}
    <button class="btn-download" onclick="preuzmiPdf(${r.id}, this)">
    <i class="fa-solid fa-file-pdf"></i> ${jeOtkazana ? 'Preuzmi Storno' : 'Preuzmi Rezervaciju'}
    </button>
    <button class="btn-cancel" style="${sakrijOtkaziDugme}" onclick="otkaziAranzman(${r.id}, '${resCode}')">
    <i class="fa-solid fa-trash-can"></i> Otkaži putovanje
    </button>
    </div>
    </div>

    <div class="res-card-details">
    <div class="details-grid">
    <div class="detail-item">
    <div class="detail-label">Odabrani Smještaj & Soba</div>
    <div class="detail-value">
    <i class="fa-solid fa-hotel" style="color: #1e7f88; margin-right: 5px;"></i>
    ${r.hotelNaziv ? escapeHtml(r.hotelNaziv) : 'Smještaj po programu'} ${r.odabranaSoba ? `(${escapeHtml(r.odabranaSoba)})` : ''}
    </div>
    </div>
    <div class="detail-item">
    <div class="detail-label">Odabrani Način Prevoza</div>
    <div class="detail-value">
    ${mapirajPrevoz(r.odabraniPrevoz)}
    </div>
    </div>
    </div>
    </div>

    <div style="margin: 15px 20px 8px 20px; font-size:0.8rem; font-weight:700; color:#0a2228; letter-spacing:0.3px;">POPIS PRIJAVLJENIH PUTNIKA</div>
    <div class="table-responsive" style="margin: 0 20px 20px 20px; width: calc(100% - 40px);">
    <table class="elegant-table">
    <thead>
    <tr>
    <th style="width: 5%; text-align:center;">#</th>
    <th style="width: 30%;">Ime i Prezime</th>
    <th style="width: 20%;">Datum rođenja</th>
    <th style="width: 15%;">Broj pasoša</th>
    <th style="width: 15%;">Državljanstvo</th>
    <th style="width: 15%;">Kontakt telefon</th>
    </tr>
    </thead>
    <tbody>
    ${putniciHtml}
    </tbody>
    </table>
    </div>
    </div>
    `;
    }).join('');

    setTimeout(() => {
    data.forEach(r => {
    const jeOtkazana = (r.status === 2 || r.status === "Otkazana");
    if (!jeOtkazana) {
    const qrElement = document.getElementById(`qr_${r.id}`);
    if (qrElement) {
    qrElement.innerHTML = "";
    new QRCode(qrElement, {
    text: `https://intertrips.ba/Verifikacija/Rezervacija/${r.id}`,
    width: 48,
    height: 48,
    colorDark: "#0a2228",
    colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
    });
    }
    }
    });
    }, 50);

    } catch (e) {
    console.error("Greška pri renderovanju rezervacija:", e);
    }
    }

    function formatirajDatum(datumStr) {
    if (!datumStr) return '—';
    try {
    const d = new Date(datumStr);
    if (isNaN(d.getTime())) return escapeHtml(datumStr);
    return `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}.`;
    } catch {
    return escapeHtml(datumStr);
    }
    }

    async function otkaziAranzman(id, resCode) {
    const rezultat = await Swal.fire({
    title: 'Da li ste sigurni?',
    text: `Želite li otkazati rezervaciju ${resCode}? Ova akcija će osloboditi vaša mjesta i vratiti iskorišteni kupon ako ste ga imali.`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc3545',
    cancelButtonColor: '#6c757d',
    confirmButtonText: 'Da, otkaži putovanje',
    cancelButtonText: 'Odustani'
    });

    if (rezultat.isConfirmed) {
    try {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
    || document.querySelector('[headers*="RequestVerificationToken"]')?.value
    || '';

    const response = await fetch(`/Rezervacija/OtkaziRezervaciju/${id}`, {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': token
    }
    });

    const data = await response.json().catch(() => ({}));

    if (response.ok) {
    await Swal.fire({
    title: 'Uspješno otkazano!',
    text: data.message || 'Rezervacija je uspješno otkazana.',
    icon: 'success',
    confirmButtonColor: '#1e7f88'
    });

    renderReservations();
    } else {
    throw new Error(data.greska || data.message || "Došlo je do greške prilikom otkazivanja.");
    }
    } catch (error) {
    Swal.fire({
    title: 'Greška!',
    text: error.message,
    icon: 'error',
    confirmButtonColor: '#1e7f88'
    });
    }
    }
    }

    async function preuzmiPdf(stvarniId, btn) {
    if (!btn || btn.disabled) return;

    let originalniTekst = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generisanje...';

    try {
    const response = await fetch(`/Rezervacija/PreuzmiItinerer/${stvarniId}`, {
    credentials: 'same-origin'
    });

    if (!response.ok) {
    const text = await response.text().catch(() => '');
    throw new Error(text || "Greška prilikom preuzimanja PDF dokumenta.");
    }

    const blob = await response.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.style.display = 'none';
    a.href = url;
    a.download = `Potvrda_InterTrips_IT-${stvarniId}.pdf`;

    document.body.appendChild(a);
    a.click();

    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
    } catch (error) {
    Swal.fire({
    title: 'Greška!',
    text: "Došlo je do greške: " + error.message,
    icon: 'error',
    confirmButtonColor: '#1e7f88'
    });
    } finally {
    btn.disabled = false;
    btn.innerHTML = originalniTekst;
    }
    }

    function mapirajPrevoz(prevoz) {
    if (prevoz === 0 || prevoz === "Avion") {
    return `<i class="fa-solid fa-plane" style="color: #1e7f88; margin-right: 5px;"></i> Avionski prevoz`;
    }
    if (prevoz === 1 || prevoz === "Autobus") {
    return `<i class="fa-solid fa-bus" style="color: #1e7f88; margin-right: 5px;"></i> Autobuski prevoz`;
    }
    if (prevoz === 2 || prevoz === "Oboje") {
    return `<i class="fa-solid fa-repeat" style="color: #1e7f88; margin-right: 5px;"></i> Kombinovani prevoz (Avion/Autobus)`;
    }
    return `<i class="fa-solid fa-van-shuttle" style="color: #1e7f88; margin-right: 5px;"></i> Uključen prevoz po programu`;
    }

    window.addEventListener('DOMContentLoaded', renderReservations);
</script>