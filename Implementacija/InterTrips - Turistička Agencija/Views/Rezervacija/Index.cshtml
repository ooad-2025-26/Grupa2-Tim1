@using InterTrips___Turistička_Agencija.Models
@{
    ViewData["Title"] = "InterTrips - Moje rezervacije";
    Layout = "_Layout";
}

<header class="hero hero--reservations">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="badge">REZERVACIJE</span>
        <h1>MOJE REZERVACIJE</h1>
        <p>Pregledajte Vaše aktivne aranžmane, preuzmite dokumentaciju ili upravljajte statusom rezervacije.</p>
    </div>
</header>

<main class="reservations-main">
    <section class="section">
        <div class="section-container">
            <div class="section-header-elegant">
                <span class="section-label">PREGLED ARANŽMANA</span>
                <h3>Vaše <span>rezervacije</span></h3>
            </div>

            <div class="reservations-shell">
                <div id="reservationsList" class="reservations-grid-layout"></div>

                <div id="emptyMsg" class="empty-state-box" style="display:none;">
                    <div class="empty-icon">📂</div>
                    <h4>Trenutno nemate aktivnih rezervacija</h4>
                    <p>Pretražite naše pakete i pronađite sljedeću idealnu destinaciju.</p>
                    <a asp-controller="Destinacije" asp-action="Index" class="btn-primary-elegant">Istraži destinacije</a>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/logo.png" alt="InterTrips logo" class="logo small-logo">
            </a>
            <p>Otkrijte najbolje destinacije na svijetu uz profesionalnu uslugu i podršku.</p>
        </div>

        <div class="footer-links">
            <h4>Istraži</h4>
            <a asp-controller="Destinacije" asp-action="Index">Destinacije</a>
            <a href="#">Putni vodiči</a>
            <a href="#">Najbolja iskustva</a>
        </div>

        <div class="footer-links">
            <h4>Kompanija</h4>
            <a asp-controller="Home" asp-action="ONama">O nama</a>
            <a href="#">Karijere</a>
            <a asp-controller="Home" asp-action="Kontakt">Kontakt</a>
        </div>

        <div class="footer-links">
            <h4>Podrška</h4>
            <a href="#">Centar za pomoć</a>
            <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
            <a href="#">Uvjeti korištenja</a>
        </div>
    </div>
    <div class="footer-bottom">© 2026 InterTrips. Sva prava zadržana.</div>
</footer>

@section Scripts {
    <style>
        :root {
            --primary: #2aa9b0;
            --primary-dark: #1e7f88;
            --primary-light: rgba(42, 169, 176, 0.1);
            --text-dark: #1c333b;
            --text-muted: #647c85;
            --bg-light: #f8fafb;
            --border-subtle: rgba(42, 169, 176, 0.15);
            --shadow-sm: 0 4px 12px rgba(63, 116, 128, 0.05);
            --shadow-md: 0 12px 30px rgba(63, 116, 128, 0.08);
            --radius-md: 12px;
            --radius-lg: 18px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .hero--reservations {
            position: relative;
            min-height: 380px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: url('/assets/mojeRezervacije.jpg') center/cover no-repeat;
            padding: 40px 20px;
        }

            .hero--reservations .hero-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(10,34,40,0.85) 0%, rgba(15,50,59,0.6) 100%);
            }

            .hero--reservations .hero-content {
                position: relative;
                z-index: 2;
                max-width: 680px;
                width: 100%;
                padding: 40px;
                border-radius: var(--radius-lg);
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(16px);
                box-shadow: 0 30px 60px rgba(0,0,0,0.3);
                text-align: center;
            }

            .hero--reservations h1 {
                color: #ffffff;
                font-size: 2.2rem;
                font-weight: 700;
                letter-spacing: 1.5px;
                margin: 12px 0;
            }

            .hero--reservations p {
                color: rgba(255, 255, 255, 0.85);
                font-size: 1.05rem;
                line-height: 1.6;
                margin: 0;
            }

            .hero--reservations .badge {
                background: rgba(42, 169, 176, 0.3);
                border: 1px solid var(--primary);
                color: #ffffff;
                padding: 6px 16px;
                border-radius: 50px;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                display: inline-block;
            }

        .reservations-main {
            background-color: var(--bg-light);
            padding: 60px 0;
        }

        .section-container {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .section-header-elegant {
            margin-bottom: 35px;
        }

            .section-header-elegant .section-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--primary);
                letter-spacing: 2px;
                display: block;
                margin-bottom: 6px;
            }

            .section-header-elegant h3 {
                font-size: 1.8rem;
                color: var(--text-dark);
                margin: 0;
                font-weight: 600;
            }

                .section-header-elegant h3 span {
                    color: var(--primary-dark);
                    position: relative;
                }

        .reservations-grid-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .r-card {
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            padding: 24px;
            transition: var(--transition);
        }

            .r-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
                border-color: rgba(42, 169, 176, 0.3);
            }

        .r-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            padding-bottom: 16px;
            border-bottom: 1px dashed var(--border-subtle);
            margin-bottom: 18px;
        }

        .r-code {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .r-code::before {
                content: "🆔";
                font-size: 14px;
            }

        .r-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

            .r-badge.active {
                background: rgba(42, 169, 176, 0.1);
                color: var(--primary-dark);
                border: 1px solid rgba(42, 169, 176, 0.2);
            }

            .r-badge.success {
                background: rgba(46, 204, 113, 0.1);
                color: #27ae60;
                border: 1px solid rgba(46, 204, 113, 0.2);
            }

            .r-badge.cancel {
                background: rgba(231, 76, 60, 0.1);
                color: #c0392b;
                border: 1px solid rgba(231, 76, 60, 0.2);
            }

        .r-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .r-line {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 4px 0;
        }

            .r-line span {
                color: var(--text-muted);
                font-size: 12px;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .r-line strong {
                color: var(--text-dark);
                font-size: 14px;
                font-weight: 600;
            }

        .r-actions {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid rgba(0,0,0,0.04);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-elegant-action {
            height: 42px;
            padding: 0 20px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            border: 1px solid transparent;
        }

            .btn-elegant-action.plan {
                background: #ffffff;
                border-color: var(--border-subtle);
                color: var(--primary-dark);
            }

                .btn-elegant-action.plan:hover {
                    background: var(--primary-light);
                    border-color: var(--primary);
                }

            .btn-elegant-action.pdf {
                background: var(--primary-dark);
                color: #ffffff;
                border: none;
            }

                .btn-elegant-action.pdf:hover {
                    background: #17656d;
                    box-shadow: 0 4px 12px rgba(30, 127, 136, 0.25);
                }

            .btn-elegant-action.cancel {
                background: transparent;
                color: var(--text-muted);
                border-color: transparent;
            }

                .btn-elegant-action.cancel:hover {
                    background: rgba(231, 76, 60, 0.08);
                    color: #c0392b;
                    border-color: rgba(231, 76, 60, 0.15);
                }

        .empty-state-box {
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 50px 30px;
            text-align: center;
            max-width: 500px;
            margin: 40px auto 0;
            box-shadow: var(--shadow-sm);
        }

        .empty-icon {
            font-size: 44px;
            margin-bottom: 16px;
        }

        .empty-state-box h4 {
            color: var(--text-dark);
            margin: 0 0 10px 0;
            font-size: 1.25rem;
        }

        .empty-state-box p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0 0 24px 0;
            line-height: 1.5;
        }

        .btn-primary-elegant {
            display: inline-flex;
            background: var(--primary-dark);
            color: #ffffff;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            transition: var(--transition);
        }

            .btn-primary-elegant:hover {
                background: #17656d;
                transform: translateY(-1px);
            }

        @@media (max-width: 768px) {
            .r-top {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .r-actions {
                justify-content: flex-start;
                width: 100%;
            }

            .btn-elegant-action {
                flex: 1 1 calc(50% - 6px);
                font-size: 12px;
                padding: 0 12px;
            }

                .btn-elegant-action.cancel {
                    flex: 1 1 100%;
                }
        }
    </style>

    <script>
        let ucitaneRezervacije = [];

        async function getReservationsForCurrentUser() {
            try {
                const response = await fetch('/Rezervacija/GetMojeRezervacije', {
                    method: 'GET',
                    credentials: 'same-origin'
                });
                if (!response.ok) return [];
                return await response.json();
            } catch (error) {
                console.error("Greška pri preuzimanju rezervacija:", error);
                return [];
            }
        }

        async function cancelReservation(id) {
            const confirmed = confirm('Da li ste sigurni da želite otkazati ovu rezervaciju?');
            if (!confirmed) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch(`/Rezervacija/OtkaziRezervaciju?id=${id}`, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'RequestVerificationToken': token || '' 
                    }
                });

                if (response.ok) {
                    alert("Rezervacija je uspješno otkazana.");
                    await renderReservations(); 
                } else {
                    const greskaPodaci = await response.json().catch(() => ({}));
                    alert(greskaPodaci.greska || "Greška pri otkazivanju rezervacije.");
                }
            } catch (error) {
                console.error("Greška:", error);
                alert("Greška u komunikaciji sa serverom.");
            }
        }

        function badgeHtml(status) {
            if (status === 'Otkazana') return '<span class="r-badge cancel">Otkazana</span>';
            if (status === 'Potvrdjena' || status === 'Potvrđena') return '<span class="r-badge success">Potvrđena</span>';
            return '<span class="r-badge active">Aktivna</span>';
        }

        function planButtonHtml(r) {
            if (!r) return '';
            const pId = r.paketId || r.PaketId;
            if (!pId) return '';
            return `
                        <a class="btn-elegant-action plan" href="/PlanPutovanja/Preview?paketId=${encodeURIComponent(pId)}">Plan putovanja</a>
                    `;
        }

        async function downloadPdfByIndex(index) {
            const r = ucitaneRezervacije[index];
            if (!r) {
                alert("Rezervacija nije pronađena u lokalnom nizu.");
                return;
            }

            const stvarniId = r.id || r.Id;
            if (!stvarniId) {
                alert("Greška: Rezervacija nema važeći ID.");
                return;
            }

            // Pronalazimo dugme koje je kliknuto da mu promijenimo tekst tokom preuzimanja
            const btn = event.currentTarget || document.querySelectorAll('.btn-elegant-action.pdf')[index];
            const originalniTekst = btn.innerHTML;

            btn.disabled = true;
            btn.textContent = "Preuzimanje...";

            try {
                const response = await fetch(`/Rezervacija/PreuzmiItinerer/${stvarniId}`);

                if (!response.ok) {
                    throw new Error("Greška prilikom generisanja ili preuzimanja PDF-a.");
                }

                const blob = await response.blob();

                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;

                a.download = `Potvrda_InterTrips_IT-${stvarniId}.pdf`;

                document.body.appendChild(a);
                a.click(); 

                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (error) {
                console.error("Greška:", error);
                alert("Došlo je do greške: " + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalniTekst;
            }
        }

        window.addEventListener('DOMContentLoaded', renderReservations);
    </script>
}