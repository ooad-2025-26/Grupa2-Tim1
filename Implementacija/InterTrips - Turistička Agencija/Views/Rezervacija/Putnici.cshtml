@{
    ViewData["Title"] = "InterTrips - Podaci o putnicima";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
        :root {
        --brand-primary: #0f766e; 
        --brand-dark: #111827; 
        --brand-light: #f0fdfa; 
        --brand-accent: #0d9488; 
        --text-main: #374151; 
        --text-muted: #6b7280;
        --bg-page: #f8fafc; 
        --border-color: #e2e8f0; 
        --error-color: #dc2626; 
        --success-bg: #f0fdf4;
        --success-color: #166534;
        --radius-lg: 16px;
        --radius-md: 10px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-page);
        color: var(--text-main);
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        }

        .topbar {
        height: 70px;
        background: #ffffff;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
        position: sticky;
        top: 0;
        z-index: 100;
        }

        .logo-link {
        display: flex;
        align-items: center;
        }

        .secure-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--success-color);
        background: var(--success-bg);
        padding: 6px 14px;
        border-radius: 30px;
        border: 1px solid #bbf7d0;
        }

        .page {
        padding: 40px 20px 80px;
        }

        .center-shell {
        max-width: 1140px;
        margin: 0 auto;
        }

        .steps {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin-bottom: 40px;
        }

        .step {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 500;
        }

        .step .circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #e2e8f0;
        display: grid;
        place-items: center;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 12px;
        }

        .step.active {
        color: var(--brand-primary);
        font-weight: 600;
        }

        .step.active .circle {
        background: var(--brand-primary);
        color: #ffffff;
        }

        .booking-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 30px;
        align-items: start;
        }

        .panel {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        }

        .panel-pad {
        padding: 30px;
        }

        .panel-title {
        font-size: 22px;
        font-weight: 800;
        margin-top: 0;
        margin-bottom: 24px;
        color: var(--brand-dark);
        letter-spacing: -0.5px;
        }

        .passenger-block {
        margin-bottom: 30px;
        padding: 24px;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        }

        .passenger-block:last-child {
        margin-bottom: 0;
        }

        .p-title {
        font-weight: 700;
        margin-bottom: 20px;
        color: var(--brand-primary);
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .p-title::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 16px;
        background: var(--brand-primary);
        border-radius: 2px;
        }

        .form-group {
        margin-bottom: 18px;
        }

        .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        }

        .field-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--brand-dark);
        margin-bottom: 8px;
        }

        .field-label .required {
        color: var(--error-color);
        margin-left: 2px;
        }

        .input, .textarea {
        width: 100%;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        height: 46px;
        padding: 0 14px;
        font-size: 14px;
        font-family: inherit;
        color: var(--brand-dark);
        outline: none;
        box-sizing: border-box;
        transition: var(--transition);
        }

        .input:focus, .textarea:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
        }

        .textarea {
        height: 90px;
        padding: 12px 14px;
        resize: none;
        }

        .error-note {
        font-size: 13px;
        background: #fef2f2;
        color: var(--error-color);
        border: 1px solid #fee2e2;
        padding: 12px 16px;
        border-radius: var(--radius-md);
        margin-top: 20px;
        display: none;
        font-weight: 600;
        line-height: 1.5;
        }

        .summary-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e7eb;
        overflow: hidden;
        position: sticky;
        top: 20px;
        }

        .summary-photo {
        height: 160px;
        position: relative;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        padding: 20px;
        background-color: #cbd5e0;
        }

        .summary-photo::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 100%);
        z-index: 1;
        }

        
        .summary-place {
        position: relative;
        z-index: 2;
        font-weight: 700;
        font-size: 20px;
        color: #ffffff !important;
        }

        .summary-body {
        padding: 24px;
        }

        .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        color: var(--text-muted);
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 8px;
        }

        .summary-row span:first-child {
        font-weight: 500;
        }

        .summary-row strong, .summary-row span:last-child {
        color: var(--brand-dark);
        font-weight: 600;
        }

        .price-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        }

        .price-line span:first-child {
        font-weight: 600;
        color: var(--brand-dark);
        font-size: 14px;
        }

        .total {
        color: var(--brand-primary);
        font-size: 24px;
        font-weight: 800;
        }

        .btn-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 24px;
        }

        .main-btn, .secondary-btn {
        height: 48px;
        border-radius: var(--radius-md);
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        box-sizing: border-box;
        }

        .main-btn {
        background: var(--brand-primary);
        color: #ffffff;
        padding: 0 28px;
        }

        .main-btn:hover {
        background: var(--brand-accent);
        }

        .secondary-btn {
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--brand-dark);
        padding: 0 24px;
        }

        .secondary-btn:hover {
        background: #f8fafc;
        border-color: var(--text-muted);
        }

        @@media (max-width: 1024px) {
        .booking-grid {
        grid-template-columns: 1fr;
        }

        .

        @@media (max-width: 768px) {
        .row {
        grid-template-columns: 1fr;
        gap: 12px;
        }

        .topbar {
        padding: 0 20px;
        }

        .steps {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding-left: 20px;
        }

        .btn-row {
        flex-direction: column-reverse;
        }

        .secondary-btn, .main-btn {
        width: 100%;
        }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/" class="logo-link">
            <img src="~/assets/logo.png" alt="InterTrips logo" class="logo" style="height:38px;">
        </a>
        <div class="secure-badge">
            <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i> Sigurna kupovina
        </div>
    </div>

    <div class="page">
        <div class="center-shell">
            <div class="steps">
                <div class="step"><div class="circle"><i data-lucide="check" style="width: 12px; height: 12px;"></i></div>Detalji</div>
                <div class="step active"><div class="circle">2</div>Putnici</div>
                <div class="step"><div class="circle">3</div>Plaćanje</div>
                <div class="step"><div class="circle">4</div>Potvrda</div>
            </div>

            <div class="booking-grid">
                <div class="left-col">
                    <div class="panel panel-pad">
                        <h3 class="panel-title" id="passengerPanelTitle">Podaci o putnicima (Letovi i Hoteli)</h3>

                        <div id="passengerContainer"></div>

                        <div id="formError" class="error-note" style="display: none; color: #dc2626; margin-bottom: 15px; font-weight: 500;"></div>

                        <div class="btn-row">
                            <button class="secondary-btn" type="button" onclick="window.history.back()">
                                <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Nazad
                            </button>
                            <button class="main-btn" type="button" onclick="goToPayment()">
                                Nastavi na plaćanje <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="right-column">
                    <div class="panel summary-card">
                        <div class="summary-photo" id="summaryPhoto">
                            <div class="summary-place" id="summaryDest">Destinacija <small id="summaryCountry">—</small></div>
                        </div>
                        <div class="summary-body">

                            <div class="summary-row">
                                <span><i data-lucide="users" class="summary-icon"></i> Putnici</span>
                                <strong id="summaryTravelers">—</strong>
                            </div>
                            <div class="summary-row">
                                <span><i data-lucide="calendar" class="summary-icon"></i> Trajanje</span>
                                <strong id="summaryNights">—</strong>
                            </div>
                            <div class="summary-row">
                                <span><i data-lucide="hotel" class="summary-icon"></i> Hotel</span>
                                <strong id="summaryHotelName">—</strong>
                            </div>
                            <div class="summary-row">
                                <span><i data-lucide="door-open" class="summary-icon"></i> Smještaj</span>
                                <strong id="summaryRoom">—</strong>
                            </div>

                            <hr class="summary-divider">

                            <div id="flightSummarySection">
                                <div class="summary-row">
                                    <span><i data-lucide="plane" class="summary-icon"></i> Let</span>
                                    <strong id="summaryFlightRoute">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="plane-takeoff" class="summary-icon"></i> Polazak</span>
                                    <strong id="summaryDeparture">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="plane-landing" class="summary-icon"></i> Povratak</span>
                                    <strong id="summaryReturn">—</strong>
                                </div>
                            </div>

                            <div id="busSummarySection" style="display: none;">
                                <div class="summary-row">
                                    <span><i data-lucide="bus" class="summary-icon"></i> Prevoz</span>
                                    <strong>Autobuski aranžman</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="calendar-days" class="summary-icon"></i> Polazak</span>
                                    <strong id="summaryBusDeparture">—</strong>
                                </div>
                                <div class="summary-row">
                                    <span><i data-lucide="calendar-days" class="summary-icon"></i> Povratak</span>
                                    <strong id="summaryBusReturn">—</strong>
                                </div>
                            </div>

                            <hr class="summary-divider">


                            <div class="price-line">
                                <span>Ukupna cijena aranžmana:</span>
                                <span class="total" id="summaryTotal">0.00 KM</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <template id="passengerTemplate">
        <div class="passenger-block">
            <div class="p-title title">Putnik</div>

            <div class="form-group row">
                <div>
                    <label class="field-label">Tip putnika <span class="required">*</span></label>
                    <select class="input ptype">
                        <option value="adult">Odrasli (18+)</option>
                        <option value="child">Dijete (0-17)</option>
                    </select>
                </div>
                <div>
                    <label class="field-label">Pol <span class="required">*</span></label>
                    <select class="input gender">
                        <option value="">Odaberite pol</option>
                        <option value="M">Muški</option>
                        <option value="F">Ženski</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <div>
                    <label class="field-label">Ime <span class="required">*</span></label>
                    <input class="input fname" placeholder="Unesite ime (kao u pasošu)">
                </div>
                <div>
                    <label class="field-label">Prezime <span class="required">*</span></label>
                    <input class="input lname" placeholder="Unesite prezime (kao u pasošu)">
                </div>
            </div>

            <div class="form-group row">
                <div>
                    <label class="field-label">Datum rođenja <span class="required">*</span></label>
                    <input type="date" class="input birthdate">
                </div>
                <div>
                    <label class="field-label">Telefon <span class="required">*</span></label>
                    <div style="display:flex; gap:10px;">
                        <select class="input phoneCode" style="max-width:130px; min-width: 100px;">
                            <option value="">+xxx</option>
                        </select>
                        <input class="input phoneNumber" placeholder="61 123 456" autocomplete="tel">
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div>
                    <label class="field-label">Broj pasoša <span class="required">*</span></label>
                    <input class="input passport"
                           placeholder="npr. C1234567"
                           maxlength="9"
                           autocomplete="off"
                           inputmode="text">
                </div>
                <div>
                    <label class="field-label">Državljanstvo <span class="required">*</span></label>
                    <select class="input nationality">
                        <option value="">Odaberite državljanstvo</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <div>
                    <label class="field-label">Česti putnik (Frequent Flyer broj)</label>
                    <input class="input freqFlyer" placeholder="Opcionalno (npr. Miles & More)">
                </div>
                <div>
                    <label class="field-label">Željeni tip kreveta (Hotel)</label>
                    <select class="input bedPreference">
                        <option value="no-preference">Bez preferencije</option>
                        <option value="double">Jedan veliki bračni krevet</option>
                        <option value="twin">Dva odvojena kreveta</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="field-label">Posebni zahtjevi (ishrana, alergije, napomene za hotel/let)</label>
                <textarea class="textarea requests" placeholder="Napomena (npr. vegetarijanski meni na letu, soba na tihoj strani, pristupačnost...)"></textarea>
            </div>
        </div>
    </template>

    <script>
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        const countries = [
            { name: "Bosna i Hercegovina", flag: "🇧🇦", dial: "+387", digits: 8 },
            { name: "Hrvatska", flag: "🇭🇷", dial: "+385", digits: 9 },
            { name: "Srbija", flag: "🇷🇸", dial: "+381", digits: 9 },
            { name: "Crna Gora", flag: "🇲🇪", dial: "+382", digits: 8 },
            { name: "Slovenija", flag: "🇸🇮", dial: "+386", digits: 8 },
            { name: "Njemačka", flag: "🇩🇪", dial: "+49", digits: 9 },
            { name: "Austrija", flag: "🇦🇹", dial: "+43", digits: 9 },
            { name: "Italija", flag: "🇮🇹", dial: "+39", digits: 9 },
            { name: "Francuska", flag: "🇫🇷", dial: "+33", digits: 9 },
            { name: "Švicarska", flag: "🇨🇭", dial: "+41", digits: 9 },
            { name: "Švedska", flag: "🇸🇪", dial: "+46", digits: 9 },
            { name: "Turska", flag: "🇹🇷", dial: "+90", digits: 10 },
            { name: "Ujedinjeni Arapski Emirati", flag: "🇦🇪", dial: "+971", digits: 9 },
            { name: "SAD", flag: "🇺🇸", dial: "+1", digits: 10 }
        ].sort((a, b) => a.name.localeCompare(b.name));

        function formatFullPhone(code, digits) {
            return `${code} ${digits}`;
        }

        function calcAgeYears(isoDate) {
            if (!isoDate) return null;
            const dob = new Date(isoDate + "T00:00:00");
            if (isNaN(dob.getTime())) return null;

            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
            return age;
        }

        function onlyDigits(s) {
            return (s || "").replace(/\D/g, "");
        }

        function formatLocalPhone(digits) {
            if (!digits) return "";
            const parts = [];
            parts.push(digits.slice(0, 2));
            if (digits.length > 2) parts.push(digits.slice(2, 5));
            if (digits.length > 5) parts.push(digits.slice(5, 8));
            if (digits.length > 8) parts.push(digits.slice(8));
            return parts.filter(Boolean).join(" ");
        }

        function getCountryRuleByName(name) {
            return countries.find(c => c.name === name) || null;
        }

        function getCountryRuleByDial(dial) {
            return countries.find(c => c.dial === dial) || null;
        }

        function generatePassengers() {
            const container = document.getElementById('passengerContainer');
            const template = document.getElementById('passengerTemplate');

            if (!container || !template) {
                console.error("Missing container or template element!");
                return;
            }

            const count = parseInt(localStorage.getItem('reservationTravelers') || '1', 10) || 1;
            const expectedAdults = parseInt(localStorage.getItem('reservationAdults') || '1', 10) || 1;

            let savedPassengers = [];
            try {
                savedPassengers = JSON.parse(localStorage.getItem('savedPassengers') || '[]');
            } catch (e) {
                savedPassengers = [];
            }
            if (savedPassengers.length !== count) {
        savedPassengers = [];
        localStorage.removeItem('savedPassengers'); 
        }
        container.innerHTML = '';
        for (let i = 1; i <= count; i++) {
        const clone = template.content.cloneNode(true);

        const titleEl = clone.querySelector('.p-title');
        if (titleEl) titleEl.textContent = `Putnik ${i}`;

                const selectNat = clone.querySelector('.nationality');
                if (selectNat) {
                    countries.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.name;
                        opt.textContent = `${c.flag} ${c.name}`;
                        selectNat.appendChild(opt);
                    });
                }

                const phoneCodeEl = clone.querySelector('.phoneCode');
                if (phoneCodeEl) {
                    countries.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.dial;
                        opt.textContent = `${c.flag} ${c.dial}`;
                        phoneCodeEl.appendChild(opt);
                    });
                }

                const wrapper = document.createElement('div');
                wrapper.appendChild(clone);
                const block = wrapper.querySelector('.passenger-block');

                const pTypeEl = block.querySelector('.ptype');
                if (pTypeEl) {
                    if (i <= expectedAdults) {
                        pTypeEl.value = 'adult';
                    } else {
                        pTypeEl.value = 'child';
                    }
                }

                if (savedPassengers && savedPassengers[i - 1]) {
                    const sp = savedPassengers[i - 1];
                    if (pTypeEl && sp.type) pTypeEl.value = sp.type;
                    
                    const genderEl = block.querySelector('.gender');
                    if (genderEl && sp.gender) genderEl.value = sp.gender;
                    
                    const fnameEl = block.querySelector('.fname');
                    if (fnameEl && sp.firstName) fnameEl.value = sp.firstName;
                    
                    const lnameEl = block.querySelector('.lname');
                    if (lnameEl && sp.lastName) lnameEl.value = sp.lastName;
                    
                    const birthdateEl = block.querySelector('.birthdate');
                    if (birthdateEl && sp.birthDate) birthdateEl.value = sp.birthDate;
                    
                    const passportEl = block.querySelector('.passport');
                    if (passportEl && sp.passport) passportEl.value = sp.passport;
                    
                    if (selectNat && sp.nationality) selectNat.value = sp.nationality;
                    
                    const freqFlyerEl = block.querySelector('.freqFlyer');
                    if (freqFlyerEl && sp.freqFlyer) freqFlyerEl.value = sp.freqFlyer;
                    
                    const bedPrefEl = block.querySelector('.bedPreference');
                    if (bedPrefEl && sp.bedPreference) bedPrefEl.value = sp.bedPreference;
                    
                    const requestsEl = block.querySelector('.requests');
                    if (requestsEl && sp.requests) requestsEl.value = sp.requests;
                    
                    const phoneNumEl = block.querySelector('.phoneNumber');
                    if (sp.phone && phoneNumEl) {
                        const phoneParts = sp.phone.split(' ');
                        if (phoneParts.length > 1) {
                            if (phoneCodeEl) phoneCodeEl.value = phoneParts[0];
                            phoneNumEl.value = formatLocalPhone(phoneParts.slice(1).join(''));
                        }
                    }
                }

                const doLiveValidate = (element) => {
                    if (element) element.style.borderColor = '';
                    validateBlock(block, i - 1, true);
                };

                const passportEl = block.querySelector('.passport');
                if (passportEl) {
                    passportEl.addEventListener('input', () => {
                        passportEl.value = passportEl.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 9);
                        doLiveValidate(passportEl);
                    });
                }

                const phoneCode = block.querySelector('.phoneCode');
                const phoneNumber = block.querySelector('.phoneNumber');
                const nationality = block.querySelector('.nationality');

                function applyPhoneRuleFromNationality() {
                    const rule = getCountryRuleByName(nationality?.value);
                    if (!rule) return;
                    if (phoneCode && !phoneCode.value) phoneCode.value = rule.dial;
                    if (phoneNumber) {
                        const maxDigits = rule.digits;
                        const digits = onlyDigits(phoneNumber.value).slice(0, maxDigits);
                        phoneNumber.value = formatLocalPhone(digits);
                    }
                }

                nationality?.addEventListener('change', () => {
                    applyPhoneRuleFromNationality();
                    doLiveValidate(nationality);
                });

                phoneNumber?.addEventListener('input', () => {
                    const rule = getCountryRuleByDial(phoneCode?.value) || getCountryRuleByName(nationality?.value);
                    const maxDigits = rule?.digits ?? 9;
                    const digits = onlyDigits(phoneNumber.value).slice(0, maxDigits);
                    phoneNumber.value = formatLocalPhone(digits);
                    doLiveValidate(phoneNumber);
                });

                phoneCode?.addEventListener('change', () => {
                    const rule = getCountryRuleByDial(phoneCode.value);
                    if (!rule || !phoneNumber) return;

                    if (nationality && !nationality.value) {
                        nationality.value = rule.name;
                    }

                    const digits = onlyDigits(phoneNumber.value).slice(0, rule.digits);
                    phoneNumber.value = formatLocalPhone(digits);
                    doLiveValidate(phoneCode);
                });

                block.querySelector('.ptype')?.addEventListener('change', () => doLiveValidate(block.querySelector('.ptype')));
                block.querySelector('.gender')?.addEventListener('change', () => doLiveValidate(block.querySelector('.gender')));
                block.querySelector('.birthdate')?.addEventListener('change', () => doLiveValidate(block.querySelector('.birthdate')));

                const fnameEl = block.querySelector('.fname');
                if (fnameEl) {
                    fnameEl.addEventListener('input', () => {
                        fnameEl.value = fnameEl.value.replace(/[0-9]/g, '');
                        doLiveValidate(fnameEl);
                    });
                }

                const lnameEl = block.querySelector('.lname');
                if (lnameEl) {
                    lnameEl.addEventListener('input', () => {
                        lnameEl.value = lnameEl.value.replace(/[0-9]/g, '');
                        doLiveValidate(lnameEl);
                    });
                }

                container.appendChild(block);
            }
        }

        function loadSummary() {
            const summaryDest = document.getElementById('summaryDest');
            if (summaryDest) {
                summaryDest.innerHTML = `${localStorage.getItem('reservationDestination') || 'Destinacija'} <small id="summaryCountry">${localStorage.getItem('reservationCountry') || '—'}</small>`;
            }

            const hotelEl = document.getElementById('summaryHotelName');
            if (hotelEl) hotelEl.textContent = localStorage.getItem('reservationHotelName') || '—';

            const roomEl = document.getElementById('summaryRoom');
            if (roomEl) roomEl.textContent = localStorage.getItem('reservationRoom') || '—';

            const nightsEl = document.getElementById('summaryNights');
            if (nightsEl) nightsEl.textContent = localStorage.getItem('reservationNights') || localStorage.getItem('reservationDuration') || '—';

            const travelersEl = document.getElementById('summaryTravelers');
            if (travelersEl) {
                const adults = localStorage.getItem('reservationAdults');
                const children = localStorage.getItem('reservationChildren');
                if (adults && parseInt(adults, 10) > 0) {
                    travelersEl.textContent = `${adults}x Odrasli${children && parseInt(children, 10) > 0 ? `, ${children}x Djeca` : ''}`;
                } else {
                    travelersEl.textContent = localStorage.getItem('reservationTravelers') || '—';
                }
            }

            const totalEl = document.getElementById('summaryTotal');
            if (totalEl) totalEl.textContent = localStorage.getItem('reservationTotal') || '0 KM';

            const prevozTip = localStorage.getItem('reservationPrevozTip') || '';
            const autobusRezervisan = localStorage.getItem('reservationBus');

            const flightSection = document.getElementById('flightSummarySection');
            const busSection = document.getElementById('busSummarySection');
            const passengerTitle = document.getElementById('passengerPanelTitle');

            if (prevozTip.toLowerCase().includes('autobus') || (autobusRezervisan && autobusRezervisan !== '—' && autobusRezervisan.trim() !== '')) {
                if (flightSection) flightSection.style.display = 'none';
                if (busSection) busSection.style.display = 'block';
                if (passengerTitle) passengerTitle.textContent = "Podaci o putnicima (Autobus i Hotel)";

                const busDep = document.getElementById('summaryBusDeparture');
                const busRet = document.getElementById('summaryBusReturn');
                if (busDep) busDep.textContent = localStorage.getItem('reservationDepartureText') || localStorage.getItem('reservationDeparture') || '—';
                if (busRet) busRet.textContent = localStorage.getItem('reservationReturnText') || localStorage.getItem('reservationReturn') || '—';
            } else {
                if (flightSection) flightSection.style.display = 'block';
                if (busSection) busSection.style.display = 'none';
                if (passengerTitle) passengerTitle.textContent = "Podaci o putnicima (Letovi i Hoteli)";

                const depEl = document.getElementById('summaryDeparture');
                if (depEl) depEl.textContent = localStorage.getItem('reservationDepartureText') || localStorage.getItem('reservationDeparture') || '—';

                const retEl = document.getElementById('summaryReturn');
                if (retEl) retEl.textContent = localStorage.getItem('reservationReturnText') || localStorage.getItem('reservationReturn') || '—';

                const routeEl = document.getElementById('summaryFlightRoute');
                if (routeEl) routeEl.textContent = localStorage.getItem('reservationFlightRoute') || localStorage.getItem('reservationFlight') || '—';

                const classEl = document.getElementById('summaryFlightClass');
                if (classEl) classEl.textContent = localStorage.getItem('reservationFlightClass') || 'Ekonomska';
            }

            const photo = document.getElementById('summaryPhoto');
            const image = localStorage.getItem('reservationImage') || '/assets/bali.jpg';
            if (photo) {
                photo.style.background = `linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.5)), url('${image}') center/cover no-repeat`;
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }

        function setFormError(msg) {
            const el = document.getElementById('formError');
            if (!el) return;
            if (!msg) {
                el.style.display = 'none';
                el.textContent = '';
                return;
            }
            el.style.display = 'block';
            el.textContent = msg;
        }

        function validateBlock(block, idx, isLive = false) {
            const type = block.querySelector('.ptype')?.value || 'adult';
            const genderEl = block.querySelector('.gender');
            const birthEl = block.querySelector('.birthdate');
            const fnameEl = block.querySelector('.fname');
            const lnameEl = block.querySelector('.lname');
            const passportEl = block.querySelector('.passport');
            const nationalityEl = block.querySelector('.nationality');
            const phoneEl = block.querySelector('.phoneNumber');

            const errorColor = '#dc2626';

            if (!isLive) {
                [genderEl, birthEl, fnameEl, lnameEl, passportEl, nationalityEl, phoneEl].forEach(el => {
                    if (el) el.style.borderColor = '';
                });
            }

            if (fnameEl && !fnameEl.value.trim()) {
                if (!isLive) fnameEl.style.borderColor = errorColor;
                return { ok: false, msg: `Unesite ime za putnika ${idx + 1}.` };
            }

            if (lnameEl && !lnameEl.value.trim()) {
                if (!isLive) lnameEl.style.borderColor = errorColor;
                return { ok: false, msg: `Unesite prezime za putnika ${idx + 1}.` };
            }

            if (genderEl && !genderEl.value) {
                if (!isLive) genderEl.style.borderColor = errorColor;
                return { ok: false, msg: `Odaberite pol za putnika ${idx + 1}.` };
            }

            const birthDate = birthEl?.value;
            if (!birthDate) {
                if (!isLive && birthEl) birthEl.style.borderColor = errorColor;
                return { ok: false, msg: `Unesite datum rođenja za putnika ${idx + 1}.` };
            }

            const inputYear = parseInt(birthDate.split('-')[0], 10);
            const currentYear = new Date().getFullYear();

            if (inputYear < 1900 || inputYear > currentYear) {
                if (birthEl) birthEl.style.borderColor = errorColor;
                return { ok: false, msg: `Godina rođenja za putnika ${idx + 1} mora biti između 1900. i ${currentYear}. godine.` };
            }

            const age = calcAgeYears(birthDate);
            if (age === null) return { ok: false, msg: `Datum rođenja za putnika ${idx + 1} nije ispravan.` };
            if (type === 'adult' && age < 18) {
                if (birthEl) birthEl.style.borderColor = errorColor;
                return { ok: false, msg: `Putnik ${idx + 1} ima ${age} god. Ako je Odrasli, mora imati 18+ godina.` };
            }

            if (type === 'child' && age >= 18) {
                if (birthEl) birthEl.style.borderColor = errorColor;
                return { ok: false, msg: `Putnik ${idx + 1} ima ${age} god. Ako je Dijete, mora imati manje od 18 godina.` };
            }

            const phoneCode = block.querySelector('.phoneCode')?.value || '';
            const phoneDigits = onlyDigits(phoneEl?.value || '');

            if (!phoneCode) {
                if (!isLive && block.querySelector('.phoneCode')) block.querySelector('.phoneCode').style.borderColor = errorColor;
                return { ok: false, msg: `Odaberite pozivni broj za putnika ${idx + 1}.` };
            }

            const rule = getCountryRuleByDial(phoneCode);
            const expected = rule?.digits ?? 9;

            if (phoneDigits.length !== expected) {
                if (!isLive && phoneEl) phoneEl.style.borderColor = errorColor;
                return { ok: false, msg: `Broj telefona za putnika ${idx + 1} mora imati tačno ${expected} cifara.` };
            }

            const passport = (passportEl?.value || '').trim();
            const PASSPORT_LEN = 9;

            if (!passport || passport.length !== PASSPORT_LEN || !/^[A-Z0-9]+$/.test(passport)) {
                if (!isLive && passportEl) passportEl.style.borderColor = errorColor;
                return { ok: false, msg: `Broj pasoša za putnika ${idx + 1} mora imati tačno ${PASSPORT_LEN} alfanumeričkih karaktera.` };
            }

            if (nationalityEl && !nationalityEl.value) {
                if (!isLive) nationalityEl.style.borderColor = errorColor;
                return { ok: false, msg: `Odaberite državljanstvo za putnika ${idx + 1}.` };
            }

            return { ok: true, msg: '' };
        }

        function goToPayment() {
            setFormError('');
            const passengers = [];
            const blocks = document.querySelectorAll('.passenger-block');

            let countAdultsForm = 0;
            let countChildrenForm = 0;

            for (let idx = 0; idx < blocks.length; idx++) {
                const block = blocks[idx];
                const res = validateBlock(block, idx, false);
                if (!res.ok) {
                    setFormError(res.msg || "Provjerite podatke putnika.");
                    block.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }

                const type = block.querySelector('.ptype')?.value || 'adult';
                if (type === 'adult') countAdultsForm++;
                if (type === 'child') countChildrenForm++;

                const nationalityEl = block.querySelector('.nationality');
                const phoneCode = block.querySelector('.phoneCode')?.value || '';
                const phoneDigits = onlyDigits(block.querySelector('.phoneNumber')?.value || '');

                const phoneFormatted = phoneCode ? formatFullPhone(phoneCode, phoneDigits) : "";
                
                const fnameVal = block.querySelector('.fname')?.value || "";
                const lnameVal = block.querySelector('.lname')?.value || "";
                const birthdateVal = block.querySelector('.birthdate')?.value || "";
                const passportVal = block.querySelector('.passport')?.value || "";
                const freqFlyerVal = block.querySelector('.freqFlyer')?.value || "";
                const bedPrefVal = block.querySelector('.bedPreference')?.value || "no-preference";
                const requestsVal = block.querySelector('.requests')?.value || "";

                const p = {
                    type,
                    gender: block.querySelector('.gender')?.value || "",
                    firstName: fnameVal.trim(),
                    lastName: lnameVal.trim(),
                    birthDate: birthdateVal,
                    passport: passportVal.trim(),
                    nationality: nationalityEl?.value || "",
                    phone: phoneFormatted,
                    freqFlyer: freqFlyerVal.trim(),
                    bedPreference: bedPrefVal,
                    requests: requestsVal.trim()
                };
                passengers.push(p);
            }

            const expectedAdults = parseInt(localStorage.getItem('reservationAdults') || '0', 10);
            const expectedChildren = parseInt(localStorage.getItem('reservationChildren') || '0', 10);

            if (localStorage.getItem('reservationAdults') !== null || localStorage.getItem('reservationChildren') !== null) {
                if (countAdultsForm !== expectedAdults || countChildrenForm !== expectedChildren) {
                    setFormError(`Struktura putnika ne odgovara rezervaciji! Izabrano: ${countAdultsForm} odraslih, ${countChildrenForm} djece. Očekivano: ${expectedAdults} odraslih, ${expectedChildren} djece.`);
                    return;
                }
            }

            localStorage.setItem('savedPassengers', JSON.stringify(passengers));
            const paketId = localStorage.getItem('reservationPaketId');
            window.location.href = paketId ? (`/Placanje?paketId=${encodeURIComponent(paketId)}`) : '/Placanje';
        }

        window.addEventListener('DOMContentLoaded', () => {
            generatePassengers();
            loadSummary();
        });
    </script>
</body>
</html>